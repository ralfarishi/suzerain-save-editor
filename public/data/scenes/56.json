{"conversationId":56,"title":"Sordland/Turn04/InT_TaurusHighwayIssue","storyPack":"StoryPack_Main","turn":4,"turnLabel":"Turn 4","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":1}]},"1":{"id":1,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":4}]},"2":{"id":2,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"But the main purpose of our visit was to resolve the strike that began to endanger the deadline.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":7}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"The H-3 Highway construction created a second opportunity to visit the seaside town of Lenkurg known for its salmon. Thousands of people from the city were employed for construction work by the new highway project.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":3}]},"5":{"id":5,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn04_InT_Issue","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":122}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"The mayor welcomed us at his own mansion and praised us for our decision to extensively invest in the Agnland region.","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":13}]},"7":{"id":7,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":8},{"convId":56,"nodeId":9}]},"8":{"id":8,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":6}]},"9":{"id":9,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":10}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"The mayor welcomed us at his own mansion and took us on a brief tour in the city.","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":12}]},"11":{"id":11,"speaker":"Narrator","isPlayerChoice":false,"text":"There also was a message of support from the mayor of Arvory, Eric Niel, who was grateful for the H-3 investments.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":24}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"We gathered at the city hall. Symon looked a little worried but Lileas was dead serious.","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == false) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":11}]},"13":{"id":13,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":14},{"convId":56,"nodeId":15}]},"14":{"id":14,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":16}]},"15":{"id":15,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == false) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":12}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"Dozens of people were outside the mansion grounds and chanting party slogans in a show of support.","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":12}]},"17":{"id":17,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“We scheduled the construction to finish sooner but Taurus Holding might miss that target with the current trajectory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":18}]},"18":{"id":18,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“The bill is necessary for this country. Our people need to be compensated and have safety regulations.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":19}]},"19":{"id":19,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I think you have the power to pass it which could help solve the protests. Alternatively, we could wait it out and let them get back to work.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":32},{"convId":56,"nodeId":33},{"convId":56,"nodeId":34}]},"20":{"id":20,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":21},{"convId":56,"nodeId":22}]},"21":{"id":21,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn04_InT_Issue_TH_Give\"] == true","variablesRead":[{"var":"BaseGame.Turn04_InT_Issue_TH_Give","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":23}]},"22":{"id":22,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn04_InT_Issue_TH_Give\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn04_InT_Issue_TH_Give","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":5}]},"23":{"id":23,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn04_LT_WorkersRights_SignedLate","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":5}]},"24":{"id":24,"speaker":"Narrator","isPlayerChoice":false,"text":"After dinner, we moved to a meeting room. Symon began.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":26}]},"25":{"id":25,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“The strike that popped up at the construction site is causing issues.”","conditionsRaw":"(Variable[\"BaseGame.Bill_Turn04_WorkersRights_Signed\"] == true) == false","variablesRead":[{"var":"BaseGame.Bill_Turn04_WorkersRights_Signed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":29}]},"26":{"id":26,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":27},{"convId":56,"nodeId":28}]},"27":{"id":27,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Bill_Turn04_WorkersRights_Signed\"] == true","variablesRead":[{"var":"BaseGame.Bill_Turn04_WorkersRights_Signed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":31}]},"28":{"id":28,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Bill_Turn04_WorkersRights_Signed\"] == true) == false","variablesRead":[{"var":"BaseGame.Bill_Turn04_WorkersRights_Signed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":25}]},"29":{"id":29,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“After the terrible Morbel mine disaster, workers have been on edge. Vetoing the Workers' Rights bill certainly did not help with the situation either.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":30}]},"30":{"id":30,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Strikers primary demand is for the bill to be reinstated. We have to solve the issue or the construction will stay halted longer.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":17}]},"31":{"id":31,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Taurus Holding has reached out to us and requested more funds.”","conditionsRaw":"Variable[\"BaseGame.Bill_Turn04_WorkersRights_Signed\"] == true","variablesRead":[{"var":"BaseGame.Bill_Turn04_WorkersRights_Signed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":68}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“We could just wait it out until the strikers get tired.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":36}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"“Why don't we just do what they want and pass the Workers' Rights bill?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":35}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“We could replace the striking workers.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":37}]},"35":{"id":35,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“We can avoid many more strikes if we show them that we can adapt and change.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":39}]},"36":{"id":36,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“That is an option but I am not sure how helpful it will be. Passing the bill will be respecting their demands.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":38}]},"37":{"id":37,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“We can't stand idle and we can't allow our stubbornness on laws to allow a few strikers to hold the construction.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":40}]},"38":{"id":38,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I agree with Lileas. Doubt sitting idly will help in this case.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":41}]},"39":{"id":39,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This could be the best choice to handle this swiftly.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":41}]},"40":{"id":40,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This will only serve to rile up the strikers even more. We might end up with a bigger mess.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":41}]},"41":{"id":41,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“We need to show people that we can finish this project, our first mega project, on time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":121}]},"42":{"id":42,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“However, following the veto, we have ceased the implementation of the policy and disbanded the expert team, resulting in a potential increase in the cost of the bill if new teams are to be established.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":43},{"convId":56,"nodeId":44},{"convId":56,"nodeId":45}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"“Absolutely not. I will not let a few strikers decide the future of our country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":46}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“You have a point.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":47}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"“We need to cut the head of the snake to truly stop this issue by replacing the strikers.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":48}]},"46":{"id":46,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I disagree. If we don't change our laws, this will lower the trust in our government and cause stability issues.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":112}]},"47":{"id":47,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“A strong government can backtrack on its decisions and accept it was wrong.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":112}]},"48":{"id":48,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Making an example of the strikers is wrong. We need to tackle the root of the issue.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":112}]},"49":{"id":49,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“What is your decision then, Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":50}]},"50":{"id":50,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“How should we handle the strikes?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":51},{"convId":56,"nodeId":52},{"convId":56,"nodeId":53}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“We will begin the procedure to pass the vetoed Workers' Rights bill. [-2 Government Budget]”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":105}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"“I'm not worried. Let's just wait it out. They will stop at one point and everything will be alright.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":58}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"“Order Taurus Holding to replace the strikers with new workers. This should fix our issue.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":59}]},"54":{"id":54,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I'm not sure about this but as you wish.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_TH_Wait","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusWait","op":"=","value":"true"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] - 1"}],"outgoingIds":[{"convId":56,"nodeId":60}]},"55":{"id":55,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Glad we made this choice.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Bill_Turn04_WorkersRights_Vetoed","op":"=","value":"false"},{"var":"BaseGame.Bill_Turn04_WorkersRights_Signed","op":"=","value":"true"},{"var":"BaseGame.Policy_Law_WorkersRightsReform","op":"=","value":"true"},{"var":"BaseGame.Situation_Welfare_ImprovedWorkingConditions","op":"=","value":"true"},{"var":"BaseGame.Situation_Economy_ExpensiveWorkersPayments","op":"=","value":"true"},{"var":"BaseGame.GovernmentBudget","op":"=","value":"Variable[\"BaseGame.GovernmentBudget\"] - 2"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusSign","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_WorkersRights_Signed","op":"=","value":"true"},{"var":"BaseGame.Turn04_InT_Issue_TH_Give","op":"=","value":"true"},{"var":"BaseGame.Turn04_InT_HighwayIssue_Solved","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":119}]},"56":{"id":56,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Respect for the state will increase. Standing by the people is the right choice.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":60}]},"57":{"id":57,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Very well. Hopefully the backlash doesn't affect us too much.”","conditionsRaw":"(Variable[\"BaseGame.Situation_Law_MediaBias\"] == true) and ((Variable[\"BaseGame.Situation_Law_MediaBias\"] == true) == false)","variablesRead":[{"var":"BaseGame.Situation_Law_MediaBias","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_TH_Replace","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusReplaced","op":"=","value":"true"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] - 1"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] - 2"}],"outgoingIds":[{"convId":56,"nodeId":60}]},"58":{"id":58,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_TH_Wait","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":100}]},"59":{"id":59,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_TH_Replace","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":99}]},"60":{"id":60,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Regardless, the decision is made.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":61}]},"61":{"id":61,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Well then. Thank you for coming. That is all on this matter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":63},{"convId":56,"nodeId":62},{"convId":56,"nodeId":64}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":66}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“Let's enjoy the hospitality of the Mayor.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":65}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“Good night.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":66}]},"65":{"id":65,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“That, I'm intending to.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":67}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon nodded and we left the meeting room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":20}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"We left the meeting room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":20}]},"68":{"id":68,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“As per the report they have sent, to finish the highway on time, they realised more capital is necessary due to the new labour laws.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":86}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"“I do not permit incompetence.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":76}]},"70":{"id":70,"speaker":"Player","isPlayerChoice":true,"text":"“Why do they even need the extra money?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":77}]},"71":{"id":71,"speaker":"Player","isPlayerChoice":true,"text":"“It's important that we finish this project on time. Money is no matter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":74}]},"72":{"id":72,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“This is unacceptable. I should have known that a cheaper offer wasn't technically possible. We wouldn't have this issue if you decided to go with SSC instead of Taurus.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":73}]},"73":{"id":73,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Now they are requesting more funds to be able to cover the increased costs. If we don't provide we could face a delay which would endanger our reputation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":69},{"convId":56,"nodeId":70},{"convId":56,"nodeId":71}]},"74":{"id":74,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“If we spend the extra amount they are requesting, we might miss other opportunities.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":75}]},"75":{"id":75,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“It's unfortunate that we were put in this spot. Do we really have a choice here?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":91}]},"76":{"id":76,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“None of us do and this is specifically why there was a brief about each companies and the potential issues.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":90}]},"77":{"id":77,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“They need it for unforeseen expenses that came from the new Workers' Rights Bill. A couple of shipment companies they had contract with also increased costs on the necessary materials.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":78}]},"78":{"id":78,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“The state must have more control over these construction projects. For the next project we should appoint a direct manager from the cabinet.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":91}]},"79":{"id":79,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“What is your decision, Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":80},{"convId":56,"nodeId":81}]},"80":{"id":80,"speaker":"Player","isPlayerChoice":true,"text":"“Give them the additional funds.” [-1 Government Budget]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":82}]},"81":{"id":81,"speaker":"Player","isPlayerChoice":true,"text":"“We don't have the funds to spare.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":83}]},"82":{"id":82,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“As you wish. I will allocate the funding to Taurus Holding.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":84}]},"83":{"id":83,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This will most likely cause a delay but Taurus Holding will be informed immediately.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":89}]},"84":{"id":84,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_TH_Money","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusFunds","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":88}]},"85":{"id":85,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“First they fail to do their job properly, then they get the money. Ridiculous!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_TH_Money","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusFunds","op":"=","value":"true"},{"var":"BaseGame.Turn04_InT_HighwayIssue_Solved","op":"=","value":"true"},{"var":"BaseGame.GovernmentBudget","op":"=","value":"Variable[\"BaseGame.GovernmentBudget\"] - 1"}],"outgoingIds":[{"convId":56,"nodeId":120}]},"86":{"id":86,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“We scheduled the construction to finish sooner but Taurus Holding might miss that target with the current trajectory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":72}]},"87":{"id":87,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModifi