all along.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":98}]},"96":{"id":96,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Why even involve outsiders when we have our own corporation to get things done?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":98}]},"97":{"id":97,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I'm sceptical about another for profit company after Taurus.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":98}]},"98":{"id":98,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Will we sink more money into this or let them figure it out?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":56,"nodeId":79}]},"99":{"id":99,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusReplaced","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":115}]},"100":{"id":100,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusWait","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":113}]},"101":{"id":101,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I have no expectations of hitting that opening deadline at this point.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_TaurusNoFunds","op":"=","value":"true"}],"outgoingIds":[{"convId":56,"nodeId":60}]},"102":{"id":102,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Bill_Turn04_WorkersRights_Vetoed","op":"=","value":"false"},{"var":"BaseGame.Bill_Turn04_WorkersRights_Signed",