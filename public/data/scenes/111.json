{"conversationId":111,"title":"Sordland/Turn07/WhatIsYourNextMove","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":10}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":112,"nodeId":1}]},"3":{"id":3,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"That's relieving to hear. I thought you forgot about all the other issues.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":35}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"She sighed and looked outside the window for a moment.","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 2"}],"outgoingIds":[{"convId":111,"nodeId":5}]},"5":{"id":5,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Can you explain me one thing. How come you think that the Supreme Court's right to vote on constitutional amendments is a major problem with such priority?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":83}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"\"To further the reforms.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":20}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"\"To ensure the new processes are respected and executed in transparency.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":91}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"\"Focus on our internal and external threats.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":18}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"\"We will eliminate the Old Guards from all branches of government.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":23}]},"10":{"id":10,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"...What will be your next move?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":11},{"convId":111,"nodeId":7},{"convId":111,"nodeId":6},{"convId":111,"nodeId":8}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":12},{"convId":111,"nodeId":13}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":9}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"14":{"id":14,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I thought we wer-\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":21}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"She sighed and looked outside the window for a moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":5}]},"16":{"id":16,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":26}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"\"That point was a red line for Mr. Ricter. We had to include it.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) and (Variable[\"BaseGame.Reform_Reformist_Path\"] == true)","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"},{"var":"BaseGame.Reform_Reformist_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":49}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":3}]},"19":{"id":19,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Mr. President!\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 2"}],"outgoingIds":[{"convId":111,"nodeId":34}]},"20":{"id":20,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":35}]},"21":{"id":21,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I'm asking the President, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":54},{"convId":111,"nodeId":71},{"convId":111,"nodeId":56},{"convId":111,"nodeId":17}]},"22":{"id":22,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":4}]},"23":{"id":23,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"You shouldn't make a move against the Court, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":24}]},"24":{"id":24,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"How can I be sure that you will not go after us too?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":25},{"convId":111,"nodeId":27},{"convId":111,"nodeId":29}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"\"Trust me. It is only the Old Guard we're after.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":77}]},"26":{"id":26,"speaker":"Narrator","isPlayerChoice":false,"text":"She sighed and looked outside the window for a moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":5}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"Help me bring Orso Hawker down. He's the only one we need.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":77}]},"28":{"id":28,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I'm sorry?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 2"}],"outgoingIds":[{"convId":111,"nodeId":60},{"convId":111,"nodeId":44},{"convId":111,"nodeId":36}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"\"We can't do anything without a proper cause anyway.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":77}]},"30":{"id":30,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Mrs. Edmonds... Mr. President had a rough day. This court vote is extremely important for us. Please do understand our position.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":22}]},"31":{"id":31,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Mrs. Edmonds, we are not against you. We want you on our side.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":35}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":16}]},"33":{"id":33,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I don't know what to say, Mr. President...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":2}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"Nia looked really worried and tense.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":30}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"Isabel took another sip from her water and looked at me without saying anything.","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":38},{"convId":111,"nodeId":39},{"convId":111,"nodeId":40}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"\"I did not intend any offense, Mrs. Edmonds. Please accept my apology.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":65}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 2"}],"outgoingIds":[{"convId":111,"nodeId":28}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"\"Mrs. Edmonds, please help us achieve this victory. We have to be together in this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":41}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"\"What do you want in return for the centrist vote?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":43}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"Mrs. Edmonds, how about we get to the point now?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":42}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":57}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":111,"nodeId":55}]},"43":{"id":43,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I don't want anything, Mr. President...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":67}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's just get to the point, Mrs. Edmonds. Do I have your vote or not?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":73}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"\"I told you. You are not our target.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":75}]},"46":{"id":46,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Just because your *corruption* police put some pressure on the Court, doesn't mean you own it now.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":74}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"She sighed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":111,"nodeId":33}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":111,"nodeId":47}]},"49":{"id":49,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Interesting. So you do not own it up, after all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":33}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":51},{"convId":111,"nodeId":52}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":53}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":59}]},"53":{"id":53,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I just want assurance that you don't intend to destroy the Court.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":111,"nodeId":45},{"convId":111,"nodeId":62},{"convId":111,"nodeId":63}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"\"Why don't you ask the *reformists*? This proposal was made together.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":48}]},"55":{"id":55,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Isn't that where we are?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":111,"nodeId":68}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"\"The judiciary should not have legislative powers, Mrs. Edmonds.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":76}]},"57":{"id":57,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Perhaps that is the way we must take...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":5}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"\"I did not intend any offense, Mrs. Edmonds. Please accept my apology.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":32}]},"59":{"id":59,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"My vote is not for sale.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":111,"nodeId":74}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"\"You heard me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":73}]},"61":{"id":61,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I hope so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":111,"nodeId":5}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"\"How can we even do that? Please, Mrs. Edmonds. Don't overexaggerate.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":111,"nodeId":92}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":tru