Ids":[{"convId":261,"nodeId":10}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"You barely registered the shockwave as the wall of extreme heat and pressure destroyed everything in its path.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":11}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":false,"text":"You couldn't believe what you were seeing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":13}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":false,"text":"It was the last thing you saw.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":2}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":false,"text":"You closed your ears and crouched down.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":6}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":9}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":3}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":5}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":261,"nodeId":8}]}}}