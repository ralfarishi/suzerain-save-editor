{"conversationId":293,"title":"Rizia/Turn 1/Intention Questions","storyPack":"StoryPack_Rizia","turn":1,"turnLabel":"Turn 1","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":4},{"convId":293,"nodeId":7},{"convId":293,"nodeId":71},{"convId":293,"nodeId":10}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":291,"nodeId":307}]},"3":{"id":3,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will be honest with you. I'm considering reforming the Rizian government.\"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_Reform\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_Reform","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":86}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":5},{"convId":293,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_Absolutism\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_Absolutism","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":11}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Focus_Government_Absolutism\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Focus_Government_Absolutism","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":8},{"convId":293,"nodeId":9}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_Reform\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_Reform","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":3}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Focus_Government_Reform\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Focus_Government_Reform","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No, that will be all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":50}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Your Grace, I feel the situation as you've just described it leaves me with limited power over my own kingdom. I wish to reign unchallenged by the House of Delegates or any of the noble families.\"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_Absolutism\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_Absolutism","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":67}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"Vina's eyes widened in shock. Hugo appeared unfazed.","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.LeaningValue_Democratic","op":"=","value":"Variable[\"RiziaDLC.LeaningValue_Democratic\"] - 2"},{"var":"RiziaDLC.PersonalValue_Tyrant","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_Tyrant\"] + 1"}],"outgoingIds":[{"convId":293,"nodeId":17}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":14},{"convId":293,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":12}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":16}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"Surprise registered on Hugo's face, but only for a second. He stroked his chin.","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.LeaningValue_Democratic","op":"=","value":"Variable[\"RiziaDLC.LeaningValue_Democratic\"] - 2"},{"var":"RiziaDLC.PersonalValue_Tyrant","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_Tyrant\"] + 1"}],"outgoingIds":[{"convId":293,"nodeId":17}]},"17":{"id":17,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You've hit upon an interesting point, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":28}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":19},{"convId":293,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":22}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"Vina opened her mouth in shock.","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.LeaningValue_Democratic","op":"=","value":"Variable[\"RiziaDLC.LeaningValue_Democratic\"] + 2"}],"outgoingIds":[{"convId":293,"nodeId":23}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"Surprise flashed across Hugo's face, but only for a second.","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.LeaningValue_Democratic","op":"=","value":"Variable[\"RiziaDLC.LeaningValue_Democratic\"] + 2"}],"outgoingIds":[{"convId":293,"nodeId":23}]},"23":{"id":23,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I hope you don't have any drastic changes in mind, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":24}]},"24":{"id":24,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The RPP may try to claim otherwise, but the citizens of Rizia hardly hunger for reform. The majority are perfectly satisfied with things as they are.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":31}]},"25":{"id":25,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This wouldn't be for me. I want to pave the way for Vina and all of her descendents.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":51}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"How do you know support is high? Anyone could be plotting anything at any time. It unsettles me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":49}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're right. I'm better off keeping things as they are.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":57}]},"28":{"id":28,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I myself have often wondered whether Rizia would be stronger were it wholly united under the banner of House Toras.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":29}]},"29":{"id":29,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Ultimately, though, the Crown enjoys high support among both the Delegates and the noble houses. I fear any attempt to defang them will lead to more strife than it is worth.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":25},{"convId":293,"nodeId":59},{"convId":293,"nodeId":63},{"convId":293,"nodeId":26},{"convId":293,"nodeId":27}]},"30":{"id":30,"speaker":"Vina Toras","isPlayerChoice":false,"text":"\"Do you know that for sure, Uncle Hugo? Our only information source is the Royal Herald, after all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":36}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":32},{"convId":293,"nodeId":33}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":34}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":35}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"Vina's nose wrinkled.","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":30}]},"35":{"id":35,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"What's more, the nobility would never tolerate such a major shake-up. Why, it was all Valero could do to get them to accept the House of Delegates.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":40},{"convId":293,"nodeId":43},{"convId":293,"nodeId":38},{"convId":293,"nodeId":37}]},"36":{"id":36,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I have my ear to the ground. Any potential sources of discontent are the ones I've already mentioned. Hardly worth rearranging the government for.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":35}]},"37":{"id":37,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let's just forget I asked this question.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":46}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"A major shake-up is not what I had in mind. I only want a few small tweaks here and there.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":84}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo firmly pressed his hands on the table.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":44}]},"40":{"id":40,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Thank you for your opinion. I'll keep it in mind.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":41}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo looked unsatisfied.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":42}]},"42":{"id":42,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Please do.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":83}]},"43":{"id":43,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"A more democratic Rizia would benefit all of us. Citizens and nobles alike.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":39}]},"44":{"id":44,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"As king, you can directly make Rizians' lives better with the stroke of a pen. I don't see why anyone would trade that for populism and infighting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":83}]},"45":{"id":45,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The best advice I can give you is to proceed gradually. Else you risk hurting the very citizens you wish to help.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":83}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo looked unsatisfied.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":47}]},"47":{"id":47,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Very well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":83}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"Vina looked askance at me, but said nothing.","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":55}]},"49":{"id":49,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I have my ear to the ground. The only potential sources of discontent are the ones I already mentioned. For now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":68}]},"50":{"id":50,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Very good.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":2}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":52},{"convId":293,"nodeId":53}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":48}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":54}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo gave an approving nod.","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":55}]},"55":{"id":55,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I completely understand the impulse. But upset the balance of power too suddenly, and your path will be far from smooth.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":56}]},"56":{"id":56,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"There is nothing stopping you from passing laws aimed at centralization. But it must be done with the utmost of sensitivity.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":69}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"My uncle arched an eyebrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":58}]},"58":{"id":58,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If it appears that any of the houses are about to pose a threat -- well, then we can have this conversation again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":85}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":60},{"convId":293,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Religious\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Religious","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Religious\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Religious","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"62":{"id":62,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"But I fear that Rizia is straying from its Wruhecist roots. Only I can restore religious harmony to the kingdom.\"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Religious\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Religious","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":64}]},"63":{"id":63,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The measures I intend to implement are necessary, but they won't be popular. I want to make sure they're met with minimal backlash.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":66}]},"64":{"id":64,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I see...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":65}]},"65":{"id":65,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"In that case, I am sure the religious community will support you. But Grand Wiseman Ignacius can advise you better than I can on this matter.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":85}]},"66":{"id":66,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It is true that the nobles in this kingdom often have trouble seeing past their own provinces.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":56}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.LeaningValue_Democratic","op":"=","value":"Variable[\"RiziaDLC.LeaningValue_Democratic\"] - 2"},{"var":"RiziaDLC.PersonalValue_Tyrant","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_Tyrant\"] + 1"}],"outgoingIds":[{"convId":293,"nodeId":13}]},"68":{"id":68,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Please trust that I will come to you if the situation changes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":85}]},"69":{"id":69,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Unless any of the houses pose an immediate threat, of course. In which case more drastic action would be justified.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":85}]},"70":{"id":70,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I worry the modern era may bring unwanted change to Rizia. All I've ever wanted was to keep things as they are.\"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_StatusQuo\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_StatusQuo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":74}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":72},{"convId":293,"nodeId":73}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_StatusQuo\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_StatusQuo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":70}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Focus_Government_StatusQuo\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Focus_Government_StatusQuo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"74":{"id":74,"speaker":"Narrator","isPlayerChoice":false,"text":"I saw sympathy in Hugo's eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":75}]},"75":{"id":75,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"That is perhaps the most challenging duty of a monarch -- to project stability and serenity even amidst the most violent of tempests.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":76}]},"76":{"id":76,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But you are not alone. Have faith in House Toras and the Rizian National Coalition to help you preserve calm and order.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":77}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":78},{"convId":293,"nodeId":79}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":80}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":82}]},"80":{"id":80,"speaker":"Vina Toras","isPlayerChoice":false,"text":"\"There's also GRACE, right? As long as we're a member, we can rely on Rumburg and the others to keep the monarchy strong.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_OnCouncil\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":81}]},"81":{"id":81,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Absolutely, Your Highness. Your aunt would never let anything get in the way of your future reign.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":87}]},"82":{"id":82,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And do not forget that we are part of a network of monarchies. Rumburg and the other members of GRACE have a vested interest in ensuring a smooth reign for you and your descendents.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_OnCouncil\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_OnCouncil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":87}]},"83":{"id":83,"speaker":"Narrator","isPlayerChoice":false,"text":"He took one last curious look at me before brightening up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":87}]},"84":{"id":84,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Hmm. Such a strategy could pacify would-be reformists without ruffling the feathers of those who prefer the status quo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":45}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"He was pensive for a moment; then, his expression brightened.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":293,"nodeId":87}]},"86":{"id":86,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.LeaningValue_Democratic","op":"=","value":"Variable[\"RiziaDLC.LeaningValue_Democratic\"] + 2"}],"outgoingIds":[{"convId":293,"nodeId":18}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Hugo_KnowsIntention","op":"=","value":"true"}],"outgoingIds":[{"convId":293,"nodeId":2}]}}}