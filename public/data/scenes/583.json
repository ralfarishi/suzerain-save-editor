:{"id":19,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Your approval of the RPP's other tax proposal has already left you on thin ice with the nobility.\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true) and (Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true)","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":20}]},"20":{"id":20,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You shouldn't push it too far.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":28}]},"21":{"id":21,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Allowing the RPP to use the media against us has already created problems with the nobility.\"","conditionsRaw":"((Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true) == false) and (Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress\"] == true) and (Variable[\"RiziaDLC.Policy_RD_Welfare_FreePress\"] == true)","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Welfare_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":22}]},"22":{"id":22,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Signing this would be a step too far for them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":28}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":24},{"convId":583,"nodeId":25}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":26}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":61}]},"26":{"id":26,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"After what you've already taken away from them, this is simply overkill.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":61}]},"27":{"id":27,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But this proposal was a deliberate attempt by the RPP to attack nobles.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":48},{"convId":583,"nodeId":42}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":29},{"convId":583,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":31}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":39}]},"31":{"id":31,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You already weakened the Royal Houses with your decrees, Romus.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":27}]},"32":{"id":32,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Please don't let the RPP influence you.\"","conditionsRaw":"(Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true) == false","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":48},{"convId":583,"nodeId":50}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":34},{"convId":583,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":36}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true) == false","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":32}]},"36":{"id":36,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"These proposals lost all of their legitimacy when you closed down the House of Delegates.\"","conditionsRaw":"Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":38}]},"37":{"id":37,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If the nobility sees taxation as an attack, that says more about them really.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"38":{"id":38,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"There is no point in even considering them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":52},{"convId":583,"nodeId":48}]},"39":{"id":39,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Please reconsider.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":48},{"convId":583,"nodeId":51}]},"40":{"id":40,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So taxation is only legitimate when it burdens the commoners? But when it reaches the nobility, it's suddenly a conspiracy?\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"41":{"id":41,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've already declared my support to the Rizian People's Party. I hope there is no confusion about this.\"","conditionsRaw":"Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"42":{"id":42,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're being dramatic again, Hugo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":44},{"convId":583,"nodeId":45}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":41}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":47}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":129},{"convId":583,"nodeId":130},{"convId":583,"nodeId":131}]},"47":{"id":47,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Don't let who wrote the proposal influence you for once, Hugo. The nobility must pay its fair share of taxes.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":49},{"convId":583,"nodeId":37},{"convId":583,"nodeId":53},{"convId":583,"nodeId":43}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You said the exact same thing before.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"50":{"id":50,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm not letting anyone influence me. This is my own decision. And you better respect it as such.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm sorry but no. I have already decided.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"52":{"id":52,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"How convenient.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":58}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":54},{"convId":583,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":40}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm sorry, Hugo, but this time I will be signing this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":132}]},"57":{"id":57,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Romus, I have watched you challenge traditions before. I have even defended you when others whispered that you were reaching too far.\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":134}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":59},{"convId":583,"nodeId":60}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":57}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":76}]},"61":{"id":61,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Tell me, Romus, was there even a conversation to be had about this? Or did the RPP simply write it for you?\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":69},{"convId":583,"nodeId":64},{"convId":583,"nodeId":66},{"convId":583,"nodeId":65},{"convId":583,"nodeId":68},{"convId":583,"nodeId":67}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":76}]},"63":{"id":63,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"My apologies if I caused offense.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":62}]},"64":{"id":64,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You give them too much credit, Hugo. My decisions are my own.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":62}]},"65":{"id":65,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So, are you just opposed to it because of who proposed it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":62}]},"66":{"id":66,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, Hugo... I am just a mouth piece for the reformists, after all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":75}]},"67":{"id":67,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What does that even mean, Hugo? I advise you to be more respectful towards me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":63}]},"68":{"id":68,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So taxation is only legitimate when it burdens the commoners? But when it reaches the nobility, it's suddenly a conspiracy?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":62}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":70},{"convId":583,"nodeId":71}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":72}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"72":{"id":72,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Houses can take their grievances and shove them exactly where they belong.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":73}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"He sighed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":74}]},"74":{"id":74,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":62}]},"75":{"id":75,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I didn't mean to suggest that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":62}]},"76":{"id":76,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'm just saying, Your Majesty, that this is not merely about generating income.\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_InheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":77}]},"77":{"id":77,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"This tax is clearly aimed at the nobility. They will see it as a *message* directed at them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":95},{"convId":583,"nodeId":82},{"convId":583,"nodeId":78},{"convId":583,"nodeId":79},{"convId":583,"nodeId":80},{"convId":583,"nodeId":81}]},"78":{"id":78,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We are going to be making money for the treasury, Hugo. This is a necessary policy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":86}]},"79":{"id":79,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let them rage. Their approval was never a requirement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":85}]},"80":{"id":80,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I cannot let the nobility dictate policy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":88}]},"81":{"id":81,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, Hugo, because taxing the wealthiest estates is truly the gravest injustice in this kingdom.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":89}]},"82":{"id":82,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Do you think this will push them too far?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":83}]},"83":{"id":83,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I do. And I believe you know it too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":91}]},"84":{"id":84,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The numbers on the balance sheet won't matter if the nobility starts treating you as a threat rather than a king.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":91}]},"85":{"id":85,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"No it wasn't...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":87}]},"86":{"id":86,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We cannot trade political stability for revenue, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":84}]},"87":{"id":87,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But their cooperation has kept this kingdom standing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":91}]},"88":{"id":88,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And yet they do dictate much of this kingdom, whether you acknowledge it or not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":90}]},"89":{"id":89,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I understand the sentiment...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":90}]},"90":{"id":90,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But these are the men and women who fund armies, who own land, who control commerce.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":92}]},"91":{"id":91,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"These are the men and women who fund armies, who own land, who control commerce.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":92}]},"92":{"id":92,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And people like that do not sit idly when they believe their future is at risk.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":93},{"convId":583,"nodeId":94},{"convId":583,"nodeId":98},{"convId":583,"nodeId":99}]},"93":{"id":93,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The nobility is not Rizia, Hugo. The people are. If the nobles have forgotten that, then it is time they remembered.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":100}]},"94":{"id":94,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The disparity grows wider by the year. If we continue down this path of preservation over reform, we will not be the ones who decide when change comes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":113}]},"95":{"id":95,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":96},{"convId":583,"nodeId":97}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":103}]},"97":{"id":97,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're looking at this as a political move, Hugo. But I see it as an economic one.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":107}]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So, basically, men like you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":119}]},"100":{"id":100,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The nobility are the pillars of this monarchy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":101}]},"101":{"id":101,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Cracked, perhaps. But pillars still.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":110}]},"102":{"id":102,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Perhaps so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":111}]},"103":{"id":103,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We've been through this, Hugo. I've already weakened them. They can't resist this change.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":102}]},"104":{"id":104,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We can't let the masses on the streets dictate policy-making.\"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":100}]},"105":{"id":105,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I advise you to ignore her opinion on this topic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":100}]},"106":{"id":106,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It seems it is only you and Ms. Werner who sees it that way.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":105}]},"107":{"id":107,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":108},{"convId":583,"nodeId":109}]},"108":{"id":108,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":106}]},"109":{"id":109,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":117}]},"110":{"id":110,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Don't forget they are holding the roof of this palace above our heads.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":122},{"convId":583,"nodeId":121},{"convId":583,"nodeId":120}]},"111":{"id":111,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But it's not only the Royal Houses, Romus. If the nobility unites against you, they can still wield considerable influence over key people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":112},{"convId":583,"nodeId":93},{"convId":583,"nodeId":94},{"convId":583,"nodeId":98}]},"112":{"id":112,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't care what they think. I will keep weakening them until they have no power over me nor the people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":100}]},"113":{"id":113,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":114},{"convId":583,"nodeId":115}]},"114":{"id":114,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":104}]},"115":{"id":115,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":116}]},"116":{"id":116,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We can help the poor without disrupting the whole system.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":100}]},"117":{"id":117,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I believe Ms. Werner also doesn't support this decree, Your Majesty.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":118}]},"118":{"id":118,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I advise you not to ignore her opinion on this topic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":100}]},"119":{"id":119,"speaker":"Narrator","isPlayerChoice":false,"text":"He grunted in disapproval.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":100}]},"120":{"id":120,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You may have a point about the risk. I'll hold off on the decree for now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":143}]},"121":{"id":121,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No, Hugo. It's the other way around. And the nobility must pay their share of taxes just like everyone else.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":138}]},"122":{"id":122,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I think I've heard enough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":137}]},"123":{"id":123,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'll see you later.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":133}]},"124":{"id":124,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But with this... I have to be the one telling you that you would indeed be doing just that.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Economy_EnactInheritanceTax\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_EnactInheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":127}]},"125":{"id":125,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You listened to my advice and held off on the Inheritance Tax.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Economy_EnactInheritanceTax\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_EnactInheritanceTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":126}]},"126":{"id":126,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I want you to do the same with this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":46},{"convId":583,"nodeId":56}]},"127":{"id":127,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Enacting the Inheritance Tax was a big blow to the nobility already. Please don't add another one.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":128},{"convId":583,"nodeId":46}]},"128":{"id":128,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will add another one as I see fit. This is happening, Hugo. So please don't stand against me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":132}]},"129":{"id":129,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're repeating the same words, Hugo. I get your concerns, but you have to trust my judgement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":132}]},"130":{"id":130,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Fine. Maybe you're right about this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":132}]},"131":{"id":131,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No. Nobody is going to get away with not paying their share of taxes anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":132}]},"132":{"id":132,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":137}]},"133":{"id":133,"speaker":"Narrator","isPlayerChoice":false,"text":"He bowed and left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":583,"nodeId":2}]},"134":{"id":134,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"va