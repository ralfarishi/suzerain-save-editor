{"conversationId":6,"title":"Sordland/Turn01/Start_Inauguration","storyPack":"StoryPack_Main","turn":1,"turnLabel":"Turn 1","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":1}]},"1":{"id":1,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":59}]},"2":{"id":2,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"In the distance, the Maroon Palace stood on top of the famous Hill of Pride. I had no way of knowing what future awaited me there.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":4}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"I looked at my family. My son and daughter, Franc and Deana, were next to Monica, my wife. Her eyes were glimmering with pride.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":58}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"As my thoughts slowly faded away, the reality of the situation dawned on me. Orso Hawker, the Chief Justice of the Supreme Court, was waiting for me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":6}]},"6":{"id":6,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“The time for the oath has come.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":7},{"convId":6,"nodeId":8},{"convId":6,"nodeId":9}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"“I am ready.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":10}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"“It has indeed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":10}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"“Let’s start.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":10}]},"10":{"id":10,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“Please repeat after me. I do solemnly swear...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":11}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":true,"text":"“I do solemnly swear...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":12}]},"12":{"id":12,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“And to the best of my ability, preserve, protect and defend...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":13}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"“And to the best of my ability, preserve, protect and defend...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":14}]},"14":{"id":14,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“You may now deliver your inauguration speech, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":15},{"convId":6,"nodeId":16},{"convId":6,"nodeId":17}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":18},{"convId":6,"nodeId":93},{"convId":6,"nodeId":94}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"“It is an honor.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":18},{"convId":6,"nodeId":93},{"convId":6,"nodeId":94}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“Let's begin.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":18},{"convId":6,"nodeId":93},{"convId":6,"nodeId":94}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“Dear citizens of Sordland!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":19}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd looked very eager to listen to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":20},{"convId":6,"nodeId":21},{"convId":6,"nodeId":22}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"“The idea of unity.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":76}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“The current dire situation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":74}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"“Change and hope.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":75}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"“It is time for a united and powerful Sordland once again!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":26}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"“Change now, not in the next decade, or years. Today!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":26}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"“Our capacity as a nation has never been greater!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":26}]},"26":{"id":26,"speaker":"Narrator","isPlayerChoice":false,"text":"Hundreds of thousands cheered. They were shouting my name in unison. I felt the responsibility, the power and the burden all at the same time.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":71},{"convId":6,"nodeId":72},{"convId":6,"nodeId":73}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"“Nice to meet you, Serge.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":29}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“It's a pleasure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":30}]},"29":{"id":29,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“It's an honor.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":65}]},"30":{"id":30,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“The pleasure is all but mine.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":65}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"The motorcade began to move. On the way, Serge proceeded to explain his duties as a driver.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":55}]},"32":{"id":32,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Every time I look at it, I am reminded of my duty to this nation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":35},{"convId":6,"nodeId":33},{"convId":6,"nodeId":34},{"convId":6,"nodeId":66}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"“So do I, Serge. It is the beating heart of the nation after all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":37}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“We all owe a great debt to the men who led the country from here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":38}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"“It is in good hands now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":36}]},"36":{"id":36,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“I am sure of that, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":39}]},"37":{"id":37,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Well said, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":39}]},"38":{"id":38,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Their service will not be forgotten.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":39}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"The car drove past the majestic gates, continued uphill to the entrance and stopped in front of the doors.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":57}]},"40":{"id":40,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Have a great day, Mr. President. A Morgna wes core.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":68}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"“Goodbye.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":43}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"“See you soon.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":43}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"I made my way upstairs through the extravagant corridors of the palace. Marble and engraved wooden finishes decorated the interior.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":77}]},"44":{"id":44,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn01_Start_Inauguration","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":133}]},"45":{"id":45,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Hello, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Codex_Characters_Others_SergeWolkner","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":52}]},"46":{"id":46,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“If you'll allow me to introduce myself, I am Serge, your new driver.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":27},{"convId":6,"nodeId":62},{"convId":6,"nodeId":28}]},"47":{"id":47,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“We will be heading towards the palace.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":31}]},"48":{"id":48,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Isn't it a beauty? The Maroon Palace.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":91}]},"49":{"id":49,"speaker":"Player","isPlayerChoice":true,"text":"“If we stand together, we prevail.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn01_HP_Speech_DireSituation","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn01_HP_Speech_ChangeHope","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn01_HP_Speech_Unity","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":95},{"convId":6,"nodeId":100},{"convId":6,"nodeId":103},{"convId":6,"nodeId":106},{"convId":6,"nodeId":98}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“The issues that plague us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn01_HP_Speech_DireSituation","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn01_HP_Speech_ChangeHope","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn01_HP_Speech_Unity","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":95},{"convId":6,"nodeId":100},{"convId":6,"nodeId":103},{"convId":6,"nodeId":106},{"convId":6,"nodeId":98}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“Our capabilities.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn01_HP_Speech_DireSituation","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn01_HP_Speech_ChangeHope","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn01_HP_Speech_Unity","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":95},{"convId":6,"nodeId":100},{"convId":6,"nodeId":103},{"convId":6,"nodeId":106},{"convId":6,"nodeId":98}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"I still felt euphoric from the aftermath of my speech. Hearing my new title made me smile even more.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":46}]},"53":{"id":53,"speaker":"Narrator","isPlayerChoice":false,"text":"I took a long look at the people of Sordland to burn this moment into my memory.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":64}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"The presidential state car was a jet black Kadilla with flags of Sordland above the front headlights. Next to it, a man was holding the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":90}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"As minutes passed by, I found myself lost in thought again, barely paying attention to what he was saying. He suddenly gestured out the window.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":48}]},"56":{"id":56,"speaker":"Narrator","isPlayerChoice":false,"text":"He was right. Sunlight glinted off the palace's many maroon-coloured domes. It was so bright that I had to look away.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Codex_Locations_Landmarks_MaroonPalace","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":32}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"Serge got out of the car and opened the door for me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":40}]},"58":{"id":58,"speaker":"Narrator","isPlayerChoice":false,"text":"Then I turned towards the key people who made it all possible. Of course, each individual was promised an important position in my government.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":124}]},"59":{"id":59,"speaker":"Narrator","isPlayerChoice":false,"text":"Two weeks had passed since we won the election.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":109}]},"60":{"id":60,"speaker":"Narrator","isPlayerChoice":false,"text":"And now I was about to be sworn in as the 4th President of Sordland.","conditionsRaw":"(Variable[\"BaseGame.Promise_Diplomacy_East\"] == true) and ((Variable[\"BaseGame.Promise_Diplomacy_East\"] == true) == false) and (Variable[\"BaseGame.Promise_Diplomacy_West\"] == true) and ((Variable[\"BaseGame.Promise_Diplomacy_West\"] == true) == false)","variablesRead":[{"var":"BaseGame.Promise_Diplomacy_East","op":"==","value":"true"},{"var":"BaseGame.Promise_Diplomacy_West","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameSupport.Report_Turn01_Laren_LowProduction","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn01_Lachaven_Port","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn01_Arvory_LackofInvestment","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn01_Holsord_LogisticalIssues","op":"=","value":"true"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 1"},{"var":"BaseGame.Capitalist","op":"=","value":"Variable[\"BaseGame.Capitalist\"] + 1"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] + 1"}],"outgoingIds":[{"convId":6,"nodeId":61}]},"61":{"id":61,"speaker":"Narrator","isPlayerChoice":false,"text":"Thousands were watching the inauguration ceremony and cheering my name: Anton Rayne.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":70}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“At ease, Serge.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":63}]},"63":{"id":63,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“As you wish, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":65}]},"64":{"id":64,"speaker":"Narrator","isPlayerChoice":false,"text":"One of the presidential guards came by to notify me that it was time to leave. I made my way to the leading car in the motorcade.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":54}]},"65":{"id":65,"speaker":"Narrator","isPlayerChoice":false,"text":"He respectfully bowed his head before opening the car door and gesturing inside. I entered the car.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":47}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“It's just a building, Serge.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":67}]},"67":{"id":67,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“You are right, Mr. President. I don't know much about architecture, but for me, it's the most beautiful building in all of Holsord.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":39}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"He referred to the famous Sordish phrase from the times of revolution; \"A Morgna wes core, Vectern sis da!\" which meant \"Morning will come, Victory is close.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":41},{"convId":6,"nodeId":42},{"convId":6,"nodeId":69}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"“Vectern sis da!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":43}]},"70":{"id":70,"speaker":"Player_Italic","isPlayerChoice":true,"text":"The die was cast.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":3}]},"71":{"id":71,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Raise fist.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":53}]},"72":{"id":72,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Wave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":53}]},"73":{"id":73,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Enjoy the moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":53}]},"74":{"id":74,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn01_HP_Speech_DireSituation","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":49},{"convId":6,"nodeId":50},{"convId":6,"nodeId":51}]},"75":{"id":75,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn01_HP_Speech_ChangeHope","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":49},{"convId":6,"nodeId":50},{"convId":6,"nodeId":51}]},"76":{"id":76,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn01_HP_Speech_Unity","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":49},{"convId":6,"nodeId":50},{"convId":6,"nodeId":51}]},"77":{"id":77,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":78},{"convId":6,"nodeId":79}]},"78":{"id":78,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Birthplace_Deyr_Poor\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Deyr_Poor","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":80}]},"79":{"id":79,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Deyr_Poor\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Deyr_Poor","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":81}]},"80":{"id":80,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn01_ST_President_Deyr","op":"=","value":"true"}],"outgoingIds":[{"convId":6,"nodeId":132}]},"81":{"id":81,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":6,"nodeId":82},{"convId":6,"nodeId":83}]},"82":{"id":82,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.P