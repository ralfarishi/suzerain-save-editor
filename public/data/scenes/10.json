{"conversationId":10,"title":"Sordland/Turn01/Ball Prep and Travel","storyPack":"StoryPack_Main","turn":1,"turnLabel":"Turn 1","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":12}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":9,"nodeId":50}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Serge opened the door for me. The normally imposing palace was festooned with garish banners that nearly made it look cheerful. A line of shiny luxury sedans stretched around it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":2}]},"4":{"id":4,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“You know... my entire family voted for you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":15},{"convId":10,"nodeId":7},{"convId":10,"nodeId":5}]},"5":{"id":5,"speaker":"Player","isPlayerChoice":true,"text":"“I won't let your family down, Serge.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":10}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"“I'm nervous myself, Franc. But I'd feel a lot more confident with my son by my side.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":92}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you and your family. I am here with all of your support.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":9}]},"8":{"id":8,"speaker":"Monica","isPlayerChoice":false,"text":"“It's all right, baby. They're here to make sure nothing bad happens to your papa -- or his family.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":87}]},"9":{"id":9,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“No reason to thank me, sir. You are the one who sparked a glimmer of hope in us all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":3}]},"10":{"id":10,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“I don't doubt that, sir. You are the one who sparked a glimmer of hope in us all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":3}]},"11":{"id":11,"speaker":"Monica","isPlayerChoice":false,"text":"“Got that over with, Franc? Let's go. The car is waiting for us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] - 2"}],"outgoingIds":[{"convId":10,"nodeId":72}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"Suddenly Deana hugged me from behind, startling me a little. Monica had fixed her hair into an elaborate braid, woven through with ribbons.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":14}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"All those years, she had stayed by my side. Now, we were about to begin the most challenging chapter in our lives yet.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":78}]},"14":{"id":14,"speaker":"Deana","isPlayerChoice":false,"text":"“Papa! Mama told me it’s time to go!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":36},{"convId":10,"nodeId":35},{"convId":10,"nodeId":34}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"“Good to know, Serge.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":3}]},"16":{"id":16,"speaker":"Franc","isPlayerChoice":false,"text":"“Sure, Dad. I'm just dying to go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":106}]},"17":{"id":17,"speaker":"Franc","isPlayerChoice":false,"text":"“If there's even time in between all the boring speeches.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":88}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"She shrugged.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":54}]},"19":{"id":19,"speaker":"Player","isPlayerChoice":true,"text":"“I did, Serge. Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":21}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"“Much appreciated. How are you today?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":23}]},"21":{"id":21,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Always a pleasure to hear that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":3}]},"22":{"id":22,"speaker":"Franc","isPlayerChoice":false,"text":"“I'm here now, aren't I?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] - 1"}],"outgoingIds":[{"convId":10,"nodeId":50},{"convId":10,"nodeId":53}]},"23":{"id":23,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“I am just as good as I can be. But today is your day, sir. I'm glad you are in charge now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":4}]},"24":{"id":24,"speaker":"Franc","isPlayerChoice":false,"text":"“Yes. The sooner we go, the sooner it'll be over, right?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":38}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] - 1"}],"outgoingIds":[{"convId":10,"nodeId":38}]},"26":{"id":26,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Nod.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":3}]},"27":{"id":27,"speaker":"Deana","isPlayerChoice":false,"text":"“Papa, don't be gross!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":57}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Monica_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Monica_Opinion\"] + 2"}],"outgoingIds":[{"convId":10,"nodeId":85}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"“These people are our friends, Deana.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":8}]},"30":{"id":30,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“We are here, sir. Hope you enjoyed the drive.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":19},{"convId":10,"nodeId":20},{"convId":10,"nodeId":26}]},"31":{"id":31,"speaker":"Deana","isPlayerChoice":false,"text":"“I think Franc is still upstairs.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":18}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"Serge rolled down the limousine's soundproof partition.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":30}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"After what seemed like just a few minutes, the convoy slowed to a halt.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":32}]},"34":{"id":34,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Stroke her hair.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":102},{"convId":10,"nodeId":103}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"“Tell your mother I will be ready very soon.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":56}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"“Hello, darling, I am ready. Where is your brother?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":31}]},"37":{"id":37,"speaker":"Franc","isPlayerChoice":false,"text":"“This thing itches.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":42}]},"38":{"id":38,"speaker":"Deana","isPlayerChoice":false,"text":"“Papa, are these people going to be around us from now on?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] - 1"},{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] + 1"}],"outgoingIds":[{"convId":10,"nodeId":79}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"“Let's just enjoy the night.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":33}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"“Monica, Franc, enough fussing around! Let's get a move on!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":107}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"“This means a great deal to me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":33}]},"42":{"id":42,"speaker":"Narrator","isPlayerChoice":false,"text":"Franc tugged at the collar of his new tuxedo. He seemed ill at ease.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":63},{"convId":10,"nodeId":68},{"convId":10,"nodeId":82}]},"43":{"id":43,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Stay silent.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":33}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“Darling! Franc! It’s time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":73}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"“We'll see, darling.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":33}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"Franc looked at the floor sullenly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":25}]},"47":{"id":47,"speaker":"Monica","isPlayerChoice":false,"text":"\"I know you will, honey.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":45},{"convId":10,"nodeId":41},{"convId":10,"nodeId":39},{"convId":10,"nodeId":43}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"“Now, where's my First Lady?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":108}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"Franc rolled his eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":47}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“Good. Let's go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":38}]},"51":{"id":51,"speaker":"Deana","isPlayerChoice":false,"text":"“I'm going to help Papa fix everything!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":49}]},"52":{"id":52,"speaker":"Monica","isPlayerChoice":false,"text":"\"Just remember, no matter what happens, the children and I will always be here for you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Monica_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Monica_Opinion\"] + 1"}],"outgoingIds":[{"convId":10,"nodeId":51}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"“I'm not joking, son.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":46}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"It was almost time to leave. The big ball was starting in less than an hour.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":48},{"convId":10,"nodeId":44},{"convId":10,"nodeId":40}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Monica_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Monica_Opinion\"] + 1"}],"outgoingIds":[{"convId":10,"nodeId":52}]},"56":{"id":56,"speaker":"Deana","isPlayerChoice":false,"text":"“Okay, Papa. I can't wait to see the Palace!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":54}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"She giggled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":54}]},"58":{"id":58,"speaker":"Monica","isPlayerChoice":false,"text":"“I know you have a lot on your mind. But you deserve to relax tonight.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":52}]},"59":{"id":59,"speaker":"Monica","isPlayerChoice":false,"text":"“Yes, we have. And there's still so much that we'll accomplish, side by side.'","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":55}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"\"With all that's been happening, I'm wondering if I made the right choice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":58}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"“I was thinking that we've come a long way together, haven't we?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":59}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing. Nice car, isn't it?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":58}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“Are you good to go, Franc?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":24}]},"64":{"id":64,"speaker":"Franc","isPlayerChoice":false,"text":"“I'm here! I'm here!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Monica_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Monica_Opinion\"] - 1"},{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] - 1"}],"outgoingIds":[{"convId":10,"nodeId":42}]},"65":{"id":65,"speaker":"Franc","isPlayerChoice":false,"text":"“A party for squares. Who will I even talk to?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":84}]},"66":{"id":66,"speaker":"Monica","isPlayerChoice":false,"text":"“Anton, what are you thinking about?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":62},{"convId":10,"nodeId":60},{"convId":10,"nodeId":61}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"Halfway to the car, Franc stopped abruptly and turned towards me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":97}]},"68":{"id":68,"speaker":"Player","isPlayerChoice":true,"text":"“I'm glad to have you with us for this big night.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":16}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"“Monica, my love, you look as gorgeous as the day we married.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":76}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"The motorcade started moving towards the palace. I gazed out the window, deep in thought.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":66}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"She was wearing a simple yet elegant beige sheath dress and short heels. Her hair had been neatly pinned into a chignon, showing off the pearl earrings I had given her for our 15th anniversary.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":13}]},"72":{"id":72,"speaker":"Narrator","isPlayerChoice":false,"text":"The Presidential Guard showed us the way as red and blue lights flashed around us. Serge, my driver, ushered us into our armored limousine.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] + 2"}],"outgoingIds":[{"convId":10,"nodeId":70}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"Monica came down the stairs.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Monica_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Monica_Opinion\"] - 1"},{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] - 1"},{"var":"BaseGame.Relations_Monica_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Monica_Opinion\"] + 1"}],"outgoingIds":[{"convId":10,"nodeId":71}]},"74":{"id":74,"speaker":"Player","isPlayerChoice":true,"text":"“How do I look?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":95}]},"75":{"id":75,"speaker":"Player","isPlayerChoice":true,"text":"“Unfortunately, yes. They can't leave our side until my term ends. You'll get used to it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":8}]},"76":{"id":76,"speaker":"Monica","isPlayerChoice":false,"text":"“Now, there's that charm that got you elected.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":28}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"“Yes. Sordland's most important family needs extra protection!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":8}]},"78":{"id":78,"speaker":"Monica","isPlayerChoice":false,"text":"“How do you do, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":99},{"convId":10,"nodeId":100},{"convId":10,"nodeId":101}]},"79":{"id":79,"speaker":"Narrator","isPlayerChoice":false,"text":"She pointed at the Presidential Guards at the door of the house.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":77},{"convId":10,"nodeId":75},{"convId":10,"nodeId":29}]},"80":{"id":80,"speaker":"Narrator","isPlayerChoice":false,"text":"Franc fell silent for a short while.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":81}]},"81":{"id":81,"speaker":"Franc","isPlayerChoice":false,"text":"“Fine. I'm sorry...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":90}]},"82":{"id":82,"speaker":"Player","isPlayerChoice":true,"text":"“Don't make me wait again.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":105}]},"83":{"id":83,"speaker":"Player","isPlayerChoice":true,"text":"“You'll love it, son. I'm sure there'll be plenty of pretty girls to dance with...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":17}]},"84":{"id":84,"speaker":"Monica","isPlayerChoice":false,"text":"“Come on, Franc, we've been through this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":86}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"Franc trudged down the stairs.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Monica_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Monica_Opinion\"] + 2"}],"outgoingIds":[{"convId":10,"nodeId":37}]},"86":{"id":86,"speaker":"Franc","isPlayerChoice":false,"text":"“Yeah, I know. I'm sorry. Just wanted to try my luck.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":11}]},"87":{"id":87,"speaker":"Narrator","isPlayerChoice":false,"text":"Monica held Deana's hand. Together, flanked by the guards, we walked out the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":67}]},"88":{"id":88,"speaker":"Franc","isPlayerChoice":false,"text":"“But I guess I have no choice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":11}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"“Don't make me angry, Franc.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":80}]},"90":{"id":90,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] - 2"}],"outgoingIds":[{"convId":10,"nodeId":11}]},"91":{"id":91,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Franc_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Franc_Opinion\"] + 2"}],"outgoingIds":[{"convId":10,"nodeId":72}]},"92":{"id":92,"speaker":"Narrator","isPlayerChoice":false,"text":"Franc smiled reluctantly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":93}]},"93":{"id":93,"speaker":"Franc","isPlayerChoice":false,"text":"“Well when you put it like that...sure. Let's go.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":91}]},"94":{"id":94,"speaker":"Narrator","isPlayerChoice":false,"text":"Franc rushed down the stairs.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":109}]},"95":{"id":95,"speaker":"Monica","isPlayerChoice":false,"text":"\"Like the 4th President of Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":85}]},"96":{"id":96,"speaker":"Player","isPlayerChoice":true,"text":"“Now where the hell is Franc? FRANC!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":94}]},"97":{"id":97,"speaker":"Franc","isPlayerChoice":false,"text":"“Dad, do I really have to go? Couldn't I stay home instead?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":6},{"convId":10,"nodeId":98},{"convId":10,"nodeId":83},{"convId":10,"nodeId":89}]},"98":{"id":98,"speaker":"Player","isPlayerChoice":true,"text":"“It's a party thrown for me! Don't you want to support your father?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":65}]},"99":{"id":99,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Kiss her hand.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":96},{"convId":10,"nodeId":69},{"convId":10,"nodeId":74}]},"100":{"id":100,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Embrace her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":96},{"convId":10,"nodeId":69},{"convId":10,"nodeId":74}]},"101":{"id":101,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Just stand there and look at her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":96},{"convId":10,"nodeId":69},{"convId":10,"nodeId":74}]},"102":{"id":102,"speaker":"Player","isPlayerChoice":true,"text":"\"Someday I'll have to pry the boys away from you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":27}]},"103":{"id":103,"speaker":"Player","isPlayerChoice":true,"text":"\"You could be president yourself someday, you know that?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":104}]},"104":{"id":104,"speaker":"Deana","isPlayerChoice":false,"text":"“Only when I'm old like you!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":10,"nodeId":57}]},"105":{"id":105,"speaker":"Paska