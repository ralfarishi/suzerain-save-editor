{"conversationId":378,"title":"Rizia/Turn 7/Morella Discussion Friendly","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":14}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":377,"nodeId":575}]},"3":{"id":3,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Tell me. What has Saltana done to deserve my goodwill?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":28},{"convId":378,"nodeId":27},{"convId":378,"nodeId":4},{"convId":378,"nodeId":6}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This isn't about 'goodwill'. It's about a murderous incursion of Derdian insurgents.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":9}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You are a man of God. Must your goodwill be earned, or can it not be freely given?\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":12}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":7},{"convId":378,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":10}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":5}]},"9":{"id":9,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Insurgents? Was Wruhec an 'insurgent' when he spread his gospel across Southern Merkopa?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":66}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Remember the words of St. Wruhec. 'The light of compassion can illuminate even those who walk in the darkest of shadows.'\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":11}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":378,"nodeId":65}]},"12":{"id":12,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"As St. Wruhec has said, 'Generosity is the heart's river, but let its waters flow with discernment'.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":13}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"He sat back on his cushion for a moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":60}]},"14":{"id":14,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Ha. That witch has you doing her bidding?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":3}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":378,"nodeId":32}]},"16":{"id":16,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We will talk. That is all I can promise you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":71}]},"17":{"id":17,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I will meet with you and Saltana. That is all I can promise.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":71}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Silence, both of you. I did not come here to trade aphorisms.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":34}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":20},{"convId":378,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true  or  Variable[\"RiziaDLC.Prologue_Religious\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Religious","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":29}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true  or  Variable[\"RiziaDLC.Prologue_Religious\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Religious","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":30}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":378,"nodeId":71}]},"23":{"id":23,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Or a way to make sure you still have resources for years to come.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":24}]},"24":{"id":24,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"It's an investment, Your Majesty. Into the future of this region.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":43},{"convId":378,"nodeId":98}]},"25":{"id":25,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"As Wruhec wrote, 'Reach not for the stars above your head...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":26}]},"26":{"id":26,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"...before tending to the soil beneath your feet.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":88}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Think about it from a financial perspective. Peace between Derdia and Morella could be lucrative for all of us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":46}]},"28":{"id":28,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What will happen when she allies with the CSP? Your insurgents will get blown to smithereens.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":45}]},"29":{"id":29,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"'Yet even the most imposing of mountains may still be shaped by the gentle rains of understanding'.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true  or  Variable[\"RiziaDLC.Prologue_Religious\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Religious","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":31}]},"30":{"id":30,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't care what he wrote. The law is the law.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true  or  Variable[\"RiziaDLC.Prologue_Religious\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Religious","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":33}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"Azmal nodded approvingly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":15}]},"32":{"id":32,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We will talk to Saltana. I will respect her borders if she respects my pilgrims' rights.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":378,"nodeId":71}]},"33":{"id":33,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We in Derdia only recognize one law. The law of the divine.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":16}]},"34":{"id":34,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"'In the realm of discourse, succinct truths are the sharpest blades of wisdom'.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":17}]},"35":{"id":35,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I agree, Supreme Wiseman. We will get Saltana to recognize your people's right to their ancestral land.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":36}]},"36":{"id":36,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Halaita. If it is said, so it will be.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":22}]},"37":{"id":37,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"In that case...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":47}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":39},{"convId":378,"nodeId":40}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"41":{"id":41,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We are fighting a war. Building a pipeline would be a waste of much-needed resources.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":23}]},"42":{"id":42,"speaker":"Narrator","isPlayerChoice":false,"text":"A faint smile appeared on Sal's lips.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":25}]},"43":{"id":43,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"A pipeline is out of the question. I'm sorry.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":37}]},"44":{"id":44,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"It's a deal, Supreme Wiseman. We will extend the pipeline if you leave Morella alone.\" [-2 Energy For +4 Budget Per Turn, -2 Budget Per Turn For Pipeline]","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] > 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":42}]},"45":{"id":45,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Are you aware of my country's weapons capabilities? We are more than prepared to fight for our right to holy pilgrimage.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":66}]},"46":{"id":46,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Riches are useless if we are unable to express our gratitude to the Lord who provided them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":66}]},"47":{"id":47,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Tell Ms. Saltana I will talk to her. But only if the King of Rizia is present to act as an intermediary.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":48},{"convId":378,"nodeId":49},{"convId":378,"nodeId":50},{"convId":378,"nodeId":56}]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That sounds fair enough. I'm happy to help.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":68}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I hope you are ready to compromise. Derdians are not automatically entitled to enter Morella, after all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":67}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":51},{"convId":378,"nodeId":52}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":53}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"My country's fighting a war, Supreme Wiseman. I don't have time to mediate my neighbors' squabbles.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":54}]},"54":{"id":54,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You approached me, not the other way around. And this as far as I will go.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":69}]},"55":{"id":55,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Halaita. If it is said, so it will be.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":71}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":57},{"convId":378,"nodeId":58}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":59}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"59":{"id":59,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"With the Lord on our side, we will convince her to aid your people in their holy travels.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":55}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":61},{"convId":378,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":63}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":64}]},"63":{"id":63,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You spoke in our favor at the Alliance of Nations. I know you are not entirely on Morella's side.\"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":72}]},"64":{"id":64,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I was wary of you after your words at the Alliance of Nations. But your actions on behalf of Golcondists have spoken volumes.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":72}]},"65":{"id":65,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Yes, that is so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":378,"nodeId":13}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"He sat back on his cushion, looking defiant.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":60}]},"67":{"id":67,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We were once one kingdom. St. Wruhec knew nothing of these modern-day borders.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":69}]},"68":{"id":68,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Make sure she is aware that I will not simply back down. The more she tries to block our holy pilgrimage, the more fiercely we will fight.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":69}]},"69":{"id":69,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Wruhec himself would not have approved of your attitude, Supreme Wiseman. 'The most steadfast heart must be willing to sway, for in yielding, it finds strength.'\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":70}]},"70":{"id":70,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Did he not also write, 'As the mountain stand still against the tempest, so too must one hold firm to their convictions'?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":19},{"convId":378,"nodeId":18},{"convId":378,"nodeId":35}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn07_Diplomacy_Derdia_EnableSaltanaMeeting","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_MorellaDispute","op":"=","value":"true"}],"outgoingIds":[{"convId":378,"nodeId":2}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":73},{"convId":378,"nodeId":74}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":47}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":75}]},"75":{"id":75,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"There is one thing we Derdians need more than access to sacred sites. Energy.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":76}]},"76":{"id":76,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I've heard about your partnership with Morella. Extend the pipeline to Derdia, and I will order our pilgrims away from Morella's borders.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":102},{"convId":378,"nodeId":83},{"convId":378,"nodeId":77},{"convId":378,"nodeId":38}]},"77":{"id":77,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That's your only request? Nothing would make me happier than to pursue an energy partnership with Derdia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":78}]},"78":{"id":78,"speaker":"Narrator","isPlayerChoice":false,"text":"He smiled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":79}]},"79":{"id":79,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"When two like souls converge, the Divine smiles upon them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":98}]},"80":{"id":80,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Respectfully, Supreme Wiseman, we barely have enough energy to sell to Morella, let alone Derdia.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_EnergyModifiersTotal\"] < 1","variablesRead":[{"var":"RiziaDLC.Resources_EnergyModifiersTotal","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":81}]},"81":{"id":81,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"So Rizia's legendary gas wealth is a myth.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":82}]},"82":{"id":82,"speaker":"Narrator","isPlayerChoice":false,"text":"He looked disappointed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":37}]},"83":{"id":83,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I can't do that. Too much could go wrong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":84}]},"84":{"id":84,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Do you not trust us, Your Majesty? The word of a Derdian is bond.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":85}]},"85":{"id":85,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Or is it your Morellan friends you are worried about?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":378,"nodeId":43},{"convId":378,"nodeId":98}]},"86":{"id":86,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He wrote a lot, didn't he?\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"4"}],"outgoingIds":[{"convId":378,"nodeId":95}]},"87":{"id":87,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That was easier than I expected.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"4"}],"outgoingIds":[{"convId":378,"nodeId":92}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_Trade