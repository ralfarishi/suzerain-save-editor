layer","isPlayerChoice":true,"text":"“You have no power.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":73}]},"62":{"id":62,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":63}]},"63":{"id":63,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“See, Marcel?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":64}]},"64":{"id":64,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“This is called graciousness and mercy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":65}]},"65":{"id":65,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Two traits that you have never had.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":66}]},"66":{"id":66,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Your words don't work on me, Tusk.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":67}]},"67":{"id":67,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Mr. President. You are being played.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":68}]},"68":{"id":68,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Mark my words. One day he will turn on you as well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":69}]},"69":{"id":69,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I am not you, Marcel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":78}]},"70":{"id":70,"speaker":"Player","isPlayerChoice":true,"text":"“I have no such illusions. But it is worth it to get rid of you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":71}]},"71":{"id":71,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Wishful thinking.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":79}]},"72":{"id":72,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Right back at you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":79}]},"73":{"id":73,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Do you think taking over my company will end me?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":79}]},"74":{"id":74,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I don't have a pen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":52}]},"75":{"id":75,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You can forget about getting re-elected, Mr. *President*.”","conditionsRaw":"((Variable[\"BaseGame.HeartOfSordland_Nationalization\"] <= 1) == false) and ((Variable[\"BaseGame.Accepted_MediaDeal\"] == true) == false)","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":"<=","value":"1"},{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":81}]},"76":{"id":76,"speaker":"Player","isPlayerChoice":true,"text":"“Don't forget. This could've gone much worse for you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":96}]},"77":{"id":77,"speaker":"Narrator","isPlayerChoice":false,"text":"He started checking his pockets.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":74}]},"78":{"id":78,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Mr. President. Walter. I'll see you both in hell.\"","condi