{"conversationId":136,"title":"Sordland/Turn07/BERGIA STEEL NOT NATIONALISED AT ALL","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":34}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":132,"nodeId":309}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Cuffed by the two guards, Marcel Koronti left the room. Walter Tusk followed shortly after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":112}]},"4":{"id":4,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I am not you, Marcel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":3}]},"5":{"id":5,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Mr. President! You are being played by this man.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":6}]},"6":{"id":6,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Mark my words. One day he will turn on you as well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":4}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"“No. There is no need.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":62}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"“You are right. Guards! Some time in Antel Rock Prison will teach him.”","conditionsRaw":"Variable[\"B