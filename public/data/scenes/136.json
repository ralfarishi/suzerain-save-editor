iablesModified":[],"outgoingIds":[{"convId":136,"nodeId":11}]},"16":{"id":16,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Dictator!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":17}]},"17":{"id":17,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Get your hands off of me!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":19}]},"18":{"id":18,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Do you know who I am?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":32}]},"19":{"id":19,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Serves you right. Good riddance, Marcel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":20}]},"20":{"id":20,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I will make sure to pay a visit sometime.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":24}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":22},{"convId":136,"nodeId":23}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":8},{"convId":136,"nodeId":132}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":25},{"convId":136,"nodeId":132}]},"24":{"id":24,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Walter!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":15}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"“Mr. Koronti. I've showed you what I'm capable of. You will not threaten me... or else.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":27}]},"26":{"id":26,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“An animal is most dangerous when he is cornered. A man like Marcel would prove...difficult in the future for sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":7},{"convId":136,"nodeId":21}]},"27":{"id":27,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Or else what?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":18}]},"28":{"id":28,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned back towards me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":136}]},"29":{"id":29,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Fuck off, Tusk.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":28}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel packed his belongings and furiously exited the room, closing the door loudly. Walter followed shortly after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":113}]},"31":{"id":31,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I'll tell you who you are, Marcel. You're a petulant child who's not fit to shit in his father's toilet.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":29}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter chuckled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":31}]},"33":{"id":33,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“There you go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":157}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter was watching Marcel with a vile smirk on his face.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":36}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"“No need for escalation. He doesn't have any power anymore.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":97}]},"36":{"id":36,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Did you think you could go behind my back, boy?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":38}]},"37":{"id":37,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“No. I am not happy at all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":101}]},"38":{"id":38,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Come on. I wouldn't be in my position if I didn't know how to play my cards right.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":40}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel reluctantly signed the papers after letting out a deep sigh.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":41}]},"40":{"id":40,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You still have a lot to learn.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":42}]},"41":{"id":41,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“My pen, please.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":43}]},"42":{"id":42,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Now that Daddy isn't around to hold your hand.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":44}]},"43":{"id":43,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Take your stupid pen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":50}]},"44":{"id":44,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Shut up, Walter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":45}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":46},{"convId":136,"nodeId":47}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.HeartOfSordland_Nationalization\"] == 2","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":"==","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":49}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.HeartOfSordland_Nationalization\"] == 2) == false","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":"==","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":79}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"“No hard feelings, Marcel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":111}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me.","conditionsRaw":"Variable[\"BaseGame.HeartOfSordland_Nationalization\"] == 2","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":"==","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":51}]},"50":{"id":50,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me, eyes blazing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":114}]},"51":{"id":51,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“If you think you will end up unscathed after this, think again.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":60},{"convId":136,"nodeId":61},{"convId":136,"nodeId":70}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter immediately produced a pen from his pocket and put it in front of Marcel with a toothy grin.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":56}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":54},{"convId":136,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.HeartOfSordland_Nationalization\"] <= 1","va