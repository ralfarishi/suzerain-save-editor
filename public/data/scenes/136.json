ablesModified":[],"outgoingIds":[{"convId":136,"nodeId":87},{"convId":136,"nodeId":88}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":107}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true) == false","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":110}]},"89":{"id":89,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I've been keeping a tight lid on secrets that could end you. Wouldn't it be a shame if they got out?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":110}]},"90":{"id":90,"speaker":"Player","isPlayerChoice":true,"text":"“Stalling won't change the outcome.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":58}]},"91":{"id":91,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“He needs to be punished swiftly. Surely you can't let him speak to you like that!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":93}]},"92":{"id":92,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“You will need to sign here, here and here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":98}]},"93":{"id":93,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You son of a--”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":35},{"convId":136,"nodeId":21}]},"94":{"id":94,"speaker":"Narrator","isPlayerChoice":false,"text":"He pointed to various sections on various pages of the document.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":92}]},"95":{"id":95,"speaker":"Player","isPlayerChoice":true,"text":"“Is there a problem?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":58}]},"96":{"id":96,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“And for you as well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":99}]},"97":{"id":97,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I wouldn't underestimate what he can do, President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":26}]},"98":{"id":98,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I won't sign anything without reading it first.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":106}]},"99":{"id":99,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I will take my leave then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":108}]},"100":{"id":100,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Go cry about it in one of your silly newspapers. Oh, wait -- they aren't yours anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":102}]},"101":{"id":101,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“But as you still left me with a significant portion of my company, let's say that I am ready to put this unfortunate decision behind us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":103},{"convId":136,"nodeId":48},{"convId":136,"nodeId":76}]},"102":{"id":102,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel packed his belongings and left the meeting room. Walter followed shortly after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":2}]},"103":{"id":103,"speaker":"Player","isPlayerChoice":true,"text":"“Thanks for being cooperative.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":99}]},"104":{"id":104,"speaker":"Narrator","isPlayerChoice":false,"text":"When he finished, he turned back to the first page and went over the whole stack again.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":109}]},"105":{"id":105,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“This is ridiculous! Know your place, little boy!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":57}]},"106":{"id":106,"speaker":"Narrator","isPlayerChoice":false,"text":"He started going through the papers.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":104}]},"107":{"id":107,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Don't you realize that I know everything about you?”","conditionsRaw":"Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":89}]},"108":{"id":108,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“And Walter, next time I see you, you'll be begging me for forgiveness.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":85}]},"109":{"id":109,"speaker":"Narrator","isPlayerChoice":false,"text":"And again...","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":80}]},"110":{"id":110,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Did you just threaten the President of Sordland?”","conditionsRaw":"(Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true) == false","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"=","value":"false"}],"outgoingIds":[{"convId":136,"nodeId":105}]},"111":{"id":111,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“In our line of business, there is no place for feelings.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":99}]},"112":{"id":112,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn07_Detained_MarcelKoronti","op":"=","value":"true"},{"var":"BaseGame.Relations_Marcel_Enemy","op":"=","value":"true"}],"outgoingIds":[{"convId":136,"nodeId":152}]},"113":{"id":113,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn07_Sued_MarcelKoronti","op":"=","value":"true"}],"outgoingIds":[{"convId":136,"nodeId":2}]},"114":{"id":114,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":115},{"convId":136,"nodeId":116}]},"115":{"id":115,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Accepted_MediaDeal\"] == true","variablesRead":[{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":117}]},"116":{"id":116,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Accepted_MediaDeal\"] == true) == false","variablesRead":[{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":53}]},"117":{"id":117,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"We had a deal, Rayne.\"","conditionsRaw":"Variable[\"BaseGame.Accepted_MediaDeal\"] == true","variablesRead":[{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":118}]},"118":{"id":118,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"Do you know how hard I've worked for you? How much sleep I've lost cleaning up your messes?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":119}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":120},{"convId":136,"nodeId":121}]},"120":{"id":120,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.HeartOfSordland_Nationalization\"] >= 2","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":122},{"convId":136,"nodeId":124}]},"121":{"id":121,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.HeartOfSordland_Nationalization\"] >= 2) == false","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":123},{"convId":136,"nodeId":129}]},"122":{"id":122,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes, that's why I only took a minority share.\"","conditionsRaw":"Variable[\"BaseGame.HeartOfSordland_Nationalization\"] >= 2","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":125}]},"123":{"id":123,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't need your deal now that I have your company.\"","conditionsRaw":"(Variable[\"BaseGame.HeartOfSordland_Nationalization\"] >= 2) == false","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":130}]},"124":{"id":124,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't need your deal anymore. The papers love me.\"","conditionsRaw":"Variable[\"BaseGame.HeartOfSordland_Nationalization\"] >= 2","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":128}]},"125":{"id":125,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"So you stabbed me in the back but failed to put the knife in all the way. Big mistake.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":126}]},"126":{"id":126,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"The deal is over. And so is your presidency.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":127}]},"127":{"id":127,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"=","value":"false"}],"outgoingIds":[{"convId":136,"nodeId":110}]},"128":{"id":128,"speaker":"Marcel Koronti","isPlayerChoice":true,"text":"\"Do they, now? We'll see about that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":126}]},"129":{"id":129,"speaker":"Player","isPlayerChoice":true,"text":"\"And I appreciate that. But not as much as I appreciate your shares.\"","conditionsRaw":"(Variable[\"BaseGame.HeartOfSordland_Nationalization\"] >= 2) == false","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":130}]},"130":{"id":130,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel's face darkened.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":131}]},"131":{"id":131,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"A traitor and an idiot. Impressive.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":107}]},"132":{"id":132,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":133},{"convId":136,"nodeId":134}]},"133":{"id":133,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn05_SnO_Investigate_Oligarchs\"] == true","variablesRead":[{"var":"BaseGame.Turn05_SnO_Investigate_Oligarchs","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":135}]},"134":{"id":134,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn05_SnO_Investigate_Oligarchs\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn05_SnO_Investigate_Oligarchs","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"135":{"id":135,"speaker":"Player","isPlayerChoice":true,"text":"“I'm a few steps ahead of you, Walter. I've launched an investigation that will uncover all of Marcel's secrets.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) and ((Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) == false) and (Variable[\"BaseGame.Turn05_SnO_Investigate_Oligarchs\"] == true)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_Investigate_Oligarchs","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":137},{"convId":136,"nodeId":139}]},"136":{"id":136,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"I'll see you both in hell.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":30}]},"137":{"id":137,"speaker":"Player","isPlayerChoice":true,"text":"\"And yours, in case you get on my bad side.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":143}]},"138":{"id":138,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"\"Don't forget I know a thing or two about you as well.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Walter_Promise_BailBusinessFulfilled\"] == true  or  Variable[\"BaseGame.Relations_Walter_Promise_CompanyFulfilled\"] == true","variablesRead":[{"var":"BaseGame.Relations_Walter_Promise_BailBusinessFulfilled","op":"==","value":"true"},{"var":"BaseGame.Relations_Walter_Promise_CompanyFulfilled","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":140}]},"139":{"id":139,"speaker":"Player","isPlayerChoice":true,"text":"\"You can't hide anything from me, Koronti.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":146}]},"140":{"id":140,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":141},{"convId":136,"nodeId":142}]},"141":{"id":141,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Accepted_MediaDeal\"] == true","variablesRead":[{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":151}]},"142":{"id":142,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Accepted_MediaDeal\"] == true) == false","variablesRead":[{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":145}]},"143":{"id":143,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter looked at me disbelievingly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":148}]},"144":{"id":144,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Don't underestimate me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":136}]},"145":{"id":145,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"Listen, you coward. Even if I did have something to hide, I've got an army of lawyers that can disprove it all.\"","conditionsRaw":"((Variable[\"BaseGame.Accepted_MediaDeal\"] == true) == false) and ((Variable[\"BaseGame.Relations_Walter_Promise_BailBusinessFulfilled\"] == true  or  Variable[\"BaseGame.Relations_Walter_Promise_CompanyFulfilled\"] == true) == false)","variablesRead":[{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"},{"var":"BaseGame.Relations_Walter_Promise_BailBusinessFulfilled","op":"==","value":"true"},{"var":"BaseGame.Relations_Walter_Promise_CompanyFulfilled","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":147}]},"146":{"id":146,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel snorted.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":145}]},"147":{"id":147,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I wonder if they will stand by you when you don't have enough money to pay them.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":144}]},"148":{"id":148,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":136,"nodeId":149},{"convId":136,"nodeId":150}]},"149":{"id":149,"speaker":"Pas