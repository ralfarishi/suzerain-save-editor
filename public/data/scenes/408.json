{"conversationId":408,"title":"Rizia/Turn 8/NOTES_CONSTITION FINALIZED","storyPack":"StoryPack_Rizia","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":4},{"convId":408,"nodeId":5}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":31}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":60}]},"6":{"id":6,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"How about the legislative? You mentioned establishing an upper house. How would that be structured?\"","conditionsRaw":"((Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true) == false) and ((Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true) == false)","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":18},{"convId":408,"nodeId":13},{"convId":408,"nodeId":14}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've changed my mind. We will establish a House of Lords comprised of the nobility as an upper house to get the nobility's backing.\"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true  and  Variable[\"RiziaDLC.Reform_Diplomatic\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":10}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes. House of Delegates will be the sole legislative body in the country.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":20}]},"9":{"id":9,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"And how would the upper house be structured?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":13},{"convId":408,"nodeId":17}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Legislative_HouseOfLords","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_HouseOfLords","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":19}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Legislative_RegionalSenate","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_RegionSenate","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":19}]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've changed my mind. We may need to establish an upper house that would provide checks and balances on the legislative branch.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true  and  Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":9}]},"13":{"id":13,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We will establish a House of Lords comprised of the nobility as an upper house to get the nobility's backing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":10}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":15},{"convId":408,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":17}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We will establish a Senate comprised of elected senators from each region as an upper house.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":11}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Maybe it's not the best idea. We will keep the House of Delegates as the sole legislative body.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":20}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"He kept taking notes as I spoke.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Legislative_HouseOfLords","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_HouseOfLords","op":"=","value":"true"},{"var":"RiziaDLC.Reform_Legislative_RegionalSenate","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_RegionSenate","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":21},{"convId":408,"nodeId":22},{"convId":408,"nodeId":51}]},"20":{"id":20,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"I understand.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_UpperHouse_Advisory","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseAdvisorary","op":"=","value":"true"},{"var":"RiziaDLC.Reform_UpperHouse_Limited","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseLimited","op":"=","value":"true"},{"var":"RiziaDLC.Reform_UpperHouse_Equal","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseEqual","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":24}]},"21":{"id":21,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"They won't have the authority to initiate any legislation. They will only have limited legislative powers, such as voting on constitutional amendments and advising the lower house.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":23}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Both houses will vote on legislation and approval of both will be required for enacting new laws. We will exercise equal bicameralism.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":54}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_UpperHouse_Advisory","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseAdvisorary","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":20}]},"24":{"id":24,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"And the judiciary?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":58},{"convId":408,"nodeId":55},{"convId":408,"nodeId":25},{"convId":408,"nodeId":53},{"convId":408,"nodeId":61}]},"25":{"id":25,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We will grant them life tenure, which would free them from the pressure of protecting powerful interests or deciding according to momentary populism.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":56}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Judiciary_Immunity","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_JudiciaryImmunity","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":27}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"He took notes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Judiciary_Immunity","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_JudiciaryImmunity","op":"=","value":"true"},{"var":"RiziaDLC.Reform_Judiciary_NoConstitutionalCourt","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_NoConstitutionalCourt","op":"=","value":"true"},{"var":"RiziaDLC.Reform_Judiciary_LifeTenure","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_LifeTenure","op":"=","value":"true"},{"var":"RiziaDLC.Reform_Judiciary_JudicialReview","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_JudicialReview","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":57}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":29},{"convId":408,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Diplomatic\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"31":{"id":31,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"I'll get to work on the draft. Mr. Sotelato will take care of rallying the movement.\"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":28}]},"32":{"id":32,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"We are going to work on centralizing the system and abolish the regional structure, yes?\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Reform_Intention_Regions_Centralize\"] ==  true","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Regions_Centralize","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":37},{"convId":408,"nodeId":62}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":34},{"convId":408,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Reform_Intention_Regions_Centralize\"] ==  true","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Regions_Centralize","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":32}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Reform_Intention_Regions_Centralize\"] ==  true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Regions_Centralize","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":36}]},"36":{"id":36,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"We are going to keep the federal structure and respect the autonomy of the regions, yes?\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Reform_Intention_Regions_Centralize\"] ==  true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Regions_Centralize","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":39},{"convId":408,"nodeId":40}]},"37":{"id":37,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes. We will centralize the system completely.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":41}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've changed my mind after our discussion. Centralization will cost us much needed support. We'll respect the regions to get their vote.\"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Diplomatic\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":42}]},"39":{"id":39,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes. We will respect the current structure.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":42}]},"40":{"id":40,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've changed my mind after our discussion. Rizia is too small of a country to require a complicated regional system. I don't want to transition into a weak and inefficient democracy. We'll centralize the structure.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":41}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_CentralizeRegions","op":"=","value":"true"},{"var":"RiziaDLC.Situation_Order_AutonomousProvincialPolicing_Some","op":"=","value":"false"},{"var":"RiziaDLC.Situation_Order_AutonomousProvincialPolicing_None","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":42}]},"42":{"id":42,"speaker":"Narrator","isPlayerChoice":false,"text":"He took notes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_CentralizeRegions","op":"=","value":"true"},{"var":"RiziaDLC.Situation_Order_AutonomousProvincialPolicing_Some","op":"=","value":"false"},{"var":"RiziaDLC.Situation_Order_AutonomousProvincialPolicing_None","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":74}]},"43":{"id":43,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"How about the House of Delegates? Are we keeping the legislative unicameral as mentioned before?\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true) and ((Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true) == false)","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":8},{"convId":408,"nodeId":47}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":45},{"convId":408,"nodeId":46}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":43}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":6}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":48},{"convId":408,"nodeId":49}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true  and  Variable[\"RiziaDLC.Reform_Diplomatic\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":7}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Regions_Centralized\"] == true  and  Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Regions_Centralized","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":12}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Judiciary_NoConstitutionalCourt","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_NoConstitutionalCourt","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":27}]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"They will have limited authority over legislation with the power to vote, and reject unconstitutional proposals and return them back to the lower house to be amended. However, the lower house should be able to bypass their veto.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":52}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_UpperHouse_Limited","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseLimited","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":20}]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We will grant them the power of judicial review and to declare laws unconstitutional, so that they can keep the legislative and the executive in check.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":59}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_UpperHouse_Equal","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_UpperHouseEqual","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":20}]},"55":{"id":55,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We will give the justices immunity so that they cannot be threatened by powerful interests or the acting executive.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":26}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Judiciary_LifeTenure","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_LifeTenure","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":27}]},"57":{"id":57,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Your Majesty. I think we've achieved a lot today.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":3}]},"58":{"id":58,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"There will be no constitutional court and the judiciary will not have any political powers.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":50}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Judiciary_JudicialReview","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_JudicialReview","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":27}]},"60":{"id":60,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"I'll get to work on the draft. And I'll begin rallying the movement as soon as possible.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":28}]},"61":{"id":61,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't want a strong judicial branch. We should retain some control over their composition.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":27}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":63},{"convId":408,"nodeId":64}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Diplomatic\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":38}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":73}]},"65":{"id":65,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":66},{"convId":408,"nodeId":67}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":77}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":68}]},"68":{"id":68,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"How about the legislative? Are we seeking to establish an upper house as mentioned before?\"","conditionsRaw":"((Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true) == false) and (Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true)","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":69},{"convId":408,"nodeId":71}]},"69":{"id":69,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Maybe it's not the best idea. We will keep the House of Delegates as the sole legislative body.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":78}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Reform_Legislative_RegionalSenate","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_ReformManus_RegionSenate","op":"=","value":"true"}],"outgoingIds":[{"convId":408,"nodeId":19}]},"71":{"id":71,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes. We will establish a Senate comprised of elected senators from each region as an upper house.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":70}]},"72":{"id":72,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've changed my mind. We will establish a Senate comprised of elected senators from each region as an upper house.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":70}]},"73":{"id":73,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've changed my mind after our discussion. We'll respect our regional system.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Diplomatic\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Diplomatic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":42}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":75},{"convId":408,"nodeId":76}]},"75":{"id":75,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":65}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":44}]},"77":{"id":77,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"How about the House of Delegates? Are we keeping the legislative unicameral as mentioned before?\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral\"] == true) and (Variable[\"RiziaDLC.Reform_Movement_Leader_Adarfo\"] == true)","variablesRead":[{"var":"RiziaDLCIsolated.Reform_Intention_Legislative_Unicameral","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Leader_Adarfo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":72},{"convId":408,"nodeId":8}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":408,"nodeId":20}]}}}