:false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":31}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":56}]},"16":{"id":16,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think we can end the meeting here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":80}]},"17":{"id":17,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But sir, I understand that you're trying to get rid of the impeachment, however I have to say that it may create problems within the party.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":18}]},"18":{"id":18,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We have to make sure they get behind that part. We do not want to lose the support of USP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":20},{"convId":32,"nodeId":21},{"convId":32,"nodeId":23}]},"19":{"id":19,"speaker":"Player","isPlayerChoice":true,"text":"\"We'll figure it out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":26}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"\"I will make sure they get behind.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":25}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"\"I appreciate your comments but the decision is made.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":25}]},"22":{"id":22,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Wish you good luck with the party, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":16}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"\"We will handle the party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":25}]},"24":{"id":24,"speaker":"Narrator","isPlayerChoice":false,"text":"We all shook hands and they left the room.","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) and ((Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Relations_Nia_Opposition","op":"=","value":"true"}],"outgoingIds":[{"convId":32,"nodeId":61}]},"25":{"id":25,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We will all be doing our part, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":44}]},"26":{"id":26,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We will all do our best to make it work, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":49}]},"27":{"id":27,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I have to say...\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true) == false) and (Variable[\"BaseGame.Reform_Law_Threshold_3\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_8\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_3","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_8","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":29}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"\"Understood.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":22}]},"29":{"id":29,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"The new lower electoral threshold will be really difficult for the party to accept. Our guys are not fond of that idea.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":35}]},"30":{"id":30,"speaker":"Player","isPlayerChoice":true,"text":"\"I will not give in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":22}]},"31":{"id":31,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But I have to say this too...\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Threshold_3\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_8\"] == true) == false) and (Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_3","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_8","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":32}]},"32":{"id":32,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Not reforming the minister laws will be frowned upon by the party. The Assembly members have insisted on getting involved in the process.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":33}]},"33":{"id":33,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That's true. It will be tough to get all of their support. Some of our members may try to openly fight against this.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":19},{"convId":32,"nodeId":55},{"convId":32,"nodeId":40}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks for the advice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":22}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":36},{"convId":32,"nodeId":37}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":38}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":33}]},"38":{"id":38,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Not reforming the minister laws will also be frowned upon by the party. The Assembly members have insisted on getting involved in the process.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":33}]},"39":{"id":39,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And be prepared to reconsider the proposal if it comes to that, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":34},{"convId":32,"nodeId":28},{"convId":32,"nodeId":30}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm prepared to reconsider if it comes to that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":26}]},"41":{"id":41,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":39}]},"42":{"id":42,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In the meantime, you must introduce this proposal to our party, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":46}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You must also be prepared to reconsider the proposal if it comes to that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":34},{"convId":32,"nodeId":28},{"convId":32,"nodeId":30}]},"44":{"id":44,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Any other comments before we proceed?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":9}]},"45":{"id":45,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We will be working on the wording of the proposal with our legal experts before we propose it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":42}]},"46":{"id":46,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You'll need to a strong speech to get them behind you. But I advise you to first talk to the leaders of the both conservative and reformist wings of the party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":51}]},"47":{"id":47,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Sir, you are pretty well-versed in speeches. You know the party. Just make sure you get them hyped up about the reforms.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":43}]},"48":{"id":48,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As much as I don't want to say this, if they make any demands to change the proposal, you may need to give in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":34},{"convId":32,"nodeId":28},{"convId":32,"nodeId":30}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Any other comments before we proceed?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":56}]},"50":{"id":50,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As Mr. Vectern said, Mrs. Tory will probably be easier to persuade. We need to unite the party under these changes, so her support is vital.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":12}]},"51":{"id":51,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"As far as I'm aware, Mr. Clavin will be our biggest problem, he may try to paint you as a dictator. Mrs. Tory will also be tough but we'll need to get her first.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":32,"nodeId":52},{"con