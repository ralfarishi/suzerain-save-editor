{"conversationId":162,"title":"Sordland/Turn08/ValgslandVisit_ComradeRayne","storyPack":"StoryPack_Main","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":4}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":160,"nodeId":3}]},"3":{"id":3,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“The pleasure is mine.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":72}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"Upon seeing me, he smiled and opened his arms.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":11}]},"5":{"id":5,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Comrade Rayne. I am planning on invading Heljiland to save Valgslandian people from the clutches of the murderous Agnolian governor.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":6}]},"6":{"id":6,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Don't worry. I don't wish to pull Sordland into this conflict in any way.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":8}]},"7":{"id":7,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Very well. I won't push further.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":192}]},"8":{"id":8,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“This is not your battle, after all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":10}]},"9":{"id":9,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Comrade Malenyev is a good friend of mine.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":19}]},"10":{"id":10,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What I want from you is simple.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":12}]},"11":{"id":11,"speaker":"Narrator","isPlayerChoice":false,"text":"We hugged and he patted me on the shoulder.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":18}]},"12":{"id":12,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I want you to recognize Heljiland as Valgslandian territory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":30}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"“Let's hope we can stay that way.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":109}]},"14":{"id":14,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What do you say, Comrade Rayne? Are you with me? I will also provide some minor financial assistance as a fellow traveller.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":16},{"convId":162,"nodeId":15},{"convId":162,"nodeId":17}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"“I won't meddle in the affairs between Valgsland and Agnolia.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":32}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"“I am with you, Comrade Hegel.” [+1 Budget]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":47}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“Please, Comrade Hegel. You must remain calm. So many lives would be lost.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":21}]},"18":{"id":18,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Comrade Rayne! It is so good to see you. I've wanted to meet you in person for a long time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":28},{"convId":162,"nodeId":26},{"convId":162,"nodeId":24}]},"19":{"id":19,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Although I don't agree with him on every matter, he demands respect.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":183}]},"20":{"id":20,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“There are two things on my mind.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":76}]},"21":{"id":21,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“So many Valgslandian lives are already lost!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":23}]},"22":{"id":22,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“However, our revolution here in Valgsland owes a great deal to Malenyev. He is the father of Malenyevism and a symbol of global revolution.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":191}]},"23":{"id":23,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Very well. I will take that as a no.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":25}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"“So. Where do we begin?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":35}]},"25":{"id":25,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Although I would appreciate the support, our matters are not yours.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":27}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“Likewise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":35}]},"27":{"id":27,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I will commence the invasion regardless.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":50}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“It's a pleasure to finally meet with you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":35}]},"29":{"id":29,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Then it is time!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_HeljilandRecognised","op":"=","value":"true"},{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"=","value":"false"},{"var":"BaseGame.GovernmentBudget","op":"=","value":"Variable[\"BaseGame.GovernmentBudget\"] + 1"},{"var":"BaseGameSupport.Journal_Turn08_ValgslandVisit_HeljilandRecognized","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":39}]},"30":{"id":30,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“If we have Sordland behind our cause, everything will be easier.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":14}]},"31":{"id":31,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Ah. You have spotted the portrait. Well. Where do I begin?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":9}]},"32":{"id":32,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“So you'd prefer to stay neutral.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":34}]},"33":{"id":33,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Comrade Rayne. If you'd like, I can put in a good word for you with Comrade Malenyev. I have the feeling you would get along with him.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":40}]},"34":{"id":34,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Very well. I respect that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":36}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"He gestured towards the painting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":38}]},"36":{"id":36,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Although I would appreciate the support, as you said, our matters are not yours.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":27}]},"37":{"id":37,"speaker":"Narrator","isPlayerChoice":false,"text":"Hegel looked down for a moment. He walked over to the window and gazed outside, his arms crossed behind his back.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":110}]},"38":{"id":38,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“This was made in 1776 by the famous Valgslandian painter, Otto Kiebern.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":43}]},"39":{"id":39,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“We have achieved a lot today, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":42}]},"40":{"id":40,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Would you like that?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":52},{"convId":162,"nodeId":51}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"The assistant immediately showed up with two more shots of vodka.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":188}]},"42":{"id":42,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Another!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":41}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"I looked at the painting. It must've been over five meters tall. It was a battle scene. On the left side, there were banners carried by Valgs; on the right, Sords.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":46}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“What can you tell me about Comrade Malenyev?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":31}]},"45":{"id":45,"speaker":"Narrator","isPlayerChoice":false,"text":"We gulped down the shots after clinking.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":50}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"Countless spears formed a triangle at the center. The sky was red from the blood.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":49}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_HeljilandRecognised","op":"=","value":"true"},{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"=","value":"false"},{"var":"BaseGame.GovernmentBudget","op":"=","value":"Variable[\"BaseGame.GovernmentBudget\"] + 1"}],"outgoingIds":[{"convId":162,"nodeId":187}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"“Let's talk about business, shall we?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":80}]},"49":{"id":49,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What do you think about it?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":60},{"convId":162,"nodeId":58},{"convId":162,"nodeId":56}]},"50":{"id":50,"speaker":"Narrator","isPlayerChoice":false,"text":"As the assistant collected the empty glasses, he whispered into Hegel's ear.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":53}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for the offer, but there is no need.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":73}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing would make me happier. Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":64}]},"53":{"id":53,"speaker":"Narrator","isPlayerChoice":false,"text":"His eyes widened and he clenched his fists in anger.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":185}]},"55":{"id":55,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“The Agnolians did what?!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":57}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"“It is a reminder. One misstep and we are back to painting the world with more blood.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":68}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"He composed himself and smiled at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":59}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing. It's just a painting.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":70}]},"59":{"id":59,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Comrade Rayne, I'm afraid you will have to excuse me. There is a matter I need to attend to.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":63},{"convId":162,"nodeId":62},{"convId":162,"nodeId":61}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“I think that we have come far. After all, we are standing here side by side instead of facing each other a battlefield.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":71}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"“Good luck.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":69}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“Is there anything I can help with?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":66}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“Of course, Comrade Hegel. It was a pleasure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":3}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Hegel_PutInAGoodWordWithMalenyev","op":"=","value":"true"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 2"}],"outgoingIds":[{"convId":162,"nodeId":73}]},"65":{"id":65,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Sorry about that. You know how it is.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":153},{"convId":162,"nodeId":158},{"convId":162,"nodeId":160}]},"66":{"id":66,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Thank you for the offer, but no.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":72}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"Smoked bear meat, a local delicacy, was served with eggs. After a very delicious meal we sat down on two couches. I immediately saw the portrait of Leon \"Malenyev\" Chavatangakwunua staring down at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":44},{"convId":162,"nodeId":48}]},"68":{"id":68,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“As the leaders of this world, we must be careful, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":74}]},"69":{"id":69,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":72}]},"70":{"id":70,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Certainly a fair viewpoint, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":81}]},"71":{"id":71,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“We can do so much more through unity, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":81}]},"72":{"id":72,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Have a good day and enjoy Haelm.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":75}]},"73":{"id":73,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Hegel_PutInAGoodWordWithMalenyev","op":"=","value":"true"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 2"}],"outgoingIds":[{"convId":162,"nodeId":80}]},"74":{"id":74,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Especially around those who are willing and ready to do precisely that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":81}]},"75":{"id":75,"speaker":"Narrator","isPlayerChoice":false,"text":"We shook hands and Hegel left in a hurry.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":2}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":98}]},"77":{"id":77,"speaker":"Narrator","isPlayerChoice":false,"text":"We made our way to the exquisite dining room. I looked around at the tableware. Everything seemed to be colored gold, blue and white.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":67}]},"78":{"id":78,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me and put his hand on my shoulder.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":5}]},"79":{"id":79,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“If they want to mess with Valgsland, they will see our might!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":78}]},"80":{"id":80,"speaker":"Narrator","isPlayerChoice":false,"text":"Two cups of coffee were brought by an assistant. I took a sip while he lit his pipe.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":87}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"We started walking.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":86}]},"82":{"id":82,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I don't understand your reasoning, but perhaps you are right.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":7}]},"83":{"id":83,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I do not know how much longer I can show restraint.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":79}]},"84":{"id":84,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“How can I stay calm?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":79}]},"85":{"id":85,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Agnolia clearly wants war.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":84}]},"86":{"id":86,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“To me, this painting tells me how far we have come. Sords and Valgs may have had our troubles, but ultimately, we are brothers.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":89}]},"87":{"id":87,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Let's begin, then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":91}]},"88":{"id":88,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“The window for diplomatic action is closing, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":83}]},"89":{"id":89,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“No two countries in this world understand each other more.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":101},{"convId":162,"nodeId":99},{"convId":162,"nodeId":13}]},"90":{"id":90,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Follow me. We will have a short breakfast.”","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn05_AutocratEmergency_Extend\"] == true  and  Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn05_AutocratEmergency_Extend","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":77}]},"91":{"id":91,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Now, before you say anything...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":102}]},"92":{"id":92,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Valgsland is being attacked!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":85}]},"93":{"id":93,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Exactly!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":83}]},"94":{"id":94,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Middle way?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":88}]},"95":{"id":95,"speaker":"Player","isPlayerChoice":true,"text":"“I would slaughter them the same way they slaughtered us!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":93}]},"96":{"id":96,"speaker":"Player","isPlayerChoice":true,"text":"“Comrade Hegel. I urge you to remain calm. No one wants war.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":92}]},"97":{"id":97,"speaker":"Player","isPlayerChoice":true,"text":"“I would approach the matter diplomatically. Surely a middle way can be found.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":94}]},"98":{"id":98,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I think you and I are like-minded people, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":103}]},"99":{"id":99,"speaker":"Player","isPlayerChoice":true,"text":"“It is great to hear these important words coming from you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":107}]},"100":{"id":100,"speaker":"Narrator","isPlayerChoice":false,"text":"After receiving the order, the guard hastily left. Hegel walked over to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":65}]},"101":{"id":101,"speaker":"Player","isPlayerChoice":true,"text":"“Exactly my thoughts.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":107}]},"102":{"id":102,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I think you will be glad to hear that I accept the deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":54}]},"103":{"id":103,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I would like to solidify our newfound friendship and admiration with a military alliance between Valgsland and Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":116}]},"104":{"id":104,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Imagine they did that to the Sordish people. What would you do, Comrade Rayne?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":96},{"convId":162,"nodeId":95},{"convId":162,"nodeId":97}]},"105":{"id":105,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What do you say, Comrade Rayne? Are you ready to achieve greatness with me?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":169},{"convId":162,"nodeId":170}]},"106":{"id":106,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“As if their occupation is not enough, they kill my people in their homes in Heljiland. Slaughtering them like mere cattle.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":104}]},"107":{"id":107,"speaker":"Narrator","isPlayerChoice":false,"text":"He nodded and pointed towards another painting that was almost as large as the first one. A burning city was depicted. Looking closer, I realized it was Conriat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":118}]},"108":{"id":108,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I have had it with those damn Agnolians who claim *our* land as their own.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":106}]},"109":{"id":109,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I am sure we will.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":113}]},"110":{"id":110,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Now that we are allies, I must tell you something.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":108}]},"111":{"id":111,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Revolution is a slow process, Comrade Rayne. Slow but sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":173}]},"112":{"id":112,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Now that that's out of the way.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":20}]},"113":{"id":113,"speaker":"Narrator","isPlayerChoice":false,"text":"He pointed towards another painting that was almost as large as the first one. A burning city was depicted. Looking closer, I realized it was Conriat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":118}]},"114":{"id":114,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I had my doubts in the beginning, but they disappeared once I met you in person.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_TradeDeal","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn08_ValgslandVisit_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":129},{"convId":162,"nodeId":126},{"convId":162,"nodeId":125}]},"115":{"id":115,"speaker":"Narrator","isPlayerChoice":false,"text":"The strong bite of alcohol turned into a sweeter aftertaste.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":37}]},"116":{"id":116,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“A pact that connects our two nations. No! It's much more than that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":137}]},"117":{"id":117,"speaker":"Narrator","isPlayerChoice":false,"text":"We clinked the glasses and drank our shots.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":115}]},"118":{"id":118,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“The Great Fire of Conriat.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":122}]},"119":{"id":119,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“In Valgsland we drink on a contract, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":117}]},"120":{"id":120,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“No one can exploit our people and expect to get away with it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":100}]},"121":{"id":121,"speaker":"Narrator","isPlayerChoice":false,"text":"He called out to a nearby assistant. A moment later, the assistant returned with two shots of vodka.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_Alliance","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn08_ValgslandVisit_Alliance","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":119}]},"122":{"id":122,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“The most shameful event in all of Valgslandian history. The scars of it must still sting.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":131},{"convId":162,"nodeId":130},{"convId":162,"nodeId":134}]},"123":{"id":123,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":173}]},"124":{"id":124,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_Alliance","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":186}]},"125":{"id":125,"speaker":"Player","isPlayerChoice":true,"text":"“Very generous. Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":145}]},"126":{"id":126,"speaker":"Player","isPlayerChoice":true,"text":"“What doubts did you have?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":147}]},"127":{"id":127,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Most excellent!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":189}]},"128":{"id":128,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I think it is time to bury the hatchet. But I also understand where you are coming from.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":142}]},"129":{"id":129,"speaker":"Player","isPlayerChoice":true,"text":"“The same goes for me too, Comrade Hegel. Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":148}]},"130":{"id":130,"speaker":"Player","isPlayerChoice":true,"text":"“Past is past. We need to look into the future.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":144}]},"131":{"id":131,"speaker":"Player","isPlayerChoice":true,"text":"“Another result of the evils of imperialism.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":143}]},"132":{"id":132,"speaker":"Player","isPlayerChoice":true,"text":"“You make good points, Comrade Hegel. Very well. I accept!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":127}]},"133":{"id":133,"speaker":"Player","isPlayerChoice":true,"text":"“Sordland can protect itself against threats. I will have to refuse.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":82}]},"134":{"id":134,"speaker":"Player","isPlayerChoice":true,"text":"“We will never forget the extremely shameful display by the Valgslandian navy. ”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":141}]},"135":{"id":135,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“A director of a foreign joint-venture mining corporation decided not to pay his miners their salary for two consecutive months. He will be handled.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":111}]},"136":{"id":136,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Are you sure about this, Comrade Rayne?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":132},{"convId":162,"nodeId":133}]},"137":{"id":137,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“A sign that unity between Valgs and Sords has finally arrived!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":168}]},"138":{"id":138,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I am offering a helping hand.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":136}]},"139":{"id":139,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Give the miners what they want. As for the director of the company, I want him to face a trial for undermining the workers of Valgsland. Relay it to the Minister of Justice at once!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":120}]},"140":{"id":140,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“If you want to protect your country against what might come next, you will need allies.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":138}]},"141":{"id":141,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“We will never forget the sins of our fathers.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":152}]},"142":{"id":142,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“As you know, the rogue state of Rumburg is on the move.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":140}]},"143":{"id":143,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Well said, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":152}]},"144":{"id":144,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I agree completely.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":152}]},"145":{"id":145,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“No. Thank you, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":165}]},"146":{"id":146,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Our two countries have never been closer.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":142}]},"147":{"id":147,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Nothing you should worry about.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":165}]},"148":{"id":148,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What's a deal or two between Valgsland and Sordland? We have so much more possibility between our countries.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":165}]},"149":{"id":149,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“If it tips to the wrong side, Valgsland may be your only way out.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":142}]},"150":{"id":150,"speaker":"Player","isPlayerChoice":true,"text":"“Sordland is part of a fragile balance. I don't want to disturb it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":155}]},"151":{"id":151,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“If not now, when?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":146}]},"152":{"id":152,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Thankfully, we in Valgsland have now cut off the head of the snake called imperialism.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":154}]},"153":{"id":153,"speaker":"Player","isPlayerChoice":true,"text":"“I definitely do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":111}]},"154":{"id":154,"speaker":"Narrator","isPlayerChoice":false,"text":"A guard approached the Chancellor.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":159}]},"155":{"id":155,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“You yourself say that balance is fragile. It will tip no matter what you do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":149}]},"156":{"id":156,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“So you say.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":128}]},"157":{"id":157,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I say the time is now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":151}]},"158":{"id":158,"speaker":"Player","isPlayerChoice":true,"text":"“What was that about?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":135}]},"159":{"id":159,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“If you will excuse me for one minute.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":164}]},"160":{"id":160,"speaker":"Player","isPlayerChoice":true,"text":"“Let's move on with the scheduled program.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":123}]},"161":{"id":161,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What did you say?!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":166}]},"162":{"id":162,"speaker":"Player","isPlayerChoice":true,"text":"“Although I am ready, Sordland is not. Our countries' past still haunts the minds of my people.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":156}]},"163":{"id":163,"speaker":"Player","isPlayerChoice":true,"text":"“If an alliance happens, I want it to happen on my terms and at a more opportune time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":157}]},"164":{"id":164,"speaker":"Narrator","isPlayerChoice":false,"text":"The chancellor stepped away with the guard while I looked around. I saw a more recent painting, depicting the upheaval of farmers against an aristocrat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":161}]},"165":{"id":165,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I will sign the papers shortly.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":171}]},"166":{"id":166,"speaker":"Narrator","isPlayerChoice":false,"text":"Hegel's loud voice echoed in the empty halls.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":139}]},"167":{"id":167,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“And why is that, Comrade Rayne?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":150},{"convId":162,"nodeId":162},{"convId":162,"nodeId":163}]},"168":{"id":168,"speaker":"Narrator","isPlayerChoice":false,"text":"He clenched his fist and looked at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":105}]},"169":{"id":169,"speaker":"Player","isPlayerChoice":true,"text":"“I accept, Comrade Hegel. May this brighten the future of both of our countries!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":127}]},"170":{"id":170,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for the offer, Comrade Hegel. However, I will have to refuse.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":167}]},"171":{"id":171,"speaker":"Narrator","isPlayerChoice":false,"text":"He got up from his seat, walked over to the window and looked outside.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":112}]},"172":{"id":172,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I hear there is still an emergency declared in Sordland.”","conditionsRaw":"Variable[\"BaseGame.Decision_Turn05_AutocratEmergency_Extend\"] == true  and  Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn05_AutocratEmergency_Extend","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":176}]},"173":{"id":173,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":174},{"convId":162,"nodeId":175}]},"174":{"id":174,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn05_AutocratEmergency_Extend\"] == true  and  Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn05_AutocratEmergency_Extend","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":172}]},"175":{"id":175,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn05_AutocratEmergency_Extend\"] == true  and  Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn05_AutocratEmergency_Extend","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":90}]},"176":{"id":176,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I hope everything is alright.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":177},{"convId":162,"nodeId":178},{"convId":162,"nodeId":179}]},"177":{"id":177,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing to worry about, Comrade Hegel. Everything has been handled.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":182}]},"178":{"id":178,"speaker":"Player","isPlayerChoice":true,"text":"“That is none of your concern, Comrade Hegel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":180}]},"179":{"id":179,"speaker":"Player","isPlayerChoice":true,"text":"“Let's change the topic.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":182}]},"180":{"id":180,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“No need to go on the defensive.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":181}]},"181":{"id":181,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I get the signal, Comrade Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":90}]},"182":{"id":182,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":90}]},"183":{"id":183,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Valgslandian Socialism aims to eliminate the power of the state by promoting the responsibility, freedom and well-being of the people. One of our key cornerstones is the devolution of big government to smaller councils with high citizen participation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":184}]},"184":{"id":184,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“We believe that the revolution in Valgsland is stable enough that we do not need the vanguardist approach of Malenyevism. We are already in the process of such a transformation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":22}]},"185":{"id":185,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn08_ValgslandVisit_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":114}]},"186":{"id":186,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn08_ValgslandVisit_Alliance","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":121}]},"187":{"id":187,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn08_ValgslandVisit_HeljilandRecognized","op":"=","value":"true"}],"outgoingIds":[{"convId":162,"nodeId":29}]},"188":{"id":188,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":45}]},"189":{"id":189,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":190}]},"190":{"id":190,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":124}]},"191":{"id":191,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Not only is he the first communist revolutionary leader of the world, he managed to unite a whole continent, forming the greatest country in the world.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":33}]},"192":{"id":192,"speaker":"Narrator","isPlayerChoice":false,"text":"Hegel looked down for a moment. He walked over to the window and gazed outside, his arms crossed behind his back.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":193}]},"193":{"id":193,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Even if you're not with us, I will tell you something you may want to know.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":162,"nodeId":108}]}}}