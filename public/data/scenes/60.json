{"conversationId":60,"title":"Sordland/Turn04/PSnW_SchoolVisit","storyPack":"StoryPack_Main","turn":4,"turnLabel":"Turn 4","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":1}]},"1":{"id":1,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":4}]},"2":{"id":2,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn04_PSnW_SchoolVisit","op":"=","value":"true"}],"outgoingIds":[{"convId":60,"nodeId":173}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"As part of the planned program, we arrived in Leiren to visit a middle school.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":130}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"The prestigious Toren Hill School was situated close to the suburbs just outside of the city centre. The building was flanked by two hills, each beautifully dotted with shrubs and flowers.","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameSupport.News_Turn04_R_DeyrLockdown","op":"=","value":"true"}],"outgoingIds":[{"convId":60,"nodeId":6}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian, Ciara and I got out of our cars and met at the entrance. Our presence had not gone unnoticed. Apart from our guards, there were at least ten reporters following us around.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":7}]},"7":{"id":7,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“That must be the principal. Right this way, sir.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":8}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"The principal was a man of short stature with a bushy moustache and a pair of glasses. He approached us quickly, but was stopped by the security guards. They started patting him down and searching him.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":10},{"convId":60,"nodeId":11}]},"9":{"id":9,"speaker":"Principal","isPlayerChoice":false,"text":"“Mr. President. Such an honor to meet with you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":13},{"convId":60,"nodeId":12}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“That won't be necessary. Let him through.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":9}]},"11":{"id":11,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Wait for them to finish.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":9}]},"12":{"id":12,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Shake his hand.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":14}]},"13":{"id":13,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Shake his hand and smile for the cameras.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":14}]},"14":{"id":14,"speaker":"Principal","isPlayerChoice":false,"text":"“Welcome to our humble school.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":15},{"convId":60,"nodeId":16},{"convId":60,"nodeId":17}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"“Sorry about the security guards. It's a necessity. Standard procedure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":19}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"“It's good to be here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":19}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“Let's begin.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":19}]},"18":{"id":18,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“It's a pleasure to meet you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":20}]},"19":{"id":19,"speaker":"Principal","isPlayerChoice":false,"text":"“Excellent. You must be Mr. Galade.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":18}]},"20":{"id":20,"speaker":"Principal","isPlayerChoice":false,"text":"“And Ms. Walda. So good of you to come all the way out here.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":21}]},"21":{"id":21,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":157}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"As we entered the students started singing the national anthem.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":170}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"After the anthem finished. All of the students immediately snapped to attention and turned to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":24}]},"24":{"id":24,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“Looks more like a military institution than a school.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":25}]},"25":{"id":25,"speaker":"Principal","isPlayerChoice":false,"text":"“Exactly. That's what we pride ourselves on. Discipline has the utmost importance in our school.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":26},{"convId":60,"nodeId":27},{"convId":60,"nodeId":28}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“Some discipline never hurt anyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":158}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"“Very good.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":31}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“We need more educated people, not soldiers.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":29}]},"29":{"id":29,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“On that we are aligned.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":36}]},"30":{"id":30,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“Up to a point, perhaps. Look at these kids.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":33}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"Ciara frowned and shook her head.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":34}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"A boy and a girl went up to the stage and grabbed their microphones. The students turned to them.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":37}]},"33":{"id":33,"speaker":"Principal","isPlayerChoice":false,"text":"“I can assure you that our students are very well educated. In fact our school is one of the top ten middle schools in the entirety of Sordland.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":35}]},"34":{"id":34,"speaker":"Principal","isPlayerChoice":false,"text":"“Glad you liked it, Mr. President.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":35}]},"35":{"id":35,"speaker":"Principal","isPlayerChoice":false,"text":"“Now, we will watch the students take their daily Student Oath.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":32}]},"36":{"id":36,"speaker":"Principal","isPlayerChoice":false,"text":"“I can assure you that our students are very well educated. In fact our school is one of the top ten middle schools in all of Sordland.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":35}]},"37":{"id":37,"speaker":"Boy","isPlayerChoice":false,"text":"“I am a Sord! My strength lies in my blood!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":38}]},"38":{"id":38,"speaker":"Girl","isPlayerChoice":false,"text":"“I will respect our honorable elders! I will protect the young!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":39}]},"39":{"id":39,"speaker":"Boy","isPlayerChoice":false,"text":"“My life belongs to Sordland now and it will belong to it forever!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":40}]},"40":{"id":40,"speaker":"Girl","isPlayerChoice":false,"text":"“I will always follow the guiding light!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":41}]},"41":{"id":41,"speaker":"Boy","isPlayerChoice":false,"text":"“Of Colonel Soll and the Great Sords!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":42}]},"42":{"id":42,"speaker":"Girl","isPlayerChoice":false,"text":"“A Morgna wes core! Vectern sis da!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":43},{"convId":60,"nodeId":44},{"convId":60,"nodeId":45}]},"43":{"id":43,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Clap loudly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":47}]},"44":{"id":44,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Nod at the kids.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":47}]},"45":{"id":45,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Do nothing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":47}]},"46":{"id":46,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“What? No one even remembers it after they graduate.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":48}]},"47":{"id":47,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Words to remember.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":46}]},"48":{"id":48,"speaker":"Principal","isPlayerChoice":false,"text":"“If you wish to follow me, we will take a look at one of our classrooms.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":49}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"Through the hallways, we made our way to classroom 7-A. As soon as I entered the whole classroom rose up and snapped to attention.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":50},{"convId":60,"nodeId":51}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“Sit down, please.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":52}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“At ease.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":52}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"The students sat down. The same boy and girl walked up to us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":53}]},"53":{"id":53,"speaker":"Principal","isPlayerChoice":false,"text":"“These are our top students and our top class. This here is my son.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":54}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"The boy came before me and saluted me like a military officer.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":55}]},"55":{"id":55,"speaker":"Principal","isPlayerChoice":false,"text":"“Tell Mr. President what you want to be.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":56}]},"56":{"id":56,"speaker":"Boy","isPlayerChoice":false,"text":"“Mr. President! I want to be a general, sir!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":57}]},"57":{"id":57,"speaker":"Boy","isPlayerChoice":false,"text":"“I am ready to sacrifice myself for my country and you, sir!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":59},{"convId":60,"nodeId":58},{"convId":60,"nodeId":60}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"“Good. You will make a fine soldier in the future. At ease, general!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":64}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“This is nonsense. What are you teaching to these students?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":62}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“I will do whatever I can to not let that happen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":64}]},"61":{"id":61,"speaker":"Principal","isPlayerChoice":false,"text":"“Was it not to your liking? I'm so sorry, Mr. President.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":88}]},"62":{"id":62,"speaker":"Narrator","isPlayerChoice":false,"text":"The principal looked extremely surprised.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":61}]},"63":{"id":63,"speaker":"Narrator","isPlayerChoice":false,"text":"The principal squeezed his son's shoulders and the boy looked up and smiled to his father. He patted him on the back and sent him off to his seat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":88}]},"64":{"id":64,"speaker":"Boy","isPlayerChoice":false,"text":"“Thank you, sir!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":63}]},"65":{"id":65,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“This is simply ridiculous. You are raising soldiers here, not students!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":66}]},"66":{"id":66,"speaker":"Principal","isPlayerChoice":false,"text":"“I am so sorry. I will immediately perform disciplinary actions.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":67}]},"67":{"id":67,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“How about you, young lady? What do you think about this?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":68}]},"68":{"id":68,"speaker":"Principal","isPlayerChoice":false,"text":"“She is our top student in this school. Her excellent grades are to--.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":69}]},"69":{"id":69,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“I didn't ask you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":159}]},"70":{"id":70,"speaker":"Girl","isPlayerChoice":false,"text":"“I-”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":71}]},"71":{"id":71,"speaker":"Girl","isPlayerChoice":false,"text":"“I'm sick of having to knit and sew while the boys learn science and chemistry. I'm smarter than all of them. Why do I have to take these stupid handcraft classes?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":72}]},"72":{"id":72,"speaker":"Principal","isPlayerChoice":false,"text":"“Ssssh! Do you know who you are talki-“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":73}]},"73":{"id":73,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“Shut up. Let her speak.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":161}]},"74":{"id":74,"speaker":"Girl","isPlayerChoice":false,"text":"“My math and reading scores are the best in the school. But they won't let me take the classes I want, just because I'm a girl.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":75}]},"75":{"id":75,"speaker":"Girl","isPlayerChoice":false,"text":"\"I want to be a scientist! Not some soldier's wife!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":76},{"convId":60,"nodeId":77},{"convId":60,"nodeId":81}]},"76":{"id":76,"speaker":"Player","isPlayerChoice":true,"text":"“You heard her, Mr. Principal. You will make the necessary changes. At once.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":80}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"“But knitting and sewing are important skills to have for a woman.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":78}]},"78":{"id":78,"speaker":"Narrator","isPlayerChoice":false,"text":"Ciara's eyes were shooting daggers at me. She looked back at the girl.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":82}]},"79":{"id":79,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I will personally check back and ensure that the changes are made.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":83}]},"80":{"id":80,"speaker":"Principal","isPlayerChoice":false,"text":"“As you wish, sir. At once.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":79}]},"81":{"id":81,"speaker":"Player","isPlayerChoice":true,"text":"“We need more people like you in this country. I applaud your determination.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":84}]},"82":{"id":82,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“Don't worry. We will talk in private later, okay?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":85}]},"83":{"id":83,"speaker":"Principal","isPlayerChoice":false,"text":"“Yes, sir.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":89}]},"84":{"id":84,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“We need more than words. We need action.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":87}]},"85":{"id":85,"speaker":"Girl","isPlayerChoice":false,"text":"“Okay.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":89}]},"86":{"id":86,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Well then. Unfortunately we are almost out of time. We have other meetings to attend to today.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":90}]},"87":{"id":87,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“Concrete action. We need to protect girls like this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":89}]},"88":{"id":88,"speaker":"Narrator","isPlayerChoice":false,"text":"The cameras flashed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":65}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"The cameras flashed once again.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":100}]},"90":{"id":90,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Thank you for the warm welcome.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":94}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":95}]},"92":{"id":92,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian. Let's leave.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":95}]},"93":{"id":93,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for the tour.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":95}]},"94":{"id":94,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"“Mr. President. Lucian. Please go ahead. I would like to speak with the girl alone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":91},{"convId":60,"nodeId":92},{"convId":60,"nodeId":93}]},"95":{"id":95,"speaker":"Principal","isPlayerChoice":false,"text":"“Thank you for visiting our school, sir.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":96}]},"96":{"id":96,"speaker":"Principal","isPlayerChoice":false,"text":"“Come on class. One. Two.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":98}]},"97":{"id":97,"speaker":"Boy","isPlayerChoice":false,"text":"“A Morgna wes core!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":115},{"convId":60,"nodeId":116}]},"98":{"id":98,"speaker":"Narrator","isPlayerChoice":false,"text":"All students in the classroom yelled but the boy whom I met was the loudest.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":97}]},"99":{"id":99,"speaker":"Narrator","isPlayerChoice":false,"text":"After another round of photos we departed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":117}]},"100":{"id":100,"speaker":"Narrator","isPlayerChoice":false,"text":"I looked around the classroom and saw a large portrait of Colonel Soll.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":101},{"convId":60,"nodeId":102},{"convId":60,"nodeId":111}]},"101":{"id":101,"speaker":"Player","isPlayerChoice":true,"text":"“Take that down.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":113}]},"102":{"id":102,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Don't say anything.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":86}]},"103":{"id":103,"speaker":"Principal","isPlayerChoice":false,"text":"“But, sir. That's a portrait of Colonel Soll. We can't just take it down.“","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] - 1"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] - 1"},{"var":"BaseGame.Turn04_PSnW_SchoolVisit_TookDownSollPortrait","op":"=","value":"true"}],"outgoingIds":[{"convId":60,"nodeId":105},{"convId":60,"nodeId":104},{"convId":60,"nodeId":106}]},"104":{"id":104,"speaker":"Player","isPlayerChoice":true,"text":"“Don't make me repeat my words.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":109}]},"105":{"id":105,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian. Do it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":108}]},"106":{"id":106,"speaker":"Player","isPlayerChoice":true,"text":"“I gave you an order.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":109}]},"107":{"id":107,"speaker":"Narrator","isPlayerChoice":false,"text":"Even the reporters looked confused for a minute, before taking many photos of the portrait being taken down.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nodeId":110}]},"108":{"id":108,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took the frame down and gave it to the principal.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":60,"nod