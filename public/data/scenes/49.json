{"conversationId":49,"title":"Sordland/Turn04/InT_SSCRailwayIssue","storyPack":"StoryPack_Main","turn":4,"turnLabel":"Turn 4","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":1}]},"1":{"id":1,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":4}]},"2":{"id":2,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"The main purpose of our visit was to solve construction issues that began to endanger the deadline.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":6}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"The L-1 Railway construction created the perfect opportunity to visit the green technological nerve centre of Sordland. Dozens of electrical engineers from the city were part of the electrification upgrade of the rail track.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":3}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"There was also a message of support from the mayor of Anrica, Curtan Leste, who was grateful for the L-1 investments.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":21}]},"6":{"id":6,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":7},{"convId":49,"nodeId":8}]},"7":{"id":7,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn03_EnT_Education_Budget_Increase\"] == true","variablesRead":[{"var":"BaseGame.Turn03_EnT_Education_Budget_Increase","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":12}]},"8":{"id":8,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn03_EnT_Education_Budget_Increase\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn03_EnT_Education_Budget_Increase","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":9}]},"9":{"id":9,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":10},{"convId":49,"nodeId":11}]},"10":{"id":10,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn03_EnT_Education_Budget_Decrease\"] == true","variablesRead":[{"var":"BaseGame.Turn03_EnT_Education_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":14}]},"11":{"id":11,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn03_EnT_Education_Budget_Decrease\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn03_EnT_Education_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":13}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"The Gelsord Research Council was very willing to let us use their facilities because the rectors were pleased by the increase of the education funding.","conditionsRaw":"Variable[\"BaseGame.Turn03_EnT_Education_Budget_Increase\"] == true","variablesRead":[{"var":"BaseGame.Turn03_EnT_Education_Budget_Increase","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":20}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"The Gelsord Research Council let us use their facilities, but the rectors weren't interested in our affairs.","conditionsRaw":"((Variable[\"BaseGame.Turn03_EnT_Education_Budget_Increase\"] == true) == false) and ((Variable[\"BaseGame.Turn03_EnT_Education_Budget_Decrease\"] == true) == false)","variablesRead":[{"var":"BaseGame.Turn03_EnT_Education_Budget_Increase","op":"==","value":"true"},{"var":"BaseGame.Turn03_EnT_Education_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":20}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"The Gelsord Research Council was very reluctant to let us use their facilities as the rectors weren't at all pleased by the reduction of education funding.","conditionsRaw":"((Variable[\"BaseGame.Turn03_EnT_Education_Budget_Increase\"] == true) == false) and (Variable[\"BaseGame.Turn03_EnT_Education_Budget_Decrease\"] == true)","variablesRead":[{"var":"BaseGame.Turn03_EnT_Education_Budget_Increase","op":"==","value":"true"},{"var":"BaseGame.Turn03_EnT_Education_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":20}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"The meeting ended. The three of us toured the Advanced Research and Development divisions in Gelsord.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":16}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"The day-long visit ended with a dinner involving the most important people in the city. Many of them were scientists.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":18}]},"17":{"id":17,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“That should be it. Good that we have figured out a way to move the process forward.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":15}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"Later, we made our way back to Holsord.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":75}]},"19":{"id":19,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn04_InT_Issue","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":94}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon looked a little more stressed than usual. Gus was also here to find solutions. He eyed me for a while.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":5}]},"21":{"id":21,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“We scheduled the project to finish in late 1955 but I have concerns about the construction due to progress being slower than expected.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":74}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"“Do we have a case of project mismanagement?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":54}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"“Finding competent managers could work. New blood can move things back on track.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":24}]},"24":{"id":24,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I know many skilled and experienced people in the construction industry. So does Symon too, I presume.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":32}]},"25":{"id":25,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“The warning will hopefully have a positive result to their performance. We could escalate further later.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Warn","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_SSCWarning","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":87}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“The incompetent managers should be fired. This is a disgrace.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":27}]},"27":{"id":27,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“It would be a drastic measure but not unreasonable. Replacing them with competent managers would do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":28}]},"28":{"id":28,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“The shake-up could have a positive result but what if the SSC overall boycotts against this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":64},{"convId":49,"nodeId":31},{"convId":49,"nodeId":23}]},"29":{"id":29,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I will personally go and talk to a few SSC managers and tell them of the gravity of the situation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"}],"outgoingIds":[{"convId":49,"nodeId":17}]},"30":{"id":30,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I don't expect them to bite back but maybe they can further slow the construction by protesting.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":32}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“The state owns the SSC. They can't retaliate and bite off the hand that feeds them.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":30}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon took a deep breath and continued.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":56}]},"33":{"id":33,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I say we replace them with more competent managers. It should help resolve the resources being handled inefficiently.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":61},{"convId":49,"nodeId":38},{"convId":49,"nodeId":41}]},"34":{"id":34,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_RailwayIssue_Solved","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":59}]},"35":{"id":35,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Couldn't agree more. This shouldn't keep going on any longer.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":70}]},"36":{"id":36,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Replace","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_SSCReplaced","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":43}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“We can't let mismanagement delay the project. It is unacceptable.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":35}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“Warn the construction managers. Send a formal warning from the Ministry of Economy and the Presidency.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":58}]},"39":{"id":39,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“State owned corporations like them never really receive performance penalties and that's why they are incompetent and lack responsibility.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":50},{"convId":49,"nodeId":37},{"convId":49,"nodeId":26}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"“Giving them a serious warning could be the solution. A slap on the wrist can do wonders.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":44}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"“Replace the construction managers with more competent people to ensure the deadline is hit.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":36}]},"42":{"id":42,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I'll make some calls. Got good contacts that can be added to the potential candidates.”","conditionsRaw":"(Variable[\"BaseGame.Situation_Law_MediaBias\"] == true) and ((Variable[\"BaseGame.Situation_Law_MediaBias\"] == true) == false)","variablesRead":[{"var":"BaseGame.Situation_Law_MediaBias","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] - 1"}],"outgoingIds":[{"convId":49,"nodeId":17}]},"43":{"id":43,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“It's good to see that failure isn't rewarded and punished. We will find more competent people through our networks.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Replace","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_SSCReplaced","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":89}]},"44":{"id":44,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“There is a good chance that they will take this far more seriously and take measures to increase speed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":32}]},"45":{"id":45,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“One of the important issues is their construction management team. The other could be the outdated construction methods used which require more manpower, but we aren't sure if that contributes to the issue.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":39}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"“How can we speed up the construction to get back on track?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":48}]},"47":{"id":47,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Money","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_SSCFunds","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":62}]},"48":{"id":48,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“That is the million ren question. There are a couple of issues that need to be resolved if we want the SSC to make the deadline.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":45}]},"49":{"id":49,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“They aren't managing to maintain the speed of the construction with the resources given. Why should they receive more?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":51}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“The SSC might need more resources to speed things up. That deadline must be met.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":49}]},"51":{"id":51,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“A cash injection to hire more workers and buy more machinery could have a positive effect on the construction.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":52},{"convId":49,"nodeId":60},{"convId":49,"nodeId":40}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"“It might even be necessary for us to hit the opening date.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":53}]},"53":{"id":53,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Let's hope that they handle the money well. I'm still not a hundred percent sure about this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":32}]},"54":{"id":54,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“That is my theory because they knew about the zones the track passes by. The old SSC construction managers think they are untouchable and that they have no obligations.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":45}]},"55":{"id":55,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“We can either give the construction managers more money, warn them or replace them.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":33}]},"56":{"id":56,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“One way or another we have to solve this issue. This can lead to real complications down the line otherwise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":55}]},"57":{"id":57,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I think that chance is far more likely. I wouldn't take that risk if I were you because there are many more critical investments we can make.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":32}]},"58":{"id":58,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Warn","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_SSCWarning","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":25}]},"59":{"id":59,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“This proves that they have failed at their base contractual agreement. What a shame that we trusted them.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_RailwayIssue_Solved","op":"=","value":"true"},{"var":"BaseGame.GovernmentBudget","op":"=","value":"Variable[\"BaseGame.GovernmentBudget\"] - 1"}],"outgoingIds":[{"convId":49,"nodeId":93}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“There is also the chance that the money could be wasted. We already spent so much on this investment.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":57}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"“Give more money to the construction managers so they can hire more workers and buy machinery to hit the deadline.” [-1 Government Budget]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":47}]},"62":{"id":62,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This extra investment could be just enough to get things back on track. However, it is unfortunate we had to spend more because we need it elsewhere too.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Money","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn04_Infrastructure_SSCFunds","op":"=","value":"true"}],"outgoingIds":[{"convId":49,"nodeId":72}]},"63":{"id":63,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“The SSC reported that they have been slowed down due to several areas on the way to Gelsord having a potential for landslides that could endanger the workers. My argument is that they should have known about it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":22},{"convId":49,"nodeId":46},{"convId":49,"nodeId":65},{"convId":49,"nodeId":66}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“Officially warning them is a possibility but isn't tangible, we need action.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":71}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"“You were right. The administration won't work with the SSC again.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":68}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“I need to hear solutions not excuses or reasons.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":67}]},"67":{"id":67,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Excuse my bluntness, sir. The management of SSC is hard to communicate with because they have the know-it-all attitude.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":73}]},"68":{"id":68,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Good call, Mr. President. Underhall should be available for a second project in the future if we have the budget to do it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":69}]},"69":{"id":69,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“We must focus on solving the issue at hand.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":50},{"convId":49,"nodeId":37},{"convId":49,"nodeId":26}]},"70":{"id":70,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“You are right. My advice would be to warn them. There is a chance they might wake up to the situation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":40},{"convId":49,"nodeId":64},{"convId":49,"nodeId":31}]},"71":{"id":71,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I don't know who they will listen to if they aren't listening to the President of Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":32}]},"72":{"id":72,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.GovernmentBudget","op":"=","value":"Variable[\"BaseGame.GovernmentBudget\"] - 1"}],"outgoingIds":[{"convId":49,"nodeId":34}]},"73":{"id":73,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“It would be possible to demand a change in leadership.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":50},{"convId":49,"nodeId":37},{"convId":49,"nodeId":26}]},"74":{"id":74,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I expected some issue even before we started this. This corporation is full of fossils that don't know how to solve problems reactively.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":63}]},"75":{"id":75,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":76},{"convId":49,"nodeId":77}]},"76":{"id":76,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn04_InT_Issue_SSC_Replace\"] == true","variablesRead":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Replace","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":49,"nodeId":82}]},"77":{"id":77,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn04_InT_Issue_SSC_Replace\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn04_InT_Issue_SSC_Replace","op":"==","value":"true"}],"var