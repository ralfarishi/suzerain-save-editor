{"conversationId":415,"title":"Rizia/Turn 8/VINA ESCAPES","storyPack":"StoryPack_Rizia","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":414,"nodeId":784}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"I entered the palace's residential wing and began making my way to my quarters.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":4}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"As I neared Vina's door, I thought I heard her speaking to someone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":5}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"I was about to step closer when I felt a hand on my shoulder.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":6}]},"6":{"id":6,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"Your Majesty! There you are.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":9}]},"7":{"id":7,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"I'm afraid there's an urgent matter regarding wedding seating arrangements. This way, please.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":8}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"Titus shadowed us as Pabel steered me back down the hall towards my study.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":14},{"convId":415,"nodeId":13},{"convId":415,"nodeId":17},{"convId":415,"nodeId":77}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":10},{"convId":415,"nodeId":11}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":7}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":36}]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Seating arrangements? Is that a euphemism for something?\"","conditionsRaw":"Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":21}]},"13":{"id":13,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I need to check in on Vina.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":22}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":15},{"convId":415,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":12}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This had better be quick.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":20}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Can't you figure it out yourself?\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":19}]},"19":{"id":19,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"I've been trying.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":23}]},"20":{"id":20,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"It will be. Hopefully.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":23}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"He shook his head briskly and withdrew a seating diagram from his breast pocket.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":24}]},"22":{"id":22,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"This will only be a moment.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":23}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"He withdrew a seating diagram from his breast pocket.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":24}]},"24":{"id":24,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"At table 12, we have delegations from Agard, Qinal, the Free Cities and Nahrburk.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":25}]},"25":{"id":25,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"Our guests from Qinal and the Free Cities refuse to sit next to each other or directly across from one another.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":26}]},"26":{"id":26,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"The Qinali, meanwhile, would like to sit directly to the left of our guest from Nahrburk, who in turn has asked to sit across from the Agardian.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":27},{"convId":415,"nodeId":29},{"convId":415,"nodeId":28},{"convId":415,"nodeId":30}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Easy. Going clockwise, it's Agard, Qinal, Nahrburk, Free Cities.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":32}]},"28":{"id":28,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Right. How about Free Cities, Nahrburk, Agard, Qinal?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":32}]},"29":{"id":29,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"From the top of the table, it's Narhburk, Qinal, Agard, Free Cities.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":33}]},"30":{"id":30,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I have no idea. Ask someone else.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":34}]},"31":{"id":31,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"Perfect. Thank you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":37}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"Pabel made a note.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn08_VinaEscapes_CorrectWeddingArrangement","op":"=","value":"true"}],"outgoingIds":[{"convId":415,"nodeId":31}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn08_VinaEscapes_CorrectWeddingArrangement","op":"=","value":"true"}],"outgoingIds":[{"convId":415,"nodeId":32}]},"34":{"id":34,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"I'm sorry, Your Majesty. I was afraid of causing an international scandal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":37}]},"35":{"id":35,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"This must be a very emotional time for you. I still remember Her Highness' birth celebrations.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":40},{"convId":415,"nodeId":44},{"convId":415,"nodeId":46},{"convId":415,"nodeId":41}]},"36":{"id":36,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"I'm afraid there's an urgent matter regarding the seating arrangements for tomorrow's diplomatic luncheon. This way please.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":8}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"