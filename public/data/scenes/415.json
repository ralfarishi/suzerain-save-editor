 Toras","isPlayerChoice":false,"text":"\"I... I don't know.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":74}]},"71":{"id":71,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"No, of course not!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":74}]},"72":{"id":72,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"I... I have no idea what happened.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":74}]},"73":{"id":73,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"I came here to give her some motherly advice ahead of her wedding. I opened the door, and she was gone.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":89},{"convId":415,"nodeId":83},{"convId":415,"nodeId":84},{"convId":415,"nodeId":85}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":75},{"convId":415,"nodeId":76}]},"75":{"id":75,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":73}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":82}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":78},{"convId":415,"nodeId":79}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":18}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":80}]},"80":{"id":80,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We're hosting a diplomatic luncheon?\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":81}]},"81":{"id":81,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"Apparently, yes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":23}]},"82":{"id":82,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"I knew she'd been feeling down lately, so I came to check up on her. I opened the door, and she was gone.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":83},{"convId":415,"nodeId":84},{"convId":415,"nodeId":85},{"convId":415,"nodeId":90}]},"83":{"id":83,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're lying. I heard her talking to someone in there.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":92}]},"84":{"id":84,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"TITUS! FIND HER!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":87}]},"85":{"id":85,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"She can't have gone far. The palace grounds are under heavy security.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":88}]},"86":{"id":86,"speaker":"Narrator","isPlayerChoice":false,"text":"Titus spoke into his radio. I struggled to make out the words on the other end.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":94}]},"87":{"id":87,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"I'm already on it, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":86}]},"88":{"id":88,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"I'm communicating with my fellow guards now, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":86}]},"89":{"id":89,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If she didn't want to get married, she could have just told me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":91}]},"90":{"id":90,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If she wasn't happy, she could have just told me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":93}]},"91":{"id":91,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"She did tell you, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":86}]},"92":{"id":92,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Interesting. Perhaps she was on the phone.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":86}]},"93":{"id":93,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"She did tell you, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":86}]},"94":{"id":94,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"I've received word that one of my men left his shift early just now. He was complaining of indigestion.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":98}]},"95":{"id":95,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Track him down. See that he gets what's coming to him.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":105}]},"96":{"id":96,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You have to find him, Titus. I want my daughter back.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":105}]},"97":{"id":97,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So she had an accomplice. I thought you Golden Guards were incorruptible.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":103}]},"98":{"id":98,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"I tried to reach him, but he's already turned his radio off.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":99},{"convId":415,"nodeId":96},{"convId":415,"nodeId":97},{"convId":415,"nodeId":102}]},"99":{"id":99,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":100},{"convId":415,"nodeId":101}]},"100":{"id":100,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":95}]},"101":{"id":101,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_TyrantKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"102":{"id":102,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It's that easy for someone to escape the palace?!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":106}]},"103":{"id":103,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Everybody has a weakness, darling. Even Captain Gordion here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":104}]},"104":{"id":104,"speaker":"Narrator","isPlayerChoice":false,"text":"Titus cleared his throat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":107}]},"105":{"id":105,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"I'll try my best, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":108}]},"106":{"id":106,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"Your Majesty, Palas Rezna's security systems are designed to keep intruders out. Not to keep princesses in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":108}]},"107":{"id":107,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"Right now, the goal is getting Princess Vina back. We can discuss the particulars later.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":108}]},"108":{"id":108,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"I'm going to talk to the guards at the gates. See if I can find out more.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":175}]},"109":{"id":109,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":110}]},"110":{"id":110,"speaker":"Narrator","isPlayerChoice":false,"text":"He dashed out, leaving me alone with my mother.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.Reports_Turn08_PorteDrazon_GoldenGuardSearchesVina","op":"=","value":"true"}],"outgoingIds":[{"convId":415,"nodeId":111},{"convId":415,"nodeId":112},{"convId":415,"nodeId":113},{"convId":415,"nodeId":117}]},"111":{"id":111,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Pabel had a hand in this, didn't he? Where did he go?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":118}]},"112":{"id":112,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Seriously, Mother. Did you help her escape?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":120}]},"113":{"id":113,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":114},{"convId":415,"nodeId":115}]},"114":{"id":114,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn05_MurderInvest_SuspectEstela\"] == true","variablesRead":[{"var":"RiziaDLC.Turn05_MurderInvest_SuspectEstela","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":116}]},"115":{"id":115,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn05_MurderInvest_SuspectEstela\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn05_MurderInvest_SuspectEstela","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"116":{"id":116,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Tell me where she is, or I'll tell everyone you're a Dastnurist.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn05_MurderInvest_SuspectEstela\"] == true","variablesRead":[{"var":"RiziaDLC.Turn05_MurderInvest_SuspectEstela","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":121}]},"117":{"id":117,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What the hell am I supposed to do now?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":130}]},"118":{"id":118,"speaker":"Narrator","isPlayerChoice":false,"text":"My mother shrugged.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":119}]},"119":{"id":119,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Your butler knows every nook and cranny of this palace, including the secret passageways. If he played any role in her escape, he's long gone by now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":124}]},"120":{"id":120,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"How many times must I tell you? She was already gone when I came in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":124}]},"121":{"id":121,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Go on, then. I honestly don't know.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":129}]},"122":{"id":122,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"You could track her down. But she'll only try to escape again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":124}]},"123":{"id":123,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":62}]},"124":{"id":124,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":125},{"convId":415,"nodeId":126}]},"125":{"id":125,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":127}]},"126":{"id":126,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":128}]},"127":{"id":127,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Your real problem is telling the rest of the continent that Rizia's big royal wedding is off.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":144},{"convId":415,"nodeId":137},{"convId":415,"nodeId":148},{"convId":415,"nodeId":152},{"convId":415,"nodeId":139}]},"128":{"id":128,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Your real problem is explaining to the international press that the Kingdom of Rizia can't hold on to its princesses.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":142},{"convId":415,"nodeId":139},{"convId":415,"nodeId":143}]},"129":{"id":129,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"If she did drive off with that guard, they could have gone anywhere.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":124}]},"130":{"id":130,"speaker":"Narrator","isPlayerChoice":false,"text":"My mother shrugged.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":122}]},"131":{"id":131,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Shit. All that wartime sympathy, literally out the window.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":157}]},"132":{"id":132,"speaker":"Narrator","isPlayerChoice":false,"text":"There was pain in his eyes as he looked at me.","conditionsRaw":"Variable[\"RiziaDLC.Policy_Law_Homosexuality_Banned\"] == true  and  (Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true  or  Variable[\"RiziaDLC.Prologue_Relations_PabelFriend\"] == true)","variablesRead":[{"var":"RiziaDLC.Policy_Law_Homosexuality_Banned","op":"==","value":"true"},{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Relations_PabelFriend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":136}]},"133":{"id":133,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":134},{"convId":415,"nodeId":135}]},"134":{"id":134,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Law_Homosexuality_Banned\"] == true  and  (Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true  or  Variable[\"RiziaDLC.Prologue_Relations_PabelFriend\"] == true)","variablesRead":[{"var":"RiziaDLC.Policy_Law_Homosexuality_Banned","op":"==","value":"true"},{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Relations_PabelFriend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":132}]},"135":{"id":135,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Law_Homosexuality_Banned\"] == true  and  (Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true  or  Variable[\"RiziaDLC.Prologue_Relations_PabelFriend\"] == true)) == false","variablesRead":[{"var":"RiziaDLC.Policy_Law_Homosexuality_Banned","op":"==","value":"true"},{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Relations_PabelFriend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":123}]},"136":{"id":136,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"Good night, Romus. And good luck.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":123}]},"137":{"id":137,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This is just cold feet. She'll come back eventually.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":156}]},"138":{"id":138,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If Titus does manage to track her down, I'll have her beheaded.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":160}]},"139":{"id":139,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":140},{"convId":415,"nodeId":141}]},"140":{"id":140,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":138}]},"141":{"id":141,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"