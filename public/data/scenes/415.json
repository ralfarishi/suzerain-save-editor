ela Toras","isPlayerChoice":false,"text":"\"If she doesn't, it'll be the end of our family's line of succession.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":168}]},"157":{"id":157,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Not to mention our family's line of succession.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":168}]},"158":{"id":158,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"But perhaps that's a small price to pay for Her Highness' happiness.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":173}]},"159":{"id":159,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"It's too late now. You can consider this the end of our family's line of succession.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":168}]},"160":{"id":160,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"If you do, that'll be the end of your line of succession.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":161}]},"161":{"id":161,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":162},{"convId":415,"nodeId":163}]},"162":{"id":162,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Relations_Lucita_Together\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_Lucita_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":164}]},"163":{"id":163,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_Lucita_Together\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Relations_Lucita_Together","op":"==","value":"true"}],"var