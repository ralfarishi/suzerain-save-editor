5":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I still have the congratulatory cigar you gave me. You must have saved up for it for months.\"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Relations_PabelFriend\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Relations_PabelFriend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":53}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"All sparrows have to leave the nest sometime.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":50}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"I detected a slight nervous quiver in his voice.","conditionsRaw":"((Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false) and ((Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"},{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":55},{"convId":415,"nodeId":56},{"convId":415,"nodeId":57}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"From just down the hall, I heard the sound of barking. Bruno.","conditionsRaw":"((Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false) and (Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true)","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"},{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":55},{"convId":415,"nodeId":56},{"convId":415,"nodeId":57}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Huh. You were there?\"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Relations_PabelFriend\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Relations_PabelFriend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":54}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":51},{"convId":415,"nodeId":52}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":48}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":47}]},"53":{"id":53,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"Lespia's finest. The import taxes were horrendous.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":50}]},"54":{"id":54,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"I was serving just beneath the head butler at the time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":50}]},"55":{"id":55,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Was this really such an urgent matter?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":58}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I have to go.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":59}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Pabel, where is Vina?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":60}]},"58":{"id":58,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"No, I suppose it wasn't. Forgive me for wasting your time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":133}]},"59":{"id":59,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"Very well. I've gotten all your clothes ready for tomorrow.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":133}]},"60":{"id":60,"speaker":"Pabel Adria","isPlayerChoice":false,"text":"\"She's been in her room this entire time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":133}]},"61":{"id":61,"speaker":"Narrator","isPlayerChoice":false,"text":"I rushed back down the hallway to Vina's room. Bruno was standing there, barking in front of a wide-open door.","conditionsRaw":"(Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true) and ((Variable[\"RiziaDLC.Policy_Law_Homosexuality_Banned\"] == true  and  (Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true  or  Variable[\"RiziaDLC.Prologue_Relations_PabelFriend\"] == true)) == false)","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"},{"var":"RiziaDLC.Policy_Law_Homosexuality_Banned","op":"==","value":"true"},{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"},{"var":"RiziaDLC.Prologue_Relations_PabelFriend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":66}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":63},{"convId":415,"nodeId":64}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":415,"nodeId":61}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","condit