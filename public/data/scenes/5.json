n","isPlayerChoice":false,"text":"“We learned from it all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":5},{"convId":5,"nodeId":11}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"I opened the expensive bottle of whiskey and poured it in the two glasses I prepared. The exquisite smell filled the room immediately.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":23}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":true,"text":"“Yes, we did.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":2}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"“The future awaits, Petr.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":16}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":4,"nodeId":223}]},"14":{"id":14,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Maybe not. But thanks for the drink. This is really amazing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":13}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"“We could, but maybe we shouldn't.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":14}]},"16":{"id":16,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Toast.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":17}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr really seemed to be enjoying himself.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":19}]},"18":{"id":18,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Yeah, but we are different. All they did was enjoy the privilege.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":22},{"convId":5,"nodeId":8}]},"19":{"id":19,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“What a taste! This is how we should start all meetings, Anton.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":7},{"convId":5,"nodeId":15}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"He suddenly looked a bit anxious on his chair.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":4}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“Screw 1924. It is tainting this moment.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":16}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"“I hope it won't be the case for my cabinet.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":20}]},"23":{"id":23,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“The 1924? That was my freshman year. Also the year after the revolution. Very difficult times, to be honest, but this smells like heaven.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":5,"nodeId":12},{"convId":5,"nodeId":21}]}}}