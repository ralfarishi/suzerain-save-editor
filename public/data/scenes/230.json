nodeId":51}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"\"In a word, money. The USP has had a chokehold on the economy for too long. It's time to give Sordish businesses a chance to thrive.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":17}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"The moderator motioned for silence.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":13}]},"31":{"id":31,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"Spoken like a true puppet of the Oligarchs.\"","conditionsRaw":"(Variable[\"BaseGame.EconomicDirection_Nationalization\"] == true) == false","variablesRead":[{"var":"BaseGame.EconomicDirection_Nationalization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"32":{"id":32,"speaker":"Moderator","isPlayerChoice":false,"text":"\"What exactly does the People's Party have to offer that the USP did not?\"","conditionsRaw":"((Variable[\"BaseGame.NewParty_DemocratParty\"] == true) == false) and ((Variable[\"BaseGame.NewParty_LiberalParty\"] == true) == false) and ((Variable[\"BaseGame.NewParty_MaroonParty\"] == true) == false) and ((Variable[\"BaseGame.NewParty_SordishProsperityParty\"] == true) == false)","variablesRead":[{"var":"BaseGame.NewParty_DemocratParty","op":"==","value":"true"},{"var":"BaseGame.NewParty_LiberalParty","op":"==","value":"true"},{"var":"BaseGame.NewParty_MaroonParty","op":"==","value":"true"},{"var":"BaseGame.NewParty_SordishProsperityParty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":42},{"convId":230,"nodeId":29},{"convId":230,"nodeId":28},{"convId":230,"nodeId":20}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":34},{"convId":230,"nodeId":35