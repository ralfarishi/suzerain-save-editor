Isolated.Debate_Enable_RemusHolstron\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":58}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":59}]},"58":{"id":58,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Your allegiances show where your petty priorities lie. This is not about the rise of the Sordish people but your own individual ego, Rayne.\"","conditionsRaw":"((Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true) == false) and (Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] == true)","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"},{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":62},{"convId":230,"nodeId":60},{"convId":230,"nodeId":61},{"convId":230,"nodeId":63}]},"59":{"id":59,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"Ah, so you eliminated the NFP leadership so you could take on its values for yourself.\"","conditionsRaw":"((Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true) == false) and ((Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] == true) == false)","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"},{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":62},{"convId":230,"nodeId":60},{"convId":230,"nodeId":61}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"\"I can be proud of my country without being a bigot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":115}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"\"The NFP doesn't think big enough. My party will crush all of Sordland's enemies.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":127}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"\"To be honest, I just plain don't like the NFP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":115}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm prepared to ally with the NFP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":110}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"\"I liked Soll's ideas. Not the man himself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":135}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"\"Not after the way I was betrayed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":136}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"\"No. It's time to take his ideas and bring them into our modern age.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":137}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"\"Honestly, I just couldn't stomach the thought of you as president.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":138}]},"68":{"id":68,"speaker":"Player","isPlayerChoice":true,"text":"\"Soll betrayed his own ideals. He had to go.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":135}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":70},{"convId":230,"nodeId":71}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":75}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":72}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":73},{"convId":230,"nodeId":74}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_ManolySuheil\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_ManolySuheil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":76}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_ManolySuheil\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_ManolySuheil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":77}]},"75":{"id":75,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"If you really wanted Sordland to have a chance at democracy, you would have endorsed the PFJP after your Congress loss.\"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":81},{"convId":230,"nodeId":80},{"convId":230,"nodeId":78},{"convId":230,"nodeId":79}]},"76":{"id":76,"speaker":"Manoly Suheil","isPlayerChoice":false,"text":"\"If you really wanted Sordland to have a chance at democracy, you would have endorsed the PFJP after your Congress loss.\"","conditionsRaw":"((Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false) and (Variable[\"BaseGameIsolated.Debate_Enable_ManolySuheil\"] == true)","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"},{"var":"BaseGameIsolated.Debate_Enable_ManolySuheil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":81},{"convId":230,"nodeId":80},{"convId":230,"nodeId":78},{"convId":230,"nodeId":79}]},"77":{"id":77,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"Ah, so you eliminated the PFJP leadership so you could take on its values for yourself.\"","conditionsRaw":"((Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false) and ((Variable[\"BaseGameIsolated.Debate_Enable_ManolySuheil\"] == true) == false)","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"},{"var":"BaseGameIsolated.Debate_Enable_ManolySuheil","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":81},{"convId":230,"nodeId":80},{"convId":230,"nodeId":78}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"\"To be honest, I just plain don't like the PFJP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":109}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm prepared to ally with the PFJP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":96}]},"80":{"id":80,"speaker":"Player","isPlayerChoice":true,"text":"\"No, the PFJP is too capitalist for my tastes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":101}]},"81":{"id":81,"speaker":"Player","isPlayerChoice":true,"text":"\"The PFJP is too globalist for me. I want to keep the focus on Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":101}]},"82":{"id":82,"speaker":"Player","isPlayerChoice":true,"text":"\"The USP cannot admit that Malenyev had the right idea. My party will finally bring communism to Sordland:\"","conditionsRaw":"((Variable[\"BaseGame.Archetype_SollistRayne\"] == true  or  Variable[\"BaseGame.Turn08_Action_Party_Ultranationalist\"] == true) == false) and ((Variable[\"BaseGame.Archetype_DemocraticRayne\"] == true) == false) and (Variable[\"BaseGame.Archetype_ComradeRayne\"] == true)","variablesRead":[{"var":"BaseGame.Archetype_SollistRayne","op":"==","value":"true"},{"var":"BaseGame.Turn08_Action_Party_Ultranationalist","op":"==","value":"true"},{"var":"BaseGame.Archetype_DemocraticRayne","op":"==","value":"true"},{"var":"BaseGame.Archetype_ComradeRayne","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":83}]},"83":{"id":83,"speaker":"Denis Stahler","isPlayerChoice":false,"text":"\"Any true communist would have joined the Communist Party. You're in this for yourself, President Rayne.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":87},{"convId":230,"nodeId":86},{"convId":230,"nodeId":85},{"convId":230,"nodeId":84}]},"84":{"id":84,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm prepared to ally with the Communist Party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":93}]},"85":{"id":85,"speaker":"Player","isPlayerChoice":true,"text":"\"To be honest, I just plain don't like the Communist Party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":95}]},"86":{"id":86,"speaker":"Player","isPlayerChoice":true,"text":"\"Your party is too radical, Stahler. I'm willing to make compromises to achieve our goals.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":95}]},"87":{"id":87,"speaker":"Player","isPlayerChoice":true,"text":"\"Any true communist would not have gone against Leon Malenyev.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":94}]},"88":{"id":88,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"No, you founded it because you could not admit you had lost.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":89},{"convId":230,"nodeId":90},{"convId":230,"nodeId":91},{"convId":230,"nodeId":92}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm so happy I don't have to put up with another four years of you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":121}]},"90":{"id":90,"speaker":"Player","isPlayerChoice":true,"text":"\"I still respect you, Lileas. I had hoped we could settle this like adults.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":122}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"\"I was happy to lose. It gave me the excuse to do what I'd wanted to for years.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":121}]},"92":{"id":92,"speaker":"Player","isPlayerChoice":true,"text":"\"That was the initial reason, yes. But I've had time to develop my platform.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":122}]},"93":{"id":93,"speaker":"Denis Stahler","isPlayerChoice":false,"text":"\"That doesn't change the fact that--\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"94":{"id":94,"speaker":"Denis Stahler","isPlayerChoice":false,"text":"\"But if you really pay attention to what Marcia said--\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"95":{"id":95,"speaker":"Denis Stahler","isPlayerChoice":false,"text":"\"Then you've just lost yourself an ally. In fact--\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":97},{"convId":230,"nodeId":98}]},"97":{"id":97,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":99}]},"98":{"id":98,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":100}]},"99":{"id":99,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Not now. It's too risky.\"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"100":{"id":100,"speaker":"Manoly Suheil","isPlayerChoice":false,"text":"\"Never. Not after what happened to--\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"101":{"id":101,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":102},{"convId":230,"nodeId":103}]},"102":{"id":102,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":104}]},"103":{"id":103,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":106}]},"104":{"id":104,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Fair enough. There's room in the Assembly for both our parties. In fact--\"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"105":{"id":105,"speaker":"Manoly Suheil","isPlayerChoice":false,"text":"\"Fair enough. There's room in the Assembly for both our parties. In fact--\"","conditionsRaw":"((Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false) and (Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true)","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"106":{"id":106,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":107},{"convId":230,"nodeId":108}]},"107":{"id":107,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":105}]},"108":{"id":108,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":109}]},"109":{"id":109,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"At last, something we agree on.\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_FrensRicter\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_FrensRicter","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"110":{"id":110,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":111},{"convId":230,"nodeId":112}]},"111":{"id":111,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":113}]},"112":{"id":112,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":114}]},"113":{"id":113,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Not now. It's too risky.\"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"114":{"id":114,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Never. Not after what happened to--\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"115":{"id":115,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":116},{"convId":230,"nodeId":117}]},"116":{"id":116,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":124}]},"117":{"id":117,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":118}]},"118":{"id":118,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":119},{"convId":230,"nodeId":120}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":123}]},"120":{"id":120,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":125}]},"121":{"id":121,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"I'm going to enjoy crushing you at the polls.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"122":{"id":122,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"You were such a bright boy, President Rayne. What happened?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"123":{"id":123,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Come over here and say that to my face. I doubt that you have the same will as we do.\"","conditionsRaw":"((Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true) == false) and (Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] == true)","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"},{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"124":{"id":124,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Such crude language, Mr. President.\"","conditionsRaw":"Variable[\"BaseGameIsolated.Debate_Enable_KesaroKibener\"] == true","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_KesaroKibener","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":30}]},"125":{"id":125,"speaker":"L