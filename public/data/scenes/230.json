nvId":230,"nodeId":29},{"convId":230,"nodeId":28},{"convId":230,"nodeId":20}]},"22":{"id":22,"speaker":"Moderator","isPlayerChoice":false,"text":"\"What exactly does the Liberal Party have to offer that the USP did not?\"","conditionsRaw":"((Variable[\"BaseGame.NewParty_DemocratParty\"] == true) == false) and (Variable[\"BaseGame.NewParty_LiberalParty\"] == true)","variablesRead":[{"var":"BaseGame.NewParty_DemocratParty","op":"==","value":"true"},{"var":"BaseGame.NewParty_LiberalParty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":42},{"convId":230,"nodeId":29},{"convId":230,"nodeId":28},{"convId":230,"nodeId":20}]},"23":{"id":23,"speaker":"Moderator","isPlayerChoice":false,"text":"\"What exactly does the Maroon Party have to offer that the USP did not?\"","conditionsRaw":"((Variable[\"BaseGame.NewParty_DemocratParty\"] == true) == false) and ((Variable[\"BaseGame.NewParty_LiberalParty\"] == true) == false) and (Variable[\"BaseGame.NewParty_MaroonParty\"] == true)","variablesRead":[{"var":"BaseGame.NewParty_DemocratParty","op":"==","value":"true"},{"var":"BaseGame.NewParty_LiberalParty","op":"==","value":"true"},{"var":"BaseGame.NewParty_MaroonParty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":42},{"convId":230,"nodeId":29},{"convId":230,"nodeId":28},{"convId":230,"nodeId":20}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":230,"nodeId":3}]},"25":{"id":25,"speaker":"Moderator","isPlayerChoice":false,"text":"\"What exactly does the Sordish Prosperity Party have to offer that the USP did not?\"","conditionsRaw":"((Variable[\"BaseGame.NewParty_DemocratParty\"] == true) == false) and ((Variable[\"BaseGame.NewParty_LiberalParty\"] == true) == false) and ((Variable[\"BaseGame.NewParty_MaroonParty\"] == true) == false) and (Variable[\"BaseGame.NewParty_SordishProsperityPart