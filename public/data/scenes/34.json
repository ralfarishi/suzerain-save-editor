Game.Reform_EmergencyDecree_Embargo_UC\"] == true) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true  or  Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Rumburg\"] == true  or  \nVariable[\"BaseGame.Reform_EmergencyDecree_Embargo_UC\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Rumburg","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_UC","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn03_EmergencyDecree_Autocrat","op":"=","value":"true"},{"var":"BaseGame.Policy_Law_Ban_WPB","op":"=","value":"true"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] + 2"},{"var":"BaseGame.Democratic","op":"=","value":"Variable[\"BaseGame.Democratic\"] - 2"},{"var":"BaseGame.Policy_Law_Ban_RedYouth","op":"=","value":"true"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] - 2"},{"var":"BaseGame.Policy_Law_Ban_YoungSords","op":"=","value":"true"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 2"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] - 2"},{"var":"BaseGame.Policy_Law_EmergencyDecree","op":"=","value":"true"},{"var":"BaseGame.Faction_OldGuard_Content","op":"=","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_None","op":"=","value":"true"}],"outgoingIds":[{"convId":34,"nodeId":3}]},"5":{"id":5,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Looks like the only thing left is to sign and declare the order, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":7}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian spoke afterwards.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":5}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":8},{"convId":34,"nodeId":9}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":10}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":14}]},"10":{"id":10,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But I am afraid that this will create further problems for our administration.\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":11}]},"11":{"id":11,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Especially by declaring the Bludish separatists a threat, we should expect more violence against Bludish citizens in general.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":12}]},"12":{"id":12,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"What are you worried about? They are a national security threat.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":13}]},"13":{"id":13,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"We can't allow Bludish people to support terrorist organizations. They should have known better.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":14}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":15},{"convId":34,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":20}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":23}]},"17":{"id":17,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I agree with declaring the Young Sords as a threat, especially after the shooting. However, I think we might bring the nationalists wrath upon ourselves.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":18}]},"18":{"id":18,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"I believe Mr. Kibener may have connections to that organization.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":19}]},"19":{"id":19,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Although I have no problems with him, this should prompt a proper investigation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":21},{"convId":34,"nodeId":22}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian looked at the decree again.","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false) and (Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":17}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"\"I agree. Anyone who have any connections to them should be investigated.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":24}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"\"Maybe we can leave Mr. Kibener alone for now and keep it on the organization level.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":24}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian looked at the decree again.","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":24}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":25},{"convId":34,"nodeId":26}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":32}]},"27":{"id":27,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Mr. President. We have to be careful with the situation we're creating here.\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":28}]},"28":{"id":28,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Our actions against Arcasia will not be received lightly. Angering a superpower will be tough on our economy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":30},{"convId":34,"nodeId":29},{"convId":34,"nodeId":31}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"\"We'll no longer bow to them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":32}]},"30":{"id":30,"speaker":"Player","isPlayerChoice":true,"text":"\"We will take the proper precautions.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":32}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"\"I am aware, Lucian.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":32}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":33},{"convId":34,"nodeId":34}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_UC\"] == true  and  Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"]","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_UC","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":36}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_UC\"] == true  and  Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"]) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_UC","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":46}]},"35":{"id":35,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Going against United Contana and banning the Red Youth will definitely make us an enemy of the Contanan Security Pact.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":37}]},"36":{"id":36,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"What's important here is that we're taking the steps to fight against the communists.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false) and (Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_UC\"] == true  and  Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"])","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_UC","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":35}]},"37":{"id":37,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We can't take this lightly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":38}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":39},{"convId":34,"nodeId":40}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":43}]},"41":{"id":41,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But we're also acting against Arcasia, Mr. President. We'll need them against the Eastern powers.\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":42}]},"42":{"id":42,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"I believe that was a difficult decision to make but Sordland stands alone, Mr. Galade, you know that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":52}]},"43":{"id":43,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"As much as I despise Arcasia and have a reason to believe that they're behind all this mess...\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":44}]},"44":{"id":44,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Mr. President decided not to act against them. If things comes to the worst, we'll have their protection, Mr. Galade.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":45}]},"45":{"id":45,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"There's no reason to be afraid of those communists...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":52}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":47},{"convId":34,"nodeId":48}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":49}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":56}]},"49":{"id":49,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"With the order of this decree, we would be able to detain anybody who is suspected for a crime.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_UC\"] == true  and  Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"]) == false) and (Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_UC","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":50}]},"50":{"id":50,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"I will personally lead an investigation against Mr. Ricter. As soon as any other leads come up...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":51}]},"51":{"id":51,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"...We'll be able to get rid of him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":55},{"convId":34,"nodeId":54},{"convId":34,"nodeId":53}]},"52":{"id":52,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Let's instead focus on what we will be doing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":46}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"\"Don't get carried away, he's not our main target.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":59}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes, we must focus on the opposition.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":56}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm looking forward to that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":56}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":57},{"convId":34,"nodeId":58}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_PoliceAuthority\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_PoliceAuthority","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":60}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_PoliceAuthority\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_PoliceAuthority","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":61}]},"59":{"id":59,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Whatever you say, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":56}]},"60":{"id":60,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Luckily, the police will have the authority to deal with the threats now.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_UC\"] == true  and  Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"]) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true) == false) and (Variable[\"BaseGame.Reform_EmergencyDecree_PoliceAuthority\"] == true)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_UC","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_PoliceAuthority","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":62}]},"61":{"id":61,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"But I still do not think that the police has the necessary powers to eliminate the threats effectively.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_UC\"] == true  and  Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"]) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_PoliceAuthority\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_UC","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_PoliceAuthority","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":67}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":63},{"convId":34,"nodeId":64}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":65}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":69}]},"65":{"id":65,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Well, I think suspension of protests and gathering of crowds will be very tough on the budget of the police.\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":66}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And the people will not like this. Especially the reformists.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":68}]},"67":{"id":67,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"I hope the precautions will prove to be enough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":62}]},"68":{"id":68,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"That's precisely who we are against, Mr. Galade.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":69}]},"69":{"id":69,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In any case...\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":70}]},"70":{"id":70,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"What's left to do is to declare the emergency and get it accepted in the Supreme Court, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":71}]},"71":{"id":71,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We should plan your speech for the declaration. This will be a big moment for Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":73}]},"72":{"id":72,"speaker":"Narrator","isPlayerChoice":false,"text":"We all shook hands and they left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":88}]},"73":{"id":73,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"I'll be in touch, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":74}]},"74":{"id":74,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"The Supreme Court will be waiting for the declaration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":75},{"convId":34,"nodeId":76},{"convId":34,"nodeId":77},{"convId":34,"nodeId":78}]},"75":{"id":75,"speaker":"Player","isPlayerChoice":true,"text":"\"I expect the Court to fulfil their promise.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":80}]},"76":{"id":76,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's get to work gentlemen.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":72}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you for all the hard work.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":72}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"\"A new era begins.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":79}]},"79":{"id":79,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It seems so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":72}]},"80":{"id":80,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Of course, Mr. President. We are workin