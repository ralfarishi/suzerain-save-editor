{"conversationId":325,"title":"Rizia/Turn 5/Notes","storyPack":"StoryPack_Rizia","turn":5,"turnLabel":"Turn 5","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"We should look into expanding social programs for our new arrivals.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":4}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":5},{"convId":325,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] >= 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":14}]},"7":{"id":7,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"I agree. I have no doubt that will have a positive impact on the situation.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":12}]},"8":{"id":8,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Yes. However, while such a proposal may offer some relief, I still don't believe it gets to the heart of what driving the conflict.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":10},{"convId":325,"nodeId":9},{"convId":325,"nodeId":11}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I understand your concern, but the name of the game here is compromise. We don't want to do anything that will rock the boat too drastically.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":18}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've made my decision.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":19}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I disagree. History has shown that the smallest of actions can create profound positive change.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":20}]},"12":{"id":12,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"In addition, such social programs will help reduce the financial burden placed on migrants, and reduce the prevalence of underground, illicit activities.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":35},{"convId":325,"nodeId":33},{"convId":325,"nodeId":36}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Resources_Budget","op":"=","value":"Variable[\"RiziaDLC.Resources_Budget\"] - 1"},{"var":"RiziaDLC.Turn05_Security_ReducePolicePresence","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn05_Security_IzaExpandSocialPrograms","op":"=","value":"true"}],"outgoingIds":[]},"14":{"id":14,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"I agree with you. It's sure to have a positive impact on the situation.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] >= 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":15}]},"15":{"id":15,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It might, however, we don't have the funds to support such an endeavor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":16}]},"16":{"id":16,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Another approach may be in order.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"17":{"id":17,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"\"Language courses and cultural integration programs to help migrants adapt to their new environment might also be beneficial.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn03_Security_TitusLeadsInvestigation\"] == true","variablesRead":[{"var":"RiziaDLC.Turn03_Security_TitusLeadsInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":8}]},"18":{"id":18,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"Is there a particular program you wish to focus on? Keep in mind, our budget is limited.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":21},{"convId":325,"nodeId":23},{"convId":325,"nodeId":22},{"convId":325,"nodeId":24}]},"19":{"id":19,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"Is there a specific program you'd like to prioritize? Please remember, we have budget constraints.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":21},{"convId":325,"nodeId":23},{"convId":325,"nodeId":22},{"convId":325,"nodeId":24}]},"20":{"id":20,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"Is there a particular program you'd like to single out? Let's keep in mind our budget limitations.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":21},{"convId":325,"nodeId":23},{"convId":325,"nodeId":22},{"convId":325,"nodeId":24}]},"21":{"id":21,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let's prioritize a food program.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":25}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let's prioritize language courses.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":27}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let's prioritize employment support.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":26}]},"24":{"id":24,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let's prioritize cultural integration programs.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":28}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn05_Decision_IzaSocialProgram_FoodProgram","op":"=","value":"true"}],"outgoingIds":[{"convId":325,"nodeId":13}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn05_Decision_IzaSocialProgram_EmploymentSupport","op":"=","value":"true"}],"outgoingIds":[{"convId":325,"nodeId":13}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn05_Decision_IzaSocialProgram_LanguageCourses","op":"=","value":"true"}],"outgoingIds":[{"convId":325,"nodeId":13}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn05_Decision_IzaSocialProgram_CulturalIntegration","op":"=","value":"true"}],"outgoingIds":[{"convId":325,"nodeId":13}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":30},{"convId":325,"nodeId":31}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn03_Security_TitusLeadsInvestigation\"] == true","variablesRead":[{"var":"RiziaDLC.Turn03_Security_TitusLeadsInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":17}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn03_Security_TitusLeadsInvestigation\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn03_Security_TitusLeadsInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":32}]},"32":{"id":32,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"And language courses and cultural integration programs to help migrants adapt to their new environment could also be beneficial.\"","conditionsRaw":"(Variable[\"RiziaDLC.Turn03_Security_TitusLeadsInvestigation\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn03_Security_TitusLeadsInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":8}]},"33":{"id":33,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Such as?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":34}]},"34":{"id":34,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"Providing food assistance and meal programs for migrants who may face economic challenges, for one.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":37}]},"35":{"id":35,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What specifically?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":34}]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What sort of programs were you thinking?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":34}]},"37":{"id":37,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"Assisting migrants in finding and retaining employment, including resume building and interview training, is another.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":325,"nodeId":29}]}}}