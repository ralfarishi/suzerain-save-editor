],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":110}]},"116":{"id":116,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true  and  Variable[\"BaseGame.Decision_Turn03_StabilityOrder_BanYoungSords\"] == true) == false","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn03_StabilityOrder_BanYoungSords","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":111}]},"117":{"id":117,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn03_ST_OldRYBansYoungSords","op":"=","value":"true"}],"outgoingIds":[{"convId":30,"nodeId":105}]},"118":{"id":118,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":119},{"convId":30,"nodeId":120}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":121}]},"120":{"id":120,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":130}]},"121":{"id":121,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Nia_Opposition","op":"=","value":"true"}],"outgoingIds":[{"convId":30,"nodeId":122}]},"122":{"id":122,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Proceed all you like. I am not behind this.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Relations_Nia_Opposition","op":"=","value":"true"}],"outgoingIds":[{"convId":30,"nodeId":125},{"convId":30,"nodeId":124},{"convId":30,"nodeId":123}]},"123":{"id":123,"speaker":"Player","isPlayerChoice":true,"text":"\"Aren't you changing your mind too quickly?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":126}]},"124":{"id":124,"speaker":"Player","isPlayerChoice":true,"text":"\"It's fine. We'll figure something out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":127}]},"125":{"id":125,"speaker":"Player","isPlayerChoice":true,"text":"\"We need you, Mrs. Morgna. Don't be like that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":128}]},"126":{"id":126,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You already knew about my position, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":129}]},"127":{"id":127,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I doubt that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":129}]},"128":{"id":128,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You should have listened to my advice, Mr. President...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":129}]},"129":{"id":129,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Let's figure this out later, ladies and gentlemen. The president has already made his decision. Let's move on.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":78}]},"130":{"id":130,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I will personally work on the wording of this proposal with my hand-picked legal experts.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":132}]},"131":{"id":131,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"In the meantime, you must introduce this proposal to our party. You will need to get them to back us if we want it to pass the assembly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":133}]},"132":{"id":132,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"With Ms. Morgna's reputation as the most experienced attorney, this proposal will be bulletproof. Chief Justice Orso will have a hard time convincing others to oppose it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":131}]},"133":{"id":133,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Sir, I advise you to first talk to the leaders of both conservative and reformist wings of the party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":81}]},"134":{"id":134,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Law_Veto_Default","op":"=","value":"false"}],"outgoingIds":[{"convId":30,"nodeId":4}]}}}