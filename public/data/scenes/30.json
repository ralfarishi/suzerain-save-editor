{"conversationId":30,"title":"Sordland/Turn03/Reformist Post Discussion","storyPack":"StoryPack_Main","turn":3,"turnLabel":"Turn 3","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":99}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":29,"nodeId":160}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"They read the changes and discussed it amongst themselves.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":21}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"After I made the final changes for the proposal, I showed it to my team.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn03_ReformPackage_Reformist","op":"=","value":"true"},{"var":"BaseGame.Reform_Law_Veto_Default","op":"=","value":"false"}],"outgoingIds":[{"convId":30,"nodeId":3}]},"5":{"id":5,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Looks like the amendments are ready to be proposed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":6}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":7},{"convId":30,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","