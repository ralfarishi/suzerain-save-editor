w":"(Variable[\"BaseGame.Reform_Law_Threshold_3\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_8\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Threshold_3","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_8","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":22}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":16},{"convId":30,"nodeId":17}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":51}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":18}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":19},{"convId":30,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":58}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":72}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian spoke afterwards.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":5}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":23},{"convId":30,"nodeId":24}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":34}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":44}]},"25":{"id":25,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Mr. President, I understand that you're trying to save your skin by giving absolute immunity to presidents but isn't that going a bit too far?\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":26}]},"26":{"id":26,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"That contradicts the whole package. If this doesn't pass, it will be on you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":27},{"convId":30,"nodeId":28},{"convId":30,"nodeId":29}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"Have a little faith, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":31}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"\"I appreciate your comments but the decision is made.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":31}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"\"I will be the target of the Supreme Court, I need this protection.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":30}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Mr. Rayne is not wrong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":12}]},"31":{"id":31,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I will be doing my part, Mr. President, don't think I won't. But I had to clarify my position.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":12}]},"32":{"id":32,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But I have to say this too...\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true) == false) and (Variable[\"BaseGame.Reform_Law_Threshold_3\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_8\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_3","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_8","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":33}]},"33":{"id":33,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"The new electoral threshold will be really difficult for the party to accept. Our guys are not fond of that idea.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":37}]},"34":{"id":34,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But I have to say this too...\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Threshold_3\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_8\"] == true) == false) and (Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_3","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_8","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":35}]},"35":{"id":35,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Not reforming the minister laws will be frowned upon by the party. The Assembly members have insisted on getting involved in the process.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":36}]},"36":{"id":36,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That's true. It will be tough to get all of their support. Some of our members may try to openly fight against this.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":43},{"convId":30,"nodeId":42},{"convId":30,"nodeId":41}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":38},{"convId":30,"nodeId":39}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":40}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":36}]},"40":{"id":40,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Not reforming the minister laws will also be frowned upon by the party. The Assembly members have insisted on getting involved in the process.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":36}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm prepared to reconsider if it comes to that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":45}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"I will make sure the party follows me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":45}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"\"We'll figure it out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":45}]},"44":{"id":44,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Any comments before we proceed?\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Impeachment_Removed\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Threshold_3\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_8\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Law_Impeachment_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_3","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_8","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":9}]},"45":{"id":45,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We will all do our best to make it work, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":46}]},"46":{"id":46,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Any other comments before we proceed?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":9}]},"47":{"id":47,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I will say that I do not agree with the new law that gives the Assembly the power to impeach the Judges of the Supreme Court.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":48}]},"48":{"id":48,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I am also against the Chief Justice and his obstructionist behaviour, but even if we get rid of all of them, the new Judges will be less independent with this law. They will be scared to go against the administration when it's needed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":49}]},"49":{"id":49,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"They need their protection to do their job. Otherwise the new ones will be pawns just like Soll's Old Guards.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":50}]},"50":{"id":50,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But it's more important that we get rid of the Old Guards, Mrs. Morgna. After the obstacles are gone, we can strive to make it better.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":53}]},"51":{"id":51,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I will say that I do not agree with the changes to the Member of Honor law. I see that you're trying hard to get immunity and save your skin after your term, Mr. President.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true) == false) and (Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":52}]},"52":{"id":52,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"This law should have been abolished. It was made to protect Soll and now you're trying to give this to every president. This conflicts with our idea of 'democratic reforms', sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":61},{"convId":30,"nodeId":62},{"convId":30,"nodeId":63}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":54},{"convId":30,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":56}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":60}]},"56":{"id":56,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"What about the changes to the Member of Honor law? I see that the President is trying very hard to get immunity and save his skin after his term.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":57}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":52}]},"58":{"id":58,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I think I gotta say that removing the decrees was not the best choice.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false) and (Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":59}]},"59":{"id":59,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"It will significantly reduce the powers of the president, especially in case of crises.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":69}]},"60":{"id":60,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"However...\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":69}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"\"As I said, I will have a target on my back, I need the immunity.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":64}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"\"You're reading too much into it, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":64}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"\"It seems we must learn to disagree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":64}]},"64":{"id":64,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked a little angry.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":65}]},"65":{"id":65,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":66},{"convId":30,"nodeId":67}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":68}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":77}]},"68":{"id":68,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Before we finish...\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":58}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":70}]},"70":{"id":70,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"You have to be careful, Anton. I'm sure you will be fine, but with all that's happening out there, we'll need to prepare against these threats one way or the other.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":76},{"convId":30,"nodeId":74},{"convId":30,"nodeId":75}]},"71":{"id":71,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Looks like we can proceed immediately.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":118}]},"72":{"id":72,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I don't think I have any problems with the changes.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Honorary_Presidents\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Honorary_Presidents","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":73}]},"73":{"id":73,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Me neither.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":71}]},"74":{"id":74,"speaker":"Player","isPlayerChoice":true,"text":"\"I appreciate the feedback, Petr.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":77}]},"75":{"id":75,"speaker":"Player","isPlayerChoice":true,"text":"\"The constitution hasn't changed yet. We'll prepare until then.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":77}]},"76":{"id":76,"speaker":"Player","isPlayerChoice":true,"text":"\"I am aware.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":77}]},"77":{"id":77,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Well, I think we can proceed now.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":118}]},"78":{"id":78,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We will be working on the wording of the proposal closely with our legal experts before we propose it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":79}]},"79":{"id":79,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In the meantime, you must introduce this proposal to our party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":80}]},"80":{"id":80,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You'll need to give a strong speech to get them behind you. But I advise you to first talk to the leaders of both conservative and reformist wings of the party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":81}]},"81":{"id":81,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"As far as I'm aware, Mr. Clavin supports the reforms already. Mrs. Tory will be the real problem. She became the real heavy-weight after we left for the executive.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":84},{"convId":30,"nodeId":83},{"convId":30,"nodeId":82}]},"82":{"id":82,"speaker":"Player","isPlayerChoice":true,"text":"\"I will handle them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":90}]},"83":{"id":83,"speaker":"Player","isPlayerChoice":true,"text":"\"Any advice for the speech?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":88}]},"84":{"id":84,"speaker":"Player","isPlayerChoice":true,"text":"\"Any advice in regards to dealing with them?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":85}]},"85":{"id":85,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As Mr. Vectern said, Mr. Clavin will probably be easier to persuade. We need to unite the party under this, so his support is vital.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":86}]},"86":{"id":86,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Mrs. Gloria will be tougher to break. The problem is that she's capable of turning the moderates and the conservatives against us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":87}]},"87":{"id":87,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As much as I don't want to say this, if she makes demands to change the proposal, you may need to give in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":92},{"convId":30,"nodeId":94},{"convId":30,"nodeId":93}]},"88":{"id":88,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Sir, you are pretty well-versed in speeches. You know the party. Just make sure you get them hyped up about the reforms.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":89}]},"89":{"id":89,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And don't show any weakness. You must also be prepared to reconsider the proposal if it comes to that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":92},{"convId":30,"nodeId":94},{"convId":30,"nodeId":93}]},"90":{"id":90,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":91}]},"91":{"id":91,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Don't show any weakness, sir. And be prepared to reconsider the proposal if it comes to that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":92},{"convId":30,"nodeId":94},{"convId":30,"nodeId":93}]},"92":{"id":92,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks for the advice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":96}]},"93":{"id":93,"speaker":"Player","isPlayerChoice":true,"text":"\"I will not give in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":96}]},"94":{"id":94,"speaker":"Player","isPlayerChoice":true,"text":"\"Understood.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":96}]},"95":{"id":95,"speaker":"Narrator","isPlayerChoice":false,"text":"We all shook hands and they left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":101}]},"96":{"id":96,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Wish you good luck with the party, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":97}]},"97":{"id":97,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think we can end the meeting here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":30,"nodeId":95}]},"98":{"id":98,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":