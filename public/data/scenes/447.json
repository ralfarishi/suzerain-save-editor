{"conversationId":447,"title":"Rizia/Turn 9/Religous Meeting Notes","storyPack":"StoryPack_Rizia","turn":9,"turnLabel":"Turn 9","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Firstly, I believe it pertinent that if we're to cement Rizian Wruhecistic principles, the role of Grand Vizier should be given to a religious figurehead -- myself, specifically.\"","conditionsRaw":"(Variable[\"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":103}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":5},{"convId":447,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Council_GrandVizier_Empty\"] == true","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Council_GrandVizier_Empty\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":21}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I know the position has opened up recently. But I have other candidates in mind.\"","conditionsRaw":"Variable[\"RiziaDLC.Council_GrandVizier_Empty\"] == true","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":92}]},"8":{"id":8,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Firstly, as I mentioned the night of the Alignment of the Six Stars, I believe it pertinent that if we're to cement Rizian Wruhecistic principles, the role of Grand Vizier should be given to a religious figurehead -- myself, specifically.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist\"] == true","variablesRead":[{"var":"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":4},{"convId":447,"nodeId":20},{"convId":447,"nodeId":22},{"convId":447,"nodeId":103}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":10},{"convId":447,"nodeId":11}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist\"] == true","variablesRead":[{"var":"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":8}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn06_Briefing_Religion_LeaningWruhecist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":3}]},"12":{"id":12,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"This will not only strengthen the bond between the monarchy and the divine but also foster a sense of righteousness and unity among our people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":13}]},"13":{"id":13,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Furthermore, as a religious leader, I offer a profound comprehension of spiritual affairs and can provide invaluable guidance on both state and soul, guaranteeing the prosperity of our realm not just in worldly affairs but also in matters of the spirit.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":15}]},"14":{"id":14,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"My second proposal, in addition to the newly assigned duties given to the Wruhec's Guardians, is that they should take over the responsibilities currently bestowed upon the Golden Guard.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy\"] == true","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"false"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"=","value":"false"}],"outgoingIds":[{"convId":447,"nodeId":18}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":16},{"convId":447,"nodeId":17}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy\"] == true","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":14}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":97}]},"18":{"id":18,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"The Guardians, much like myself, would uphold the kingdom's laws with unwavering devotion to the divine principles of Wruhecism. They'd ensure justice free from personal bias or political motivations.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":19}]},"19":{"id":19,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Their extensive spiritual training and commitment to ethical conduct make them ideal for handling sensitive matters that require both discretion and moral integrity. I'd argue they would be more effective than the Golden Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":122}]},"20":{"id":20,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, I remember. You'll be pleased to know I'm still open to such a proposal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":23}]},"21":{"id":21,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I said it before and I'll say it again... I'm not replacing Hugo. What's your other idea?\"","conditionsRaw":"(Variable[\"RiziaDLC.Council_GrandVizier_Empty\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":92}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Oh, yes. Right. You as Grand Vizier. What were you saying about that?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":91}]},"23":{"id":23,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I *am* pleased to hear it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":12}]},"24":{"id":24,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I'm very pleased you think so. And speaking of shakeups, I believe the royal council could be in line for such a change.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":108}]},"25":{"id":25,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Such a replacement, comprised of priests and clerics, would ensure that decisions align closely with divine principles.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":26}]},"26":{"id":26,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Such a council would guide the kingdom toward a more faith-based governance, where moral integrity and spiritual guidance shape every aspect of our rule.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":27}]},"27":{"id":27,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"This change would move us towards establishing a government guided by spiritual principles, where divine law reigns supreme.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":29}]},"28":{"id":28,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Which brings me to my final proposal, this time involving the royal council.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":43}]},"29":{"id":29,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"So what do you say, Your Majesty, will you take my hand and embark on this righteous journey to establish God's heavenly kingdom on earth?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":35}]},"30":{"id":30,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Well, if we're talking about the role of Grand Vizier, consider the job yours.\" [Appoint Grand Vizier]","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":41}]},"31":{"id":31,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I have no intention of supplanting Hugo for you.\"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":39}]},"32":{"id":32,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"That's wonderful! It's heartening to know that we share the same vision and goals for the kingdom's future.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":33}]},"33":{"id":33,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"And speaking of visions, that brings me to the last topic I wanted to discuss... the royal council.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":108}]},"34":{"id":34,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm open to taking such a journey, however, when it comes to replacing Hugo, as I previously said, that's a no-go.\"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":39}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":36},{"convId":447,"nodeId":37}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":38}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":30},{"convId":447,"nodeId":31},{"convId":447,"nodeId":83},{"convId":447,"nodeId":34}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You already know my answer regarding the Grand Vizier position. It's yours.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":90}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"=","value":"false"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"false"}],"outgoingIds":[{"convId":447,"nodeId":40}]},"40":{"id":40,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I'm sorry to hear that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"=","value":"false"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"false"}],"outgoingIds":[{"convId":447,"nodeId":48}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":42}]},"42":{"id":42,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Excellent! You have no idea how much this means for me, and for Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":48}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_ReplaceGoldenGuards","op":"=","value":"false"}],"outgoingIds":[{"convId":447,"nodeId":108}]},"44":{"id":44,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If you're really keen on the position of Grand Vizier, you can submit a petition for it during the upcoming council reshuffle. I assure you that your consideration will be given *utmost attention*, if you get my meaning.\" [Promise Grand Vizier]","conditionsRaw":"((Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) == false) and (Variable[\"RiziaDLC.Council_GrandVizier_Empty\"] == true)","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"},{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":88}]},"45":{"id":45,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Without it, we risk straying further from the path of righteousness and forsaking the will of the Divine.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"46":{"id":46,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Implementing these changes in part will still mark progress towards establishing divine governance. It's a promising start on our journey towards fulfilling the will of the Divine.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":76}]},"47":{"id":47,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I see nothing but a bright future ahead of us. Rizia is blessed to have you as our sovereign king.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":76}]},"48":{"id":48,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"What of the Golden Guard's and the Royal Council's replacement?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":60},{"convId":447,"nodeId":51},{"convId":447,"nodeId":49},{"convId":447,"nodeId":50},{"convId":447,"nodeId":55}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm not fond of either. While I'm usually open to bold moves, this feels like it's crossing a line, and is a step too far.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":53}]},"50":{"id":50,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I commend you for your vision of the future. I shall give your Royal Council replacement proposal serious consideration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":54}]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Both are complex proposals, and if approved, would necessitate a substantial amount of time an planning.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":52}]},"52":{"id":52,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Understandable, Your Majesty. Perhaps, when you've hard more time to think about it, we can return to these proposals.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":61}]},"53":{"id":53,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Yes, of course. Then I won't speak of it any longer. Another time perhaps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":59}]},"54":{"id":54,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Please do. There's untold possibilities that we could accomplish if you initiated that reform.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":62}]},"55":{"id":55,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I applaud your vision for the future. I will carefully consider the Golden Guard replacement proposal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":56}]},"56":{"id":56,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Oh, please do. There's untold possibilities that we could accomplish if you initiated that reform.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":63}]},"57":{"id":57,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"\"That's excellent news! But yes, of course. I'll bring this up again when timing is more suitable.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":58}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_InterestedReplaceGGAndCouncil","op":"=","value":"true"}],"outgoingIds":[]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_InterestedReplaceGGAndCouncil","op":"=","value":"false"}],"outgoingIds":[]},"60":{"id":60,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I see no reason why either of those proposals couldn't come to fruition, but that isn't something I wish to decide just now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":57}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_InterestedReplaceAgnostic","op":"=","value":"true"}],"outgoingIds":[]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_InterestedReplaceCouncil","op":"=","value":"true"}],"outgoingIds":[]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_InterestedReplaceGG","op":"=","value":"true"}],"outgoingIds":[]},"64":{"id":64,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Anyway, thanks for hearing me out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":68},{"convId":447,"nodeId":67},{"convId":447,"nodeId":65},{"convId":447,"nodeId":66}]},"65":{"id":65,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Rest assured, I am committed to implementing the required reforms to establish the kingdom of Rizia as God's kingdom on earth.\" [Full Theocracy]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":69}]},"66":{"id":66,"speaker":"Player_Romus","isPlayerChoice":false,"text":"Just so we're clear, I have no intention of turning this kingdom into a divine realm governed by religious principles -- at least how you envision it.\" [No Theocracy]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":72}]},"67":{"id":67,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I can't commit to implementing all of your reforms, but I'm open to some. We need to maintain a level of autonomy for the state, separate from the influence of the Sanctuary.\" [Partial Theocracy]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":70}]},"68":{"id":68,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Committing to all your reforms just isn't possible, especially when it concerns issues such as economic stability and diplomatic relations. However, I am open to some collaboration.\" [Partial Theocracy]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":71}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_Full","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":73}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_Partial","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":74}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_Partial","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":86}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_None","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":87}]},"73":{"id":73,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Bless You, Your Majesty. This momentous decision heralds a new era for our kingdom, one where divine guidance shall illuminate our path forward.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_Full","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":47}]},"74":{"id":74,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Overall, I'm heartened to hear your acceptance of at least some of my proposals. Though it falls short of the full theocratic reformation I envisioned, it signifies a step forward nonetheless.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_Partial","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":46}]},"75":{"id":75,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"As Grand Vizier, I vow to exceed the expectations placed upon me by both God and the king, ensuring that every task is carried out with utmost diligence and dedication.\"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true  or  Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) and ((Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":77},{"convId":447,"nodeId":78}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true  or  Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":79}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true  or  Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":80},{"convId":447,"nodeId":81}]},"80":{"id":80,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":82}]},"81":{"id":81,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":75}]},"82":{"id":82,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"As your future Grand Vizier, I vow to exceed the expectations placed upon me by both God and the king, ensuring that every task is carried out with utmost diligence and dedication.\"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true  or  Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier\"] == true) and (Variable[\"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier\"] == true)","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":84},{"convId":447,"nodeId":85}]},"84":{"id":84,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Council_GrandVizier_Empty\"] == true","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":44}]},"85":{"id":85,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Council_GrandVizier_Empty\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"86":{"id":86,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Overall, it heartens me to hear your acceptance of at least some of my proposals. Though it falls short of the full theocratic reformation I envisioned, it signifies a step forward nonetheless.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_Partial","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":46}]},"87":{"id":87,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"It pains me to hear you reject all of my proposals. Enforcing such measures would have been a pivotal step towards establishing divine governance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Theocracy_None","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":45}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":89}]},"89":{"id":89,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"That's encouraging to hear. I'll most certainly put in a petition when the time comes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":48}]},"90":{"id":90,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Thanks again, Your Majesty. You have no idea how much this means for me, and for Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":48}]},"91":{"id":91,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"That the advantages of appointing me to such a position would be immense.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":12}]},"92":{"id":92,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Very well. Moving on...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":121}]},"93":{"id":93,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Well, it goes without saying that Titus wouldn't be happy about that. However, seeing as how he's my security counselor, I don't see him putting up much of a fuss.\"","conditionsRaw":"Variable[\"RiziaDLC.Council_Security_Titus\"] == true","variablesRead":[{"var":"RiziaDLC.Council_Security_Titus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":107}]},"94":{"id":94,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":95},{"convId":447,"nodeId":96}]},"95":{"id":95,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Council_Security_Titus\"] == true","variablesRead":[{"var":"RiziaDLC.Council_Security_Titus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":93}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Council_Security_Titus\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Council_Security_Titus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":101}]},"97":{"id":97,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"My second proposal would be to take the responsibilities currently bestowed upon the Golden Guard, and give them to the Wruhec's Guardians.\"","conditionsRaw":"(Variable[\"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn09_ReligionMeeting_GuardiansDeploy","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"false"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"=","value":"false"}],"outgoingIds":[{"convId":447,"nodeId":18}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Makes sense. If this kingdom is to fully embrace the one true faith, then it needs to in all matters of governance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":110}]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Golden Guard's history of protecting the monarchy dates back centuries. I won't be the ruler to discard such a longstanding tradition.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_RebelKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_RebelKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":111}]},"100":{"id":100,"speaker":"Player_Romus","isPlayerChoice":false,"text":"Ah, throw tradition out the window. Sure! I'm open to the idea. The palace could certainly use a shakeup.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_RebelKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_RebelKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":24}]},"101":{"id":101,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Well, it goes without saying that Titus wouldn't be happy about that.\"","conditionsRaw":"(Variable[\"RiziaDLC.Council_Security_Titus\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Council_Security_Titus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":109}]},"102":{"id":102,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Which brings me to the last topic I wanted to discuss... the royal council.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":108}]},"103":{"id":103,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":104},{"convId":447,"nodeId":105}]},"104":{"id":104,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":120}]},"105":{"id":105,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"106":{"id":106,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Splendid! There's so much you and I can do together to see this through.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":119}]},"107":{"id":107,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I'm glad you brought that up, actually. My final proposal is in regard to the royal council.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":108}]},"108":{"id":108,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"To put it simply, they ought to be supplanted by a religious council.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_ReplaceGoldenGuards","op":"=","value":"false"}],"outgoingIds":[{"convId":447,"nodeId":25}]},"109":{"id":109,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Captain Gordion is one of the most honorable men in this kingdom. I'm sure we could arrange for him to serve in a similar capacity under the Guardians.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":102}]},"110":{"id":110,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I'm glad you see it that way, as it aligns perfectly with my ultimate proposal for the royal council.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":108}]},"111":{"id":111,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Of course. And I don't mean to diminish or disparage any of their past accomplishments. I only seek to ensure this kingdom reaches its full potential.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":28}]},"112":{"id":112,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":113},{"convId":447,"nodeId":114}]},"113":{"id":113,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_RebelKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_RebelKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":100}]},"114":{"id":114,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_RebelKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_RebelKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":99}]},"115":{"id":115,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":116},{"convId":447,"nodeId":117}]},"116":{"id":116,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":118}]},"117":{"id":117,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"118":{"id":118,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Of course! I was considering such a change myself.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":32}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"true"}],"outgoingIds":[{"convId":447,"nodeId":12}]},"120":{"id":120,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Absolutely. Without question. Overseeing a religious government without your kind of spiritual leadership would be a sin in and of itself.\" [Appoint Grand Vizier]","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":106}]},"121":{"id":121,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_AppointGrandVizier","op":"=","value":"false"},{"var":"RiziaDLC.Turn09_ReligionMeeting_Sal_PromisedGrandVizier","op":"=","value":"false"}],"outgoingIds":[{"convId":447,"nodeId":15}]},"122":{"id":122,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"That said, I would recommend that Captain Gordion continue his current duties, but oversee the Guardians instead, considering his unwavering dedication to Wruhecism.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":447,"nodeId":112},{"convId":447,"nodeId":98},{"convId":447,"nodeId":94},{"convId":447,"nodeId":115}]}}}