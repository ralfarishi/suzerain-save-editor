{"conversationId":163,"title":"Sordland/Turn08/ValgslandVisit_AntiCommunistRayne","storyPack":"StoryPack_Main","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":15}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":160,"nodeId":3}]},"3":{"id":3,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Have a good day, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":48}]},"4":{"id":4,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“We are at the end of our allocated time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":19}]},"5":{"id":5,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Enjoy your stay in Valgsland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":11},{"convId":163,"nodeId":6},{"convId":163,"nodeId":16}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for the *warm* hospitality.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":7}]},"7":{"id":7,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Sarcasm, huh? Haven't heard that one before.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":3}]},"8":{"id":8,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I am glad that at least we can agree on one matter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":60}]},"9":{"id":9,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Excuses. Is that it?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":32}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“I won't sit idly while you insult me. The deal is off. We are finished here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":14}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":true,"text":"“I am definitely not staying after this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":13}]},"12":{"id":12,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Have a safe trip back home, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":48}]},"13":{"id":13,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Suit yourself.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":3}]},"14":{"id":14,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Suit yourself.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":12}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"He briefly scanned me from head to toe.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":18}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"“I will. Have a good day, Chancellor Hegel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":3}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“I think that we have come far. After all, we are standing here side by side instead of facing each other on a battlefield.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":26}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"We shook hands as he stared me down.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":21}]},"19":{"id":19,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I must go back to work.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":5}]},"20":{"id":20,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I sincerely hope you understand that the world doesn't work that way anymore, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":29}]},"21":{"id":21,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Mr. Rayne. Welcome to Valgsland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":37},{"convId":163,"nodeId":36},{"convId":163,"nodeId":38}]},"22":{"id":22,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“No you don't. But you will answer to the people of your country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":28}]},"23":{"id":23,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Recognise Heljiland as Valgslandian territory and I am ready to come to the table.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":24},{"convId":163,"nodeId":25},{"convId":163,"nodeId":31}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"“That's it? Sure. I will announce it as soon as possible.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":30}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"“Why? What are you after?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":27}]},"26":{"id":26,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“We can do so much more through unity. However, not everyone wants that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":90}]},"27":{"id":27,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Is that a yes or a no?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":33},{"convId":163,"nodeId":34}]},"28":{"id":28,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Do not underestimate your people, Mr. Rayne, or it might be the end of you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":45}]},"29":{"id":29,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Perhaps in the past, but not anymore.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":56}]},"30":{"id":30,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Then consider our trade deal sealed, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":50}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“There is no way I can do that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":14}]},"32":{"id":32,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Are you saying that you're not only weak, but also can't own up to your mistakes?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":49}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"“Fine. Deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":39}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“I reject. You are asking for too much.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":14}]},"35":{"id":35,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I have no qualms about what has been negotiated so far.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":61}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":44}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“It's good to be here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":44}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“So. Where do we begin?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":44}]},"39":{"id":39,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Then consider our trade deal sealed, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":50}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"“I don't answer to you, Chancellor Hegel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":55}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"He extended his hand for a handshake.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_HeljilandRecognised","op":"=","value":"true"},{"var":"BaseGame.Valgsland_TradeDeal","op":"=","value":"true"},{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"=","value":"false"},{"var":"BaseGameSupport.Journal_Turn08_ValgslandVisit_TradeDealAndHeljiland","op":"=","value":"true"}],"outgoingIds":[{"convId":163,"nodeId":42},{"convId":163,"nodeId":43}]},"42":{"id":42,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Shake hands.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":4}]},"43":{"id":43,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Don't shake his hand.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":4}]},"44":{"id":44,"speaker":"Narrator","isPlayerChoice":false,"text":"He gestured towards the painting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":46}]},"45":{"id":45,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“After all, it was the people who brought imperialism to its knees.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":56}]},"46":{"id":46,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“This was made in 1776 by the famous Valgslandian painter, Otto Kiebern.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":47}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"I looked at the painting. It must've been over five meters tall. It was a battle scene. On the left side there were banners carried by Valgs; on the right, Sords.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":51}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned around and walked away, leaving me alone in the empty halls of the Royal Palace.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":2}]},"49":{"id":49,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“To be honest, you do not surprise me, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":56}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Valgsland_HeljilandRecognised","op":"=","value":"true"},{"var":"BaseGame.Valgsland_TradeDeal","op":"=","value":"true"},{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"=","value":"false"}],"outgoingIds":[{"convId":163,"nodeId":121}]},"51":{"id":51,"speaker":"Narrator","isPlayerChoice":false,"text":"Countless spears formed a triangle at the center. The sky was red from the blood.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":53}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"Hegel frowned.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":9}]},"53":{"id":53,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What do you think about it?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":17},{"convId":163,"nodeId":58},{"convId":163,"nodeId":59}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"Hegel frowned.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":20}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"Hegel frowned.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":22}]},"56":{"id":56,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Listen, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":68}]},"57":{"id":57,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“What I want is simple.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":23}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing. It's just a painting.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":76}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“It is a reminder. One misstep and we are back to painting the world with more blood.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":73}]},"60":{"id":60,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Let me tell you this, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":74}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":62},{"convId":163,"nodeId":63}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":108}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":69}]},"64":{"id":64,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":57}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"“You have the gall to say that after all this?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":64}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“Let's hear it. What do you want?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":57}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"“You are making it less likely with every minute passing.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":57}]},"68":{"id":68,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“You have come here for a trade deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":82}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":70},{"convId":163,"nodeId":71}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Bergia\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Bergia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":109}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Bergia\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Bergia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":78}]},"72":{"id":72,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“You started privatizing your economy and sold state assets to make the rich even richer.”","conditionsRaw":"(Variable[\"BaseGame.EconomicDirection_Privatization\"] == true) and ((Variable[\"BaseGame.Decision_Turn05_SPAid_AcceptArcasia\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true) == false) and ((Variable[\"BaseGame.Decision_Turn05_AutocratEmergency_Extend\"] == true  and  Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true) == false)","variablesRead":[{"var":"BaseGame.EconomicDirection_Privatization","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn05_SPAid_AcceptArcasia","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn05_AutocratEmergency_Extend","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":81}]},"73":{"id":73,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“As the leaders of this world, we must be careful, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":85}]},"74":{"id":74,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“A trade deal between Valgsland and Sordland is possible.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":66},{"convId":163,"nodeId":65},{"convId":163,"nodeId":67}]},"75":{"id":75,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“I must admit I have been watching your rule with worry.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":117}]},"76":{"id":76,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“A response that I expected.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":90}]},"77":{"id":77,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“True. But I can certainly make your life harder.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":60}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":79},{"convId":163,"nodeId":80}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Lorren\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Lorren","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":110}]},"80":{"id":80,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Lorren\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Lorren","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":111}]},"81":{"id":81,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Your actions are clear as day.”","conditionsRaw":"((Variable[\"BaseGame.EconomicDirection_Privatization\"] == true) == false) and ((Variable[\"BaseGame.Decision_Turn05_SPAid_AcceptArcasia\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true) == false) and ((Variable[\"BaseGame.Decision_Turn05_AutocratEmergency_Extend\"] == true  and  Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true) == false)","variablesRead":[{"var":"BaseGame.EconomicDirection_Privatization","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn05_SPAid_AcceptArcasia","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn05_AutocratEmergency_Extend","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":40},{"convId":163,"nodeId":91},{"convId":163,"nodeId":83}]},"82":{"id":82,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Then let's talk about your deal and we will call it a day.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":89},{"convId":163,"nodeId":84},{"convId":163,"nodeId":10}]},"83":{"id":83,"speaker":"Player","isPlayerChoice":true,"text":"“My hand was forced when I made those decisions.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":52}]},"84":{"id":84,"speaker":"Player","isPlayerChoice":true,"text":"“You have just lowered your chances of achieving a trade deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":93}]},"85":{"id":85,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“Especially around those who are willing and ready to do precisely that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":90}]},"86":{"id":86,"speaker":"Player","isPlayerChoice":true,"text":"“That's enough! I didn't come here to hear threats. We are done here!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":14}]},"87":{"id":87,"speaker":"Player","isPlayerChoice":true,"text":"“You don't have to like me to trade with Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":77}]},"88":{"id":88,"speaker":"Player","isPlayerChoice":true,"text":"“Then it goes both ways, Chancellor Hegel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":8}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"“I expect nothing more.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":112}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"We started walking.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":75}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"“Chancellor Hegel. Please. Sordland's concerns are Sordland's alone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":163,"nodeId":54}]},"92":{"id":92,"speaker":"Emmerich Hegel","isPlayerChoice":false,"text":"“My problem is with you, Mr. Rayne. It's with how you lead Sordland.”","conditionsRaw":"(Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) == false","