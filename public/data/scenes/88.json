{"conversationId":88,"title":"Sordland/Turn06/Personal_ReturnOfInvestment2","storyPack":"StoryPack_Main","turn":6,"turnLabel":"Turn 6","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":88,"nodeId":1}]},"1":{"id":1,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":88,"nodeId":68}]},"2":{"id":2,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“You now officially have a stake in Underhall Construction. Considering their status as the number one construction company in the entire Sordland, I must say that this was an excellent choice.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":88,"nodeId":30}]},"4":{"id":4,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn06_Personal_ReturnOfInvestment2","op":"=","value":"true"}],"outgoingIds":[{"convId":88,"nodeId":69}]},"5":{"id":5,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“A very enjoyable party turned out to be even more enjoyable with actual results out of it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":88,"nodeId":37},{"convId":88,"nodeId":56},{"convId":88,"nodeId":57}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"The phone rang and I picked it up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":88,"nodeId":7}]},"7":{"id":7,"speaker":"Livia Suno","isPlayerChoice":false,"text":"“Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":88,"nodeId"