{"conversationId":73,"title":"Sordland/Turn05/A_AutocratAssembly","storyPack":"StoryPack_Main","turn":5,"turnLabel":"Turn 5","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":1}]},"1":{"id":1,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":3}]},"2":{"id":2,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"A session of the Grand National Assembly was in order because of the continued discussion about the emergency. The opposition wanted to declare it null and void.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":4}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"I was seated in one of the seats reserved for the council of ministers, which was positioned slightly higher than the rest of the seats and had an angle that made for a clear view of the whole place.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":5}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"I glanced down at the USP seats and casually watched the people inside as Gloria announced the next speaker before the vote to revoke the decree.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":6}]},"6":{"id":6,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Mr. Frens Ricter from the People's Freedom and Justice Party has the floor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":7}]},"7":{"id":7,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Ladies and Gentlemen! A devastating picture has often been painted of the state of affairs prevailing in Sordland today. As always in such cases, there is no lack of exaggeration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":8}]},"8":{"id":8,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Considering the extreme measures being taken that completely sets aside our freedoms, no one can fairly demand or expect of us to accept this extension of the Emergency Act.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":9}]},"9":{"id":9,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"The elections of December have resulted in a majority for the USP and thus given Mr. Rayne the opportunity to govern, strictly as laid down in the intention of the Constitution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":10}]},"10":{"id":10,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"But where this opportunity is given, it is coupled with obligations. Respecting the laws and listening to criticism is necessary.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":11}]},"11":{"id":11,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Not only the Assembly's opinion was not asked, the reasons for the emergency nor its extension were not justified!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":12}]},"12":{"id":12,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":13},{"convId":73,"nodeId":14}]},"13":{"id":13,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":15}]},"14":{"id":14,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":16}]},"15":{"id":15,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"The President clearly has ideological intentions. This decree was an attempt to destroy the Socialist Movement.\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":16}]},"16":{"id":16,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":17},{"convId":73,"nodeId":18}]},"17":{"id":17,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":19}]},"18":{"id":18,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":20}]},"19":{"id":19,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"This decree was a declaration of war against the Bludish people. The President does not even shy away from using divisive words. He has political intentions which will have grave consequences for our country.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true) == false) and (Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":20}]},"20":{"id":20,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":21},{"convId":73,"nodeId":22}]},"21":{"id":21,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":23}]},"22":{"id":22,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":24}]},"23":{"id":23,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Mr. Rayne is exploiting the shooting of Bernard Circas and using this to his advantage to give us all these lies about national security threats!\"","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false) and (Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":24}]},"24":{"id":24,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Ladies and Gentlemen of the United Sordland Party! You have claimed to have reformed the party and promised to bring the change people have been asking for.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false) and ((Variable[\"BaseGame.Reform_EmergencyDecree_Banned_YS\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Banned_YS","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":25}]},"25":{"id":25,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Yet while the workers, the peasants, the whitecollar employees, the civil servants, or the businessmen of Sordland have their own troubles and demands from us, you go about fighting wars with enemies that don't exist!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":26}]},"26":{"id":26,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Everybody expected of you to rewrite the outdated Constitution of Tarquin Soll. Now we have an emergency on our hands, which is fabricated to create a justification for the lack of reforms of the government. And their apparent hunger for authority!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":165}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"Loud applauses came from the opposition.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":28},{"convId":73,"nodeId":29},{"convId":73,"nodeId":30}]},"28":{"id":28,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Ask Gloria for a moment to respond.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":34}]},"29":{"id":29,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Stay silent.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":32}]},"30":{"id":30,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Stand up and yell at him.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":31}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"I shouted at him in protest.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":49},{"convId":73,"nodeId":50},{"convId":73,"nodeId":51},{"convId":73,"nodeId":52}]},"32":{"id":32,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I ask for my honorable colleagues to support the PFJP in revoking this emergency, here and now!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":59}]},"33":{"id":33,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"I'm sorry to interrupt, Mr. Ricter, but the President has asked for an opportunity to respond. You have directly addressed the President in your speech, so I shall give him the opportunity to give a brief response.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn05_A_Autocrat_Ricter_Responded","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":35}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"Gloria looked at me and nodded.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":145}]},"35":{"id":35,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"The President has the floor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":36},{"convId":73,"nodeId":37},{"convId":73,"nodeId":38}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"\"Mr. Ricter, you speak of pure slander. There are no political intentions...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":39}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"\"Gentlemen, you're underestimating the threats!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":39}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"\"Mr. Ricter! Who are you to speak about such things?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":39}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"Frens laughed sarcastically.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":40},{"convId":73,"nodeId":41},{"convId":73,"nodeId":42}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"We will be controlling the situation shortly. Be patient!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":43}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"\"We know that Mr. Ricter himself has ties with foreign interests!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":43}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"The State is doing what's best for Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":43}]},"43":{"id":43,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Mr. President, let's keep it brief.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":46},{"convId":73,"nodeId":44},{"convId":73,"nodeId":136},{"convId":73,"nodeId":45}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"\"The decree is completely legal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":47}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"\"Don't be fooled by Mr. Ricter's slander. We all know the truth.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":47}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"\"This emergency will show us the real traitors among us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":47}]},"47":{"id":47,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"I have to let Mr. Ricter continue, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":48}]},"48":{"id":48,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Mr. Frens Ricter has the floor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":56}]},"49":{"id":49,"speaker":"Player","isPlayerChoice":true,"text":"\"PURE SLANDER!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":53}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"\"DON'T WASTE OUR TIME!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":53}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"\"WATCH WHAT YOU ARE SAYING!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":53}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"\"VERY CREATIVE!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":53}]},"53":{"id":53,"speaker":"Narrator","isPlayerChoice":false,"text":"Frens first looked at me and then at Gloria.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":146}]},"54":{"id":54,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Mr. President... Please.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn05_A_Autocrat_Ricter_Shouted","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":55}]},"55":{"id":55,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Please continue, Mr. Ricter.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":57}]},"56":{"id":56,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Thank you, Mrs. Speaker.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":85}]},"57":{"id":57,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Thank you, Mrs. Speaker. I have to say, I deplore the reaction of the President...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":58}]},"58":{"id":58,"speaker":"Narrator","isPlayerChoice":false,"text":"He cleared his throat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":32}]},"59":{"id":59,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I am talking to the members of the United Sordland Party as well! Do not act partisan in matters with such critical importance. We know that this emergency is a dangerous exaggeration and it can have very grim consequences on our democratic institutions.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":60}]},"60":{"id":60,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I wish to trust in your judgement and ask for your help in reaching an absolute majority against this decree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":164}]},"61":{"id":61,"speaker":"Narrator","isPlayerChoice":false,"text":"One man from the USP seats yelled: \"in your dreams!\" It made the USP burst in laughter.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":62}]},"62":{"id":62,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"When in fact the Assembly fails to deliver its duties for the good of the Sordish people, I shall be personally making a case to the Supreme Court about the legality of this emergency.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":63}]},"63":{"id":63,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Ladies and Gentlemen! We all know that this emergency is unlawful!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":65}]},"64":{"id":64,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"It clearly breaches on the freedoms and rights of men defined in the Section 100 of the Constitution.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":69}]},"65":{"id":65,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":66},{"convId":73,"nodeId":67}]},"66":{"id":66,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":68}]},"67":{"id":67,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":64}]},"68":{"id":68,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"It breaches on the right for a fair trial by giving the State the right to detain anyone without a trial. This is a breach on democracy as well as the freedoms of men defined in the Section 100 of the Constitution.\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":69}]},"69":{"id":69,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":70},{"convId":73,"nodeId":71}]},"70":{"id":70,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":73}]},"71":{"id":71,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":72}]},"72":{"id":72,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Sordland is being practically transformed into a police state.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":74}]},"73":{"id":73,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"It also denies people's right to assemble in protest. This is a clear breach of freedom of expression and freedom of speech!\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_SuspendedProtests\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_SuspendedProtests","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":74}]},"74":{"id":74,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"According to the Constitution, these rights can not be suspended under any other circumstances than being under invasion.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":75}]},"75":{"id":75,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Do any of you see any Rumburgian tanks in Sordland? Are we under bombardment? There is nobody attacking but the State! They are persecuting thousands of innocents under national security threats! Who will stop the President from prosecuting all who oppose him tomorrow?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":76}]},"76":{"id":76,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"The State is acting illegally! I hereby invite the Supreme Court to duty and ask for them to subject this decree to a proper judicial review and revoke it before it's too late.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":79}]},"77":{"id":77,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I hail those who are persecuted and in despair. We hail the strong Sordish opposition. Their steadfastness and loyalty are worthy of acclaim. The courage of their convictions, their unbroken faith - are the guarantees of a brighter future.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":101}]},"78":{"id":78,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"No decree can give you the power to destroy ideas which are eternal and indestructible!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":77}]},"79":{"id":79,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"We must adhere to the basic principles of a constitutional state, to the equality of rights, and the concept of social legislation anchored therein. I ask everybody's support in the upcoming vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":80}]},"80":{"id":80,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Thank you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":81}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"Mr. Ricter walked back to his seat among applauses from his party.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":82}]},"82":{"id":82,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Next, the Assembly will vote on PFJP's demand to revoke the validity of the emergency.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":83}]},"83":{"id":83,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"According to the Constitution, the Assembly requires at least two-thirds majority to revoke an emergency declared by the President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":86}]},"84":{"id":84,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"We have 131 ayes and 119 nays.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":95}]},"85":{"id":85,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Mr. President spoke nonsense.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":32}]},"86":{"id":86,"speaker":"Narrator","isPlayerChoice":false,"text":"People started to get up from their seats to take the envelopes and cast their votes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":87},{"convId":73,"nodeId":88}]},"87":{"id":87,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Keep sitting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":92}]},"88":{"id":88,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Go to cast a vote.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":89}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"I grabbed the envelope and prepared my vote.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":90},{"convId":73,"nodeId":91}]},"90":{"id":90,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Vote aye for the fun of it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":93}]},"91":{"id":91,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Vote no.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":93}]},"92":{"id":92,"speaker":"Narrator","isPlayerChoice":false,"text":"I watched as everybody voted one by one.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":93}]},"93":{"id":93,"speaker":"Narrator","isPlayerChoice":false,"text":"Some time has passed when the votes were counted.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":166}]},"94":{"id":94,"speaker":"Narrator","isPlayerChoice":false,"text":"Suddenly Gloria's gavel echoed in the hall, which eliminated the carefree attitude that lurked after the voting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":84}]},"95":{"id":95,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Ayes does not exceed the two-third threshold, so the nays have it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":96}]},"96":{"id":96,"speaker":"Narrator","isPlayerChoice":false,"text":"PFJP members started making noises.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":98}]},"97":{"id":97,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Ask to speak.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":104}]},"98":{"id":98,"speaker":"Narrator","isPlayerChoice":false,"text":"A lot of people including Frens Ricter demanded to speak.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":99}]},"99":{"id":99,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Yes, Mr. Ricter.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":100}]},"100":{"id":100,"speaker":"Narrator","isPlayerChoice":false,"text":"Frens looked directly at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":78}]},"101":{"id":101,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned around and went back to his seat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":97},{"convId":73,"nodeId":102}]},"102":{"id":102,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Leave the Assembly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":103}]},"103":{"id":103,"speaker":"Narrator","isPlayerChoice":false,"text":"The whole Assembly watched behind me as I walked.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":132}]},"104":{"id":104,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Yes, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":105},{"convId":73,"nodeId":106},{"convId":73,"nodeId":107}]},"105":{"id":105,"speaker":"Player","isPlayerChoice":true,"text":"\"I want to thank the members of the Assembly...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":108}]},"106":{"id":106,"speaker":"Player","isPlayerChoice":true,"text":"\"Let us try to be more civil towards each other...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":108}]},"107":{"id":107,"speaker":"Player","isPlayerChoice":true,"text":"\"Mr. Ricter, you cannot stand against the USP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":108}]},"108":{"id":108,"speaker":"Narrator","isPlayerChoice":false,"text":"Frens watched me with no emotions in his face.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":109},{"convId":73,"nodeId":110},{"convId":73,"nodeId":111}]},"109":{"id":109,"speaker":"Player","isPlayerChoice":true,"text":"\"I condemn Mr. Ricter's empathy and support for the prosecuted.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":112}]},"110":{"id":110,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's put this behind us, we must not deviate from the real enemy!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":112}]},"111":{"id":111,"speaker":"Player","isPlayerChoice":true,"text":"\"Rest assured, we will handle all the problems.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":112}]},"112":{"id":112,"speaker":"Narrator","isPlayerChoice":false,"text":"Mansoun Leke interrupted me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":113}]},"113":{"id":113,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"You talk about difficult times, enemies and problems, yet all these are products of the Sordish State!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":117}]},"114":{"id":114,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":115},{"convId":73,"nodeId":116}]},"115":{"id":115,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":118}]},"116":{"id":116,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":119}]},"117":{"id":117,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"The Bludish people are refraining themselves from turning against those who tortured and humiliated them for decades! We only ask to be properly represented in the Assembly. You say the decree has nothing to do with political agenda. But all we have are fingers being pointed out again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":114}]},"118":{"id":118,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"Workers Party of Bludia is a completely legal and democratic party that's being supported by millions of Bludish people! I condemn this State for silencing another democratic party again!\"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":119}]},"119":{"id":119,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"It seems Sordland has made its choice again. Any attempt to turn back the wheels of time will be in vain.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_Bluds\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_Bluds","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":120}]},"120":{"id":120,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"We the Bludish people... and the democratic socialists are aware that one cannot eliminate the realities of power politics by the simple act of legal protests. We now see the reality of your present rule.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":121}]},"121":{"id":121,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"But the people’s sense of justice also wields political power, Mr. President! And we will never stop appealing to this sense of justice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":122}]},"122":{"id":122,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Order, Mr. Leke! Try to refrain from speaking out of turn.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":123},{"convId":73,"nodeId":124},{"convId":73,"nodeId":126},{"convId":73,"nodeId":125}]},"123":{"id":123,"speaker":"Player","isPlayerChoice":true,"text":"\"You have it all wrong, Mr. Leke.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":127}]},"124":{"id":124,"speaker":"Player","isPlayerChoice":true,"text":"\"Are you implying violence against the State!?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":128}]},"125":{"id":125,"speaker":"Player","isPlayerChoice":true,"text":"\"This has nothing to do with race.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":127}]},"126":{"id":126,"speaker":"Player","isPlayerChoice":true,"text":"\"Are you giving support to the separatists?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":128}]},"127":{"id":127,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"We know how you rule, Mr. President! God save us all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":129}]},"128":{"id":128,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"Go ahead, create any reason to prosecute me too!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":129}]},"129":{"id":129,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"Order! This issue has been settled.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":130}]},"130":{"id":130,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"\"We will be moving on to the next topic...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":137}]},"131":{"id":131,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"The people’s sense of justice also wields political power, Mr. President! And we will never stop appealing to this sense of justice!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":135}]},"132":{"id":132,"speaker":"Narrator","isPlayerChoice":false,"text":"I barely heard Mansoun Leke yelling behind me right when I walked out the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":131}]},"133":{"id":133,"speaker":"Narrator","isPlayerChoice":false,"text":"It was a tough session but the opposition failed to revoke the emergency decree in the end, which worked perfectly for us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":134}]},"134":{"id":134,"speaker":"Narrator","isPlayerChoice":false,"text":"However, Frens was going to disrupt the decree by going to the Court. If Orso's promise could be trusted, that would not create issues for us, but I still couldn't keep myself from worrying.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":144}]},"135":{"id":135,"speaker":"Narrator","isPlayerChoice":false,"text":"I felt back at ease as soon as I left the Assembly's chaos behind.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":133}]},"136":{"id":136,"speaker":"Player","isPlayerChoice":true,"text":"\"The emergency was a hard decision to make but it was needed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":47}]},"137":{"id":137,"speaker":"Narrator","isPlayerChoice":false,"text":"Gloria did her best to bring order back to the Assembly and proceed with the schedule.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":138}]},"138":{"id":138,"speaker":"Narrator","isPlayerChoice":false,"text":"After the session, I finally felt at ease when I left the chaos of the Assembly behind.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":133}]},"139":{"id":139,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":140},{"convId":73,"nodeId":141}]},"140":{"id":140,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Wehlen_TradeDeal\"] == true","variablesRead":[{"var":"BaseGame.Wehlen_TradeDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":142}]},"141":{"id":141,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Wehlen_TradeDeal\"] == true) == false","variablesRead":[{"var":"BaseGame.Wehlen_TradeDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":158}]},"142":{"id":142,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Report_Turn05_Uziren_BorderReport","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":158}]},"143":{"id":143,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn05_A_Speech","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":163}]},"144":{"id":144,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn05_R_EmergencyDebate","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn05_HP_EmergencyDebate","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn05_LT_EmergencyReview","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":147}]},"145":{"id":145,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn05_A_Autocrat_Ricter_Responded","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":33}]},"146":{"id":146,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"v