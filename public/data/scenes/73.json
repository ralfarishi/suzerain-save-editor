":154},{"convId":73,"nodeId":155}]},"154":{"id":154,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn05_A_Autocrat_Ricter_Responded\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn05_A_Autocrat_Ricter_Responded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":157}]},"155":{"id":155,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn05_A_Autocrat_Ricter_Responded\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn05_A_Autocrat_Ricter_Responded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":139}]},"156":{"id":156,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn05_ST_RayneRicterDebate_Shout_NoDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":139}]},"157":{"id":157,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn05_ST_RayneRicterDebate_Respond_NoDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":139}]},"158":{"id":158,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":159},{"convId":73,"nodeId":160}]},"159":{"id":159,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Agnolia_HeljilandRecognised\"] == true","variablesRead":[{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":161}]},"160":{"id":160,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Agnolia_HeljilandRecognised\"] == true) == false","variablesRead":[{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":162}]},"161":{"id":161,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn05_G_AgnoliaRamsNavy","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":143}]},"162":{"id":162,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn05_G_WalkerWarnsNavy","op":"=","value":"true"}],"outgoingIds":[{"convId":73,"nodeId":143}]},"163":{"id":163,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":2}]},"164":{"id":164,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":61}]},"165":{"id":165,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":27}]},"166":{"id":166,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":73,"nodeId":94}]}}}