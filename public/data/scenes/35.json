{"conversationId":35,"title":"Sordland/Turn03/A_LateBriefing","storyPack":"StoryPack_Main","turn":3,"turnLabel":"Turn 3","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":1}]},"1":{"id":1,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":4}]},"2":{"id":2,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn03_A_LateBriefing","op":"=","value":"true"}],"outgoingIds":[{"convId":35,"nodeId":70}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"The reform committee had intensified work after the negotiations with the Old Guard broke down. Options regarding the new Constitution were already laid out.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":60}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"A few minutes later, Lucian and Petr arrived.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Autocrat_Intention","op":"=","value":"false"}],"outgoingIds":[{"convId":35,"nodeId":43}]},"6":{"id":6,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"There are some people in USP who would support a new Constitution with more executive powers. Getting the support of the nationalists is our best bet.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":36,"nodeId":1}]},"7":{"id":7,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Now we have a better picture of your intentions, sir. I will start reaching out to my contacts to make a draft that works for you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":8}]},"8":{"id":8,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I'll present your input to the committee. In a few months, you would have the draft on your desk to make the final changes yourself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":9}]},"9":{"id":9,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think this was yet another fruitful meeting, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":24},{"convId":35,"nodeId":25},{"convId":35,"nodeId":26},{"convId":35,"nodeId":27}]},"10":{"id":10,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But now we have a better picture of your intentions, sir. I will start reaching out to my contacts to make a draft that works for you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":12}]},"11":{"id":11,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Well, regardless of what you decide, we will need to work together with all the cabinet to push this agenda.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":10}]},"12":{"id":12,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'll present your input to the USP leaders and the National Front. In a few months, you would have the draft on your desk to make the final changes yourself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":13}]},"13":{"id":13,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think this was yet another fruitful meeting, sir. I trust your judgement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":14},{"convId":35,"nodeId":15},{"convId":35,"nodeId":16},{"convId":35,"nodeId":17}]},"14":{"id":14,"speaker":"Player","isPlayerChoice":true,"text":"\"Your service is appreciated.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":20}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"\"If we do this, I promise, you will be kings.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":20}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"\"Together we will make Sordland great.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":19}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks for the meeting, gentlemen.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":18}]},"18":{"id":18,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for your time, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":23}]},"19":{"id":19,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Yes we will!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":22}]},"20":{"id":20,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for the kind words, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":21}]},"21":{"id":21,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"You can count on us, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":38}]},"22":{"id":22,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm sure you will lead us to greatness, sir. Thanks for your time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":38}]},"23":{"id":23,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Thank you, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":38}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"\"Your service is appreciated.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":28}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"\"If we do this, we will be remembered as heroes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":32}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"\"Together we will democratize Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":35}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks for the meeting, everybody.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":30}]},"28":{"id":28,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for the kind words, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":31}]},"29":{"id":29,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Thank you, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":36}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for your time, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":29}]},"31":{"id":31,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"You can count on us, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":36}]},"32":{"id":32,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"That would be really great!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":33}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"He laughed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":36}]},"34":{"id":34,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Yes, sir. Thank you for your time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":36}]},"35":{"id":35,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Ours too, of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":34}]},"36":{"id":36,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Since we have arrived at the same page with Ms. Morgna again I will reach out to her to for guidance on the draft constitution work. She has principles and wouldn't go against her own code out of previous disagreements.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":37}]},"37":{"id":37,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Anyway, I think this is where we'll call it, sir. Have a good day.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":40}]},"38":{"id":38,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think this is where we'll call it, sir. Have a good day.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":39}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":3}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":3}]},"41":{"id":41,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Dictator_Path","op":"=","value":"true"},{"var":"BaseGame.Reform_Dictator_Intention","op":"=","value":"true"}],"outgoingIds":[{"convId":35,"nodeId":61}]},"42":{"id":42,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Let's not act rash. They have already begun mobilising support against our reform attempts but if we go down the route of removing the Court vote on legislation, it must be thoroughly considered.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":45},{"convId":35,"nodeId":46},{"convId":35,"nodeId":53}]},"43":{"id":43,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"After what they pulled off I say let's screw them over. We can go all the way with the reforms and shatter the power of the Old Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":44}]},"44":{"id":44,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"The people chose us to make real change and to do it, we need to gain as much constitutional power to remove the obstructionists from power.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":42}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"\"The Vice President has a point. It's us versus them now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":52}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's consider all of our options carefully.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":50}]},"47":{"id":47,"speaker":"Player","isPlayerChoice":true,"text":"\"The future lies in a true reform of the constitution. The people elected us for that, let us embrace our purpose.\"","conditionsRaw":"Variable[\"BaseGame.Prologue_Speech_Democracy_Liberal\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Speech_Democracy_Liberal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":48}]},"48":{"id":48,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Why don't we take more power away from them?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":58}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Reformist_Path","op":"=","value":"true"},{"var":"BaseGame.Reform_Reformist_Intention","op":"=","value":"true"}],"outgoingIds":[{"convId":35,"nodeId":59}]},"50":{"id":50,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"True, sorry I got a little hotheaded.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":58}]},"51":{"id":51,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It was always. But how do we proceed?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":58}]},"52":{"id":52,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"The lines are drawn sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":51}]},"53":{"id":53,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":54},{"convId":35,"nodeId":55}]},"54":{"id":54,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Speech_Democracy_Liberal\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Speech_Democracy_Liberal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":47}]},"55":{"id":55,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Speech_Democracy_Liberal\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Speech_Democracy_Liberal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's consolidate our constitutional power and remove the Old Guard equation.\"","conditionsRaw":"Variable[\"GameCondition.Turn03_LateBrief_ReformistBranch\"] == false","variablesRead":[{"var":"GameCondition.Turn03_LateBrief_ReformistBranch","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":63}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"\"We should not be blinded by hatred of foes. Our true purpose will be real reform for the future of this nation.\"","conditionsRaw":"Variable[\"GameCondition.Turn03_LateBrief_DictatorBranch\"] == false","variablesRead":[{"var":"GameCondition.Turn03_LateBrief_DictatorBranch","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":62}]},"58":{"id":58,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The reform committee has presented two options. It's either we take more power to ourselves to beat the Old Guard or we opt for a true reformist agenda to democratise Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":64},{"convId":35,"nodeId":67}]},"59":{"id":59,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Very well if that is your decision. We will need to engage further with the progressive wing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Reformist_Path","op":"=","value":"true"},{"var":"BaseGame.Reform_Reformist_Intention","op":"=","value":"true"},{"var":"GameCondition.Turn03_LateBrief_ReformistBranch","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn03_LateReform_Reformist","op":"=","value":"true"}],"outgoingIds":[{"convId":37,"nodeId":1}]},"60":{"id":60,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Autocrat_Intention","op":"=","value":"false"}],"outgoingIds":[{"convId":35,"nodeId":5}]},"61":{"id":61,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I will fully support you, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Dictator_Path","op":"=","value":"true"},{"var":"BaseGame.Reform_Dictator_Intention","op":"=","value":"true"},{"var":"GameCondition.Turn03_LateBrief_DictatorBranch","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn03_LateReform_Dictator","op":"=","value":"true"}],"outgoingIds":[{"convId":35,"nodeId":6}]},"62":{"id":62,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn03_LateBrief_ReformistBranch","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn03_LateReform_Reformist","op":"=","value":"true"}],"outgoingIds":[{"convId":35,"nodeId":49}]},"63":{"id":63,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn03_LateBrief_DictatorBranch","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn03_LateReform_Dictator","op":"=","value":"true"}],"outgoingIds":[{"convId":35,"nodeId":41}]},"64":{"id":64,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":65},{"convId":35,"nodeId":66}]},"65":{"id":65,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"GameCondition.Turn03_LateBrief_ReformistBranch\"] == false","variablesRead":[{"var":"GameCondition.Turn03_LateBrief_ReformistBranch","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":35,"nodeId":56}]},"66":{"id":66,"speaker":"Lucian Galade