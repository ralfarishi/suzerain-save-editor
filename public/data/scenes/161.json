{"conversationId":161,"title":"Sordland/Turn08/ValgslandVisit_TalkWithDeivid","storyPack":"StoryPack_Main","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":6}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":160,"nodeId":7}]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"“Comrade Hegel.”","conditionsRaw":"Variable[\"BaseGame.Archetype_ComradeRayne\"] == true","variablesRead":[{"var":"BaseGame.Archetype_ComradeRayne","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":33}]},"4":{"id":4,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“It's chilly out here. I must go and try to get some sleep. I'm an old man, after all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":5}]},"5":{"id":5,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“I recommend you do the same.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":9},{"convId":161,"nodeId":10}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"Midnight was approaching as our delegation boarded SRS Holsord.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":13}]},"7":{"id":7,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Very well. Good night.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":16}]},"8":{"id":8,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“It is sometimes good to air out one's thoughts.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":26},{"convId":161,"nodeId":34}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"“Good idea.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":14}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“I will stay a little longer.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":7}]},"11":{"id":11,"speaker":"Narrator","isPlayerChoice":false,"text":"We spent a couple of minutes watching the waves.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":4}]},"12":{"id":12,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“I must go and try to sleep, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":5}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"The large ship was once the royal yacht of King Egmund himself. By the order of Soll, it was repurposed to serve the leaders of Sordland for state visits.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":62}]},"14":{"id":14,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Have a good night.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":18}]},"15":{"id":15,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Mr. President. I am surprised you are still up this late.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":49},{"convId":161,"nodeId":36},{"convId":161,"nodeId":24}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"I watched the sea for some more time before going back to my compartment to sleep.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":20}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"We departed from the port of Lachaven, along with a few other smaller escort boats.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":22}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"I went back to my compartment to sleep.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":20}]},"19":{"id":19,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Silently watch the horizon.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":12}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"The dawn arrived and our ship moored at the busy port of Wilbern.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":21}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"Amid the usual camera flashes, our convoy made its way to the train station.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":25}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"I entered the luxurious compartments reserved for heads of state. I lay down on the bed to rest my eyes before we arrived at Wilbern, a major city in Valgsland.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":30}]},"23":{"id":23,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Good point.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":41}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"“I could say the same thing about you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":23}]},"25":{"id":25,"speaker":"Narrator","isPlayerChoice":false,"text":"After a short, uneventful ride, we arrived at the central train station of Haelm, the capital city of Valgsland. A huge crowd was already there, awaiting my arrival. They swarmed around me and took photos as I stepped out of the train.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":27}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“I said it's nothing.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":43}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"Our delegation met with various members of the Valgslandian cabinet before taking our cars to the Royal Palace. The flags of Valgsland and the CSP were waving next to the entrance.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":29}]},"28":{"id":28,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Anytime, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":4}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"Assistants took my belongings and led me to the museum wing. It was there that I saw Chancellor Hegel. He was inspecting a very large painting on the wall.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":37},{"convId":161,"nodeId":31}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"The Markian Sea was known for its treacherous waters, but tonight's trip promised to be rather calm and quiet. Still, I couldn't sleep.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":32}]},"31":{"id":31,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Clear your throat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":33}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"I went out to the upper deck to have some fresh air. A light breeze was blowing, and I relished its briny smell. There was nobody here except Deivid.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":60}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned around. He was a man of small stature with a bald spot and a striking visage. His famous pipe was in his mouth.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":2}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“Are you also worried about the future all the time?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":58}]},"35":{"id":35,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Do you mind if I ask why you can't sleep?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":53},{"convId":161,"nodeId":52},{"convId":161,"nodeId":54}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"“I like taking night walks.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":51}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":38},{"convId":161,"nodeId":39}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Archetype_ComradeRayne\"] == true","variablesRead":[{"var":"BaseGame.Archetype_ComradeRayne","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":3}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Archetype_ComradeRayne\"] == true) == false","variablesRead":[{"var":"BaseGame.Archetype_ComradeRayne","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":42}]},"40":{"id":40,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“As mankind, we are forever gullible. Always reaching out for what we don't have.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":44}]},"41":{"id":41,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“I used to feel that sleep was wasted time. Why spend one-third of one's life in the dark?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":61}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"“Chancellor Hegel.”","conditionsRaw":"(Variable[\"BaseGame.Archetype_ComradeRayne\"] == true) == false","variablesRead":[{"var":"BaseGame.Archetype_ComradeRayne","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":33}]},"43":{"id":43,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":11}]},"44":{"id":44,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“That includes the choices we *could've* made, and their results which will never come to pass.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":45},{"convId":161,"nodeId":55},{"convId":161,"nodeId":19}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for your wisdom, Deivid.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":28}]},"46":{"id":46,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“That is precisely why we must be strong.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":4}]},"47":{"id":47,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“There is no way out of it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":46}]},"48":{"id":48,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“It doesn't.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":47}]},"49":{"id":49,"speaker":"Player","isPlayerChoice":true,"text":"“I can't sleep.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":50}]},"50":{"id":50,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Do you mind if I ask why?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":53},{"convId":161,"nodeId":52},{"convId":161,"nodeId":54}]},"51":{"id":51,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“Ah. One of my own.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":41}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"“It's nothing. Don't worry about it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":8}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"“I do mind.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":43}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"“Are you also worried about the future all the time?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":58}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":true,"text":"“That doesn't help me at all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":56}]},"56":{"id":56,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“No, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":48}]},"57":{"id":57,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“What I realized in time was that worrying is simply a part of life.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":40}]},"58":{"id":58,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“I'm an old man, Mr. President. I have been alive for over seventy years.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":59}]},"59":{"id":59,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“I spent most of those years worrying about various things. Endlessly.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":57}]},"60":{"id":60,"speaker":"Narrator","isPlayerChoice":false,"text":"My foreign minister was leaning over a railing, gazing out at the inky waves.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":15}]},"61":{"id":61,"speaker":"Deivid Wisci","isPlayerChoice":false,"text":"“I rather appreciate it now. But there's still something special about being awake while the rest of the world has its eyes closed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":35}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":161,"nodeId":17}]}}}