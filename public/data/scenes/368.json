{"conversationId":368,"title":"Rizia/Turn 6/FPnT_DukeWarPhoneCall","storyPack":"StoryPack_Rizia","turn":6,"turnLabel":"Turn 6","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":92}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"I sat in my office, waiting to place the call that would change the future of Rizia and Pales.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":87}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"I placed the phone to my ear. I took a deep breath as the Palesian palace operators connected me to Duke Reinhart.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":6},{"convId":368,"nodeId":7},{"convId":368,"nodeId":8},{"convId":368,"nodeId":9}]},"5":{"id":5,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"Oh... Your Majesty. I've been waiting to hear from you.\"","conditionsRaw":"((Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true) == false) and (((Variable[\"RiziaDLC.Pales_War\"] == true  and  Variable[\"RiziaDLC.PostIncident_Border_JointInvestigation\"] == true)) == false)","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"},{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.PostIncident_Border_JointInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":22},{"convId":368,"nodeId":23},{"convId":368,"nodeId":24}]},"6":{"id":6,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Duke Reinhart. What a pleasure it is to have the chance to speak with you again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":79}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This is the King speaking.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":10}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Hello, Axel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":10}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It's King Romus Toras. The Ruler of Rizia Imperii, and Valenqiris, and of Brenas and Iza; of Cardesse and Montaklar, and the ancient lands of the Rezenids, Descendant of the Most Honorable Queen Lyza and King Valero, and the Sovereign of the Kingdom of Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":18}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":11},{"convId":368,"nodeId":12}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":16}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true) == false","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":5}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":14},{"convId":368,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":17}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true) == false","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":5}]},"16":{"id":16,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"I didn't expect to have a dialogue with you after what happened.\"","conditionsRaw":"Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":25},{"convId":368,"nodeId":26},{"convId":368,"nodeId":27}]},"17":{"id":17,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"I'm afraid I don't see it that way, Your Majesty. Especially after what happened.\"","conditionsRaw":"(Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true) and ((Variable[\"RiziaDLC.Pales_War\"] == true  and  Variable[\"RiziaDLC.PostIncident_Border_JointInvestigation\"] == true)) and (((Variable[\"RiziaDLC.Pales_War\"] == true  and  Variable[\"RiziaDLC.PostIncident_Border_JointInvestigation\"] == true)) == false)","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"},{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.PostIncident_Border_JointInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":25},{"convId":368,"nodeId":26},{"convId":368,"nodeId":27}]},"18":{"id":18,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"Am I supposed to be impressed?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":19},{"convId":368,"nodeId":20},{"convId":368,"nodeId":21}]},"19":{"id":19,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Indeed. You should be.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":82}]},"20":{"id":20,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It is just part of the protocol, as you know.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":82}]},"21":{"id":21,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Well... It doesn't really matter, Your Grace.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":82}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Me too, Your Grace. And now, you're going to hear me out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":30}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Good. Because I wanted to talk to you about something.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":30}]},"24":{"id":24,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm afraid I'm not bringing good news, Your Grace.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":30}]},"25":{"id":25,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Given the circumstances, I never thought I would be giving you a personal phone call. But here we are.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":29}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Me neither. So listen carefully.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":29}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Well... I'm not bringing good news, Your Grace.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":28}]},"28":{"id":28,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"I wasn't expecting anything less.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":82}]},"29":{"id":29,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"I'm listening.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":82}]},"30":{"id":30,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"I'm listening.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":31}]},"31":{"id":31,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"So... What did you want to tell me, Your Majesty?\"","conditionsRaw":"(Variable[\"RiziaDLC.War_Incident_Border\"] == true) == false","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":33},{"convId":368,"nodeId":36},{"convId":368,"nodeId":37},{"convId":368,"nodeId":38}]},"32":{"id":32,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Even after Pales' horrific actions, I am showing you my respect by opening communications. Let that be clear.\"","conditionsRaw":"Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_Pales_ANDORArbitration\"] == true","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_Pales_ANDORArbitration","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":45}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":34},{"convId":368,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_Pales_ANDORArbitration\"] == true","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_Pales_ANDORArbitration","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":32}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.War_Incident_Border\"] == true  or  Variable[\"RiziaDLC.War_Incident_Naval\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_Pales_ANDORArbitration\"] == true) == false","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"},{"var":"RiziaDLC.War_Incident_Naval","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_Pales_ANDORArbitration","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Please listen to me very carefully. This is your last chance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":45}]},"37":{"id":37,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am giving you a gentlemanly head start by informing you of my decision to invade Pales, Your Grace.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":40}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I wanted to offer you a way out. Surrender the duchy and swear fealty to the Rizian crown, so we can be stronger together.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":39}]},"39":{"id":39,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"Hah... You can't be serious.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":41}]},"40":{"id":40,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"No... You can't be serious.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":41}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"There was a brief silence.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":44},{"convId":368,"nodeId":42},{"convId":368,"nodeId":43}]},"42":{"id":42,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"There are no jokes, Your Grace. Pales has become a rogue nation with you at its head. Rizia will militarily intervene -- if you don't comply.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":48}]},"43":{"id":43,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The quicker you grasp the reality of the situation the better, Your Grace. I'm announcing the invasion of Pales.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":47}]},"44":{"id":44,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"But I am. So listen to me very carefully.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":45}]},"45":{"id":45,"speaker":"Narrator","isPlayerChoice":false,"text":"He went silent.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":58},{"convId":368,"nodeId":54},{"convId":368,"nodeId":50},{"convId":368,"nodeId":46},{"convId":368,"nodeId":57}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This is not a joke, Your Grace. Pales has become a rogue nation with you at its head. Rizia will militarily intervene -- if you don't comply.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":48}]},"47":{"id":47,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"What?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":66}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":60},{"convId":368,"nodeId":59},{"convId":368,"nodeId":61},{"convId":368,"nodeId":62}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm sure I don't need to remind you of how much stronger the Rizian Armed Forces are compared to Pales' armies...\"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":56}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":51},{"convId":368,"nodeId":52}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":49}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":53}]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm sure I don't need to remind you of how much larger Rizia is than Pales...\"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Strong","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Overwhelming","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":56}]},"54":{"id":54,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am aware of your intentions to let the western powers settle in our region in exchange for your own security. I will not allow that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":55}]},"55":{"id":55,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"What are you talking about?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":48}]},"56":{"id":56,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"And?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":48}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm offering a peaceful way out from your dire situation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":48}]},"58":{"id":58,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I cannot allow you to become a threat to our energy industry. You must understand my situation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":48}]},"59":{"id":59,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I only want you to swear allegiance to the Rizian crown and reunite Pales with Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":63}]},"60":{"id":60,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You will surrender the Aureus field to Rizia completely.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":63}]},"61":{"id":61,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You will surrender all the territories except the city of Pales to Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":63}]},"62":{"id":62,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The quicker you grasp the reality of the situation the better, Your Grace. I'm announcing the invasion of Pales.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":47}]},"63":{"id":63,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"You must be insane if you think I'll give in to your threats.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":72},{"convId":368,"nodeId":69},{"convId":368,"nodeId":70},{"convId":368,"nodeId":71}]},"64":{"id":64,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"Pales stood against the forces of your father, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":65}]},"65":{"id":65,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"If you insist on repeating his mistakes, we will stand against you as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":76},{"convId":368,"nodeId":73},{"convId":368,"nodeId":74},{"convId":368,"nodeId":75}]},"66":{"id":66,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"We can't lead our countries to war. Peace must be maintained by any means necessary.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":68},{"convId":368,"nodeId":67}]},"67":{"id":67,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It's too late for that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":63}]},"68":{"id":68,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If you want peace... Listen to me very carefully.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":60},{"convId":368,"nodeId":59},{"convId":368,"nodeId":61}]},"69":{"id":69,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Think of your people, Axel. Think of the destruction your people will suffer. Surrender before it's too late.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":64}]},"70":{"id":70,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You are right. I am insane. But I thought you were cleverer than that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":64}]},"71":{"id":71,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You still dare insult me? You will pay for this, Duke Reinhart.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":64}]},"72":{"id":72,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That's it, then. It's war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":64}]},"73":{"id":73,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Remember: I gave you a choice, and you refused. You will regret it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":77}]},"74":{"id":74,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This time it will be very different.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":77}]},"75":{"id":75,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am sorry it had to come to this, Axel. I hope you'll survive the war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":77}]},"76":{"id":76,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Have a good day, Axel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":77}]},"77":{"id":77,"speaker":"Narrator","isPlayerChoice":false,"text":"I hung up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":88}]},"78":{"id":78,"speaker":"Narrator","isPlayerChoice":false,"text":"And just like that, the Second Pales War had begun.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":90}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":80},{"convId":368,"nodeId":81}]},"80":{"id":80,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true  and  Variable[\"RiziaDLC.PostIncident_Border_JointInvestigation\"] == true)","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.PostIncident_Border_JointInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":17}]},"81":{"id":81,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"((Variable[\"RiziaDLC.Pales_War\"] == true  and  Variable[\"RiziaDLC.PostIncident_Border_JointInvestigation\"] == true)) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.PostIncident_Border_JointInvestigation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":13}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":83},{"convId":368,"nodeId":84}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.War_Incident_Border\"] == true","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":85}]},"84":{"id":84,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.War_Incident_Border\"] == true) == false","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":31}]},"85":{"id":85,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"The world knows it was Rizia who was behind the incident at our border, Your Majesty.\"","conditionsRaw":"Variable[\"RiziaDLC.War_Incident_Border\"] == true","variablesRead":[{"var":"RiziaDLC.War_Incident_Border","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":86}]},"86":{"id":86,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"And yet you decided not to even acknowledge it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":32},{"convId":368,"nodeId":36},{"convId":368,"nodeId":37},{"convId":368,"nodeId":38}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":4}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":78}]},"89":{"id":89,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":368,"nodeId":3}]},"90":{"id":90,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Pales_War","op":"=","value":"true"},{"var":"RiziaDLC.Diplomacy_Pales_NegotiatingPower","op":"=","value":"-100"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Pales","op":"=","value":"false"}],"outgoingIds":[{"convId":368,"nodeId":91}]},"91":{