{"conversationId":390,"title":"Rizia/Turn 7/BFF Convo (Friendly)","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":76}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":389,"nodeId":1370}]},"3":{"id":3,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"I suggest that you take advantage of Rumburg's contacts within the Bludish Freedom Front.\"","conditionsRaw":"Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":4},{"convId":390,"nodeId":5},{"convId":390,"nodeId":10}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Bluds? But they're terrorists.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":21}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":6},{"convId":390,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":9}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Those Golcondists? Never.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":24}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That's it? Of course I welcome the opportunity to assist devout Wruhecists in need.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":22}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I still don't see how that will help us in any way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":11}]},"11":{"id":11,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"It's simple, really.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":50}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":13},{"convId":390,"nodeId":14}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Military_DerdianMercenaries_Zille\"] == true","variablesRead":[{"var":"RiziaDLC.Resources_Military_DerdianMercenaries_Zille","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Military_DerdianMercenaries_Zille\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Resources_Military_DerdianMercenaries_Zille","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":17}]},"15":{"id":15,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"As loathe as I am to suggest violence as a solution to the Zille conundrum...  an internal resistance effort from the BFF could work in perfect concert with the Derdian mercenaries already present in the region.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Military_DerdianMercenaries_Zille\"] == true","variablesRead":[{"var":"RiziaDLC.Resources_Military_DerdianMercenaries_Zille","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":31},{"convId":390,"nodeId":32},{"convId":390,"nodeId":33},{"convId":390,"nodeId":91}]},"16":{"id":16,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"I am still loathe to suggest violence as a solution to the Zille conundrum. But in the absence of an agreement with President Smolak, an internal resistance might be our last hope.\"","conditionsRaw":"((Variable[\"RiziaDLC.Resources_Military_DerdianMercenaries_Zille\"] == true) == false) and (Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true)","variablesRead":[{"var":"RiziaDLC.Resources_Military_DerdianMercenaries_Zille","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":31},{"convId":390,"nodeId":27},{"convId":390,"nodeId":33},{"convId":390,"nodeId":91}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":18},{"convId":390,"nodeId":19}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":16}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":20}]},"20":{"id":20,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"I am loathe to suggest violence as a solution to the Zille conundrum. Especially since Wehlen may yet return the region through diplomatic means.\"","conditionsRaw":"((Variable[\"RiziaDLC.Resources_Military_DerdianMercenaries_Zille\"] == true) == false) and ((Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Resources_Military_DerdianMercenaries_Zille","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":31},{"convId":390,"nodeId":32},{"convId":390,"nodeId":33},{"convId":390,"nodeId":91}]},"21":{"id":21,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"They are a persecuted minority fighting an oppressive government.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":23}]},"22":{"id":22,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"And they, in turn, can assist you in the reclamation of Zille.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":101}]},"23":{"id":23,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"And their struggle can, conveniently, be channeled towards Zille.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":101}]},"24":{"id":24,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Try to see past their religion and empathize with their struggle against the Wehzek government.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":25}]},"25":{"id":25,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"A struggle that can, conveniently, be channeled towards Zille.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":101}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't want the BFF getting in the way of our existing resistance plans.\"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Diplomacy_Zille_ATAActive\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_Zille_SuOminaActive\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_Zille_ATAActive","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_Zille_SuOminaActive","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":39}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":28},{"convId":390,"nodeId":29}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Diplomacy_Zille_ATAActive\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_Zille_SuOminaActive\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_Zille_ATAActive","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_Zille_SuOminaActive","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":26}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Diplomacy_Zille_ATAActive\"] == true  or  Variable[\"RiziaDLC.Situation_Diplomacy_Zille_SuOminaActive\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_Zille_ATAActive","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_Zille_SuOminaActive","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"30":{"id":30,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The BFF would be active in Zille sooner or later, anyway. We'd just be giving them a nudge.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false  and  Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"},{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":37}]},"31":{"id":31,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The BFF have their own fight going on. I don't want to interfere with it one way or another.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":40}]},"32":{"id":32,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If we funded the BFF and Smolak found out about it, he'd have an excuse to hold on to Zille forever.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":35}]},"33":{"id":33,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Why do I get the feeling you're trying to use both Rizia and the BFF toward your own ends, Your Excellency?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":34}]},"34":{"id":34,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Don't be so cynical. I see an opportunity for our interests to align. That's all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":81},{"convId":390,"nodeId":43}]},"35":{"id":35,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"And who would tell him? Do you run that leaky of a ship, Your Majesty?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":81},{"convId":390,"nodeId":43}]},"36":{"id":36,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Suit yourself, Your Majesty. It was just a suggestion.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":102}]},"37":{"id":37,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Exactly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":81},{"convId":390,"nodeId":43}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No... I don't like this. We'll figure out another way to retake Zille.\"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":36}]},"39":{"id":39,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Ah, well. I don't know what else is happening in Zille. I merely saw an opportunity for our interests to align.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":81},{"convId":390,"nodeId":43}]},"40":{"id":40,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"The BFF only exists due to foreign powers interfering in Bludia. It's only right that we help them tip the scales in the other direction.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":81},{"convId":390,"nodeId":43}]},"41":{"id":41,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"You don't have to twist my arm, Your Excellency. I'll fund the Bludish Freedom Front, if you can promise me they'll help us 'liberate' Zille.\" [-1 Budget]","conditionsRaw":"(Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false) and ((Variable[\"RiziaDLC.Resources_Budget\"] < 0) == false)","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"},{"var":"RiziaDLC.Resources_Budget","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":89}]},"42":{"id":42,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I cannot agree to this plan in good conscience. I'll be damned to hell before I help Golcondist sinners spread their twisted gospel.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false  and  Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"},{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":47}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":44},{"convId":390,"nodeId":45}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":84}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false) == false","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":98}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'd love to agree to this. But I don't have the budget for it.\"","conditionsRaw":"(Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false) and (Variable[\"RiziaDLC.Resources_Budget\"] < 0)","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"},{"var":"RiziaDLC.Resources_Budget","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":88}]},"47":{"id":47,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Oh, my.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":48}]},"48":{"id":48,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"I knew you were taking Rizia in a more religious direction, but to hear such zealotry with my own ears...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":49},{"convId":390,"nodeId":54},{"convId":390,"nodeId":56}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Zealotry? I am telling the objective truth. If you could only look beyond the narrow worldview of St. Dast, you would agree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":62}]},"50":{"id":50,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Up to this point, we have been aiding the Bluds' liberation efforts in the north of Wehlen. But I see no reason why their struggle can't be directed southward as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":101}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":52},{"convId":390,"nodeId":53}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Law_GolcondistBlasphemy\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_Law_GolcondistBlasphemy","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":68}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Law_GolcondistBlasphemy\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_Law_GolcondistBlasphemy","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":70}]},"54":{"id":54,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You should consider the same, Your Excellency. Your secularization reforms will lead Rumburg to ruin.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":63}]},"55":{"id":55,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"If I may, Your Excellency... Zille has nothing to do with the former Greater Bludia region. Why would the BFF get involved there?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":51}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It is not too late for you to embrace Wruhecism either, Beatrice. Your sister was so happy after she saw the light.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":57}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":58},{"convId":390,"nodeId":59}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_LovedWife\"] == false","variablesRead":[{"var":"RiziaDLC.Prologue_LovedWife","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":94}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_LovedWife\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Prologue_LovedWife","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":61}]},"60":{"id":60,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"My sister despised your silly religion almost as much as she despised you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":65}]},"61":{"id":61,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"My sister was happy with you. Wruhecism had nothing to do with it.\"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_LovedWife\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Prologue_LovedWife","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":65}]},"62":{"id":62,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"I... I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":95}]},"63":{"id":63,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"As valuable as religion is to me personally, it must be separated from the state if my nation is to be taken seriously. I'm surprised Mr. Esquibel hasn't told you the same.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":67}]},"64":{"id":64,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"Rizia's religious governance is between the King and our Grand Wiseman. I wouldn't presume to have a say in such matters.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":75}]},"65":{"id":65,"speaker":"Narrator","isPlayerChoice":false,"text":"Laurento's face flushed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":66}]},"66":{"id":66,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"The King has turned down your offer, Your Excellency. No need to bring up personal matters.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":104}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"Laurento grew indignant.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":64}]},"68":{"id":68,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"You have established Rizia as a safe haven for their so-called religion. Besides which...\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Law_GolcondistBlasphemy\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_Law_GolcondistBlasphemy","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":73}]},"69":{"id":69,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"You have shown yourself to be no great friend to Wiktor Smolak. Besides which...\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Law_GolcondistBlasphemy\"] == false) == false) and (Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true)","variablesRead":[{"var":"RiziaDLC.Policy_Law_GolcondistBlasphemy","op":"==","value":"false"},{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":73}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":71},{"convId":390,"nodeId":72}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":69}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":73}]},"73":{"id":73,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Any action that destabilizes the Smolak regime will help the Bludish cause, no matter where it is carried out.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Law_GolcondistBlasphemy\"] == false) == false) and ((Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Policy_Law_GolcondistBlasphemy","op":"==","value":"false"},{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":74}]},"74":{"id":74,"speaker":"Narrator","isPlayerChoice":false,"text":"Laurento pondered over this for a moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":12}]},"75":{"id":75,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"His Majesty has turned down your offer. Let's leave it at that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":104}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"She leaned forward and spoke confidentially.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":77}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":78},{"convId":390,"nodeId":79}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":3}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false) == false","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":80}]},"80":{"id":80,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"I suggest that you assist Rumburg in funding the Bludish Freedom Front.\"","conditionsRaw":"(Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false) == false","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":4},{"convId":390,"nodeId":5},{"convId":390,"nodeId":10}]},"81":{"id":81,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":82},{"convId":390,"nodeId":83}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":38}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":87}]},"84":{"id":84,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":85},{"convId":390,"nodeId":86}]},"85":{"id":85,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] < 0","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":46}]},"86":{"id":86,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":41}]},"87":{"id":87,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We still have a chance to get Zille back fair and square. If that fails, you might hear from me again.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_AgreementRefused\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_AgreementRefused","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":90}]},"88":{"id":88,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Then we'll have to leave it be. Rizia must ante up to have a stake in this game.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":102}]},"89":{"id":89,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"I cannot control their actions completely, of course. But as I said, I will do my very best.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":97}]},"90":{"id":90,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Understood.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":102}]},"91":{"id":91,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":92},{"convId":390,"nodeId":93}]},"92":{"id":92,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false  and  Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"},{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":42}]},"93":{"id":93,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw\"] == false  and  Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Religion_RemoveGolcondistBlasphemyLaw","op":"==","value":"false"},{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":30}]},"94":{"id":94,"speaker":"Narrator","isPlayerChoice":false,"text":"Her face contorted into a snarl.","conditionsRaw":"Variable[\"RiziaDLC.Prologue_LovedWife\"] == false","variablesRead":[{"var":"RiziaDLC.Prologue_LovedWife","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":60}]},"95":{"id":95,"speaker":"Narrator","isPlayerChoice":false,"text":"Laurento hurriedly cut in.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":96}]},"96":{"id":96,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"Your Excellency, the King has turned down your offer. Perhaps it's best to leave it at that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":104}]},"97":{"id":97,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Resources_Budget","op":"=","value":"Variable[\"RiziaDLC.Resources_Budget\"] - 1"}],"outgoingIds":[{"convId":390,"nodeId":100}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You don't have to twist my arm, Your Excellency. I want the BFF's help in Zille.\"","conditionsRaw":"(Variable[\"RiziaDLC.CountryRelation_Rumburg_Unfriendly\"] == false  and  Variable[\"RiziaDLC.CountryRelation_Rumburg_Hostile\"] == false) == false","variablesRead":[{"var":"RiziaDLC.CountryRelation_Rumburg_Unfriendly","op":"==","value":"false"},{"var":"RiziaDLC.CountryRelation_Rumburg_Hostile","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":99}]},"99":{"id":99,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Then you shall have it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":100}]},"100":{"id":100,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Zille_ViolentResistancePower","op":"=","value":"Variable[\"RiziaDLC.Zille_ViolentResistancePower\"] + 1"},{"var":"RiziaDLC.Diplomacy_Wehlen_FundBFF","op":"=","value":"true"}],"outgoingIds":[{"convId":390,"nodeId":2}]},"101":{"id":101,"speaker":"Narrator","isPlayerChoice":false,"text":"Laurento coughed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":55}]},"102":{"id":102,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"At any rate, Your Excellency, thank you for this offer. And for entrusting us with such sensitive information.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":103}]},"103":{"id":103,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Why, certainly. What are allies for?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":2}]},"104":{"id":104,"speaker":"Narrator","isPlayerChoice":false,"text":"Beatrice still looked troubled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":105}]},"105":{"id":105,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"It is a dangerous road you are traveling, Romus. I do not know how much further Rumburg can accompany you down it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":390,"nodeId":2}]}}}