{"conversationId":74,"title":"Sordland/Turn05/Personal_ReturnOfInvestment","storyPack":"StoryPack_Main","turn":5,"turnLabel":"Turn 5","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":1}]},"1":{"id":1,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":4}]},"2":{"id":2,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"“I was doing well until you gave me a call.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":163}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"I was sipping my first cup of coffee for the day when the phone lit up and rang.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":6}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"I picked up the phone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":124}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"I swore under my breath. I thought my schedule was clear for at least half an hour.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":5}]},"7":{"id":7,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“It definitely was.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":64}]},"8":{"id":8,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Mr. President. How are you doing on this fine day, if I may ask?”","conditionsRaw":"(Variable[\"BaseGame.BlackTuesdayHappened\"] == true  or Variable[\"BaseGame.SuperpowerTradeWarHappened\"] == true) == false","variablesRead":[{"var":"BaseGame.BlackTuesdayHappened","op":"==","value":"true"},{"var":"BaseGame.SuperpowerTradeWarHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":11},{"convId":74,"nodeId":10},{"convId":74,"nodeId":3}]},"9":{"id":9,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Sorry, I know it's underwhelming. I bet you wish you'd gone for a bigger buy-in earlier.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":32},{"convId":74,"nodeId":30},{"convId":74,"nodeId":26}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm fine. You?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":16}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":true,"text":"“What is it, Gus?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":15}]},"12":{"id":12,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn05_Personal_ReturnOfInvestment","op":"=","value":"true"}],"outgoingIds":[{"convId":74,"nodeId":136}]},"13":{"id":13,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.PersonalWealth","op":"=","value":"Variable[\"BaseGame.PersonalWealth\"] + 7"}],"outgoingIds":[{"convId":74,"nodeId":12}]},"14":{"id":14,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.PersonalWealth","op":"=","value":"Variable[\"BaseGame.PersonalWealth\"] + 5"}],"outgoingIds":[{"convId":74,"nodeId":12}]},"15":{"id":15,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I am calling you because I just heard from the CEO of Armadine Industries, Arron Bridges, regarding the recent initial public offering on the Ventrie City Stock Exchange.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":92}]},"16":{"id":16,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Business as usual on my end. Thanks for asking.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":15}]},"17":{"id":17,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.PersonalWealth","op":"=","value":"Variable[\"BaseGame.PersonalWealth\"] + 3"}],"outgoingIds":[{"convId":74,"nodeId":12}]},"18":{"id":18,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Oh, come on. You are the president! Nobody got to that seat without taking massive risks.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":64}]},"19":{"id":19,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Well. I will take that. Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":64}]},"20":{"id":20,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“As you might've guessed, it's about our massive venture investment of 3000 shares worth nearly three million ren.”","conditionsRaw":"Variable[\"BaseGame.Decision_Turn01_PersonalInvestment_Spend3\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn01_PersonalInvestment_Spend3","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":21}]},"21":{"id":21,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":22},{"convId":74,"nodeId":23}]},"22":{"id":22,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.SuperpowerTradeWarHappened\"] == true  or  Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true","variablesRead":[{"var":"BaseGame.SuperpowerTradeWarHappened","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":24}]},"23":{"id":23,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.SuperpowerTradeWarHappened\"] == true  or  Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false","variablesRead":[{"var":"BaseGame.SuperpowerTradeWarHappened","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":67}]},"24":{"id":24,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Thanks to the ongoing trade war, I was told that the Armadine stock prices plunged after the IPO. The markets are very volatile right now.”","conditionsRaw":"Variable[\"BaseGame.SuperpowerTradeWarHappened\"] == true  or  Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true","variablesRead":[{"var":"BaseGame.SuperpowerTradeWarHappened","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":27}]},"25":{"id":25,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“You will love it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":80}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“I'm not much of a risk taker.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":18}]},"27":{"id":27,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Don't worry. Our stocks are still secure and they advised us not to sell because a recovery is expected in the near future.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":28}]},"28":{"id":28,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“However, this means that we have not made any profits, and on the contrary have lost fifty percent of the value compared to our initial purchase.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":31}]},"29":{"id":29,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“It is. Trust me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":25}]},"30":{"id":30,"speaker":"Player","isPlayerChoice":true,"text":"“Darn it. Yes, I do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":64}]},"31":{"id":31,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I'm sorry, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":82},{"convId":74,"nodeId":34},{"convId":74,"nodeId":33},{"convId":74,"nodeId":35},{"convId":74,"nodeId":86}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“It was a good start for sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":7}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"“I knew I shouldn't have listened to your advice.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":38}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“Why are you apologizing? It's not your fault.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":39}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"“You know what they say. Don't invest what you can't afford to lose.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":42}]},"36":{"id":36,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“It was risky, yes. But look at where we are now!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":70},{"convId":74,"nodeId":65},{"convId":74,"nodeId":63}]},"37":{"id":37,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Isn't that great?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":43},{"convId":74,"nodeId":40},{"convId":74,"nodeId":41}]},"38":{"id":38,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“At the time, I thought Armadine was a sure bet. This trade war came out of nowhere.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":44}]},"39":{"id":39,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Thank you for understanding the unfortunate situation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":44}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"“Great news! So, how much did we gain?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":25}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"“Yes. It's great. Go on.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":25}]},"42":{"id":42,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Wasn't Konrath Koronti the one that said that? He was a visionary for the free world for sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":44}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"“This better be worth it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":29}]},"44":{"id":44,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Regardless, we still have a hold on our stocks.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":47}]},"45":{"id":45,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“The shares have doubled in price at the IPO in the VCSE and we will soon receive the profits made from the investment.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":37}]},"46":{"id":46,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Exactly. Electronics manufacturing has a great future and Armadine seems to have a head start.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":64}]},"47":{"id":47,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I am confident once the effects of this nasty trade war subside, we'll recover the value of our shares and then some.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":107},{"convId":74,"nodeId":100},{"convId":74,"nodeId":102}]},"48":{"id":48,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I am very pleased to say that we have made gains!”","conditionsRaw":"((Variable[\"BaseGame.SuperpowerTradeWarHappened\"] == true  or  Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false) and ((Variable[\"BaseGame.BlackTuesdayHappened\"] == true) == false)","variablesRead":[{"var":"BaseGame.SuperpowerTradeWarHappened","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"},{"var":"BaseGame.BlackTuesdayHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":45}]},"49":{"id":49,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“That's all I wanted to talk to you about, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Gus_CutLosses","op":"=","value":"true"}],"outgoingIds":[{"convId":74,"nodeId":51},{"convId":74,"nodeId":59},{"convId":74,"nodeId":52}]},"50":{"id":50,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Goodbye for now.”","conditionsRaw":"Variable[\"BaseGame.Relations_Gus_CutLosses\"] == true","variablesRead":[{"var":"BaseGame.Relations_Gus_CutLosses","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":66}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“Remind me never to do business with you ever again.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":57}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"“Keep me up to date on other opportunities.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":58}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"“I knew it was the right call to trust you on this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":113}]},"54":{"id":54,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":55},{"convId":74,"nodeId":56}]},"55":{"id":55,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn01_PersonalInvestment_Spend2\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn01_PersonalInvestment_Spend2","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":148}]},"56":{"id":56,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn01_PersonalInvestment_Spend2\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn01_PersonalInvestment_Spend2","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":152}]},"57":{"id":57,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Again, I am so sorry.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":156}]},"58":{"id":58,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I'll let you know immediately when new opportunities arise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":156}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“Very well. Talk to you later then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":156}]},"60":{"id":60,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":61},{"convId":74,"nodeId":62}]},"61":{"id":61,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn01_PersonalInvestment_Spend1\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn01_PersonalInvestment_Spend1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":144}]},"62":{"id":62,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn01_PersonalInvestment_Spend1\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn01_PersonalInvestment_Spend1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":54}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“It's all thanks to you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":19}]},"64":{"id":64,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I assure you, this will pale in comparison to what we will do together in the future.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":135}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"“Some things are just worth taking the risk for.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":46}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"The line dropped.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":141}]},"67":{"id":67,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":68},{"convId":74,"nodeId":69}]},"68":{"id":68,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.BlackTuesdayHappened\"] == true","variablesRead":[{"var":"BaseGame.BlackTuesdayHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":71}]},"69":{"id":69,"speaker":"Gus Manger","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.BlackTuesdayHappened\"] == true) == false","variablesRead":[{"var":"BaseGame.BlackTuesdayHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":48}]},"70":{"id":70,"speaker":"Player","isPlayerChoice":true,"text":"“I have a good eye for investments.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":79}]},"71":{"id":71,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Instead of suffering losses due to market volatility like most public firms in Merkopa, we actually came out unscathed. Arcasia wasn't influenced by the Black Tuesday crash!”","conditionsRaw":"((Variable[\"BaseGame.SuperpowerTradeWarHappened\"] == true  or  Variable[\"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia\"] == true) == false) and (Variable[\"BaseGame.BlackTuesdayHappened\"] == true)","variablesRead":[{"var":"BaseGame.SuperpowerTradeWarHappened","op":"==","value":"true"},{"var":"BaseGame.Reform_EmergencyDecree_Embargo_Arcasia","op":"==","value":"true"},{"var":"BaseGame.BlackTuesdayHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":108}]},"72":{"id":72,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“It could have been much worse, but we got out of it with the best outcome. Isn't that great?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":74},{"convId":74,"nodeId":73},{"convId":74,"nodeId":53}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"“Great news! So, how much did we gain?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":78}]},"74":{"id":74,"speaker":"Player","isPlayerChoice":true,"text":"“Unbelievable. How can you say that when the Sordish economy is crippled?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":76}]},"75":{"id":75,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I think so too.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":156}]},"76":{"id":76,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“You are right, Mr. President. I'm sorry.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":80}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"“This is the beginning of a good partnership. Keep it up.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":75}]},"78":{"id":78,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“You're going to want to sit down.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":80}]},"79":{"id":79,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“That, you do. Did you read Konrath Koronti's book on entrepreneurship, by any chance? Everything I know about the market, I learned from him.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":74,"nodeId":64}]},"80":{"id":80,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“In total w