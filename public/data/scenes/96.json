{"conversationId":96,"title":"Sordland/Turn07/VoteWon","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":8}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":9}]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"\"That's a good start. If she's willing to talk, she's willing to cooperate.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":68}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":5},{"convId":96,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Assembly_Vote\"] >= 20","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">=","value":"20"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Assembly_Vote\"] >= 20) == false","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">=","value":"20"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":14}]},"7":{"id":7,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I'm sure the Assembly vote must count for something... I mean, it passed by ninety percent, for God's sake!\"","conditionsRaw":"Variable[\"BaseGame.Reform_Assembly_Vote\"] >= 20","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">=","value":"20"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":20}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian, Petr and I convened on the massive balcony of the palace. It was nice to catch a breeze in the increasing summer heat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":17}]},"9":{"id":9,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"We barely squeaked by with the Assembly. It was a tough win...\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Assembly_Vote\"] >= 20) == false) and ((Variable[\"BaseGame.Reform_Assembly_Vote\"] > 16) == false)","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">=","value":"20"},{"var":"BaseGame.Reform_Assembly_Vote","op":">","value":"16"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":24}]},"10":{"id":10,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We may need to take some extreme measures, though.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":4}]},"11":{"id":11,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"If we cannot get Mrs. Edmond's centrists, we will have no choice but to reach out to the Old Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":4}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian looked at both of us with a raised eyebrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":83}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"\"Well, she could probably pass as one...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":48}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":15},{"convId":96,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Assembly_Vote\"] > 16","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">","value":"16"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":177}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Assembly_Vote\"] > 16) == false","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">","value":"16"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":9}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"Both had grins on their faces, but Petr's got larger as he kept recounting our success in the Assembly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":25}]},"18":{"id":18,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Hey, we won the vote comfortably. I'm sure that counts for something.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Assembly_Vote\"] >= 20) == false) and (Variable[\"BaseGame.Reform_Assembly_Vote\"] > 16) and (Variable[\"BaseGame.Reform_Gloria_Convinced\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">=","value":"20"},{"var":"BaseGame.Reform_Assembly_Vote","op":">","value":"16"},{"var":"BaseGame.Reform_Gloria_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":22}]},"19":{"id":19,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"He refused to speak with us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":66}]},"20":{"id":20,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"They wouldn't dare reject such a popular proposal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":27}]},"21":{"id":21,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"By convincing all of the other Justices. Every single one.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":11}]},"22":{"id":22,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"There is at least some pressure on the Court now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":181}]},"23":{"id":23,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"...Now we have the council of grumpy old men in our way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":28}]},"24":{"id":24,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"The Old Guard won't have any trouble justifying a rejection.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":181}]},"25":{"id":25,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Fellas! The first obstacle has been cleared! Congratulations to all of us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":105},{"convId":96,"nodeId":104},{"convId":96,"nodeId":103}]},"26":{"id":26,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We've come this far. Anything is possible.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":11}]},"27":{"id":27,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It was indeed a historic vote. The President has accomplished something even Tarquin Soll had trouble with.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":29}]},"28":{"id":28,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I have to say, that's a fitting description for the Court. But unfortunately for us, they are more than that. They're our largest obstacle yet.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":39}]},"29":{"id":29,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But this may also make the Court see you as the ultimate threat. I wouldn't be so relaxed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":36},{"convId":96,"nodeId":35},{"convId":96,"nodeId":34}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Indeed. But then again, so was securing the Assembly vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":11}]},"31":{"id":31,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The Court still sees us as a threat. They will not be persuaded so easily.\"","conditionsRaw":"Variable[\"BaseGame.Reform_BludishRights_Amendment_Proposal\"] == false","variablesRead":[{"var":"BaseGame.Reform_BludishRights_Amendment_Proposal","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":36},{"convId":96,"nodeId":35},{"convId":96,"nodeId":34}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"\"It's going to be tough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":30}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"\"If the Old Guard is against us... How do we even get six votes?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":21}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"\"If the Justices fail us at this stage, I'm sure the people will see them for who they really are.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":43}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"\"Don't worry. I'll talk to the Justices and convince them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":49}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"\"We never expected this to be easy. Nothing has changed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":47}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"\"Do you think we can do it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":26}]},"38":{"id":38,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"She's a tough woman. I doubt that she'll be persuaded at this point.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":56}]},"39":{"id":39,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Also... You are forgetting about Mrs. Edmonds. They're not all grumpy old men.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":65},{"convId":96,"nodeId":63},{"convId":96,"nodeId":13},{"convId":96,"nodeId":61}]},"40":{"id":40,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"And Nia was pretty adamant about her position against the proposal. That's already one vote lost out of eleven.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":78},{"convId":96,"nodeId":79},{"convId":96,"nodeId":82},{"convId":96,"nodeId":100}]},"41":{"id":41,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Mrs. Morgna has been helping out with the lobbying of the Court. She has been speaking with Mrs. Edmonds, and we believe she's our key figure on the inside.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Reformist_Path\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reformist_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":93}]},"42":{"id":42,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Yeah...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":67}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I wouldn't be so sure, sir. They control more than the Court, as you know.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":45}]},"44":{"id":44,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"So... That gives us three votes to start with.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":50}]},"45":{"id":45,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And the average citizen has no interest in such matters. The public won't be very helpful.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":53}]},"46":{"id":46,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We've come this far. Anything is possible.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":10}]},"47":{"id":47,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That's true, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":53}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr started laughing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":80}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I believe in you, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":53}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":51},{"convId":96,"nodeId":52}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":76}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":64}]},"53":{"id":53,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"In any case, we should start with our best bet. I already asked Nia to arrange a meeting with Mrs. Edmonds.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":57}]},"54":{"id":54,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We surely cannot. We'll need to work with Mr. Garaci and Mrs. Edmonds to undermine Orso.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":96}]},"55":{"id":55,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It's a tough spot to be in. As I said, we have no other way but to convince Mr. Hawker's fellow Old Guard members behind his back.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":10}]},"56":{"id":56,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Also, even if she was with us, that wouldn't change the current climate.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":64}]},"57":{"id":57,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"She's willing to speak with you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":3},{"convId":96,"nodeId":60},{"convId":96,"nodeId":59}]},"58":{"id":58,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Wait. Did you just call Nia a grumpy old woman?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":85}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"\"How about Heron Garaci?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":19}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"\"Good. I'll make sure she joins us. Just watch.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":68}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"\"Come on, gentlemen, let's not overthink this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":42}]},"62":{"id":62,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Well, Nia has the ears of Justices Dalton and Martin. So, we could assume that we have their support as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":44}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"\"The real trouble is their big daddy Hawker. We can't let him control the Court against us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":54}]},"64":{"id":64,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm not trying to be pessimistic, but Mrs. Morgna cannot do this alone. Let's not forget about Mr. Hawker. And his loyalists.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":75}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"\"...And Mrs. Morgna. She's technically a member too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":58}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He refused to speak with you, Petr. But if the president can have a one-on-one meeting with him, I'm sure he'll open up.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":2}]},"67":{"id":67,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"With all due respect, sir, this is the most crucial step in passing your reforms. It cannot be overthought.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":96}]},"68":{"id":68,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I'm sure you'll convince her.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":2}]},"69":{"id":69,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Indeed. But then again, so was winning over the Assembly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":10}]},"70":{"id":70,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I'm afraid she is. I knew she would be a headache...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":77}]},"71":{"id":71,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Mrs. Morgna has been reluctant to help with the lobbying of the Court. But she has accepted to at least try and convince the Justices to organize a meeting with us.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reformist_Path\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reformist_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":73}]},"72":{"id":72,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"She has the ears of Justices Dalton and Martin. So, we could assume that we have their support as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":44}]},"73":{"id":73,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Which means our lobbying efforts have not yet borne fruit. It will be up to you and Mrs. Morgna, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":40}]},"74":{"id":74,"speaker":"Player","isPlayerChoice":true,"text":"\"It's fine. We can do it together. I trust Nia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":50}]},"75":{"id":75,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We'll still need to reach out to the Old Guard and the moderates in order to reach six votes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":37},{"convId":96,"nodeId":33},{"convId":96,"nodeId":32}]},"76":{"id":76,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Let's not over-assume, Petr. Mrs. Morgna has already made her position known. She will not support the proposal.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":84}]},"77":{"id":77,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Not to make it sound more depressing, but it's not only about her. Let's not forget about Mr. Hawker. And his loyalists.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":90}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"\"So, she's serious about voting against the proposal?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":70}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"\"I can't let her sabotage our efforts. She's a minister of my cabinet, she *will* give me her vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":86}]},"80":{"id":80,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Ouch.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":12}]},"81":{"id":81,"speaker":"Player","isPlayerChoice":true,"text":"\"It's going to be tough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":69}]},"82":{"id":82,"speaker":"Player","isPlayerChoice":true,"text":"\"It's fine. We can do it without her.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":77}]},"83":{"id":83,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Anyway...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":87}]},"84":{"id":84,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"What? I mean... She would probably support us after that win, no?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":38}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"He laughed. Lucian look at him with a raised eyebrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":83}]},"86":{"id":86,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I don't know about that, Anton. You have to convince her yourself, if you can.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":77}]},"87":{"id":87,"speaker":"Narrator","isPlayerChoice":false,"text":"He cleared his throat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":92}]},"88":{"id":88,"speaker":"Player","isPlayerChoice":true,"text":"\"If the reformist justices are against us along with the Old Guard... How do we even get six votes?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":55}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"\"Do you think we can do it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":46}]},"90":{"id":90,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"That's four or five votes gone, right from the start.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":94}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"\"Hasn't she managed to lobby anyone else?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":72}]},"92":{"id":92,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"About the Court...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":96}]},"93":{"id":93,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Our lobbying efforts are continuing positively, but they have yet to yield concrete results. It will be ultimately up to Mrs. Morgna and you to persuade the Justices, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":95}]},"94":{"id":94,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Yes. We'll need to reach out to the Old Guard and the moderates in order to reach six votes. There is not much leeway.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":89},{"convId":96,"nodeId":88},{"convId":96,"nodeId":81}]},"95":{"id":95,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"And we already have Nia inside the Court. That's one vote out of eleven.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":99},{"convId":96,"nodeId":91},{"convId":96,"nodeId":74}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":97},{"convId":96,"nodeId":98}]},"97":{"id":97,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Reformist_Path\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reformist_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":41}]},"98":{"id":98,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reformist_Path\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reformist_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":71}]},"99":{"id":99,"speaker":"Player","isPlayerChoice":true,"text":"\"Which leaves us five more...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":62}]},"100":{"id":100,"speaker":"Player","isPlayerChoice":true,"text":"\"Can we even trust her to bring the other Justices to the table?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":101}]},"101":{"id":101,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I don't know, but she promised to talk Mrs. Edmonds into having a meeting with you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":102}]},"102":{"id":102,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In the end, we cannot trust anyone, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":77}]},"103":{"id":103,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you again for your hard work, Petr.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":106}]},"104":{"id":104,"speaker":"Player","isPlayerChoice":true,"text":"\"We can celebrate once we get past the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":108}]},"105":{"id":105,"speaker":"Player","isPlayerChoice":true,"text":"\"Great job, gentlemen!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":109}]},"106":{"id":106,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"It was nothing, Anton. It was mostly you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":109}]},"107":{"id":107,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"What about Tarquin Soll? Did you see him again?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":110}]},"108":{"id":108,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The president's right. The Assembly was the easy part.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":109}]},"109":{"id":109,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr leaned on the balcony railing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":107}]},"110":{"id":110,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As far as I know he's still staying in Holsord, but hasn't cared to pay his respects to President Rayne yet.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":116}]},"111":{"id":111,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But for now, let's move on.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":173}]},"112":{"id":112,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In any case, I will conduct proper investigations into this. We should know every hidden Old Guard member who is working with Soll.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":111}]},"113":{"id":113,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Okay...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":112}]},"114":{"id":114,"speaker":"Player","isPlayerChoice":true,"text":"\"He saw their faces, but didn't recognize them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":124}]},"115":{"id":115,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's not name any names now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":113}]},"116":{"id":116,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"What the hell was that all about anyway? Him appearing out of nowhere...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":150},{"convId":96,"nodeId":122},{"convId":96,"nodeId":155},{"convId":96,"nodeId":130}]},"117":{"id":117,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's just move on with our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":168}]},"118":{"id":118,"speaker":"Player","isPlayerChoice":true,"text":"\"Maybe you should have. Even Serge knew about it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":152}]},"119":{"id":119,"speaker":"Player","isPlayerChoice":true,"text":"\"What's done is done. Let's not linger in the past.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":141}]},"120":{"id":120,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm sorry that we failed to warn you he would be attending, Mr. President. We should have been informed about his arrival.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":154}]},"121":{"id":121,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Well, the laws protect him from almost anything, and allow him to be a member of the Assembly. He can still propose bills and vote for them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":148}]},"122":{"id":122,"speaker":"Player","isPlayerChoice":true,"text":"\"He came to the Assembly to make a statement. But we still won the vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":120}]},"123":{"id":123,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Oh, he did? Who were they?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":115},{"convId":96,"nodeId":114}]},"124":{"id":124,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"That's too bad.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":112}]},"125":{"id":125,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But he has no authority anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":121}]},"126":{"id":126,"speaker":"Player","isPlayerChoice":true,"text":"\"No, he didn't.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":124}]},"127":{"id":127,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes, he did.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":123}]},"128":{"id":128,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As long as he's around, he will always have influence over the republic he built. We should have seen this coming.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":125}]},"129":{"id":129,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He wished to intimidate the Assembly into rejecting our proposal, sir. And it seems to have failed. But we can't be sure. He might be here to work with the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":128}]},"130":{"id":130,"speaker":"Player","isPlayerChoice":true,"text":"\"What do you think was his real intention?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":129}]},"131":{"id":131,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course not, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":112}]},"132":{"id":132,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"He didn't see who they were, did he?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":139},{"convId":96,"nodeId":126},{"convId":96,"nodeId":127}]},"133":{"id":133,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Soll might be working behind the scenes against us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":138}]},"134":{"id":134,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"What? Me? Never!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":131}]},"135":{"id":135,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It seems some of our respected MPs already knew about this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":132}]},"136":{"id":136,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I guess not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":112}]},"137":{"id":137,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"With him around, we have to be extra careful.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":138}]},"138":{"id":138,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We cannot let the party slip from our grasp.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":159},{"convId":96,"nodeId":158},{"convId":96,"nodeId":157}]},"139":{"id":139,"speaker":"Player","isPlayerChoice":true,"text":"\"It doesn't matter now, does it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":136}]},"140":{"id":140,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Still, sir, we should have been more aware. But it's time to plan ahead now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":142}]},"141":{"id":141,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You're right, sir. We must plan ahead now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":142}]},"142":{"id":142,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":173}]},"143":{"id":143,"speaker":"Player","isPlayerChoice":true,"text":"\"He said he overheard some people talking about it around the Assembly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":135}]},"144":{"id":144,"speaker":"Player","isPlayerChoice":true,"text":"\"I hope you are not hiding anything from me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":134}]},"145":{"id":145,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"It smells fishy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":157},{"convId":96,"nodeId":160},{"convId":96,"nodeId":117}]},"146":{"id":146,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You're right, sir. But as long as he's here in Holsord, he can create problems for us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":175}]},"147":{"id":147,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You're right, sir. We must plan ahead now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":176}]},"148":{"id":148,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That's proper authority, if you ask me. When you are the founder of this system, you don't need to be sitting in the presidential office to have power.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":155},{"convId":96,"nodeId":172},{"convId":96,"nodeId":167},{"convId":96,"nodeId":166}]},"149":{"id":149,"speaker":"Player","isPlayerChoice":true,"text":"\"I learned it from Serge. How come MY DRIVER knows more than YOU!?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":170}]},"150":{"id":150,"speaker":"Player","isPlayerChoice":true,"text":"\"He is not a threat to us. We should focus on our tasks at hand.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":147}]},"151":{"id":151,"speaker":"Player","isPlayerChoice":true,"text":"\"It's all good.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":164}]},"152":{"id":152,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"How did Serge know, anyway?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":139},{"convId":96,"nodeId":143},{"convId":96,"nodeId":144}]},"153":{"id":153,"speaker":"Player","isPlayerChoice":true,"text":"\"That wasn't your fault.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":164}]},"154":{"id":154,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"What Lucian said. We apologize.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":151},{"convId":96,"nodeId":153},{"convId":96,"nodeId":149}]},"155":{"id":155,"speaker":"Player","isPlayerChoice":true,"text":"\"He just joined a constitutional vote. I think it's perfectly normal that he'd come out for this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":146}]},"156":{"id":156,"speaker":"Player","isPlayerChoice":true,"text":"\"It's not that important. He didn't do anything.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":140}]},"157":{"id":157,"speaker":"Player","isPlayerChoice":true,"text":"\"I just still can't believe I didn't know he was coming.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":120}]},"158":{"id":158,"speaker":"Player","isPlayerChoice":true,"text":"\"We should organize a cabinet meeting to discuss the situation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":171}]},"159":{"id":159,"speaker":"Player","isPlayerChoice":true,"text":"\"Exactly. We must plan our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":168}]},"160":{"id":160,"speaker":"Player","isPlayerChoice":true,"text":"\"Just try to reach out to him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":169}]},"161":{"id":161,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That's what my sources say, sir. But considering he hasn't come to the Palace... I don't know what to expect.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":145}]},"162":{"id":162,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Indeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":137}]},"163":{"id":163,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":173}]},"164":{"id":164,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In a situation such as this, I would have expected Karl to report it to me. But it's no excuse. We should have done our own research.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":119},{"convId":96,"nodeId":156},{"convId":96,"nodeId":118}]},"165":{"id":165,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"No, sir. But he certainly has enormous influence.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":133}]},"166":{"id":166,"speaker":"Player","isPlayerChoice":true,"text":"\"I want to talk to him. Are you sure he's still in Holsord?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":161}]},"167":{"id":167,"speaker":"Player","isPlayerChoice":true,"text":"\"Lucian's right. He already showcased his powers at the vote. We must be careful.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":162}]},"168":{"id":168,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":163}]},"169":{"id":169,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'll do my best, sir. Let's now move on to our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":163}]},"170":{"id":170,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In a situation such as this, I would have expected Karl to report it to me. But you're right, sir. We should have done our own research.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":152}]},"171":{"id":171,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. I'll make the necessary arrangements. Let's talk about our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":163}]},"172":{"id":172,"speaker":"Player","isPlayerChoice":true,"text":"\"Are you saying he still has more authority than me?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":165}]},"173":{"id":173,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Yeah, we have the first hurdle cleared, but...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":23}]},"174":{"id":174,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":173}]},"175":{"id":175,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But let's move on for now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":174}]},"176":{"id":176,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":173}]},"177":{"id":177,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":178},{"convId":96,"nodeId":179}]},"178":{"id":178,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Gloria_Convinced\"] == true","variablesRead":[{"var":"BaseGame.Reform_Gloria_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":18}]},"179":{"id":179,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Gloria_Convinced\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Gloria_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":180}]},"180":{"id":180,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"That was too close for comfort. Can't believe we made it through.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Assembly_Vote\"] >= 20) == false) and (Variable[\"BaseGame.Reform_Assembly_Vote\"] > 16) and ((Variable[\"BaseGame.Reform_Gloria_Convinced\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":">=","value":"20"},{"var":"BaseGame.Reform_Assembly_Vote","op":">","value":"16"},{"var":"BaseGame.Reform_Gloria_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":22}]},"181":{"id":181,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":182},{"convId":96,"nodeId":183}]},"182":{"id":182,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_BludishRights_Amendment_Proposal\"] == false","variablesRead":[{"var":"BaseGame.Reform_BludishRights_Amendment_Proposal","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":31}]},"183":{"id":183,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_BludishRights_Amendment_Proposal\"] == false) == false","variablesRead":[{"var":"BaseGame.Reform_BludishRights_Amendment_Proposal","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":184}]},"184":{"id":184,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The Court still sees us as a threat. Especially now that we're removing the term 'Sord' from the constitution.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_BludishRights_Amendment_Proposal\"] == false) == false","variablesRead":[{"var":"BaseGame.Reform_BludishRights_Amendment_Proposal","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":185}]},"185":{"id":185,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'll be honest. It will be extremely difficult to persuade enough Justices.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":96,"nodeId":36},{"convId":96,"nodeId":35},{"convId":96,"nodeId":34}]}}}