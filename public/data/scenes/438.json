{"conversationId":438,"title":"Rizia/Turn 9/Pabel Extradition","storyPack":"StoryPack_Rizia","turn":9,"turnLabel":"Turn 9","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":77}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":435,"nodeId":9}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"The Derdian leader rose to leave, then sat back down with a thoughtful look on his face.","conditionsRaw":"(Variable[\"RiziaDLC.Pabel_Gone\"] == true) and (Variable[\"RiziaDLC.Turn09_DerdiaWehlenMediation_Success\"] == true  or  Variable[\"RiziaDLC.Turn09_MorellaDerdiaMediation_Success\"] == true)","variablesRead":[{"var":"RiziaDLC.Pabel_Gone","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_DerdiaWehlenMediation_Success","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_MorellaDerdiaMediation_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":4}]},"4":{"id":4,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Your Majesty... did you know that a former member of your royal household has recently claimed asylum in Derdia?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":9},{"convId":438,"nodeId":6},{"convId":438,"nodeId":12},{"convId":438,"nodeId":10}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Is it the Princess?\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Escapes\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":16}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":7},{"convId":438,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Escapes\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":5}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Escapes\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I did not know that. But it does not come as surprising news.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":29}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What? You must extradite this person immediately.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":18}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"My butler Pabel Adria, I presume? He mentioned he had friends there.\"","conditionsRaw":"Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":15}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":13},{"convId":438,"nodeId":14}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":11}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_Pabel_Together\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"15":{"id":15,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"None other.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":25}]},"16":{"id":16,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"No. A man by the name of Pabel Adria.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":25}]},"17":{"id":17,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I presume it is someone involved in Princess Vina's recent disappearance?\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":32}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":19},{"convId":438,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":22}]},"21":{"id":21,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"That may be possible.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":23}]},"22":{"id":22,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"That won't be possible.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":71}]},"23":{"id":23,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"The man, Pabel Adria, claims he will be unjustly persecuted if he returns to Rizia. But if you deem his crime worthy of punishment, you may have him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":34},{"convId":438,"nodeId":36},{"convId":438,"nodeId":35}]},"24":{"id":24,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He assisted in my daughter's disappearance. He might have information about where she is.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Escapes\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":66}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":26},{"convId":438,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":28}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":64}]},"28":{"id":28,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Mr. Adria claims he will be unjustly persecuted if he returns to Rizia. But if you deem his crime worthy of punishment by your laws, you may have him.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":34},{"convId":438,"nodeId":36},{"convId":438,"nodeId":35}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":30},{"convId":438,"nodeId":31}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":17}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":33}]},"32":{"id":32,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"This man, Pabel Adria, claims he will be unjustly persecuted if he returns to Rizia. But if you deem his crime worthy of punishment by your laws, you may have him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":34},{"convId":438,"nodeId":36},{"convId":438,"nodeId":35}]},"33":{"id":33,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Then you know that I cannot help you should you wish Pabel Adria's extradition to Rizia.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":37},{"convId":438,"nodeId":40},{"convId":438,"nodeId":41},{"convId":438,"nodeId":45}]},"34":{"id":34,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Thank you, Supreme Wiseman. Nobody betrays the King of Rizia without consequences.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":65}]},"35":{"id":35,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No, leave him be. Punishing him would accomplish nothing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":67}]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, send him here. He was complicit in my daughter's escape. He might have information about where she is.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":65}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":38},{"convId":438,"nodeId":39}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Escapes\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":24}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Escapes\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"40":{"id":40,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You don't understand. Nobody betrays the King of Rizia and gets away with it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":66}]},"41":{"id":41,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"How can you say that? Do you even know what he did?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":66}]},"42":{"id":42,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"According to the Derdian Constitution, we are obliged to offer sanctuary to those facing persecution due to their practice of the most sacred form of love.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":43}]},"43":{"id":43,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Without exception.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":49},{"convId":438,"nodeId":52},{"convId":438,"nodeId":60},{"convId":438,"nodeId":54}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Pabel_Arrested","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn09_Derdia_PabelExtradition","op":"=","value":"true"},{"var":"RiziaDLC.Relations_Pabel_Together","op":"=","value":"false"}],"outgoingIds":[{"convId":438,"nodeId":73}]},"45":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I would not expect your assistance in this matter. What happened is between Mr. Adria and myself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":57}]},"46":{"id":46,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Wruhec himself would admire your mercy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":73}]},"47":{"id":47,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We do not use such labels in Derdia. And we do not imprison men when a divine spark ignites between them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":74}]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't understand. Are you saying my butler was a homosexual?\"","conditionsRaw":"Variable[\"RiziaDLC.Relations_Pabel_Together\"] == false  and  Variable[\"RiziaDLC.Relations_Pabel_OutedToPlayer\"] == false","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"false"},{"var":"RiziaDLC.Relations_Pabel_OutedToPlayer","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":47}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":50},{"convId":438,"nodeId":51}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Relations_Pabel_Together\"] == false  and  Variable[\"RiziaDLC.Relations_Pabel_OutedToPlayer\"] == false","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"false"},{"var":"RiziaDLC.Relations_Pabel_OutedToPlayer","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":48}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_Pabel_Together\"] == false  and  Variable[\"RiziaDLC.Relations_Pabel_OutedToPlayer\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Relations_Pabel_Together","op":"==","value":"false"},{"var":"RiziaDLC.Relations_Pabel_OutedToPlayer","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[]},"52":{"id":52,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I understand. May God forgive him, then.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":74}]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Love wasn't his crime. Abetting my daughter's escape was.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Escapes\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":59}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":55},{"convId":438,"nodeId":56}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Escapes\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":53}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Escapes\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":62}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"Azmal nodded sagely.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":58}]},"58":{"id":58,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I will not ask what happened. But I hope the Lord shows you both mercy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":73}]},"59":{"id":59,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"And yet Rizia would have him punished for either.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":74}]},"60":{"id":60,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The most sacred form of love is between a man and a woman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":61}]},"61":{"id":61,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Is that what you believe, Your Majesty? Or are you parroting the words of your flawed Sanctuary?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":72}]},"62":{"id":62,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Have you ever actually been with a man, Supreme Wiseman? There's nothing sacred about it.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Escapes\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Escapes","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":63}]},"63":{"id":63,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"That is in the eye of the beholder, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":72}]},"64":{"id":64,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I do not want to put a taint on what we have accomplished today. But I unfortunately cannot assist in returning him to Rizia.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_DecriminalizeHomosexuality","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":37},{"convId":438,"nodeId":40},{"convId":438,"nodeId":41},{"convId":438,"nodeId":45}]},"65":{"id":65,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Very well. I'll give the orders when I arrive back at the Garrison.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":44}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"Azmal shook his head.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":42}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"Azmal nodded.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":46}]},"68":{"id":68,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":69},{"convId":438,"nodeId":70}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pabel_Gone\"] == true","variablesRead":[{"var":"RiziaDLC.Pabel_Gone","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":3}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pabel_Gone\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pabel_Gone","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":76}]},"71":{"id":71,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"As long as he faces danger upon returning to Rizia, Pabel Adria must remain in Derdia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":37},{"convId":438,"nodeId":40},{"convId":438,"nodeId":41}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":438,"nodeId":74}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"He stood up, shook my hand and left the suite.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Pabel_Arrested","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn09_Derdia_PabelExtradition","op":"=","value":"true"},{"var":"RiziaDLC.Relations_Pabel_Together","op":"=","value":"false"}],"outgoingIds":[{"convId":438,"nodeId":2}]},"74":{"id":74,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I will not ask you to change your kingdom's laws.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":438,"nodeId":75}]},"75":{"id":75,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But I hope that someday you and your people will see things the way we do. The way St. Wruhec intended.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":73}]},"76":{"id":76,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"May the Lord be with you.\"","conditionsRaw":"((Variable[\"RiziaDLC.Pabel_Gone\"] == true) == false) and (Variable[\"RiziaDLC.Turn09_DerdiaWehlenMediation_Success\"] == true  or  Variable[\"RiziaDLC.Turn09_MorellaDerdiaMediation_Success\"] == true) and ((Variable[\"RiziaDLC.Turn09_DerdiaWehlenMediation_Success\"] == true  or  Variable[\"RiziaDLC.Turn09_MorellaDerdiaMediation_Success\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Pabel_Gone","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_DerdiaWehlenMediation_Success","op":"==","value":"true"},{"var":"RiziaDLC.Turn09_MorellaDerdiaMediation_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":438,"nodeId":73}]},"77":{"id":7