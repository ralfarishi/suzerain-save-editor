{"conversationId":105,"title":"Sordland/Turn07/NOTES","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"\"I'm offering my help in exchange for a position in the cabinet. As the Minister of Law and Justice in the next term.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":5}]},"4":{"id":4,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"\"You know I have both the expertise and the influence. It's a huge offer, Mr. President. For both of us.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":10},{"convId":105,"nodeId":13},{"convId":105,"nodeId":11},{"convId":105,"nodeId":9}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":6},{"convId":105,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":4}]},"8":{"id":8,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"\"I think you'd also agree that Mrs. Morgna isn't doing much to justify the retainment of her position.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":4}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't like this offer, Mr. Garaci. I need something better than that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"\"It is an interesting offer.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":17}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":true,"text":"\"You're asking too much.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't know if I can trust you more than Mrs. Morgna.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":18}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":14},{"convId":105,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":12}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"\"I like your offer.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":17}]},"17":{"id":17,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"\"I think it's mutually beneficial.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":19}]},"18":{"id":18,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"\"I'll show you my influence and my reliability at the vote as long as you can promise me that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":19}]},"19":{"id":19,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"\"So... What do you say, Mr. President?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":105,"nodeId":20},{"convId":105,"nodeId":21},{"convId":105,"nodeId":22}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"\"It's a deal. I'll make you the next minister of justice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"\"Agreed. I'll give you the seat if we pass the vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm conflicted.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]}}}