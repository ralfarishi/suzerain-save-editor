{"conversationId":108,"title":"Sordland/Turn07/NiaDialogue01_Ally","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":35}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":10}]},"3":{"id":3,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Lucian and Petr believe that he can be persuaded though... So I'll leave that up to you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":14}]},"4":{"id":4,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"The Old Guards are fanatically opposing your proposal, so I doubt there is any possibility there.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":5},{"convId":108,"nodeId":7}]},"5":{"id":5,"speaker":"Player","isPlayerChoice":true,"text":"\"What about Heron? I thought we could get to him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":61}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"\"We won the vote. Maybe we could still persuade Orso.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":10}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"\"Can we rely on Isabel to bring all three centrist votes?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":97}]},"8":{"id":8,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We can't know for *sure* of course, but the centrist trio always stick together and Isabel is their mouthpiece. She's the only one willing to talk, so we have to take our chances with her.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":14}]},"9":{"id":9,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Yes. We might need him for the last vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":72}]},"10":{"id":10,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"He's not willing to talk. I doubt you can do anything about that. He won't be giving away his powers like that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":14}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's talk about our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":15}]},"12":{"id":12,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Heron might be a possibility, yes. But I advise against dealing with any of them. If we can persuade Isabel, we can get the votes we need.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":3}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you for your efforts with the Anti-corruption police.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":18}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":96}]},"15":{"id":15,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Well, the next step is speaking to Isabel and making sure she votes for the proposal. But also...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":2}]},"16":{"id":16,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"He's doing his best to organize the Court against your proposal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":38}]},"17":{"id":17,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I guess we have... maybe 15 minutes?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":2}]},"18":{"id":18,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Thank you for signing the order, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":83}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":41}]},"20":{"id":20,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She's certainly open to dialogue but also sceptical. She seemed to be scared of a potential purge against the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":21},{"convId":108,"nodeId":25},{"convId":108,"nodeId":27}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"\"Interesting. We should play into that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":34}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":23},{"convId":108,"nodeId":24}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":28}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"\"We can find common ground against the Old Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":32}]},"26":{"id":26,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Their weakest link is Heron, but the rest are unbreakable.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":76},{"convId":108,"nodeId":36}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"So you think she's scared of us?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":29}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"\"When will Isabel be here?\"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":30}]},"29":{"id":29,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She's not entirely scared about the situation but then again none of the court even believed that you would pass the Assembly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":69}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked at her watch.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":17}]},"31":{"id":31,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"So maybe she's feeling the pressure on her now. But in any case, we'll discover that soon enough.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":19}]},"32":{"id":32,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"That's what I hope for too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":19}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":50},{"convId":108,"nodeId":53},{"convId":108,"nodeId":47},{"convId":108,"nodeId":11},{"convId":108,"nodeId":22}]},"34":{"id":34,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Just don't take her lightly. Isabel's feeling the pressure after the vote but she's not a weak woman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":19}]},"35":{"id":35,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm sure he has also pressured the Justices of the Court right after that win. I can't speak any sense into them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":65},{"convId":108,"nodeId":45},{"convId":108,"nodeId":68},{"convId":108,"nodeId":79}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"\"We need to talk to Heron, then.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":9}]},"37":{"id":37,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But there's huge pressure on them. The Anti-corruption force has found incriminating evidence against some of the Justices.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":77}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":39},{"convId":108,"nodeId":40}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":37}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":26}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":33}]},"42":{"id":42,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Also thanks for the recent efforts of our anti-corruption force, we managed to *pressure* several Justices into cooperation.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":43}]},"43":{"id":43,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"So we have... potentially four or five votes in total. So today's meeting can bring us the last vote we need to reach six.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":4}]},"44":{"id":44,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We still need three more votes. Isabel can potentially bring two to three votes, that's why she's our ticket.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":46}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"\"What is the atmosphere in the Court?\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":94}]},"46":{"id":46,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"The Old Guards are fanatically opposing your proposal, so I doubt there is any possibility there. But we might still need their help if Isabel can't bring exactly the three votes we need.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":5},{"convId":108,"nodeId":6},{"convId":108,"nodeId":7}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":48},{"convId":108,"nodeId":49}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":79}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":51},{"convId":108,"nodeId":52}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":65}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":54},{"convId":108,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":45}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":57},{"convId":108,"nodeId":58}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":42}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":44}]},"59":{"id":59,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You are right, but where's the breaking point?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":86}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":96}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":62},{"convId":108,"nodeId":63}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":12}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":66}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":33}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"\"What about Justice Edmonds? Do you think we can sway her?\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":73}]},"66":{"id":66,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Heron is a possibility, yes. I dislike him but if we really want to be sure we might need him. A disgrace of a justice he is.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":14}]},"67":{"id":67,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She's not openly protesting against the Old Guards but she has told me about her concerns about them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":20}]},"68":{"id":68,"speaker":"Player","isPlayerChoice":true,"text":"\"You are the Minister of Justice. You must speak sense into them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":82}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":70},{"convId":108,"nodeId":71}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":74}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":31}]},"72":{"id":72,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You should call Lucian, he has been trying to deal with him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":60}]},"73":{"id":73,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Yes, I think she's our best bet. We have a meeting with her now, after all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":67}]},"74":{"id":74,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She must also be under pressure after the anti-corruption police's raids against her fellow colleagues.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":19}]},"75":{"id":75,"speaker":"Player","isPlayerChoice":true,"text":"\"We have to keep up the pressure.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":92}]},"76":{"id":76,"speaker":"Player","isPlayerChoice":true,"text":"\"Nobody is unbreakable.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":59}]},"77":{"id":77,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Although they have immunity, they are scared that these would go public. We have already gained a few more votes in the Court but I'm not sure more Old Guards would jump on the same wagon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":87},{"convId":108,"nodeId":13},{"convId":108,"nodeId":80},{"convId":108,"nodeId":75}]},"78":{"id":78,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"It is the Old Guard that are disrespecting their positions. But we will hopefully take care of that soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":60}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"\"What has Orso been doing?\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":108,"nodeId":16}]},"80":{"id":80,"speaker":"Player","isPlayerChoice":true,"text":"\"Good. The whole Court must finally learn to back down.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":85}]},"81":{"id":81,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Orso and Heron have a tight grip on everybody.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":64}]},"82":{"id":82,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You know who I'm dealing with, Mr. President. It's not easy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":81}]},"83":{"id":83,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"The efforts are bearing fruit.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":60}]},"84":{"id":84,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I only know about the two Justices I've mentioned earlier who are with me. So we have three votes there.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":56}]},"85":{"id":85,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We are not in a battle against the Court here, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":78}]},"86":{"id":86,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"These old men have a pride as vast as Merkopa, they're not easy game.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":60}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":88},{"convId":108,"nodeId":89}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":91}]},"89":{"id":89,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"90":{"id":90,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Anyway...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":60}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"\"They can keep relying on their immunity. Soon, we will be able to impeach them.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":93}]},"92":{"id":92,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"The investigations are still going, Mr. President. The pressure will build up.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":60}]},"93":{"id":93,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"With the ongoing investigations of the anti-corruption force, I'm sure we will have a strong position against most of the Old Guards regarding their impeachment.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":95}]},"94":{"id":94,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Most Justices don't really talk when I'm around. They don't trust me as I'm an outside member of the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":84}]},"95":{"id":95,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But I still think it was not the right decision to add that to the proposal. This might pressure the future Courts to always be in line with the fear of being displaced.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":90}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":33}]},"97":{"id":97,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":98},{"convId":108,"nodeId":99}]},"98":{"id":98,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":100}]},"99":{"id":99,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":8}]},"100":{"id":100,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We can't know for *sure* of course, but the ACP should help them get in line if Isabel's trust can be earned. The centrists stick together.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":108,"nodeId":14}]}}}