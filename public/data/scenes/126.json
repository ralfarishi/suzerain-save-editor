{"conversationId":126,"title":"Sordland/Turn07/CallWithRemus","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":115,"nodeId":86}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Remus responded in a low voice.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":11}]},"4":{"id":4,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"How may I help you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":6},{"convId":126,"nodeId":35},{"convId":126,"nodeId":10},{"convId":126,"nodeId":18},{"convId":126,"nodeId":22}]},"5":{"id":5,"speaker":"Player","isPlayerChoice":false,"text":"\"I'm already working on it, but I may require some help with getting rid of Orso Hawker. I don't trust the deep state elements inside the Forces.\"","conditionsRaw":"Variable[\"BaseGame.Turn07_SecretState_AttemptToKillOrsoHawker\"] == true","variablesRead":[{"var":"BaseGame.Turn07_SecretState_AttemptToKillOrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":29}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":7},{"convId":126,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn07_SecretState_AttemptToKillOrsoHawker\"] == true","variablesRead":[{"var":"BaseGame.Turn07_SecretState_AttemptToKillOrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":5}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn07_SecretState_AttemptToKillOrsoHawker\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn07_SecretState_AttemptToKillOrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"9":{"id":9,"speaker":"Player","isPlayerChoice":false,"text":"\"I may require some help with getting rid of Orso Hawker.\"","conditionsRaw":"Variable[\"BaseGame.YoungSords_Kill_OrsoHawker\"] == false","variablesRead":[{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":31}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":false,"text":"\"Security in Sordland is still concerning. I require your help with boosting our security forces.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":47}]},"11":{"id":11,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Who is this?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":12},{"convId":126,"nodeId":13},{"convId":126,"nodeId":14},{"convId":126,"nodeId":15}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":false,"text":"\"It's the President speaking.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":17}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":false,"text":"\"It's Anton Rayne.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":17}]},"14":{"id":14,"speaker":"Player","isPlayerChoice":false,"text":"\"Your secret partner.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":17}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":false,"text":"\"The one who knocks.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":16}]},"16":{"id":16,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"What?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":17}]},"17":{"id":17,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Oh, Mr. President. How nice of you to call.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":4}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":false,"text":"\"The elections are approaching. I require your help with our... campaign.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":53}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.YoungSords_Aids_Security","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_YoungSords_Ordered_SecurityAid","op":"=","value":"true"}],"outgoingIds":[{"convId":126,"nodeId":58}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.YoungSords_Aids_Election","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_YoungSords_Ordered_ElectionAid","op":"=","value":"true"}],"outgoingIds":[{"convId":126,"nodeId":58}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"=","value":"true"},{"var":"BaseGame.Turn07_SecretState_Kill_OrsoHawker","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_YoungSords_Ordered_OrsoHawkerMurder","op":"=","value":"true"}],"outgoingIds":[{"convId":126,"nodeId":58}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":false,"text":"\"I just wanted to ask if everything was going well on your side.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":23}]},"23":{"id":23,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Oh, thank you, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":24}]},"24":{"id":24,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Everything is running smoothly. But is there something you need from us?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":6},{"convId":126,"nodeId":10},{"convId":126,"nodeId":18},{"convId":126,"nodeId":25}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":false,"text":"\"No, thank you. Maybe another time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":26}]},"26":{"id":26,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Uhm... Okay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":27}]},"27":{"id":27,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Well, if that was all, I'll have to go back to my work now, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":28}]},"28":{"id":28,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Have a nice day.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":34}]},"29":{"id":29,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"I see...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":30}]},"30":{"id":30,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"You are right not to trust them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":33}]},"31":{"id":31,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"I see...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":32}]},"32":{"id":32,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"I knew this was coming.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":33}]},"33":{"id":33,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Maybe we can help you with that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":41}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"The line dropped dead.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":2}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":36},{"convId":126,"nodeId":37}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.YoungSords_Kill_OrsoHawker\"] == false","variablesRead":[{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":9}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.YoungSords_Kill_OrsoHawker\"] == false) == false","variablesRead":[{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":38}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":false,"text":"\"You are late. Why is the Chief Justice still around?\"","conditionsRaw":"(Variable[\"BaseGame.YoungSords_Kill_OrsoHawker\"] == false) == false","variablesRead":[{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":39}]},"39":{"id":39,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"We are talking about one of the most protected men in Sordland here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":40}]},"40":{"id":40,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Have some patience.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":61}]},"41":{"id":41,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Mr. Hawker is proving to be an unreliable partner to us as well. I'm not against the idea of sending a message through him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":42}]},"42":{"id":42,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"I'll discuss this with the guys.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":43},{"convId":126,"nodeId":44},{"convId":126,"nodeId":45}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":false,"text":"\"Good. I'll be expecting the news.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":21}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":false,"text":"\"That settles it then.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":21}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":false,"text":"\"Maybe you got me wrong, Mr. Holstron. Let's just cancel this whole thing. This was a misunderstanding.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":46}]},"46":{"id":46,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Oh? Okay...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":27}]},"47":{"id":47,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"We can surely help with that, Mr. Rayne.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":48}]},"48":{"id":48,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"If you can persuade Ms. Graf to restructure the forces to integrate us through a separate division...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":49}]},"49":{"id":49,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"The security situation will quickly improve.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":50},{"convId":126,"nodeId":51}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":false,"text":"\"Consider it done. Prove your worth.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":19}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":false,"text":"\"Come to think of it, maybe this isn't the best idea.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":52}]},"52":{"id":52,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Oh? Okay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":27}]},"53":{"id":53,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"We can surely help with that, Mr. Rayne.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":54}]},"54":{"id":54,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"You can count on the Young Sords to *protect* the ballots and the integrity of the elections.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":55}]},"55":{"id":55,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"But we may ask you to transfer some funds to us in the future to be able to organize efficiently.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":56},{"convId":126,"nodeId":57}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":false,"text":"\"Understood. Just tell me whenever you need the money.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":20}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":false,"text":"\"Come to think of it, maybe this isn't the best idea.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":52}]},"58":{"id":58,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"Great.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.YoungSords_Aids_Security","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_YoungSords_Ordered_SecurityAid","op":"=","value":"true"},{"var":"BaseGame.YoungSords_Aids_Election","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_YoungSords_Ordered_ElectionAid","op":"=","value":"true"},{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"=","value":"true"},{"var":"BaseGame.Turn07_SecretState_Kill_OrsoHawker","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_YoungSords_Ordered_OrsoHawkerMurder","op":"=","value":"true"}],"outgoingIds":[{"convId":126,"nodeId":59}]},"59":{"id":59,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"You'll see the results whenever they're ready.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":60}]},"60":{"id":60,"speaker":"Remus Holstron","isPlayerChoice":false,"text":"\"It was nice catching up with you, Mr. President. Take care.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":126,"nodeId":34}]},"61":{"id":61,"speaker":"Remus Holstron","i