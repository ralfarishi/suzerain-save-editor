{"conversationId":382,"title":"Rizia/Turn 7/Energy Partnership Unfriendly","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":377,"nodeId":536}]},"3":{"id":3,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Do you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":4}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"He adjusted the folds of his robe.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":5}]},"5":{"id":5,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I will remind you that you had an opportunity to strengthen those ties by lifting your Golcondist ban. You did not seize it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":20}]},"6":{"id":6,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But there is one other thing Rizia can help us with. Energy.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false) and ((Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true) == false) and ((Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false)","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":7}]},"7":{"id":7,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I hear you are constructing a pipeline between Rizia and Morella. Can it be extended to my country?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":8},{"convId":382,"nodeId":17},{"convId":382,"nodeId":18},{"convId":382,"nodeId":65}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I doubt that Morella would allow such an extension given your history.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":10}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Agreed. We shouldn't be getting too far ahead of ourselves.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":92}]},"10":{"id":10,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"It is not Derdia's fault that we are cruelly barred from our ancestral places of worship.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":27}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Perfect. Derdia, Rizia and Morella will stand strong against the CSP's overreach.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_CommieKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":91}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":13},{"convId":382,"nodeId":14}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We're at war. Our ships could get targeted.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":64}]},"16":{"id":16,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You do not want to extend your pipeline from Morella. But perhaps you would still be willing to ship us oil or gas across the Gulf of Moridia.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] > 1","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":">","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":12},{"convId":382,"nodeId":62},{"convId":382,"nodeId":63}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It depends on whether you are able to make peace with the Morellan prime minister.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":45}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"An interesting possibility. I will consider it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":19}]},"19":{"id":19,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I recognize that it would require us to cooperate with Morella.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":27}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":21},{"convId":382,"nodeId":22}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":25}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":36}]},"23":{"id":23,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"The only potential I see is for an energy partnership.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false) and (Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true) and ((Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false)","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":86}]},"24":{"id":24,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But there is one other thing Rizia can help us with. Energy.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false) and (Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false)","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":31}]},"25":{"id":25,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But the pipeline you have promised is a good start.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":32}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Perfect. Derdia, Rizia and Morella will stand strong together against Arcasian imperialism.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_CommieKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":91}]},"27":{"id":27,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But for a chance at energy security, I am willing to face the devil herself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":46}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":29},{"convId":382,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_CommieKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":26}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_CommieKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":11}]},"31":{"id":31,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I hear you have formed energy partnerships with other Merkopan countries. Perhaps you would be willing to ship us oil or gas across the Gulf of Moridia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":59},{"convId":382,"nodeId":12},{"convId":382,"nodeId":62},{"convId":382,"nodeId":63}]},"32":{"id":32,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Get energy flowing from Morella to my country. Then we can talk about further cooperation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":9},{"convId":382,"nodeId":98},{"convId":382,"nodeId":28}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":34},{"convId":382,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":23}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":6}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":37},{"convId":382,"nodeId":38}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":24}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":33}]},"39":{"id":39,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We would be, if we had any energy to sell you.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 2","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":96}]},"40":{"id":40,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am afraid not. We barely have enough energy to meet Morella's needs, let alone Derdia's.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 1","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":69}]},"41":{"id":41,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Until your holy institutions respect my country's religion, a strictly transactional relationship is all I will agree to.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":46}]},"42":{"id":42,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"I shall begin the pipeline. But you must be ready to stop your disgraceful border violations.\" [-2 Energy For +2 Budget Per Turn, -2 Budget Per Turn For Pipeline]","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] >= 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":71}]},"43":{"id":43,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"Excellent. We will build the pipeline, and together, our three nations will begin a new era of peace and cooperation.\" [-2 Energy For +2 Budget Per Turn, -2 Budget Per Turn For Pipeline]","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] >= 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":78}]},"44":{"id":44,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"With all apologies, I cannot. A pipeline to Morella is all I can manage right now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":79}]},"45":{"id":45,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Peace? Her country discarded that chance when it closed its borders to us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":27}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"Sal smiled faintly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":47}]},"47":{"id":47,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Ignoring your religious ideals for the sake of earthly riches. Your true colors are showing, Supreme Wiseman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":83},{"convId":382,"nodeId":84},{"convId":382,"nodeId":48},{"convId":382,"nodeId":73}]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"More proof that Golcondists don't have ideals at all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":81}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Remember Wruhec's words, Sal. Do not reach for the stars above your head before tending to the soil beneath your feet,\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":51}]},"50":{"id":50,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Precisely.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":382,"nodeId":58}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":382,"nodeId":50}]},"52":{"id":52,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You ask me for a closer relationship, only to insult me?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":382,"nodeId":82}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Derdia_EnergyShippingAgreement","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Energy_Modifier_DerdiaEnergyExport","op":"=","value":"-2"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_EnergyDealShipping","op":"=","value":"true"}],"outgoingIds":[{"convId":382,"nodeId":55}]},"54":{"id":54,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Then we have failed to find common ground once more.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"55":{"id":55,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Thank you, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Derdia_EnergyShippingAgreement","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Energy_Modifier_DerdiaEnergyExport","op":"=","value":"-2"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_EnergyDealShipping","op":"=","value":"true"}],"outgoingIds":[{"convId":382,"nodeId":76}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"All right. An energy agreement it is.\" [-2 Energy Per Turn, +2 Budget Per Turn]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":53}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Nevertheless, I would rather not make an energy deal with you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":54}]},"58":{"id":58,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"In the end, it is your energy and your decision.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":106},{"convId":382,"nodeId":44},{"convId":382,"nodeId":77}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":60},{"convId":382,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 2","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":39}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":95}]},"62":{"id":62,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Wouldn't it be easier for you to buy oil from Wehlen?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":94}]},"63":{"id":63,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"To be frank, we need your diplomatic support more than we need you to buy our energy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":89}]},"64":{"id":64,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"The Gulf is far north of your front, is it not? Shipping has not been disrupted so far.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":103}]},"65":{"id":65,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":66},{"convId":382,"nodeId":67}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 1","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":40}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 1) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":68}]},"68":{"id":68,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I was thinking of a different kind of partnership.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 1) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":41}]},"69":{"id":69,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Ah. A shame.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":70}]},"70":{"id":70,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But perhaps it is best for both of us to keep our relationship as it is.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"71":{"id":71,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Only if she is ready to admit that she has wronged us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":105}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn07_Diplomacy_Derdia_EnableSaltanaMeeting","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"}],"outgoingIds":[{"convId":382,"nodeId":2}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":74},{"convId":382,"nodeId":75}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":49}]},"75":{"id":75,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"76":{"id":76,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I cannot promise closer cooperation than that. But I hope you are satisfied.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"77":{"id":77,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I wish I could help you. But we lack the funds for such a construction.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] >= 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":80}]},"78":{"id":78,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Let's not get too far ahead of ourselves.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":105}]},"79":{"id":79,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"So for all your talk of cooperation, you're on the side of the godless heathens. I understand.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"80":{"id":80,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"And yet you were able to afford it where Morella was concerned.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"81":{"id":81,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":382,"nodeId":52}]},"82":{"id":82,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"This conversation is going nowhere.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"83":{"id":83,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He is only trying to provide for his people, Grand Wiseman. Just as I am doing in Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":100}]},"84":{"id":84,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Indeed, Azmal. You cannot have it both ways.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":85}]},"85":{"id":85,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You asked me about closer ties, Your Majesty. This is my answer.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":58}]},"86":{"id":86,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":87},{"convId":382,"nodeId":88}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] > 1","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":">","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":16}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] > 1) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":">","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":97}]},"89":{"id":89,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Until your holy institutions respect my country's religion, a strictly transactional relationship is all I will agree to.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":56},{"convId":382,"nodeId":57}]},"90":{"id":90,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I am glad we are on the same page. Regarding this, at least.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":103}]},"91":{"id":91,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I do not share your animosity towards the superpowers. For the last 40 years, they have been kind enough to leave Derdia alone.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"92":{"id":92,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Indeed not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"93":{"id":93,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"'United' is not the term for it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"94":{"id":94,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Wehlen? Your Majesty, Wiktor Smolak's persecution of Golcondists makes your blasphemy laws look gentle.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":102}]},"95":{"id":95,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That's exactly the kind of partnership I was thinking of, Supreme Wiseman.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":90}]},"96":{"id":96,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Ah. So the mighty Rizia is facing an energy shortage.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":101}]},"97":{"id":97,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But as I understand it, your own supplies are running too low to provide us with what we need.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] > 1) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":">","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Empire of Moridia, united once more. It warms my heart.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":93}]},"99":{"id":99,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":382,"nodeId":104}]},"100":{"id":100,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Yes, we cannot be expected to carry out our religious duties without heat or electricity.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":58}]},"101":{"id":101,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"All the more reason for our nations to stay at a distance from each other.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":2}]},"102":{"id":102,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"He will not even grant our pilgrims passage through his country to the holy Archsanctuary of Deyr. And you think he will trade with us?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":99}]},"103":{"id":103,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Think about it. Once your Zille harbor is recovered, the distance between our ports will be practically nothing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":56},{"convId":382,"nodeId":57}]},"104":{"id":104,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"It will be easier to trade with Rizia once your Zille harbor is recovered from that madman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":382,"nodeId":56},{"convId":382,"nodeId":57}]},"105":{"id":105,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"}],"outgoingIds":[{"convId":382,"nodeId":72}]},"106":{"id":106,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":107},{"convId":382,"nodeId":108}]},"107":{"id":107,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] >= 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":42},{"convId":382,"nodeId":43}]},"108":{"id":108,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] >= 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":382,"nodeId":77}]}}}