{"conversationId":544,"title":"Rizia/Turn 10/HOD Shutdown Notes/HOD Shutdown Notes Conversation","storyPack":"StoryPack_Rizia","turn":10,"turnLabel":"Turn 10","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"I began to think aloud as I reflected upon the circumstances surrounding the events that led me here.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":15},{"convId":544,"nodeId":17},{"convId":544,"nodeId":4},{"convId":544,"nodeId":16},{"convId":544,"nodeId":33},{"convId":544,"nodeId":37}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No surprise that those claiming to serve the public ended up defying the Crown.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":26},{"convId":544,"nodeId":7},{"convId":544,"nodeId":5},{"convId":544,"nodeId":6}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"All they did was twist our laws and traditions to suit their own purposes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":25},{"convId":544,"nodeId":20},{"convId":544,"nodeId":9},{"convId":544,"nodeId":8}]},"6":{"id":6,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I never wanted it to come to this, but I did what needed to be done.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":25},{"convId":544,"nodeId":20},{"convId":544,"nodeId":9},{"convId":544,"nodeId":8}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I refused to let them steer this kingdom off course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":25},{"convId":544,"nodeId":20},{"convId":544,"nodeId":9},{"convId":544,"nodeId":8}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I always strived to protect and uphold the integrity of these lands.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":29},{"convId":544,"nodeId":24},{"convId":544,"nodeId":28}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Even when others questioned me, I remained resolute.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":29},{"convId":544,"nodeId":24},{"convId":544,"nodeId":28}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“Democracy... what a joke.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":11},{"convId":544,"nodeId":13},{"convId":544,"nodeId":14},{"convId":544,"nodeId":12}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Mob rule is more like it!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":19}]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Chaos-driven, pandering to the masses.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":19}]},"13":{"id":13,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Quixotic idealism fraught with insurmountable problems.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":19}]},"14":{"id":14,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Like giving a child a hammer -- everything’s a nail.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":19}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Once full of voices, this hall now reflects the Crown’s true strength.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":26},{"convId":544,"nodeId":7},{"convId":544,"nodeId":5},{"convId":544,"nodeId":6}]},"16":{"id":16,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The old order thought they could cling to power, but now, it’s mine to reshape.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":26},{"convId":544,"nodeId":7},{"convId":544,"nodeId":5},{"convId":544,"nodeId":6}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"These so-called delegates thought they held power but never grasped true leadership.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":26},{"convId":544,"nodeId":7},{"convId":544,"nodeId":5},{"convId":544,"nodeId":6}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"A monarchy was the only way to ensure stability and order.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":41}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"My eyes fell on an old banner draped over a bench.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":22},{"convId":544,"nodeId":23}]},"20":{"id":20,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Justice demanded action, not complacency.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":29},{"convId":544,"nodeId":24},{"convId":544,"nodeId":28}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"More like, \"The Strength of the Crown,\" I thought to myself.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":18}]},"22":{"id":22,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Pick up banner.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":21}]},"23":{"id":23,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Ignore banner.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":41}]},"24":{"id":24,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I had no choice but to cut them down before they could strike. Rizia's survival was at stake.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":30}]},"25":{"id":25,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You give them an inch of trust, and they'll take a mile of betrayal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":29},{"convId":544,"nodeId":24},{"convId":544,"nodeId":28}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"They concealed their true loyalty while sharpening their knives.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":25},{"convId":544,"nodeId":20},{"convId":544,"nodeId":9},{"convId":544,"nodeId":8}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"In it resided Rizia's constitution, a relic of this kingdom's brief experiment with democracy.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":32},{"convId":544,"nodeId":10},{"convId":544,"nodeId":31}]},"28":{"id":28,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Still, I can't help but wonder if there could have been another way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":30}]},"29":{"id":29,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It's why I was destined to become king. It was my duty, my purpose to bring these lands back under control.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":30}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"I reached the center of the chamber, I noticed the display case near the podiums.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":27}]},"31":{"id":31,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“To think that this unassuming document could have incited such turmoil and challenge to my rule.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":19}]},"32":{"id":32,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"A good idea in theory but inevitably flawed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":19}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":34},{"convId":544,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_FunnyKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":544,"nodeId":36}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_FunnyKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"They certainly did love to hear themselves talk. Now, it’s blissfully quiet.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_FunnyKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_Funn