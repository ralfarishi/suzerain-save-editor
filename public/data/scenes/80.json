{"conversationId":80,"title":"Sordland/Turn06/InT_HighwayOpening","storyPack":"StoryPack_Main","turn":6,"turnLabel":"Turn 6","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":1}]},"1":{"id":1,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":5}]},"2":{"id":2,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon and Lileas who heavily assisted the project were with me alongside Lucian to decide on how to proceed tomorrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":177}]},"4":{"id":4,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Involving the President could be beneficial for his image.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":111}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"Arriving in Lachaven for the grand opening ceremony of the H-3 Highway was a proud moment for all of us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":3}]},"6":{"id":6,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I don't support anything beyond the opening ceremony. Actions speak for themselves.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":4}]},"7":{"id":7,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn06_InT_Opening","op":"=","value":"true"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"}],"outgoingIds":[{"convId":80,"nodeId":129}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"Today was a great victory for the administration.","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  or  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) and ((Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  or  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) == false) and (Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  and  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) and ((Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  and  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) == false) and (Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) and ((Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) == false) and (Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) and ((Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) == false)","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"},{"var":"BaseGame.Agnolia_TradeDeal","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"},{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"}],"outgoingIds":[{"convId":80,"nodeId":96}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"“I'd prefer we just do the opening ceremony. No need for senseless show.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":14}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“I agree. There is much to gain.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":22}]},"11":{"id":11,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“The people will be satisfied. More importantly, so will businesses.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":15}]},"12":{"id":12,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Sounds good. It would display unity and strength if we were all together in the convoy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":15}]},"13":{"id":13,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":80,"nodeId":12}]},"14":{"id":14,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Of course. We'll do the ceremony and open the highway to the public immediately after.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":11}]},"15":{"id":15,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Additionally, a large crowd is invited for the ceremony and will be watching the opening speech.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":18},{"convId":80,"nodeId":16},{"convId":80,"nodeId":17},{"convId":80,"nodeId":112}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"“It will be a good opportunity for exposure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":76}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“Like the good campaign days.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":77}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing like a cheerful crowd. Looking forward to it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":75}]},"19":{"id":19,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Alright then. We have a lot of work to do tomorrow. See you in the morning.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":115},{"convId":80,"nodeId":116},{"convId":80,"nodeId":117}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"The team left, leaving the rest of the evening to prepare for the big day tomorrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":23}]},"21":{"id":21,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Signal Lucian to begin the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":24}]},"22":{"id":22,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":80,"nodeId":13}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"The next day a stage had been erected next to the entrance of the highway in the down-town.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":86}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Brothers and sisters of Sordland!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":88}]},"25":{"id":25,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Thank you, Mr. President. Lachaven! It is great to be here today among you industrious people.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":89}]},"26":{"id":26,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Thanks, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":90}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"We began moving towards the stage as the excitement was growing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":21}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“People of Sordland! Welcome to the opening ceremony of the H-3 Highway!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":35}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian's voice echoed in the square next to the highway. Hundreds of Sordland and USP flags began to wave as the cheers intensified.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":30}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Without further ado, I invite the President of Sordland to the stage.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":33}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“Citizens! Welcome to the opening ceremony of the H-3 Highway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":35}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“Lachaveners! Welcome to the opening ceremony of the H-3 Highway!”","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Lachaven_Rich","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":34}]},"33":{"id":33,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Move up to the stage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":124},{"convId":80,"nodeId":31},{"convId":80,"nodeId":28}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting from the crowd intensified. Some were yelling the motto of Lachaven; Liberty until eternity.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":36},{"convId":80,"nodeId":37}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting from the crowd continued.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":36},{"convId":80,"nodeId":37}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"“At the beginning of this journey we promised jobs and opportunity. We kept our promise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":38},{"convId":80,"nodeId":39}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“Trust me, our work is far from over. This project is only the beginning of good tidings.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":38},{"convId":80,"nodeId":39}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“The aim with the H-3 was to improve logistics to aid businesses to create economic growth in East Nargis and Agnland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":57},{"convId":80,"nodeId":56}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"“Our intention with the H-3 was to serve our citizens who were having a hard time travelling between Lachaven and Arvory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":57},{"convId":80,"nodeId":56}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"The highway officially opened to the public and thousands began utilising it as soon as we left the area.","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":180}]},"41":{"id":41,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":42},{"convId":80,"nodeId":43}]},"42":{"id":42,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":54}]},"43":{"id":43,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":40}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“None of this would be possible without my colleague with sound advice, the Minister of the Interior Lileas Graf. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":49}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"“We have to thank the mind behind the highway project for it all, the esteemed Minister of Economy and Tax, Symon Holl. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":50}]},"46":{"id":46,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I'm sure each one of you will be proud of the achievements made during the project once we cut that ribbon and you can drive or travel on the highway yourselves.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":84}]},"47":{"id":47,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“United we stand and divided we fall.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":83}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"“I took time off from my duties to personally manage the project to success.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":85}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"Lileas walked up to me and leaned on the microphone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":25}]},"50":{"id":50,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon walked up to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":26}]},"51":{"id":51,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Cut the ribbon.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":52}]},"52":{"id":52,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Congratulations to all. It was a solid and fruitful effort. Hopefully with much more to come.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":53}]},"53":{"id":53,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“It's a good moment indeed. It gives us pride as a nation. One big step behind us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":41}]},"54":{"id":54,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Your car is prepared and ready.”","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":92}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"A forty meter long red ribbon was hanging over it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":91}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"“This highway brings thousands of new jobs! Many unemployed citizens have benefited and will benefit on the path of the highway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":44},{"convId":80,"nodeId":48},{"convId":80,"nodeId":45}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"“This highway brings down travel time by half! Travelling between Lachaven and Arvory is now faster and more comfortable.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":44},{"convId":80,"nodeId":48},{"convId":80,"nodeId":45}]},"58":{"id":58,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Enter car.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":63}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“I'd like Lileas with me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":61}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“I will drive the car on my own.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":67}]},"61":{"id":61,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I'm honored. It will be great to arrive in Arvory with the President of Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":70}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“I want to have Symon in the lead car.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":65}]},"63":{"id":63,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Who do you want to travel with, Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":64},{"convId":80,"nodeId":62},{"convId":80,"nodeId":59},{"convId":80,"nodeId":60}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian, you would be my preference.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":146}]},"65":{"id":65,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This isn't necessary but I won't refuse. We can talk about future economic projects.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":69}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Thank you, Mr. President. It will be a good journey to talk about how the Supreme Court will react to the legal challenge by Mr. Ricter.”","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Path\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":68}]},"67":{"id":67,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Sure. We will all be following in our vehicles. See you in Arvory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":71}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving out of the opening ceremony area and into the new highway, the media took pictures of me and Lucian who looked serious.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":72}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving out of the opening ceremony area and into the new highway, the media took pictures of me and Symon who smiled to the cameras.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":72}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving out of the opening ceremony area and into the new highway, the media took pictures of me and Lileas who waved to the cameras.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":72}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving out of the opening ceremony area and into the new highway, the media took pictures of me driving by myself.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":72}]},"72":{"id":72,"speaker":"Narrator","isPlayerChoice":false,"text":"The new highway was in pristine condition and quality.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":93}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"After the relaxing four hour drive to Arvory, we were welcomed by celebratory citizens and Mayor Eric Niel.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":40}]},"74":{"id":74,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“On another note. It goes without mentioning that this was a team effort.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":79}]},"75":{"id":75,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think all of us do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":78}]},"76":{"id":76,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Agreed. Every single press outlet has of course been notified and they will be there.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":78}]},"77":{"id":77,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Things were certainly easier back then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":78}]},"78":{"id":78,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon stepped in for a comment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":74}]},"79":{"id":79,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Beginning with the President who put trust in me, I want to thank all involved in H-3.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":80},{"convId":80,"nodeId":81},{"convId":80,"nodeId":113}]},"80":{"id":80,"speaker":"Player","isPlayerChoice":true,"text":"“Symon, you deserve a lot of credit. After all, it was you who came up with the project.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":82}]},"81":{"id":81,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for your kind words. It truly means a good deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":82}]},"82":{"id":82,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Finally people got what they wanted for a long time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":114}]},"83":{"id":83,"speaker":"Narrator","isPlayerChoice":false,"text":"Lileas brought attention to the strength that comes from unity. She then mentioned the positive change the highway creates for Agnland.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":120}]},"84":{"id":84,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon mentioned the beginning of a Sordish economic recovery and the plans to stop the recession altogether.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":118}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd began cheering my name.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":119}]},"86":{"id":86,"speaker":"Narrator","isPlayerChoice":false,"text":"The calm and warm weather created a positive mood in the usually breezy Lachaven.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":87}]},"87":{"id":87,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd was large but still smaller than some rallies due to the strong PFJP presence here.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":27}]},"88":{"id":88,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I welcome you, Lachaveners today as a proud servant of this country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":29}]},"89":{"id":89,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“This project is a perfect example of the capacity and capabilities of Sordland as a nation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":47}]},"90":{"id":90,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Our aim with this project is obvious, to improve the speed and efficiency of transportation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":46}]},"91":{"id":91,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon gave me a pair of large scissors to commence the opening. The crowd was watching.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":176}]},"92":{"id":92,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The drive to Arvory should take about four hours and the rest of the motorcade will follow you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":58}]},"93":{"id":93,"speaker":"Narrator","isPlayerChoice":false,"text":"It was the best driving experience one could have nowadays while providing the best traction and least noise.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":73}]},"94":{"id":94,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"}],"outgoingIds":[{"convId":80,"nodeId":8}]},"95":{"id":95,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"}],"outgoingIds":[{"convId":80,"nodeId":94}]},"96":{"id":96,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn06_InT_OnTime","op":"=","value":"true"}],"outgoingIds":[{"convId":80,"nodeId":128}]},"97":{"id":97,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian stood up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":98}]},"98":{"id":98,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“First of all...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":99}]},"99":{"id":99,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Congratulations everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":102}]},"100":{"id":100,"speaker":"Player","isPlayerChoice":true,"text":"“We couldn't have done this without our excellent team.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":105}]},"101":{"id":101,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Nod.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":107}]},"102":{"id":102,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“To many more projects like this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":108}]},"103":{"id":103,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I have a plan on how to do that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":109}]},"104":{"id":104,"speaker":"Player","isPlayerChoice":true,"text":"“Good work.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":105}]},"105":{"id":105,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Indeed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":107}]},"106":{"id":106,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“It's been a long time since the last successful infrastructure project. There is good reason to capitalise on the occasion.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":103}]},"107":{"id":107,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Let's move on to our plans for the opening tomorrow.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":106}]},"108":{"id":108,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Well done.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":104},{"convId":80,"nodeId":100},{"convId":80,"nodeId":101}]},"109":{"id":109,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“If Mr. President accepts, a drive from Lachaven to Arvory should do the trick. After the motorcade takes off, the road will be open to the public.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":110}]},"110":{"id":110,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“What are your thoughts?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":6}]},"111":{"id":111,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think so too. Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":10},{"convId":80,"nodeId":9}]},"112":{"id":112,"speaker":"Player","isPlayerChoice":true,"text":"“I guess we can't help it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":78}]},"113":{"id":113,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":82}]},"114":{"id":114,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“We will need to show our best face tomorrow. I'll make sure that our focus on improving business and logistics is relayed to wherever necessary.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":19}]},"115":{"id":115,"speaker":"Player","isPlayerChoice":true,"text":"“See you at the ceremony.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":20}]},"116":{"id":116,"speaker":"Player","isPlayerChoice":true,"text":"“Goodbye for now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":20}]},"117":{"id":117,"speaker":"Player","isPlayerChoice":true,"text":"“Once again, good work everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":20}]},"118":{"id":118,"speaker":"Narrator","isPlayerChoice":false,"text":"After he was done with his speech, Lucian took Symon's place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":121}]},"119":{"id":119,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took my place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":121}]},"120":{"id":120,"speaker":"Narrator","isPlayerChoice":false,"text":"After she was done with her speech, Lucian took Lileas's place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":121}]},"121":{"id":121,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Citizens of Lachaven! There you have it!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":122}]},"122":{"id":122,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“As promised, Anton Rayne—the 4th President of Sordland—has delivered!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":123}]},"123":{"id":123,"speaker":"Narrator","isPlayerChoice":false,"text":"We moved towards the entrance of the highway next to the stage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":55}]},"124":{"id":124,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":125},{"convId":80,"nodeId":126}]},"125":{"id":125,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Lachaven_Rich","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":127}]},"126":{"id":126,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Lachaven_Rich","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":80,"nodeId":32}]},"127":{"id":127,"speaker":"Player","isPlayerChoice":true,"text":"“Fellow Free Lachaveners! Welcome to the opening ceremony of the H-3 Highway!”","conditionsRaw":"Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true","variablesRead":[{"va