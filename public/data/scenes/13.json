{"conversationId":13,"title":"Sordland/Turn02/A_MediaDeal","storyPack":"StoryPack_Main","turn":2,"turnLabel":"Turn 2","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":1}]},"1":{"id":1,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":3}]},"2":{"id":2,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Our motorcade headed to the meeting location set by Marcel Koronti. I had only my most confidential and trustworthy team members with me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":8}]},"4":{"id":4,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“I hope the journey was comfortable.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":12},{"convId":13,"nodeId":133},{"convId":13,"nodeId":13},{"convId":13,"nodeId":161}]},"5":{"id":5,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“He would have been very happy to hear this from you, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":40}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"“Where are we, Serge?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":10}]},"7":{"id":7,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Look outside.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":9}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"After a few hours of driving along River Eskel, we took a turn before entering Conriat. The darkness started setting in as we drove up to a hill.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":6},{"convId":13,"nodeId":7}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"I could see giant stadium lights on the hilltop far away in the distance. It looked like a massive complex.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":15}]},"10":{"id":10,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“We are nearing the HOS Country Club, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":14}]},"11":{"id":11,"speaker":"Narrator","isPlayerChoice":false,"text":"We arrived and the big iron gates of the country club opened. It was huge and outright extravagant. The main building, inspired by Lespian architecture, was illuminated from all sides.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":19}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"“The location is very remote indeed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":17}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"“It wasn't bad. I am looking forward to this meeting.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":18}]},"14":{"id":14,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“We'll be there shortly.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":11}]},"15":{"id":15,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“We are nearing our destination.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":11}]},"16":{"id":16,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Enter the building.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":21}]},"17":{"id":17,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“It's a very exclusive country club for people who value their privacy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":16}]},"18":{"id":18,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I am sure it will be worth our time. He is a Koronti after all. Let’s get personal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":20}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"It was rather chilly. I was approached by Petr Vectern and Lucian Galade.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":4}]},"20":{"id":20,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Let's.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":16}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"After opening the marble engraved wooden door, we were greeted by two tall women. The receptionists led us to the meeting room upstairs.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":22}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel was standing by the window looking outside at the beautiful complex. He turned around to have a quick look at us both.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":23}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"He was a strikingly handsome man with well-groomed hair. He walked towards me with his hand reached out for a handshake.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":24},{"convId":13,"nodeId":25}]},"24":{"id":24,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Reach out for a handshake.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":28}]},"25":{"id":25,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Do nothing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":27}]},"26":{"id":26,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“It is such a pleasure to meet you in person, Mr. Koronti. I appreciate your efforts to reach out and establish a mutually beneficial friendship.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":36}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"He put his hand back in his pocket and smiled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":26}]},"28":{"id":28,"speaker":"Narrator","isPlayerChoice":false,"text":"He had a firm grip.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":26}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"“Yes. There is much to discuss.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":32}]},"30":{"id":30,"speaker":"Player","isPlayerChoice":true,"text":"“I heard about your meteoric rise in HOS.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":34}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“Let’s have a seat.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":41}]},"32":{"id":32,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Believe it or not I have been a secret admirer of your political success.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":33}]},"33":{"id":33,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I find your quick rise to power was shockingly well-executed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":163},{"convId":13,"nodeId":44},{"convId":13,"nodeId":45},{"convId":13,"nodeId":110}]},"34":{"id":34,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I'm flattered. You truly are going to be the best President this country has seen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":35}]},"35":{"id":35,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I say this because you have gone against the odds and survived. I respect that more than anything.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":110},{"convId":13,"nodeId":42},{"convId":13,"nodeId":43}]},"36":{"id":36,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Thanks for hosting us. I admired your father very much, may he rest in peace.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":39}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“May he rest in peace. He was a true entrepreneur.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":5}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“Please accept our condolences. We are saddened.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":5}]},"39":{"id":39,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Welcome. Your kind words have touched me, Mr. Vice President. He was indeed a great man.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":37},{"convId":13,"nodeId":38},{"convId":13,"nodeId":109}]},"40":{"id":40,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“It's time to look forward. Let's talk about our bright future.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":29},{"convId":13,"nodeId":31},{"convId":13,"nodeId":30}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel gently pointed at the seats. We sat down around a gigantic table. Before speaking he knocked on wood.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":135}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"“It seems we had similar experiences.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":41}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"“Politics is a ladder. The higher you climb the more chaos is around you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":41}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“I would not be standing here if I was bad at what I do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":41}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"“The admiration goes both ways.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":41}]},"46":{"id":46,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Well... I am known to be a straightforward person. So, let me get to the point without wasting your valuable time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":47}]},"47":{"id":47,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“It was during the Alphonso campaign when I was struck by what you managed to do within the party.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":51}]},"48":{"id":48,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Give Lucian a puzzled look.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":53}]},"49":{"id":49,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Look at the painting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":52}]},"50":{"id":50,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Look at Marcel.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":56}]},"51":{"id":51,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel's eyes traveled toward one of the paintings on his wall.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":49},{"convId":13,"nodeId":48},{"convId":13,"nodeId":50},{"convId":13,"nodeId":164}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"The famous piece depicted a giant, sleeping beneath a village. The trees, rivers and hills were all a part of the giant's body.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":54}]},"53":{"id":53,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian looked back at me and shrugged. Then he raised his eyebrows, something which he usually did when curious.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":56}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"Its eyes were two caves looking up at the people. It showed daylight on the far left and night time on the far right.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":55}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"The giant seemed to be watching the village. It was totally unbeknownst to the villagers.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":56}]},"56":{"id":56,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel pointed his finger at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":57}]},"57":{"id":57,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You said we will transform this nation, Mr. Rayne. My conglomerate has a way of doing things and I don't want them to change.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":58}]},"58":{"id":58,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“So, I want to cooperate with you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":59},{"convId":13,"nodeId":60},{"convId":13,"nodeId":111},{"convId":13,"nodeId":166}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“Cooperate?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":61}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“Please, explain further.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":61}]},"61":{"id":61,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You might have the people's support now, Mr. President. But what happens when you make mistakes?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":112}]},"62":{"id":62,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“What is that supposed to mean?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":63}]},"63":{"id":63,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Let's hear his point, Vice President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":113}]},"64":{"id":64,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“...If they were released.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":67},{"convId":13,"nodeId":65},{"convId":13,"nodeId":66},{"convId":13,"nodeId":116}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"“Continue.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":68}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“You are playing a dangerous game.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":70}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"“I see where you are getting at.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":69}]},"68":{"id":68,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Now, assume that the press would actually protect your integrity no matter what. That the people I reach -- up to five million of them -- will not lose faith in you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":117},{"convId":13,"nodeId":71},{"convId":13,"nodeId":72}]},"69":{"id":69,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You knew that a long time before you came here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":117},{"convId":13,"nodeId":71},{"convId":13,"nodeId":72}]},"70":{"id":70,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“We are all dangerous men playing dangerous games.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":117},{"convId":13,"nodeId":71},{"convId":13,"nodeId":72}]},"71":{"id":71,"speaker":"Player","isPlayerChoice":true,"text":"“What do you want in return?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":73}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"“You aren’t just being nice, are you?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":73}]},"73":{"id":73,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I want two things, Mr. President. Number one is a guarantee from you that the Rayne administration won't meddle in HOS affairs, no matter what happens.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":74}]},"74":{"id":74,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Number two is a simple gentleman's favor for the future. Let me prove my services to you first, and I'm sure you won't disapprove when the time comes.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":75},{"convId":13,"nodeId":76},{"convId":13,"nodeId":77}]},"75":{"id":75,"speaker":"Player","isPlayerChoice":true,"text":"“This is far too risky for me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":80}]},"76":{"id":76,"speaker":"Player","isPlayerChoice":true,"text":"“It is an interesting proposal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":82}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"“How do I know that I can trust you?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":84}]},"78":{"id":78,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think it is a good deal. He is right, we will need the media support. With his newspapers and channels on our side we can dodge a lot of bullets.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":88}]},"79":{"id":79,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“I think he is getting more out of this than we are. He wouldn't be offering such a risky deal unless he wanted something big.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":89}]},"80":{"id":80,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Great risk means great reward. This mutually beneficial cooperation will help you greatly.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":81}]},"81":{"id":81,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I can guarantee that you will see its benefits sooner than later. We can make history together, if we dare to challenge the odds.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":93},{"convId":13,"nodeId":86},{"convId":13,"nodeId":87},{"convId":13,"nodeId":92}]},"82":{"id":82,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Not just interesting but necessary. You surely know that this is a win-win situation.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":83}]},"83":{"id":83,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“The media will be on your side strengthening your position. It will also protect my business operations throughout the changes this country will see.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":93},{"convId":13,"nodeId":86},{"convId":13,"nodeId":87},{"convId":13,"nodeId":92}]},"84":{"id":84,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“My circle advised against this. They don't even know we are meeting. Mr. President, we're both putting ourselves at risk here, but I am willing to trust you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":85}]},"85":{"id":85,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“The question is; are you willing to trust me and accept this offer?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":93},{"convId":13,"nodeId":86},{"convId":13,"nodeId":87},{"convId":13,"nodeId":92}]},"86":{"id":86,"speaker":"Player","isPlayerChoice":true,"text":"“What do you think about this, Lucian?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":91}]},"87":{"id":87,"speaker":"Player","isPlayerChoice":true,"text":"“You have been awfully silent, Petr.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":90}]},"88":{"id":88,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The one thing that bothers me though is his favor request. We do not know what he'll ask for, and it could be something that endangers our administration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":151}]},"89":{"id":89,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“We need to be cautious. If we get caught or this gets out, I can't imagine the consequences.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":151}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr leaned over to my ear and whispered.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":79}]},"91":{"id":91,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian leaned over to my ear and whispered.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":78}]},"92":{"id":92,"speaker":"Player","isPlayerChoice":true,"text":"“Mr. Koronti, I have to reject.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":103}]},"93":{"id":93,"speaker":"Player","isPlayerChoice":true,"text":"“We have a deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":102}]},"94":{"id":94,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Happy to hear that. You can contact me personally through this number.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"=","value":"true"},{"var":"BaseGame.Situation_Law_MediaBias","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn02_StruckDealWithMarcel","op":"=","value":"true"},{"var":"BaseGame.Accepted_MediaDeal","op":"=","value":"true"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 2"},{"var":"BaseGame.Democratic","op":"=","value":"Variable[\"BaseGame.Democratic\"] - 2"}],"outgoingIds":[{"convId":13,"nodeId":131}]},"95":{"id":95,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I hope you will uphold your end of the bargain as well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":159},{"convId":13,"nodeId":105},{"convId":13,"nodeId":106},{"convId":13,"nodeId":132}]},"96":{"id":96,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Return to Holsord.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":104}]},"97":{"id":97,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Thank you for your time, Mr. Koronti.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":96}]},"98":{"id":98,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Such a pity, Mr. President. And here I thought we were going to be good friends.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"=","value":"false"},{"var":"BaseGameSupport.Journal_Turn02_RefusedDealWithMarcel","op":"=","value":"true"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] - 2"},{"var":"BaseGame.Democratic","op":"=","value":"Variable[\"BaseGame.Democratic\"] + 1"}],"outgoingIds":[{"convId":13,"nodeId":99}]},"99":{"id":99,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“It's a shame. Really.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":124},{"convId":13,"nodeId":107},{"convId":13,"nodeId":108}]},"100":{"id":100,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Let's leave.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":157}]},"101":{"id":101,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I was hoping that would end better.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":125},{"convId":13,"nodeId":126},{"convId":13,"nodeId":127}]},"102":{"id":102,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"=","value":"true"},{"var":"BaseGame.Situation_Law_MediaBias","op":"=","value":"true"}],"outgoingIds":[{"convId":13,"nodeId":170}]},"103":{"id":103,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"=","value":"false"}],"outgoingIds":[{"convId":13,"nodeId":168}]},"104":{"id":104,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn02_A_MediaDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":13,"nodeId":169}]},"105":{"id":105,"speaker":"Player","isPlayerChoice":true,"text":"“A deal is a deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":154}]},"106":{"id":106,"speaker":"Player","isPlayerChoice":true,"text":"“You can bet on it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":155}]},"107":{"id":107,"speaker":"Player","isPlayerChoice":true,"text":"“Remember who you are speaking to, Mr. Koronti.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":152}]},"108":{"id":108,"speaker":"Player","isPlayerChoice":true,"text":"“I regret coming here to see you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":153}]},"109":{"id":109,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Stay silent.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":40}]},"110":{"id":110,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":41}]},"111":{"id":111,"speaker":"Player","isPlayerChoice":true,"text":"“The intent is mutual.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":61}]},"112":{"id":112,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Everybody makes mistakes...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":62}]},"113":{"id":113,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Being a president in this country means having many enemies. Enemies that would resort to anything to bring you down.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":114}]},"114":{"id":114,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Let’s say these enemies caused a scandal or leaked sensitive information from the administration.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":115}]},"115":{"id":115,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“These would be destructive once they were released...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":64}]},"116":{"id":116,"speaker":"Player","isPlayerChoice":true,"text":"“Are you threatening me?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":118}]},"117":{"id":117,"speaker":"Player","isPlayerChoice":true,"text":"“Let's hear your offer.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":73}]},"118":{"id":118,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Absolutely not. I'm merely offering a helping hand.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":117},{"convId":13,"nodeId":71},{"convId":13,"nodeId":119}]},"119":{"id":119,"speaker":"Player","isPlayerChoice":true,"text":"“It doesn't sound like help.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":120}]},"120":{"id":120,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I harbor no ill will. It is up to you whether to accept my support or not. Let me at least explain further.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":122},{"convId":13,"nodeId":121}]},"121":{"id":121,"speaker":"Player","isPlayerChoice":true,"text":"“I have heard enough.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":103}]},"122":{"id":122,"speaker":"Player","isPlayerChoice":true,"text":"“Make your case.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":73}]},"123":{"id":123,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“So... do we have a deal?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":93},{"convId":13,"nodeId":92}]},"124":{"id":124,"speaker":"Player","isPlayerChoice":true,"text":"“Goodbye, Mr. Koronti.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":100}]},"125":{"id":125,"speaker":"Player","isPlayerChoice":true,"text":"“Agreed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":129}]},"126":{"id":126,"speaker":"Player","isPlayerChoice":true,"text":"“It was your idea.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":130}]},"127":{"id":127,"speaker":"Player","isPlayerChoice":true,"text":"“He pushed it too far.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":128}]},"128":{"id":128,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The threats were unacceptable.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":96}]},"129":{"id":129,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I'm sorry. I should have seen it coming.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":96}]},"130":{"id":130,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian didn't comment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":96}]},"131":{"id":131,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“As soon as you know that a story against you will break, please call me and it will be taken care of.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":95}]},"132":{"id":132,"speaker":"Player","isPlayerChoice":true,"text":"“As long as you do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":156}]},"133":{"id":133,"speaker":"Player","isPlayerChoice":true,"text":"“Anything to keep me away from home.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":134}]},"134":{"id":134,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“That bad, huh? Well this should prove distracting. Shall we then?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":16}]},"135":{"id":135,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“The past months have been tumultuous to say the least, I am glad you and your family were unharmed at the shooting.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":139}]},"136":{"id":136,"speaker":"Player","isPlayerChoice":true,"text":"“They were startled, but the important thing is they are safe and sound.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":145}]},"137":{"id":137,"speaker":"Player","isPlayerChoice":true,"text":"“I will not allow this situation to continue.”","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":144}]},"138":{"id":138,"speaker":"Player","isPlayerChoice":true,"text":"“I stayed and served my country dutifully.”","conditionsRaw":"Variable[\"BaseGame.Prologue_Military_Order_Accomplished\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Military_Order_Accomplished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":147}]},"139":{"id":139,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“The whole incident must have been a shock for the kids. They aren't used to what we lived through back in the late '20s. I still remember when my father took us out of the country when it became too dangerous in Conriat.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":140},{"convId":13,"nodeId":136},{"convId":13,"nodeId":143},{"convId":13,"nodeId":148}]},"140":{"id":140,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":141},{"convId":13,"nodeId":142}]},"141":{"id":141,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":137}]},"142":{"id":142,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"143":{"id":143,"speaker":"Player","isPlayerChoice":true,"text":"“Spare me your life story, Mr. Koronti.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":146}]},"144":{"id":144,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“The restoration of order is important for business and the political atmosphere, but one must consider the measures and cost.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":46}]},"145":{"id":145,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Of course that is all that matters. No family should suffer from tragedy ever again, we've had enough of that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":46}]},"146":{"id":146,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“As you wish, but it's an amazing life story.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":172}]},"147":{"id":147,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I am sure you did. My father also served this country and employed thousands in those times of crisis.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":46}]},"148":{"id":148,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":149},{"convId":13,"nodeId":150}]},"149":{"id":149,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Military_Order_Accomplished\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Military_Order_Accomplished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":138}]},"150":{"id":150,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Military_Order_Accomplished\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Military_Order_Accomplished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"151":{"id":151,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel interrupted us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":123}]},"152":{"id":152,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Oh, I know very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":100}]},"153":{"id":153,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Hm.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":100}]},"154":{"id":154,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“A man of his word, excellent.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":160}]},"155":{"id":155,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I rarely bet, but when I do, all possibilities are accounted for.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":160}]},"156":{"id":156,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You can count on me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":160}]},"157":{"id":157,"speaker":"Narrator","isPlayerChoice":false,"text":"We left the complex and entered the car.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":101}]},"158":{"id":158,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel put his second hand on mine.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":160}]},"159":{"id":159,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Shake his hand.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":158}]},"160":{"id":160,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“We will meet again. Goodbye.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":97}]},"161":{"id":161,"speaker":"Player","isPlayerChoice":true,"text":"“I can't think of comfort when our country is descending into chaos.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":162}]},"162":{"id":162,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“When you put it like that...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":16}]},"163":{"id":163,"speaker":"Player","isPlayerChoice":true,"text":"“Let's just get to the point.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":41}]},"164":{"id":164,"speaker":"Player","isPlayerChoice":true,"text":"“Let me be *straightforward*. Sit down and get to the damn point.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":13,"nodeId":165}]},"165":{"id":165,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Ah no need be rude, 