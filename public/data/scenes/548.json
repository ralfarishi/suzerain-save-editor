rom the start, the Senate will struggle to have any influence on the Delegates' decisions.\"","conditionsRaw":"((Variable[\"RiziaDLC.Reform_UpperHouse_Equal\"] == true) == false) and (Variable[\"RiziaDLC.Reform_UpperHouse_Limited\"] == true)","variablesRead":[{"var":"RiziaDLC.Reform_UpperHouse_Equal","op":"==","value":"true"},{"var":"RiziaDLC.Reform_UpperHouse_Limited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":73}]},"71":{"id":71,"speaker":"Adarfo Sotelato","isPlayerChoice":false,"text":"\"But with no real authority, they'll just sit there -- voices drowned out by those who actually hold power.\"","conditionsRaw":"((Variable[\"RiziaDLC.Reform_UpperHouse_Equal\"] == true) == false) and ((Variable[\"RiziaDLC.Reform_UpperHouse_Limited\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Reform_UpperHouse_Equal","op":"==","value":"true"},{"var":"RiziaDLC.Reform_UpperHouse_Limited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":73}]},"72":{"id":72,"speaker":"Adarfo Sotelato","isPlayerChoice":false,"text":"\"The creation of the Regional Senate is progressing steadily, with candidates actively campaigning.\"","conditionsRaw":"((Variable[\"RiziaDLC.Reform_PrimeMinister_Manus\"] == true) == false) and ((Variable[\"RiziaDLC.Reform_PrimeMinister_Daria\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Reform_PrimeMinister_Manus","op":"==","value":"true"},{"var":"RiziaDLC.Reform_PrimeMinister_Daria","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":64}]},"73":{"id":73,"speaker":"Adarfo Sotelato","isPlayerChoice":false,"text":"\"Frankly, they'd save everyone time by skipping the elections altogether and appointing actors to read from a script.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":74}]},"74":{"id":74,"speaker":"Adarfo Sotelato","isPlayerChoice":false,"text":"\"At least then they wouldn't have to pretend this is anything more than a farce.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":75}]},"75":{"id":75,"speaker":"Adarfo Sotelato","isPlayerChoice":false,"text":"\"Until the new legislative building is complete. the Grand Hall of Palas Rezna will serve as their stage.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":2}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":77},{"convId":548,"nodeId":78}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":79}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":80}]},"79":{"id":79,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"So is my mother, who's all but assured to be elected as a representative of Brenas.\"","conditionsRaw":"Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":51}]},"80":{"id":80,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"So is Leona, who's all but assured to be elected as a representative of Brenas.\"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":51}]},"81":{"id":81,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":82},{"convId":548,"nodeId":83}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":84}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":85}]},"84":{"id":84,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"So is my mother, who's all but assured to be elected as a representative of House Sazon.\"","conditionsRaw":"Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":2}]},"85":{"id":85,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"So is Leona, who's all but assured to be elected as a representative of House Sazon.\"","conditionsRaw":"(Variable[\"RiziaDLC.Relations_HouseSazon_AngelicaPardoned\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Relations_HouseSazon_AngelicaPardoned","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":548,"nodeId":2}]}}}