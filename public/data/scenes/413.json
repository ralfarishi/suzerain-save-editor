{"conversationId":413,"title":"Rizia/Turn 8/A_HugoLeaves","storyPack":"StoryPack_Rizia","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":119}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Shortly after my return from Wehlen, I was told that my uncle wanted to speak to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":82}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"The door to my chambers swung open as Titus let him in.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":92}]},"5":{"id":5,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Romus. My king.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":104}]},"6":{"id":6,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Yet I cannot help but wonder whether this triumph had to come at such a great cost.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":9}]},"7":{"id":7,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I begged you with all my heart -- as your uncle and your Grand Vizier. And you refused to listen.\"","conditionsRaw":"(Variable[\"RiziaDLC.Rico_Extradited\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":27}]},"8":{"id":8,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Despite the fact that my son was proven innocent, you are keen on letting Ricardus rot in a cell...\"","conditionsRaw":"(Variable[\"RiziaDLC.Rico_Extradited\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":19}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":10},{"convId":413,"nodeId":11}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Rico_Extradited\"] == true","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":12}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Rico_Extradited\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":8}]},"12":{"id":12,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Despite my entreaties, you insisted on sending my son to Wehlen...\"","conditionsRaw":"Variable[\"RiziaDLC.Rico_Extradited\"] == true","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":13}]},"13":{"id":13,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Ricardus might have erred, but he is still a Toras. Your flesh and blood, for God's sake!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":14},{"convId":413,"nodeId":112},{"convId":413,"nodeId":16},{"convId":413,"nodeId":17}]},"14":{"id":14,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He is a traitor, Hugo. We've already been through this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":21}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I did what I had to do to get Zille back. Rico was a necessary sacrifice so that millions more Rizians could live in peace and freedom.\"","conditionsRaw":"Variable[\"RiziaDLC.ZilleReturn_Success\"] == true","variablesRead":[{"var":"RiziaDLC.ZilleReturn_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":116}]},"16":{"id":16,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am sorry, Hugo. There is nothing I can do about it now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":23}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You are speaking to the King, Hugo. Please lower your voice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":22}]},"18":{"id":18,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He's your cousin, for God's sake! Your flesh and blood!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":112},{"convId":413,"nodeId":16},{"convId":413,"nodeId":17},{"convId":413,"nodeId":20}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"I could see him struggling to stay calm.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":18}]},"20":{"id":20,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We've already been through this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":7}]},"21":{"id":21,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"How could you let President Smolak take him? I explicitly asked you to respect Rico's dignity.\"","conditionsRaw":"Variable[\"RiziaDLC.Rico_Extradited\"] == true","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":28}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"He stopped himself and cleared his throat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":26}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":24},{"convId":413,"nodeId":25}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Rico_Extradited\"] == true","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":21}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Rico_Extradited\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":7}]},"26":{"id":26,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Your Majesty...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":23}]},"27":{"id":27,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You know how much I've done for the sake of the Crown. For our family.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":34}]},"28":{"id":28,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"What end goal can justify subjecting your own cousin to the barbaric punishment of the Wehzeks? Have you so little faith in Rizian justice?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":32},{"convId":413,"nodeId":29},{"convId":413,"nodeId":30},{"convId":413,"nodeId":31}]},"29":{"id":29,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Barbaric? Ricardus is royalty. They're probably feeding him grapes over there right now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":117}]},"30":{"id":30,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am terribly sorry. I'll miss Rico just as much as you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":33}]},"31":{"id":31,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It was a decision borne of necessity, not desire. The negative consequences of denying Wehlen's request would have been far worse.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":33}]},"32":{"id":32,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I believe I have said enough on this subject.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":33}]},"33":{"id":33,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Think of my loyalty, Romus. Of my service to the Crown. Is this the price? My son's head on a foreign pike?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":36},{"convId":413,"nodeId":37},{"convId":413,"nodeId":38},{"convId":413,"nodeId":39}]},"34":{"id":34,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I swore an oath to give my life in service to this kingdom. And I do not intend to falter in my sacred duty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":44}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"He looked at me with fury in his eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":40}]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Don't be so dramatic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":41}]},"37":{"id":37,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Your loyalty has never been in question, nor will it ever be. This pains me deeply, Hugo. Believe me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":43}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What's done is done. The Crown must often make choices that wound us personally for the greater good of the kingdom.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":43}]},"39":{"id":39,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The longer you keep going on like this, the more I'm beginning to doubt that loyalty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":35}]},"40":{"id":40,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You don't mean that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":27}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"He looked at me with fury in his eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":42}]},"42":{"id":42,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Are you serious?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":27}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"He let out a deep sigh.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":27}]},"44":{"id":44,"speaker":"Narrator","isPlayerChoice":false,"text":"He was holding his golden pin, The Vizier's Star -- the official symbol of his authority as the Grand Vizier -- in his hands. He gripped it tightly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":45}]},"45":{"id":45,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I cannot bear this, Romus...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":55}]},"46":{"id":46,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I cannot in good conscience continue my duties as Grand Vizier, knowing my son has been thrown to the wolves.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":47}]},"47":{"id":47,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I need some time on my own. I need to leave the capital.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":51},{"convId":413,"nodeId":50},{"convId":413,"nodeId":49},{"convId":413,"nodeId":48},{"convId":413,"nodeId":52}]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What do you mean, you're leaving?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":58}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You can't quit. You're fired.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":118}]},"50":{"id":50,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You cannot just abandon your duties, Hugo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":65}]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If that is your wish, Uncle, I will not stop you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":54}]},"52":{"id":52,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And where will you go?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":53}]},"53":{"id":53,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I will go back home, to Monqiz. It has been too long, anyway.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":59}]},"54":{"id":54,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Thank you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":65}]},"55":{"id":55,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I cannot continue to serve you in the same capacity anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":46}]},"56":{"id":56,"speaker":"Narrator","isPlayerChoice":false,"text":"He walked up to my desk and placed his pin on it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":66}]},"57":{"id":57,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"For the good of the Crown, I must.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":53}]},"58":{"id":58,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I cannot stay here, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":53}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":60},{"convId":413,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":63}]},"62":{"id":62,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I shall assist Vina once she moves to Valenqiris, if Her Highness accepts my help.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":64}]},"63":{"id":63,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I shall assist Duke Hubertus with his duties, if His Grace accepts my help.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":64}]},"64":{"id":64,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I will do what I can for our house and our province. But I will no longer involve myself in the affairs of the capital.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":56}]},"65":{"id":65,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It pains me deeply, but I must let go of my title and responsibilities.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":57}]},"66":{"id":66,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"There.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":67}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"He knelt in front of me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":68}]},"68":{"id":68,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It was an honor to serve you, King Romus Toras, the First of His Name.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":75},{"convId":413,"nodeId":69},{"convId":413,"nodeId":70},{"convId":413,"nodeId":71}]},"69":{"id":69,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Your departure is tantamount to betrayal. I will no longer be able to trust you after this. You understand that, right?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":72}]},"70":{"id":70,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm warning you, Hugo. Don't think about doing anything questionable.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":72}]},"71":{"id":71,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"There is no need for that. Stand up. You are still family.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":76}]},"72":{"id":72,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I am disappointed you would think that of me, my nephew.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":73}]},"73":{"id":73,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"My loyalty to the Kingdom has never once wavered.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":74}]},"74":{"id":74,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Glovurius axa Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":77}]},"75":{"id":75,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And it was an honor to have your guidance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":74}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"He stood up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":74}]},"77":{"id":77,"speaker":"Narrator","isPlayerChoice":false,"text":"He bowed his head and left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":83}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Council_GrandVizier_Hugo","op":"=","value":"false"},{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"=","value":"true"}],"outgoingIds":[{"convId":413,"nodeId":80}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":2}]},"80":{"id":80,"speaker":"Narrator","isPlayerChoice":false,"text":"As the door closed, I let out a breath I didn't realize I'd been holding.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Council_GrandVizier_Hugo","op":"=","value":"false"},{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"=","value":"true"}],"outgoingIds":[{"convId":413,"nodeId":81}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo would have to be watched closely from now on.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":90}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":4}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":78}]},"84":{"id":84,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":3}]},"85":{"id":85,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":86},{"convId":413,"nodeId":87}]},"86":{"id":86,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Rico_Extradited\"] == true","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":89}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Rico_Extradited\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Rico_Extradited","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":88}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.News_Turn08_RH_HugoLeaves_Arrest","op":"=","value":"true"}],"outgoingIds":[{"convId":413,"nodeId":79}]},"89":{"id":89,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.News_Turn08_RH_HugoLeaves_Extradite","op":"=","value":"true"}],"outgoingIds":[{"convId":413,"nodeId":79}]},"90":{"id":90,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Council_GrandVizier_Hugo","op":"=","value":"false"},{"var":"RiziaDLC.Council_GrandVizier_Empty","op":"=","value":"true"},{"var":"RiziaDLC.Hugo_Resigned","op":"=","value":"true"}],"outgoingIds":[{"convId":413,"nodeId":91}]},"91":{"id":91,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":85}]},"92":{"id":92,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":93},{"convId":413,"nodeId":94}]},"93":{"id":93,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":96}]},"94":{"id":94,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":103}]},"95":{"id":95,"speaker":"Narrator","isPlayerChoice":false,"text":"Bruno immediately jumped up on him, tail wagging. Hugo didn't pay him any attention.","conditionsRaw":"Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":97},{"convId":413,"nodeId":98},{"convId":413,"nodeId":99}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":95}]},"97":{"id":97,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Bruno! Down!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":102}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're just going to let him do that?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":101}]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Sorry. He's forgotten all of the training Rico gave him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":100}]},"100":{"id":100,"speaker":"Narrator","isPlayerChoice":false,"text":"On hearing his son's name, Hugo shuddered involuntarily. He pushed Bruno aside and stood before me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":5}]},"101":{"id":101,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo didn't answer. He pushed Bruno aside and stood before me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":5}]},"102":{"id":102,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo stared ahead numbly. He pushed Bruno aside and stood before me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":5}]},"103":{"id":103,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo had a numb look in his eyes as he came to stand before me.","conditionsRaw":"(Variable[\"RiziaDLC.BrunoDog_Adopted\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BrunoDog_Adopted","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":5}]},"104":{"id":104,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":105},{"convId":413,"nodeId":106}]},"105":{"id":105,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.ZilleReturn_Success\"] == true","variablesRead":[{"var":"RiziaDLC.ZilleReturn_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":107}]},"106":{"id":106,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.ZilleReturn_Success\"] == true) == false","variablesRead":[{"var":"RiziaDLC.ZilleReturn_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":109}]},"107":{"id":107,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I must... congratulate you on negotiating the successful return of Zille.\"","condit