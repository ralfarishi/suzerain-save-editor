p":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":115}]},"115":{"id":115,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I did what I thought was right at the time. How was I to know Smolak wouldn't keep his word?\"","conditionsRaw":"(Variable[\"RiziaDLC.ZilleReturn_Success\"] == true) == false","variablesRead":[{"var":"RiziaDLC.ZilleReturn_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":116}]},"116":{"id":116,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Surely this was not the only way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":23}]},"117":{"id":117,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You know that isn't true.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":33}]},"118":{"id":118,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Then so be it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":53}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":413,"nodeId":84}]}}}