:"((Variable[\"RiziaDLC.HouseElections_RPPWinsSeats\"] == true) == false) and (Variable[\"RiziaDLC.HouseElections_RNCWinsSeats\"] == true)","variablesRead":[{"var":"RiziaDLC.HouseElections_RPPWinsSeats","op":"==","value":"true"},{"var":"RiziaDLC.HouseElections_RNCWinsSeats","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":44}]},"22":{"id":22,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If you ask my opinion, it is unlikely there will be much change in the House.\"","conditionsRaw":"((Variable[\"RiziaDLC.HouseElections_RPPWinsSeats\"] == true) == false) and ((Variable[\"RiziaDLC.HouseElections_RNCWinsSeats\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.HouseElections_RPPWinsSeats","op":"==","value":"true"},{"var":"RiziaDLC.HouseElections_RNCWinsSeats","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":44}]},"23":{"id":23,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The House has recently sent me their report on public opinion.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":3}]},"24":{"id":24,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"According to it, the population seems to quite content with our administration and the popularity of our Majesty is very high.\"","conditionsRaw":"Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 5","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":9}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":26},{"convId":587,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 3","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"3"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":34}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 3) == false","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"3"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":28}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":29},{"convId":587,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":35}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0) == false","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":31}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":32},{"convId":587,"nodeId":33}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_PublicOpinion\"] > -1","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">","value":"-1"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":36}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_PublicOpinion\"] > -1) == false","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">","value":"-1"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":37}]},"34":{"id":34,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"According to it, the population seems to quite content with our administration at the moment.\"","conditionsRaw":"((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 5) == false) and (Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 3)","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"5"},{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"3"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":9}]},"35":{"id":35,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"According to it, there is not a lot of concerning news. Everything seems to be quite stable.\"","conditionsRaw":"((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 5) == false) and ((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 3) == false) and (Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0)","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"5"},{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"3"},{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":9}]},"36":{"id":36,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It paints a worrying picture. It seems to have decreased quite a bit.\"","conditionsRaw":"((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 5) == false) and ((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 3) == false) and ((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0) == false) and (Variable[\"RiziaDLC.Country_PublicOpinion\"] > -1)","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"5"},{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"3"},{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"},{"var":"RiziaDLC.Country_PublicOpinion","op":">","value":"-1"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":9}]},"37":{"id":37,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It paints a very worrying picture. A lot of people are getting increasingly discontent and radicalization seems to be increasing as well.\"","conditionsRaw":"((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 5) == false) and ((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 3) == false) and ((Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0) == false) and ((Variable[\"RiziaDLC.Country_PublicOpinion\"] > -1) == false)","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"5"},{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"3"},{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"},{"var":"RiziaDLC.Country_PublicOpinion","op":">","value":"-1"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":9}]},"38":{"id":38,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And the parties have already started their campaigns.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":10}]},"39":{"id":39,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"However, one difference of this election is that a huge number of new voters have been registered - Wehzeks, Qinalis, Derdians and more...\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_ForeignVotingRights\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_ForeignVotingRights","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":40}]},"40":{"id":40,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It can potentially result in a surprise result.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":13}]},"41":{"id":41,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And with the new laws regarding the press, the turnouts will likely be the largest ever in this election.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_ForeignVotingRights\"] == true) == false) and (Variable[\"RiziaDLC.Policy_RD_Welfare_FreePress\"] == true)","variablesRead":[{"var":"RiziaDLC.Policy_ForeignVotingRights","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Welfare_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":42}]},"42":{"id":42,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And the Rizian People's Party is already using these avenues to grow their reach.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":43}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"He looked at the notes he was holding.","conditionsRaw":"((Variable[\"RiziaDLC.Policy_ForeignVotingRights\"] == true) == false) and ((Variable[\"RiziaDLC.Policy_RD_Welfare_FreePress\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Policy_ForeignVotingRights","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Welfare_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":6}]},"44":{"id":44,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"However, there's still a long way to go and we'll have to wait and see the results first.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":51},{"convId":587,"nodeId":16},{"convId":587,"nodeId":45},{"convId":587,"nodeId":46},{"convId":587,"nodeId":48}]},"45":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Thank you, Uncle. Keep following the House and the elections, I'd like to know about every important move.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":56}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't see how this concerns me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":53}]},"47":{"id":47,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It is worrying. I will look into what I can do for our public opinion.\"","conditionsRaw":"Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":56}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":49},{"convId":587,"nodeId":50}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":47},{"convId":587,"nodeId":57}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0) == false","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"}],"variablesModified":[],"outgoingIds":[]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I see. Anything else?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":52}]},"52":{"id":52,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"No, that was the extent of my update.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":2}]},"53":{"id":53,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Well...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":54}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"He hesitated to speak.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":55}]},"55":{"id":55,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I understand. That was the extent of my update.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":2}]},"56":{"id":56,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Of course, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":2}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't care if the public hates me.\"","conditionsRaw":"Variable[\"RiziaDLC.Country_PublicOpinion\"] >= 0","variablesRead":[{"var":"RiziaDLC.Country_PublicOpinion","op":">=","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":587,"nodeId":53}]}}}