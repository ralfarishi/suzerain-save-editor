{"conversationId":95,"title":"Sordland/Turn07/VoteLost","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":9}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":7}]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"\"What do you think was his real intention?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":5}]},"4":{"id":4,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"How did Serge know, anyway?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":6},{"convId":95,"nodeId":59},{"convId":95,"nodeId":71}]},"5":{"id":5,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He wished to intimidate the Assembly against our proposal, sir. And it seems to have worked.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":7}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"\"It doesn't matter now, does it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":84}]},"7":{"id":7,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As long as he's around, he will always have influence over the republic which he has built. We should have seen this coming.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":66}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":22}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian, Petr and I met in my office and decided to move out onto the balcony to get some fresh air in the increasing summer heat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":23}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":11},{"convId":95,"nodeId":12}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Assembly_Vote\"] == 16","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"16"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":13}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Assembly_Vote\"] == 16) == false","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"16"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":15}]},"13":{"id":13,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I still can't believe we lost by one vote...\"","conditionsRaw":"Variable[\"BaseGame.Reform_Assembly_Vote\"] == 16","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"16"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":28}]},"14":{"id":14,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Meanwhile...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":22}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":16},{"convId":95,"nodeId":17}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Assembly_Vote\"] == 11","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"11"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":102}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Assembly_Vote\"] == 11) == false","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"11"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":21}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's just move on to our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":35}]},"19":{"id":19,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I don't know what to say... I still can't believe we didn't even achieve a simple majority.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Assembly_Vote\"] == 16) == false) and (Variable[\"BaseGame.Reform_Assembly_Vote\"] == 11) and (Variable[\"BaseGame.Reform_BludishRights_Amendment_Proposal\"] == false)","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"16"},{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"11"},{"var":"BaseGame.Reform_BludishRights_Amendment_Proposal","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":30}]},"20":{"id":20,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I will also try and test the waters with our MPs. We can't let the party slip out of our grasp.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":90},{"convId":95,"nodeId":91},{"convId":95,"nodeId":89}]},"21":{"id":21,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"What do we do now? All our plans, for nothing...\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Assembly_Vote\"] == 16) == false) and ((Variable[\"BaseGame.Reform_Assembly_Vote\"] == 11) == false)","variablesRead":[{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"16"},{"var":"BaseGame.Reform_Assembly_Vote","op":"==","value":"11"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":39}]},"22":{"id":22,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We'll be organizing a cabinet meeting to discuss our present and future state of affairs.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":20}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"They both looked uncomfortable in their suits. Petr was trying not to make eye contact and kept letting out depressing sighs.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":25}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's just move on with our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":29}]},"25":{"id":25,"speaker":"Narrator","isPlayerChoice":false,"text":"He wiped the sweat off his forehead with a handkerchief.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":10}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":22}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"Just try to reach out to him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":57}]},"28":{"id":28,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It was all Mrs. Tory's doing...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":34}]},"29":{"id":29,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":78}]},"30":{"id":30,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"The party has finally spoken.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":32}]},"31":{"id":31,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Okay...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":49}]},"32":{"id":32,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Yes. The USP leadership is beginning to target us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":41}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"\"No, he didn't.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":48}]},"34":{"id":34,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"She changed the threshold! That bitch!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":36}]},"35":{"id":35,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. We must plan ahead now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":45}]},"36":{"id":36,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"She merely used her authority as Speaker. It was a valid interpretation of the Constitution. There were more than 250 members present...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":98}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"\"He saw their faces, but he didn't recognize them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":48}]},"38":{"id":38,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Yeah... What the hell was that all about? Soll appearing out of nowhere...\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_AssemblyVote_LostBy1\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_AssemblyVote_LostBy1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":50},{"convId":95,"nodeId":46},{"convId":95,"nodeId":47},{"convId":95,"nodeId":3}]},"39":{"id":39,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Yes. The USP leadership is beginning to target us as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":41}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"Exactly. We must plan our next steps.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":29}]},"41":{"id":41,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Not to mention Tarquin Soll himself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":98}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's not name any names now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":31}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You're right, sir. We must plan ahead now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":45}]},"44":{"id":44,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Oh, he did? Who were they?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":42},{"convId":95,"nodeId":37}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":22}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"\"He came to the Assembly to make a statement. And it worked.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":56}]},"47":{"id":47,"speaker":"Player","isPlayerChoice":true,"text":"\"What's done is done. Let's not linger in the past.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":54}]},"48":{"id":48,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"That's too bad.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":49}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In any case, I will conduct proper investigations into this. We should know every hidden Old Guard member who is working with Soll.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":14}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"\"Gentlemen! Nothing is over yet. We still have a country to lead.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":52}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"\"That wasn't your fault.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":61}]},"52":{"id":52,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"If we can lead it...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":82}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"\"Maybe you should have. Even Serge knew about it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":4}]},"54":{"id":54,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You're right, sir. We must plan ahead now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":8}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":true,"text":"\"We should organize a cabinet meeting to discuss the situation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":88}]},"56":{"id":56,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm sorry that we failed to gather the necessary intelligence about his arrival. Something went wrong on the security reports. I still don't know what. It was partly our fault.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":58}]},"57":{"id":57,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'll do my best, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":78}]},"58":{"id":58,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Y-Yes. We apologize.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":60},{"convId":95,"nodeId":51},{"convId":95,"nodeId":62}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"\"He said he overheard some people talking about it around the Assembly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":80}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"\"It's all good.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":61}]},"61":{"id":61,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In a situation such as this, I would have expected Karl to report it to me. But it's no excuse. We should have done our own research.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":63},{"convId":95,"nodeId":18},{"convId":95,"nodeId":53}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"\"I learned it from Serge. How come MY DRIVER knows more than YOU!?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":65}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"\"What's done is done. Let's not linger in the past.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":43}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes, he did.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":44}]},"65":{"id":65,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"In a situation such as this, I would have expected Karl to report it to me. But you're right, sir. We should have done our own research.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":4}]},"66":{"id":66,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But he has no authority anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":68}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"\"I just still can't believe I didn't know about this beforehand.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":56}]},"68":{"id":68,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Well, the laws protect him from almost anything, and allows him to be a member of the Assembly. He can still propose bills and vote for them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":70}]},"69":{"id":69,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course not, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":49}]},"70":{"id":70,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That's proper authority, if you ask me. When you are the founder of this system, you don't need to be sitting in the presidential office to have power.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":47},{"convId":95,"nodeId":72},{"convId":95,"nodeId":73},{"convId":95,"nodeId":77}]},"71":{"id":71,"speaker":"Player","isPlayerChoice":true,"text":"\"I hope you are not hiding anything from me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":74}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"\"Are you saying he still has more authority than me?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":79}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"\"Lucian's right. He already showcased his powers at the vote. We must be careful.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":81}]},"74":{"id":74,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"What? Me? Never!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":69}]},"75":{"id":75,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The party is in disarray since we lost the vote. Soll might be working behind the scenes against us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":86}]},"76":{"id":76,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"He didn't see who they were, did he?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":6},{"convId":95,"nodeId":33},{"convId":95,"nodeId":64}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"\"I want to talk to him. Do you know if he's still in Holsord?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":85}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":22}]},"79":{"id":79,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"No, sir. But he certainly has enormous influence.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":75}]},"80":{"id":80,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It seems some of our respected MPs already knew about this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":76}]},"81":{"id":81,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We must be careful, indeed. The party is in disarray since we lost the vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":83}]},"82":{"id":82,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"...Which we will. You're right, sir. We must plan ahead now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":26}]},"83":{"id":83,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And with Soll making a comeback... We cannot trust anyone in the USP to keep supporting us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":86}]},"84":{"id":84,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I guess not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":49}]},"85":{"id":85,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He must be, sir. But he didn't even come to the Palace to pay his respects. I don't know what to expect.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":87}]},"86":{"id":86,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We cannot let the party turn against the administration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":40},{"convId":95,"nodeId":55},{"convId":95,"nodeId":67}]},"87":{"id":87,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"It smells fishy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":67},{"convId":95,"nodeId":27},{"convId":95,"nodeId":24}]},"88":{"id":88,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. I'll make the necessary arrangements.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":78}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"\"I want a list of every party member who voted against the proposal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":92}]},"90":{"id":90,"speaker":"Player","isPlayerChoice":true,"text":"\"Good. I want each minister to give me a report.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":97}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"\"The party has to learn to respect me. Tarquin Soll is not their leader anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":96}]},"92":{"id":92,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Sir, it was a secret ballot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":93},{"convId":95,"nodeId":94}]},"93":{"id":93,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't care. I want names.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":95}]},"94":{"id":94,"speaker":"Player","isPlayerChoice":true,"text":"\"Goddammit.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":96}]},"95":{"id":95,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. I'll do what I can.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":96}]},"96":{"id":96,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Don't worry, sir. We'll address the party soon enough, and put them in their proper place.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":2}]},"97":{"id":97,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Yes, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":2}]},"98":{"id":98,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":99},{"convId":95,"nodeId":100}]},"99":{"id":99,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_AssemblyVote_LostBy1\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_AssemblyVote_LostBy1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":101}]},"100":{"id":100,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_AssemblyVote_LostBy1\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_AssemblyVote_LostBy1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":38}]},"101":{"id":101,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"With a single vote, the ghost of the past has once again kept our nation from achieving progress.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_AssemblyVote_LostBy1\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_AssemblyVote_LostBy1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":38}]},"102":{"id":102,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":95,"nodeId":