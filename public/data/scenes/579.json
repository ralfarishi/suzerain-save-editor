{"conversationId":579,"title":"Rizia/INCREASELEVIES/INCREASELEVIES Conversation","storyPack":"StoryPack_Rizia","turn":-1,"turnLabel":"General","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":356,"nodeId":52}]},"3":{"id":3,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I've heard that you're calling for an increase in the levy obligations.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":4},{"convId":579,"nodeId":5},{"convId":579,"nodeId":8},{"convId":579,"nodeId":9}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Not just an increase. A doubling.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":29}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes. It's time the provinces contribute their fair share of soldiers and resources for the Crown.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":29}]},"6":{"id":6,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"That may be the intent, but you're also giving the noble houses more leverage than ever.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":34}]},"7":{"id":7,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"There's no denying that a stronger army is an asset.\"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":15}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I know it is risky to give the Houses more power, but it's a necessary compromise.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":29}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, Hugo. You heard it right.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":29}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"He leaned forward.","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":11}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":12},{"convId":579,"nodeId":13}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":28}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":7}]},"14":{"id":14,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Especially given our current circumstances as the weakest military power in the region.\"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":24}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":16},{"convId":579,"nodeId":17}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":14}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":18}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":19},{"convId":579,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Average\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Average","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Average\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Average","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":24}]},"21":{"id":21,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Especially given that all our neighbors possess stronger militaries than ours.\"","conditionsRaw":"((Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak\"] == true) == false) and (Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Average\"] == true)","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Average","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":24}]},"22":{"id":22,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But I hope you considered in detail what this will mean for the royal houses.\"","conditionsRaw":"((Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak\"] == true) == false) and ((Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Average\"] == true) == false) and ((Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Average","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":23},{"convId":579,"nodeId":35},{"convId":579,"nodeId":33},{"convId":579,"nodeId":39},{"convId":579,"nodeId":89},{"convId":579,"nodeId":36},{"convId":579,"nodeId":131}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The houses have always provided troops. If anything, more soldiers will ensure that every region is prepared should the kingdom face a threat.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":6}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":25},{"convId":579,"nodeId":26}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":22}]},"27":{"id":27,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And I understand this could also be helpful against the unrest we're facing.\"","conditionsRaw":"((Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak\"] == true) == false) and ((Variable[\"RiziaDLC.Situation_Diplomacy_PowerProjection_Average\"] == true) == false) and (Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true)","variablesRead":[{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Weak","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Diplomacy_PowerProjection_Average","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":22}]},"28":{"id":28,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"There's no denying we need a stronger force to end the Pales invasion quickly.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":30}]},"29":{"id":29,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":126}]},"30":{"id":30,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If you're certain these forces would make a difference in the ground operations, this would be the right call. We need numbers.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":102}]},"31":{"id":31,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No, I'm just going with my gut here.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_FunnyKing\"] == true  or  Variable[\"RiziaDLCSetup.CurrentTurn\"] < 5","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"},{"var":"RiziaDLCSetup.CurrentTurn","op":"<","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":120}]},"32":{"id":32,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Then take the time to consider it, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":74}]},"33":{"id":33,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't need to *consider* what's already obvious. The houses will grumble, they always do. But they will comply.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":42}]},"34":{"id":34,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Doubling their forces will double their influence as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":49}]},"35":{"id":35,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"More soldiers mean stronger houses, but it also means they are more dependent on the Crown. If they want to keep their new forces, they'll need to stay in line.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":43}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":37},{"convId":579,"nodeId":38}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_FunnyKing\"] == true  or  Variable[\"RiziaDLCSetup.CurrentTurn\"] < 5","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"},{"var":"RiziaDLCSetup.CurrentTurn","op":"<","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":31}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_FunnyKing\"] == true  or  Variable[\"RiziaDLCSetup.CurrentTurn\"] < 5) == false","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"},{"var":"RiziaDLCSetup.CurrentTurn","op":"<","value":"5"}],"variablesModified":[],"outgoingIds":[]},"39":{"id":39,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It will make them more loyal in the long run. This is both their burden and their reward.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":6}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo narrowed his eyes, seemingly unimpressed by my sarcasm. A forceful smile appeared on his face.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.PersonalValue_FunnyKing","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_FunnyKing\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":41}]},"41":{"id":41,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Ah, of course! Who needs a Grand Vizier when one has intestines?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":89},{"convId":579,"nodeId":51},{"convId":579,"nodeId":50},{"convId":579,"nodeId":52},{"convId":579,"nodeId":90}]},"42":{"id":42,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"There's a fine line between grumbling and resisting, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":45}]},"43":{"id":43,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Will they, now?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":44}]},"44":{"id":44,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Handing each of these houses twice the number of soldiers under their personal command only empowers them to do the opposite of 'falling in line.'\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":49}]},"45":{"id":45,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Handing each of these houses twice the number of soldiers under their personal command is the very thing that could make 'grumbling' turn into something far worse.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":49}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And what do you propose, Uncle? That we keep our forces weak? That the House armies stay tiny and underequipped while threats gather on our borders?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":107}]},"47":{"id":47,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You believe this decree could weaken the monarchy in the long run?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":55}]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You might be right. If they try to use their troops as their personal armies rather than the kingdom's forces, then we'll have a problem.\"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":32}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":115},{"convId":579,"nodeId":47},{"convId":579,"nodeId":46},{"convId":579,"nodeId":112},{"convId":579,"nodeId":122}]},"50":{"id":50,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Naturally. Strategic foresight is overrated.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":88}]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I do pride myself on efficiency.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":88}]},"52":{"id":52,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I assume you came here for something other than dramatic irony, Uncle.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":88}]},"53":{"id":53,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'm not here to question your authority. But I must remind you that this decree doesn't only increase our forces. It shifts power in ways we can't control once the ink is dry.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":54}]},"54":{"id":54,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'm only here to challenge you before your enemies do.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":49}]},"55":{"id":55,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"That depends on the Azaros and the Sazons. And on you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":64}]},"56":{"id":56,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Then the decree is completely justified.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":59}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo blinked once, then exhaled slowly, pressing his lips together as if physically holding back a response.","conditionsRaw":"(Variable[\"RiziaDLC.Trait_SoberKing\"] == true  and  Variable[\"RiziaDLC.PersonalValues_FellOffWagon\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Trait_SoberKing","op":"==","value":"true"},{"var":"RiziaDLC.PersonalValues_FellOffWagon","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":58}]},"58":{"id":58,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You're the king, Romus. No one is saying you haven’t thought this through.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":60}]},"59":{"id":59,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I trust your judgement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":87}]},"60":{"id":60,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I will speak of this no more.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":86}]},"61":{"id":61,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Say what you will. But the absence of fear has toppled more kings than I can count.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":81}]},"62":{"id":62,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'm here to challenge you before your enemies do.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":49}]},"63":{"id":63,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"That is precisely why I am here. So you do not ignore the potential fallout.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":62}]},"64":{"id":64,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Because once you give a man an army, the only thing stopping him from using it is whether he fears you enough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":65},{"convId":579,"nodeId":66},{"convId":579,"nodeId":67},{"convId":579,"nodeId":68},{"convId":579,"nodeId":122}]},"65":{"id":65,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Then I'll make sure they do.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":138}]},"66":{"id":66,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Then I remove them before they get that chance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":75}]},"67":{"id":67,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I appreciate the words, but fear won't hold a nation together.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":69}]},"68":{"id":68,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That's too dramatic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":61}]},"69":{"id":69,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"No, but the absence of fear has toppled more kings than I can count.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":81}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":71},{"convId":579,"nodeId":72}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_SoberKing\"] == true  and  Variable[\"RiziaDLC.PersonalValues_FellOffWagon\"] == false","variablesRead":[{"var":"RiziaDLC.Trait_SoberKing","op":"==","value":"true"},{"var":"RiziaDLC.PersonalValues_FellOffWagon","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":73}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_SoberKing\"] == true  and  Variable[\"RiziaDLC.PersonalValues_FellOffWagon\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Trait_SoberKing","op":"==","value":"true"},{"var":"RiziaDLC.PersonalValues_FellOffWagon","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":57}]},"73":{"id":73,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Of course not.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_SoberKing\"] == true  and  Variable[\"RiziaDLC.PersonalValues_FellOffWagon\"] == false","variablesRead":[{"var":"RiziaDLC.Trait_SoberKing","op":"==","value":"true"},{"var":"RiziaDLC.PersonalValues_FellOffWagon","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":58}]},"74":{"id":74,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You lose nothing by thinking twice, but you risk everything by acting too soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":78}]},"75":{"id":75,"speaker":"Narrator","isPlayerChoice":false,"text":"He raised an eyebrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":76}]},"76":{"id":76,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The trouble with preemptive strikes, Romus, is that they teach others to do the same.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":81}]},"77":{"id":77,"speaker":"Narrator","isPlayerChoice":false,"text":"He bowed and left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":2}]},"78":{"id":78,"speaker":"Narrator","isPlayerChoice":false,"text":"I grabbed the pen.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":79},{"convId":579,"nodeId":106}]},"79":{"id":79,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Sign the decree.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":93}]},"80":{"id":80,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I surely hope so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.PersonalValue_Tyrant","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_Tyrant\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":81}]},"81":{"id":81,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":82},{"convId":579,"nodeId":83}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":84}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":85}]},"84":{"id":84,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But I understand the situation we're in. This decree will indeed be helpful with that.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":86}]},"85":{"id":85,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But I trust your judgement.\"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":78}]},"86":{"id":86,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I trust your judgement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":78}]},"87":{"id":87,"speaker":"Narrator","isPlayerChoice":false,"text":"I grabbed the pen.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":79}]},"88":{"id":88,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Look...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Said_Halaita","op":"=","value":"Variable[\"RiziaDLC.Said_Halaita\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":53}]},"89":{"id":89,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"With all due respect, Hugo, I've already thought about this in detail and I'm aware of the potential consequences.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":53}]},"90":{"id":90,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Halaita.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":119}]},"91":{"id":91,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I understand your concerns, Hugo, but I am certain these forces would make a difference in Pales.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":109}]},"92":{"id":92,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Pales won't be conquered easily with what we have now. The royal houses have the manpower. We should use it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":111}]},"93":{"id":93,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":94}]},"94":{"id":94,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'll let the others know about the changes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":95}]},"95":{"id":95,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Until next time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":77}]},"96":{"id":96,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I understand. Take your time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":99},{"convId":579,"nodeId":97},{"convId":579,"nodeId":98}]},"97":{"id":97,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"See you at dinner.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":100}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Good. Now I need a moment, if you'll excuse me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":100}]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I appreciate your counsel, Hugo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":77}]},"100":{"id":100,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Certainly, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":77}]},"101":{"id":101,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But I hope you considered in detail what this will mean for the royal houses.\"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":91},{"convId":579,"nodeId":92},{"convId":579,"nodeId":35},{"convId":579,"nodeId":33},{"convId":579,"nodeId":89}]},"102":{"id":102,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":103},{"convId":579,"nodeId":104}]},"103":{"id":103,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":105}]},"104":{"id":104,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":101}]},"105":{"id":105,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And I understand this could also be helpful against the unrest we're facing.\"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":101}]},"106":{"id":106,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You've given me a lot to consider. I'll hold off on the decree for now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":96}]},"107":{"id":107,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"No. I propose you stop assuming their compliance is guaranteed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":64}]},"108":{"id":108,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Just be sure that when we win, these forces answer to you, not the Houses who command them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":113},{"convId":579,"nodeId":114},{"convId":579,"nodeId":110},{"convId":579,"nodeId":125}]},"109":{"id":109,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Then by all means, sign the decree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":108}]},"110":{"id":110,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will. Thank you for the advice, Hugo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":59}]},"111":{"id":111,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I understand.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":108}]},"112":{"id":112,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No offense, Hugo, but I tire of your assumption that I haven't thought this through. Do you believe I draft decrees in a drunken stupor?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":70}]},"113":{"id":113,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You don't need to worry. I have no intention of letting the Houses walk over me. They may grumble, but they will comply.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":42}]},"114":{"id":114,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let's think about that after I sign this decree and win the war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":63}]},"115":{"id":115,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":116},{"convId":579,"nodeId":117}]},"116":{"id":116,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":118}]},"117":{"id":117,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"118":{"id":118,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I understand where you're coming from, but I am certain these forces are desperately needed for the war effort.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":56}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Said_Halaita","op":"=","value":"Variable[\"RiziaDLC.Said_Halaita\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":88}]},"120":{"id":120,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.PersonalValue_FunnyKing","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_FunnyKing\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":40}]},"121":{"id":121,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You might be right. I've been focused on the war effort, but I haven't considered what happens after the war.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":32}]},"122":{"id":122,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":123},{"convId":579,"nodeId":124}]},"123":{"id":123,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":121}]},"124":{"id":124,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":48}]},"125":{"id":125,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"If the provinces want to keep their new forces, they'll need to stay in line.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":43}]},"126":{"id":126,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":127},{"convId":579,"nodeId":128}]},"127":{"id":127,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":130}]},"128":{"id":128,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":10}]},"129":{"id":129,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I wouldn't have expected that after our discussion where you were considering abolishing the levies altogether.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":10}]},"130":{"id":130,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'm a little surprised.\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_AbolishLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":129}]},"131":{"id":131,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":132},{"convId":579,"nodeId":133}]},"132":{"id":132,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true  or  Variable[\"RiziaDLCSetup.CurrentTurn\"] < 5","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"},{"var":"RiziaDLCSetup.CurrentTurn","op":"<","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":134}]},"133":{"id":133,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true  or  Variable[\"RiziaDLCSetup.CurrentTurn\"] < 5) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"},{"var":"RiziaDLCSetup.CurrentTurn","op":"<","value":"5"}],"variablesModified":[],"outgoingIds":[]},"134":{"id":134,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No, I have not. I am a mere instrument of God's will.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true  or  Variable[\"RiziaDLCSetup.CurrentTurn\"] < 5","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"},{"var":"RiziaDLCSetup.CurrentTurn","op":"<","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":135}]},"135":{"id":135,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.PersonalValue_Religious","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_Religious\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":136}]},"136":{"id":136,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo narrowed his eyes, as if trying to determine whether I was serious. A forceful smile appeared on his face.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.PersonalValue_Religious","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_Religious\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":137}]},"137":{"id":137,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Ah, of course! The pure, God-given instincts of the King.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":579,"nodeId":89},{"convId":579,"nodeId":51},{"convId":579,"nodeId":50},{"convId":579,"nodeId":90}]},"138":{"id":138,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.PersonalValue_Tyrant","op":"=","value":"Variable[\"RiziaDLC.PersonalValue_Tyrant\"] + 1"}],"outgoingIds":[{"convId":579,"nodeId":80}]}}}