{"conversationId":168,"title":"Sordland/Turn08/InT_LateRailwayOpening","storyPack":"StoryPack_Main","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":1}]},"1":{"id":1,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":129}]},"2":{"id":2,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"The locomotive assistant flipped a few switches, and the train began pulling out of the central station. Lucian waved at the press photographers as I \"drove\".","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":49}]},"4":{"id":4,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn08_InT_LateOpening","op":"=","value":"true"}],"outgoingIds":[{"convId":168,"nodeId":172}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"It was a great victory for my administration.","conditionsRaw":"(Variable[\"BaseGame.Turn02_InT_Corporation_TaurusHolding\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_TaurusHolding\"] == true) == false) and (Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) == false) and (Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) and ((Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false) and (Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Lorren\"] == true  and  Variable[\"BaseGame.Decision_Turn02_EconomicRelief_BailedBusinesses\"] == true) and ((Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Lorren\"] == true  and  Variable[\"BaseGame.Decision_Turn02_EconomicRelief_BailedBusinesses\"] == true) == false)","variablesRead":[{"var":"BaseGame.Turn02_InT_Corporation_TaurusHolding","op":"==","value":"true"},{"var":"BaseGame.Turn02_InT_Corporation_SordishState","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Lorren","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn02_EconomicRelief_BailedBusinesses","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"},{"var":"BaseGame.Economy","op":"=","value":"Variable[\"BaseGame.Economy\"] + 1"},{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"},{"var":"BaseGameSupport.News_Turn08_E_L1_Taurus_Show","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_L1_Taurus_Show","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_L1_Taurus_NoShow","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_E_L1_Taurus_NoShow","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_L1_SSC_NoShow","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_E_L1_SSC_NoShow","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_E_L1_SSC_Show","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_L1_SSC_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":168,"nodeId":128}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"The railway officially opened to the public right after we left, and thousands began using it.","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":169}]},"7":{"id":7,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":8},{"convId":168,"nodeId":9}]},"8":{"id":8,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":14}]},"9":{"id":9,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":6}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"We walked towards the line where the first electric train was waiting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":15}]},"11":{"id":11,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Cut the ribbon.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":12}]},"12":{"id":12,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Congratulations to all. Hopefully this success will lead to many more.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":13}]},"13":{"id":13,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“It's a good moment indeed. We have helped so many in the countryside.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":7}]},"14":{"id":14,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The train is prepared, sir.”","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":97}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"A red ribbon was hanging by the door of the train.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":96}]},"16":{"id":16,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Sounds fantastic. The President arriving to Lachaven in the driver's seat would make the headlines for sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":53}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"It was finally happening. Tomorrow would be the grand opening ceremony of the L-1 High-speed rail.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"},{"var":"BaseGame.Turn04_InT_RailwayIssue_Solved","op":"=","value":"true"}],"outgoingIds":[{"convId":168,"nodeId":124}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon and Gus, who had heavily assisted in the project, had come to discuss the ceremony plans with Lucian and myself.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":103}]},"19":{"id":19,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I don't support anything beyond the opening ceremony. The railway's completion speaks for itself.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":21}]},"20":{"id":20,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Thank you, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":95}]},"21":{"id":21,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I see your point. But involving the President further could be beneficial for the administration.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":112}]},"22":{"id":22,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Get in the train.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":30}]},"23":{"id":23,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Alright then. We have a lot of work to do. See you tomorrow morning.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":51},{"convId":168,"nodeId":60},{"convId":168,"nodeId":115}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“It's been a long time since the last successful infrastructure project. From a public relations point of view, we can certainly capitalize on the occasion.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":101}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"“I'd like Gus with me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":28}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“I will drive the train on my own.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":36}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon walked up beside me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":61}]},"28":{"id":28,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I'm honored. It will be great to arrive in Lachaven with the President of Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":41}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"“I want to have Symon in the cab.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":32}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Who do you want to travel with in the cab, Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":31},{"convId":168,"nodeId":29},{"convId":168,"nodeId":25},{"convId":168,"nodeId":26}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian, I want you to ride with me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":33}]},"32":{"id":32,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This isn't necessary, but I won't refuse. We can talk about future economic projects.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":39}]},"33":{"id":33,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Thank you, Mr. President. It will be a good journey. We can talk about the election campaign preparations.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":3}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“I agree. Get me on that train.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":40}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"“I'd prefer we just do the opening ceremony. No need for senseless spectacle.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":44}]},"36":{"id":36,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Sure. We will be in the other carriages. See you in Lachaven.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":43}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“Thanks to this railway, thousands of new jobs have been and will continue to be created.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":73},{"convId":168,"nodeId":46},{"convId":168,"nodeId":68}]},"38":{"id":38,"speaker":"Narrator","isPlayerChoice":false,"text":"Gus sauntered over to the podium and leaned into the microphone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":20}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"The locomotive assistant flipped a few switches, and the train began pulling out of the central station. Symon smiled awkwardly at the press photographers as I \"drove\".","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":49}]},"40":{"id":40,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":168,"nodeId":45}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"The locomotive assistant flipped a few switches, and the train began pulling out of the central station. Gus gave a thumbs-up to the press photographers as I \"drove\".","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":49}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks to this railway, travel between Holsord and Lachaven is now twice as fast and endlessly more comfortable.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":73},{"convId":168,"nodeId":46},{"convId":168,"nodeId":68}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"The locomotive assistant flipped a few switches, and the train began pulling out of the central station. I waved at the press photographers as I \"drove\".","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":49}]},"44":{"id":44,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Of course. We'll hold the ceremony and open the upgraded railway to the public immediately after.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":52}]},"45":{"id":45,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":168,"nodeId":16}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"“Ensuring the success of this project wasn't just one of my presidential goals -- it was my personal priority.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":90}]},"47":{"id":47,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Walk to the podium.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":120},{"convId":168,"nodeId":71},{"convId":168,"nodeId":64}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian's voice echoed in the central station. Thousands of Sordland and USP flags began to wave as the loud cheers intensified.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":67}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"The new train was in pristine condition. Its electric engine provided the smoothest ride I'd ever had.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":54}]},"50":{"id":50,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“This railway project is a perfect example of how we can bring prosperity to the under-developed areas between our major cities.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":89}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“See you at the ceremony.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":65}]},"52":{"id":52,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“The people will be satisfied with their improved transportation service anyway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":53}]},"53":{"id":53,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Additionally, a large crowd has been invited to the ceremony and will be watching the opening speech.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":69},{"convId":168,"nodeId":63},{"convId":168,"nodeId":74},{"convId":168,"nodeId":113}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"After an uneventful four hours on board, we were welcomed by a throng of citizens at Lachaven station.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":6}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took my place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":118}]},"56":{"id":56,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Once we cut that ribbon and the citizens of Holsord get on the train, I believe you'll agree we have succeeded.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":88}]},"57":{"id":57,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Signal for Lucian to begin the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":59}]},"58":{"id":58,"speaker":"Narrator","isPlayerChoice":false,"text":"The next morning, a stage had been erected inside the central station.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":91}]},"59":{"id":59,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Brothers and sisters of Sordland!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":93}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“Goodbye for now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":65}]},"61":{"id":61,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Thanks, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":94}]},"62":{"id":62,"speaker":"Narrator","isPlayerChoice":false,"text":"We took our places onstage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":57}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“It will be a good opportunity for exposure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":82}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“People of Sordland! Welcome to the opening ceremony of the L-1 High-speed railway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":70}]},"65":{"id":65,"speaker":"Narrator","isPlayerChoice":false,"text":"We all dispersed in order to prepare for the big day.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":58}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“We built this railway to create economic growth throughout the Greater Holsord and Gelsland regions.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":42},{"convId":168,"nodeId":37}]},"67":{"id":67,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Without further ado, I invite the President of Sordland to the stage.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":47}]},"68":{"id":68,"speaker":"Player","isPlayerChoice":true,"text":"“I want to acknowledge the brilliant mind behind this project, the esteemed Minister of Economy and Tax, Symon Holl. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":27}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing like a cheerful crowd. Looking forward to it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":83}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting and excitement from the crowd intensified. A large group began singing the national anthem.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":77},{"convId":168,"nodeId":79}]},"71":{"id":71,"speaker":"Player","isPlayerChoice":true,"text":"“Citizens! Welcome to the opening ceremony of the L-1 High-speed railway!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":70}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"“Holsordians! Welcome to the opening ceremony of the L-1 High-speed railway.”","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Holsord_Middle\"]) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Holsord_Middle","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":70}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"“None of this would be possible without the sound advice of my cabinet member Gus Manger. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":38}]},"74":{"id":74,"speaker":"Player","isPlayerChoice":true,"text":"“Like the good old campaign days.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":80}]},"75":{"id":75,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“We will show our best face tomorrow. Meanwhile, I'll make sure that our message about improving the countryside gets across.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":23}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting from the crowd continued. Some were yelling the motto of Holsord: High above all.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":77},{"convId":168,"nodeId":79}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"“At the beginning of this journey, we promised jobs and opportunity. We kept our promise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":66},{"convId":168,"nodeId":78}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"“Our intention with the L-1 Railway was to allow citizens to easily commute between the major cities of Holsord and Lachaven.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":42},{"convId":168,"nodeId":37}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"“Trust me, our work is far from over. This project is only the beginning.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":66},{"convId":168,"nodeId":78}]},"80":{"id":80,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Things were certainly easier back then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":87}]},"81":{"id":81,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“We had our disagreements, but the important thing was the outcome. The Sordish people have been waiting a long time for this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":75}]},"82":{"id":82,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Agreed. Every single press outlet has of course been notified and they will be there.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":87}]},"83":{"id":83,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think all of us are.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":87}]},"84":{"id":84,"speaker":"Player","isPlayerChoice":true,"text":"“Symon, you deserve the credit. After all, it was you who came up with the project.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":81}]},"85":{"id":85,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for your kind words. It truly means a good deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":81}]},"86":{"id":86,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Beginning with the President who put his trust in me, I want to thank all who were involved in L-1.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":84},{"convId":168,"nodeId":85},{"convId":168,"nodeId":114}]},"87":{"id":87,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“On another note. It goes without mentioning that this was a team effort.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":86}]},"88":{"id":88,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon went on to explain how this railway was a crucial stepping stone on the way to a full Sordish economic recovery.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":117}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"Gus continued to explain the many benefits the upgraded railway would bring to the areas along its path.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":116}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd began cheering my name.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":55}]},"91":{"id":91,"speaker":"Narrator","isPlayerChoice":false,"text":"It was a sunny day in our usually cloudy capital city.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":92}]},"92":{"id":92,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd looked quite large. I spotted many party members.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":62}]},"93":{"id":93,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I welcome you Holsordians today as a proud servant of this country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":48}]},"94":{"id":94,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Our aim with this project wasobvious: to improve the speed and efficiency of transportation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":56}]},"95":{"id":95,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Holsord! It is great to be here in this beautiful capital that does so much good for this country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":50}]},"96":{"id":96,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon handed me an oversized pair of scissors.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":171}]},"97":{"id":97,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The journey to Lachaven should take about four hours. The rest of us will be on the train as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":22}]},"98":{"id":98,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"}],"outgoingIds":[{"convId":168,"nodeId":155}]},"99":{"id":99,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Economy","op":"=","value":"Variable[\"BaseGame.Economy\"] + 1"}],"outgoingIds":[{"convId":168,"nodeId":5}]},"100":{"id":100,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"}],"outgoingIds":[{"convId":168,"nodeId":98}]},"101":{"id":101,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I have a plan on how to do that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":102}]},"102":{"id":102,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“If the President accepts, driving the first high-speed train to Lachaven would be great for our image nationwide.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":111}]},"103":{"id":103,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian stood up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":125}]},"104":{"id":104,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Well done, everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":106},{"convId":168,"nodeId":107},{"convId":168,"nodeId":108}]},"105":{"id":105,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“To many more projects like this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":104}]},"106":{"id":106,"speaker":"Player","isPlayerChoice":true,"text":"“Good work.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":109}]},"107":{"id":107,"speaker":"Player","isPlayerChoice":true,"text":"“We couldn't have done this without our excellent team.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":109}]},"108":{"id":108,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Nod.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":110}]},"109":{"id":109,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Indeed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":110}]},"110":{"id":110,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Let's move on to our plans for the opening tomorrow.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":24}]},"111":{"id":111,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“What are your thoughts?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":19}]},"112":{"id":112,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think so too. Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":34},{"convId":168,"nodeId":35}]},"113":{"id":113,"speaker":"Player","isPlayerChoice":true,"text":"“I guess we can't avoid that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":87}]},"114":{"id":114,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":81}]},"115":{"id":115,"speaker":"Player","isPlayerChoice":true,"text":"“Once again, good work everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":65}]},"116":{"id":116,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took Gus' place after he was done with his speech.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":118}]},"117":{"id":117,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took Symon's place after he was done with his speech.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":118}]},"118":{"id":118,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Citizens of Holsord! There you have it!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":119}]},"119":{"id":119,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“As promised, Anton Rayne, the 4th President of Sordland, has delivered!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":10}]},"120":{"id":120,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":121},{"convId":168,"nodeId":122}]},"121":{"id":121,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Birthplace_Holsord_Middle\"]","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Holsord_Middle","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":123}]},"122":{"id":122,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Holsord_Middle\"]) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Holsord_Middle","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":72}]},"123":{"id":123,"speaker":"Player","isPlayerChoice":true,"text":"“My fellow Holsordians! I welcome you today to our opening ceremony of the L-1 High-speed railway.”","conditionsRaw":"Variable[\"BaseGame.Prologue_Birthplace_Holsord_Middle\"]","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Holsord_Middle","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":76}]},"124":{"id":124,"speaker":"Narrator","isPlayerChoice":false,"text":"Though the construction delay had taken its toll on our morale, this was still a proud moment for all of us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":158}]},"125":{"id":125,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“First of all...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":126}]},"126":{"id":126,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“This day might have arrived later than expected, but it doesn't change the fact that we are here now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":127}]},"127":{"id":127,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“This is still a big success. Congratulations, everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":168,"nodeId":105}]},"128":{"id":128,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn08_LateRailwayOpening","op":"=","value":"true"},{"var":"BaseGame.Policy_Economy_RailwayProject","op":"=","value":"true"}],"outgoingIds":[{"convId":168,"nodeId":4}]},"129":{"id":129,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"}],"outgoingIds":[{"convId":168,"nodeId":146}]},"130":{"id":130,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified