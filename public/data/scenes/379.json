{"conversationId":379,"title":"Rizia/Turn 7/Morella Discussion Unfriendly","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":10}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":377,"nodeId":536}]},"3":{"id":3,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Peace between Morella, Rizia and Derdia could be lucrative for all of us. Don't you realize that?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":7}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Don't you realize Morella is on the verge of joining the CSP? Your insurgents will be blown to smithereens.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":8}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It's not about 'help'. It's about Derdians breaking the law.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":6}]},"6":{"id":6,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"As St. Wruhec has said, 'Laws devoid of justice are but chains upon the righteous. To break such chains is man's highest duty.'\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":23}]},"7":{"id":7,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You think a man of God can be bought so easily?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":23}]},"8":{"id":8,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Are you aware of my country's weapons capabilities? We are more than prepared to fight for our right to holy pilgrimage.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":23}]},"9":{"id":9,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"After your lip service to Derdia at the Alliance of Nations, you are siding with Morella after all. I shouldn't be surprised.\"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":14}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":11},{"convId":379,"nodeId":12}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":9}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":13}]},"13":{"id":13,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"So you are here to do a woman's bidding. I shouldn't be surprised.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Derdia_ANSpeech_MakeHappy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":14}]},"14":{"id":14,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Why should I help either of you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":3},{"convId":379,"nodeId":4},{"convId":379,"nodeId":5},{"convId":379,"nodeId":16}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You are a man of God. Must your goodwill be earned, or can it not be freely given?\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":19}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":17},{"convId":379,"nodeId":18}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":20}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":15}]},"19":{"id":19,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"As St. Wruhec has said, 'Generosity is the heart's river, but let its waters flow with discernment'.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":24}]},"20":{"id":20,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Remember the words of St. Wruhec. 'The light of compassion can illuminate even those who walk in the darkest of shadows.'\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":21}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":379,"nodeId":22}]},"22":{"id":22,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Yes, that is so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":379,"nodeId":24}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"He sat back on his cushion, looking defiant.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":67}]},"24":{"id":24,"speaker":"Narrator","isPlayerChoice":false,"text":"He sat back on his cushion for a moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":67}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":26},{"convId":379,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":32}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"28":{"id":28,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You approached me, not the other way around. And this as far as I will go.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":39}]},"29":{"id":29,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"And only if she is willing to compromise and allow Derdians into Morella's Archsanctuaries. Unlike you.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Law_GolcondistBlasphemy\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Law_GolcondistBlasphemy","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":25},{"convId":379,"nodeId":33},{"convId":379,"nodeId":64},{"convId":379,"nodeId":37}]},"30":{"id":30,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Tell Ms. Saltana I will talk to her. But only if the King of Rizia is present to act as an intermediary.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":85}]},"31":{"id":31,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"With the Lord on our side, we will convince her to aid your people in their holy travels.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":36}]},"32":{"id":32,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"My country's fighting a war, Supreme Wiseman. I don't have time to mediate my neighbors' squabbles.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":28}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":34},{"convId":379,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":31}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"36":{"id":36,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Halaita. If it is said, so it will be.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":39}]},"37":{"id":37,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I have spoken to her. I highly doubt she will compromise on that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":44}]},"38":{"id":38,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"There is no 'halfway' when it comes to the holy duties of a Golcondist.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":39}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Turn07_Diplomacy_Derdia_EnableSaltanaMeeting","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_MorellaDispute","op":"=","value":"true"}],"outgoingIds":[{"convId":379,"nodeId":2}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"He smirked slightly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":41}]},"41":{"id":41,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"In that case...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":30}]},"42":{"id":42,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Or is it your Morellan friends you are worried about?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":53},{"convId":379,"nodeId":81}]},"43":{"id":43,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We are not allies, Your Majesty. This is purely a matter of convenience.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":81}]},"44":{"id":44,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I will give her one chance. If she refuses it, the Derdians' holy struggle will continue.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":39}]},"45":{"id":45,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Or a way to make sure you still have resources for years to come.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":52}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"'For lo, true virtue lies in balancing the celestial with the hearth.'\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"},{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"}],"outgoingIds":[{"convId":379,"nodeId":50}]},"47":{"id":47,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Don't make me regret this, Mr. Azmal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"},{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"}],"outgoingIds":[{"convId":379,"nodeId":49}]},"48":{"id":48,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Promises are easier to make than fulfill.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":80}]},"49":{"id":49,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I assure you I will not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":80}]},"50":{"id":50,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"And we in Derdia have plenty of hearths to keep alit.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":80}]},"51":{"id":51,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"His pen was but a conduit for the Divine.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":80}]},"52":{"id":52,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"It's an investment, Your Majesty. Into the future of this region.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":53},{"convId":379,"nodeId":81}]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"A pipeline is out of the question. Isn't there anything else you want?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":41}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"A faint smile appeared on Sal's lips.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":57}]},"55":{"id":55,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That was easier than I expected.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"},{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"}],"outgoingIds":[{"convId":379,"nodeId":48}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He wrote a lot, didn't he?\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"},{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"}],"outgoingIds":[{"convId":379,"nodeId":51}]},"57":{"id":57,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"As Wruhec wrote, 'Reach not for the stars above your head...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":58}]},"58":{"id":58,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"...before tending to the soil beneath your feet.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":59}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"2"},{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"},{"var":"RiziaDLC.MorellaConditions_DerdianProblemSolved","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Morella_PilgrimsToLeaveMorellaAlone","op":"=","value":"true"}],"outgoingIds":[{"convId":379,"nodeId":55},{"convId":379,"nodeId":47},{"convId":379,"nodeId":61}]},"60":{"id":60,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"It's a deal, Supreme Wiseman. We will extend the pipeline if you leave Morella alone.\" [-2 Energy For +2 Budget Per Turn, -2 Budget Per Turn For Pipeline]","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] >= 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">=","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":54}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":379,"nodeId":62},{"convId":379,"nodeId":63}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditi