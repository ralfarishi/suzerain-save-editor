vId":374,"nodeId":77}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_MotherEstelaHighlighted","op":"=","value":"true"}],"outgoingIds":[{"convId":374,"nodeId":77}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_VinaHighlighted","op":"=","value":"true"}],"outgoingIds":[{"convId":374,"nodeId":77}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_RomusAloneHighlighted","op":"=","value":"true"}],"outgoingIds":[{"convId":374,"nodeId":77}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_HugoHiglighted","op":"=","value":"true"}],"outgoingIds":[{"convId":374,"nodeId":77}]},"44":{"id":44,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Glovurius axa Rizia!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":99}]},"45":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"For Honor, For Rizia, For Eternity!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":91}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Anchored in Gold!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":91}]},"47":{"id":47,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"United under the Crown, we stand strong!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":91}]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"For king and country!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":91}]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"United we stand – a family, a kingdom, one force for the future of Rizia!\"","conditionsRaw":"Variable[\"RiziaDLC.Turn06_WarSpeech_EntireFamily\"] == true","variablesRead":[{"var":"RiziaDLC.Turn06_WarSpeech_EntireFamily","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":39}]},"50":{"id":50,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"With the wisdom of the Grand Vizier at my side, we march boldly into our shared destiny!\"","conditionsRaw":"Variable[\"RiziaDLC.Turn06_WarSpeech_Hugo\"] == true  or  Variable[\"RiziaDLC.Turn06_WarSpeech_EntireFamily\"] == true","variablesRead":[{"var":"RiziaDLC.Turn06_WarSpeech_Hugo","op":"==","value":"true"},{"var":"RiziaDLC.Turn06_WarSpeech_EntireFamily","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":43}]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Beside me stands our future, Princess Vina – a beacon of strength and hope for Rizia.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn06_WarSpeech_Vina\"] == true  or  Variable[\"RiziaDLC.Turn06_WarSpeech_EntireFamily\"] == true","variablesRead":[{"var":"RiziaDLC.Turn06_WarSpeech_Vina","op":"==","value":"true"},{"var":"RiziaDLC.Turn06_WarSpeech_EntireFamily","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":41}]},"52":{"id":52,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"With Queen Mother Estela, our matriarch, at my side, we carry forth the Rizian spirit.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn06_WarSpeech_Estela\"] == true  or  Variable[\"RiziaDLC.Turn06_WarSpeech_EntireFamily\"] == true","variablesRead":[{"var":"RiziaDLC.Turn06_WarSpeech_Estela","op":"==","value":"true"},{"var":"RiziaDLC.Turn06_WarSpeech_EntireFamily","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":40}]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Alone I stand, yet I am united with every Rizian heart – for our kingdom, for our people.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn06_WarSpeech_RomusAlone\"] == true  or  Variable[\"RiziaDLC.Turn06_WarSpeech_EntireFamily\"] == true","variablesRead":[{"var":"RiziaDLC.Turn06_WarSpeech_RomusAlone","op":"==","value":"true"},{"var":"RiziaDLC.Turn06_WarSpeech_EntireFamily","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":42}]},"54":{"id":54,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Raise fist in the air.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_EntireFamilyHighlighted","op":"=","value":"true"},{"var":"RiziaDLC.Tu