{"conversationId":374,"title":"Rizia/Turn 6/Outro","storyPack":"StoryPack_Rizia","turn":6,"turnLabel":"Turn 6","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":29}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":372,"nodeId":415}]},"3":{"id":3,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The time for diplomacy has passed. It is time for we Rizians to assert ourselves in the face of the Palesian aggressor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":35}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"With a heavy heart, I declare that war has descended upon us. And I call for your compassion.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":27}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Guided by divine providence, we enter a war to protect our sacred values and the sanctity of our homeland.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":27}]},"6":{"id":6,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It is with a sense of duty that I announce a state of war, a necessary stance for Rizia's security and future.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":27}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Our independence is non-negotiable. We will not be swayed by international pressures or superpower alliances.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] - 1"},{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":34}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"My people, I have long yearned for the reunification of our lands, a dream that today becomes a solemn vow.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":25}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"In the heart of every Rizian, there lies a deep-seated desire to see our nation whole, undivided by foreign claims or unjust rulings.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":30}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This reunification is not merely a quest for land, but a reclamation of the Rizian history and culture that is deeply intertwined with these territories.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":32}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"As your King, I stand before you, not only as a leader but as a steward of our collective legacy, committed to restoring what is ours.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":25}]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Today, it is the spirit of our ancestors that guides us, their unfulfilled aspirations now our sacred mission.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":25}]},"13":{"id":13,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The journey ahead is fraught with challenges, but our resolve is fortified by the righteousness of our cause.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":25}]},"14":{"id":14,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"As we stand on the precipice of change, I ask you, my people, to hold fast to the belief that our future is one of prosperity and peace. Pales and Rizia will reunite under one banner.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] - 1"},{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":24}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The journey ahead is full of struggle, pain, and death. But we have survived all of our past national struggles, and we will survive this one too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":31}]},"16":{"id":16,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will say to you: The 'Grand Duchy' has no legitimate claim to statehood. It belonged to Rizia once, and it will again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":26}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"As your king, I have to be honest with all of you. Everyone will have to do their part to win this war, and sacrifices will need to be made.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":26}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"In our sacrifices, we find the seeds of our eventual triumph. Our shared hardships make us stronger.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] - 1"},{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":24}]},"19":{"id":19,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let us brace for the trials ahead, knowing that each challenge we overcome is a step closer to our rightful destiny.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] - 1"},{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":24}]},"20":{"id":20,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This century began with trials for our people, yet we've endured. We will survive once again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":28}]},"21":{"id":21,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"As long as they still have my daughter, we will fight them to the very last breath.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Hostage\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Hostage","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":28}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"From the Rezenid Empire through the present day, we are a people that not only survives, but thrives.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":28}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Guided by our faith, we march forward with divine conviction.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":28}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":3},{"convId":374,"nodeId":4},{"convId":374,"nodeId":36},{"convId":374,"nodeId":6}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":10},{"convId":374,"nodeId":15},{"convId":374,"nodeId":16},{"convId":374,"nodeId":17}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":7},{"convId":374,"nodeId":14},{"convId":374,"nodeId":18},{"convId":374,"nodeId":19}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":20},{"convId":374,"nodeId":103},{"convId":374,"nodeId":22},{"convId":374,"nodeId":100},{"convId":374,"nodeId":75}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":61},{"convId":374,"nodeId":58},{"convId":374,"nodeId":70},{"convId":374,"nodeId":67},{"convId":374,"nodeId":64},{"convId":374,"nodeId":73},{"convId":374,"nodeId":74}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":374,"nodeId":8},{"convId":374,"nodeId":9},{"convId":374,"nodeId":11},{"convId":374,"nodeId":12},{"convId":374,"nodeId":13}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] + 1"}],"outgoingIds":[{"convId":374,"nodeId":25}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"Variable[\"RiziaDLC.Turn06_WarSpeech_Impact\"] - 1"}],"outgoingIds":[{"convId":374,"nodeId":26}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn06_WarSpeech_Impact","op":"=","value":"