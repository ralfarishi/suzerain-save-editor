{"conversationId":97,"title":"Sordland/Turn07/Kesaro&FrensDialogue","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":4}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":7}]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"\"We're doing good, Frens. Enjoying the victory at the Assembly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":16}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian suddenly turned around and pointed at the side entrance to the balcony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":5}]},"5":{"id":5,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Look who's coming.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":6}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":7},{"convId":97,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_NFP_Convinced\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_NFP_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":9}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_NFP_Convinced\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_NFP_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":10}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"It was Kesaro Kibener. He slowly walked up to us with a smile on his face and spread his arms wide as he approached us.","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_NFP_Convinced\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_NFP_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":11}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"It was Frens Ricter. He slowly walked up to us with a smile on his face.","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_NFP_Convinced\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_NFP_Convinced","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":12}]},"11":{"id":11,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Here you are!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":24}]},"12":{"id":12,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Afternoon, gentlemen. How are you all doing?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":13}]},"13":{"id":13,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Afternoon, Mr. Ricter.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":3},{"convId":97,"nodeId":14},{"convId":97,"nodeId":15}]},"14":{"id":14,"speaker":"Player","isPlayerChoice":true,"text":"\"Busy as always, Mr. Ricter. How about you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":17}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"\"You should've let me know you were coming out. I would've planned a barbecue or something.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":18}]},"16":{"id":16,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Oh yes. I should congratulate you again for passing the proposal. You deserved it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":20}]},"17":{"id":17,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"The same goes for me, Mr. President. These are some busy days indeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":21}]},"18":{"id":18,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Hah. No need for that, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":22}]},"19":{"id":19,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I also hope you will do something about your promise at some point, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":46}]},"20":{"id":20,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We should also thank you for your efforts. You were of tremendous assistance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":23}]},"21":{"id":21,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Especially after that mutual victory. We should thank you for your efforts, Mr. Ricter. You were of tremendous assistance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":23}]},"22":{"id":22,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We should thank you for your efforts. You were of tremendous assistance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":23}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"Frens bowed his head slightly in response.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":45}]},"24":{"id":24,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"The most dangerous men in the Maroon Palace.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":25}]},"25":{"id":25,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Afternoon, Mr. Kibener.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":26},{"convId":97,"nodeId":27},{"convId":97,"nodeId":28}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"\"Damn right, we're dangerous.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":29}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"Welcome, Mr. Kibener. How are you doing?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":31}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"\"You should've let me know you were coming out. I would've planned a barbecue or something.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":34}]},"29":{"id":29,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Lock up your daughters.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":30}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr laughed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":34}]},"31":{"id":31,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"I'm good, Mr President. You must be feeling similarly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":32}]},"32":{"id":32,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Our cooperation yielded spectacular results.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":34}]},"33":{"id":33,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Goddamn. This sun.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":35}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"Kesaro squinted into the bright sunlight.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":33}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"He reached down to his pocket, pulled out a pair of sunglasses and set them on his nose.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":36}]},"36":{"id":36,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Did you three figure out the Court situation?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":37}]},"37":{"id":37,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Most of them have been resisting our efforts. But we're working on it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":38}]},"38":{"id":38,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"It's not looking good?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":41},{"convId":97,"nodeId":40},{"convId":97,"nodeId":39}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"\"Don't worry. We've got this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":65}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"We'll figure it out, Mr. Kibener. I'll be talking to several of the Justices very soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":65}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"\"To be honest, it's not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":65}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":43},{"convId":97,"nodeId":44}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Promise_Seat\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Seat","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":47}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Promise_Seat\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Seat","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":53}]},"45":{"id":45,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I'm looking forward to having many more cooperations between us. And victories.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":42}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian and Petr looked at me. I could feel Lucian's suspicious gaze.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":48},{"convId":97,"nodeId":49},{"convId":97,"nodeId":50}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"He leaned towards me and lowered his voice.","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Promise_Seat\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Seat","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":19}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"\"Of course, Mr. Ricter. Rest assured.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":51}]},"49":{"id":49,"speaker":"Player","isPlayerChoice":true,"text":"\"The time will come.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":51}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"\"We'll see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":52}]},"51":{"id":51,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I'll be waiting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":54}]},"52":{"id":52,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"We most certainly will, Mr. President. But anyway...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":54}]},"53":{"id":53,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I wish you good luck with the Supreme Court.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Promise_Seat\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Seat","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":55}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"He straightened up again.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":53}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":56},{"convId":97,"nodeId":57}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Nia_Opposition\"] == true","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":59}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":165}]},"58":{"id":58,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I have conversed with Mrs. Morgna and Justice Zizek. We have at least three Justices supporting the proposal.\"","conditionsRaw":"((Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) == false) and ((Variable[\"BaseGame.Reform_BludishRights_Amendment_Proposal\"] == true) == false)","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"},{"var":"BaseGame.Reform_BludishRights_Amendment_Proposal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":59}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":60},{"convId":97,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Bribed\"] == true  or  Variable[\"BaseGame.Relations_Frens_Promise_Taurus\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Bribed","op":"==","value":"true"},{"var":"BaseGame.Relations_Frens_Promise_Taurus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Bribed\"] == true  or  Variable[\"BaseGame.Relations_Frens_Promise_Taurus\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Frens_Bribed","op":"==","value":"true"},{"var":"BaseGame.Relations_Frens_Promise_Taurus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":63}]},"62":{"id":62,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I hope everything works out.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) and (Variable[\"BaseGame.Relations_Frens_Bribed\"] == true  or  Variable[\"BaseGame.Relations_Frens_Promise_Taurus\"] == true)","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"},{"var":"BaseGame.Relations_Frens_Bribed","op":"==","value":"true"},{"var":"BaseGame.Relations_Frens_Promise_Taurus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":107}]},"63":{"id":63,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"We must be united if we want to break them.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Nia_Opposition\"] == true) and ((Variable[\"BaseGame.Relations_Frens_Bribed\"] == true  or  Variable[\"BaseGame.Relations_Frens_Promise_Taurus\"] == true) == false)","variablesRead":[{"var":"BaseGame.Relations_Nia_Opposition","op":"==","value":"true"},{"var":"BaseGame.Relations_Frens_Bribed","op":"==","value":"true"},{"var":"BaseGame.Relations_Frens_Promise_Taurus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":64}]},"64":{"id":64,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"We must also be *seen* as united more than ever. Therefore, I'd like to propose a proper alliance for the next elections.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":94}]},"65":{"id":65,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":66}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":67},{"convId":97,"nodeId":68}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":69}]},"68":{"id":68,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":70}]},"69":{"id":69,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"But we're moving forward with our alliance, yes?\"","conditionsRaw":"Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":73},{"convId":97,"nodeId":72},{"convId":97,"nodeId":71}]},"70":{"id":70,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Well I hope you do something about it. It's not like the Justices are big fans of this administration.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":90}]},"71":{"id":71,"speaker":"Player","isPlayerChoice":true,"text":"\"It's not the time for that. We must first pass the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":75}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"\"Of course, Kesaro.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":74}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes, Mr. Kibener. We'll announce our alliance as promised.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":74}]},"74":{"id":74,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"I'm looking forward to it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":75}]},"75":{"id":75,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"I might also be able to help with this whole Court situation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":76}]},"76":{"id":76,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"I know Mr. Garaci well. I know that he said that he's not open to any talks before the vote but... I'm sure I can convince him to meet with you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":79},{"convId":97,"nodeId":78},{"convId":97,"nodeId":77}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't want to do any business with that man.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":80}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"\"That's good news. Can I count on you to bring him to the table?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":84}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"\"That would be very much appreciated, Mr. Kibener.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":84}]},"80":{"id":80,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Really?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":81}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian leaned in towards me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":82}]},"82":{"id":82,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Sir, I advise you to reconsider. We need his help.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":83}]},"83":{"id":83,"speaker":"Narrator","isPlayerChoice":false,"text":"Kesaro awaited my response, his expression unreadable behind his sunglasses.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":87},{"convId":97,"nodeId":86}]},"84":{"id":84,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Of course. I'll do my best.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":85}]},"85":{"id":85,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Reform_Heron_SentKesaro","op":"=","value":"true"}],"outgoingIds":[{"convId":97,"nodeId":164}]},"86":{"id":86,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. Really. We don't need the Old Guard's help. We need them gone.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":88}]},"87":{"id":87,"speaker":"Player","isPlayerChoice":true,"text":"\"So, can I really count on you to bring him to the table?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":84}]},"88":{"id":88,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"How can you get rid of them if you cannot even change the Constitution?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":89}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"He sighed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":91}]},"90":{"id":90,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"Anyway, I'll leave you three to whatever you were conspiring to before I came.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Reform_Reform_Heron_SentKesaro","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_SentKesaroToConvinceHeron","op":"=","value":"true"}],"outgoingIds":[{"convId":97,"nodeId":92}]},"91":{"id":91,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"I guess you have a plan. I'll trust you on this for now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":90}]},"92":{"id":92,"speaker":"Kesaro Kibener","isPlayerChoice":false,"text":"\"The heat here is killing me. We should catch up soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":93}]},"93":{"id":93,"speaker":"Narrator","isPlayerChoice":false,"text":"He walked back to the door and left the balcony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":136}]},"94":{"id":94,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"And more in-depth collaboration throughout the rest of the current term.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":97},{"convId":97,"nodeId":96},{"convId":97,"nodeId":95},{"convId":97,"nodeId":98}]},"95":{"id":95,"speaker":"Player","isPlayerChoice":true,"text":"\"An alliance with the main opposition is too big of a deal. I'm afraid that's not an option.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":103}]},"96":{"id":96,"speaker":"Player","isPlayerChoice":true,"text":"\"I'd love to accept such a proposal, Mr. Ricter.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":99}]},"97":{"id":97,"speaker":"Player","isPlayerChoice":true,"text":"\"That's what I was waiting for. We need a proper alliance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":100}]},"98":{"id":98,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm glad we were able to work together on the new Constitution. But that's the extent of our collaboration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":103}]},"99":{"id":99,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"That's great to hear.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":101}]},"100":{"id":100,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"It would surely put pressure on the Old Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":101}]},"101":{"id":101,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Such a grand coalition has never happened in Sordland before. We should show people that our parties can work together. That civility and cooperation is possible.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":102}]},"102":{"id":102,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"It would surely have a great symbolic meaning. Especially if we can change the Constitution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":105}]},"103":{"id":103,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"As I expected.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":106}]},"104":{"id":104,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I'll reach out to you soon about it. We must start organizing and announce it as soon as possible.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn07_PromisedFrensAlliance","op":"=","value":"true"}],"outgoingIds":[{"convId":97,"nodeId":107}]},"105":{"id":105,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"=","value":"true"}],"outgoingIds":[{"convId":97,"nodeId":163}]},"106":{"id":106,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for the offer nonetheless.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":107}]},"107":{"id":107,"speaker":"Narrator","isPlayerChoice":false,"text":"Frens reached down at his pocket, fumbled with a handkerchief and wiped the sweat of his forehead.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":108}]},"108":{"id":108,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"Anyway, I'll leave you three to it. We should catch up soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":109}]},"109":{"id":109,"speaker":"Frens Ricter","isPlayerChoice":false,"text":"\"I'd rather get back inside now. The sun is getting intense.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":110}]},"110":{"id":110,"speaker":"Narrator","isPlayerChoice":false,"text":"He walked back to the door and left the balcony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":112}]},"111":{"id":111,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Well. That was interesting.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":175}]},"112":{"id":112,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":113},{"convId":97,"nodeId":114}]},"113":{"id":113,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":111}]},"114":{"id":114,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":116}]},"115":{"id":115,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"So we are seriously joining forces with the PFJP, huh?\"","conditionsRaw":"(Variable[\"BaseGame.Amendment_PFJP_GivenLeaderCredit\"] == true) == false","variablesRead":[{"var":"BaseGame.Amendment_PFJP_GivenLeaderCredit","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":122},{"convId":97,"nodeId":121},{"convId":97,"nodeId":120}]},"116":{"id":116,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Look at him go. He's such a clown.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":169}]},"117":{"id":117,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"He seriously wanted an alliance with the USP? That's new.\"","conditionsRaw":"(Variable[\"BaseGame.Amendment_PFJP_GivenLeaderCredit\"] == true) == false","variablesRead":[{"var":"BaseGame.Amendment_PFJP_GivenLeaderCredit","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":118}]},"118":{"id":118,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He wants to take the credit for the new Constitution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":119}]},"119":{"id":119,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"If it passes, that is.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":133},{"convId":97,"nodeId":132},{"convId":97,"nodeId":131}]},"120":{"id":120,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm not sure how deep we'll dive in. For now, we'll cooperate.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":123}]},"121":{"id":121,"speaker":"Player","isPlayerChoice":true,"text":"\"I believe that will only be beneficial for our position.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":124}]},"122":{"id":122,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. Sordland needs to experience some democracy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":125}]},"123":{"id":123,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Gotcha.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":129}]},"124":{"id":124,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Actually, I agree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":126}]},"125":{"id":125,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"A coalition government could make things much more difficult for us though.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":127}]},"126":{"id":126,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But a coalition government could make things much more difficult for us down the road.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":127}]},"127":{"id":127,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Petr is not entirely wrong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":128}]},"128":{"id":128,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Entirely? What is that supposed to mean? There's nothing wro-\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":129}]},"129":{"id":129,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"A coalition government with the PFJP can mean a lot of things. But one thing is for sure: once Mr. Ricter enters our government, it will be hard to get him to leave.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":130}]},"130":{"id":130,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We should be careful, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":2}]},"131":{"id":131,"speaker":"Player","isPlayerChoice":true,"text":"\"I respect the man. But he's overestimating himself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":135}]},"132":{"id":132,"speaker":"Player","isPlayerChoice":true,"text":"\"He'll get the credit in his dreams.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":134}]},"133":{"id":133,"speaker":"Player","isPlayerChoice":true,"text":"\"We don't need him anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":134}]},"134":{"id":134,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Damn right.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":2}]},"135":{"id":135,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He has a tendency to play the 'nice guy'. When not playing the victim.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":2}]},"136":{"id":136,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":137},{"convId":97,"nodeId":138}]},"137":{"id":137,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":142}]},"138":{"id":138,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":139}]},"139":{"id":139,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Look at him go. That man.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":140}]},"140":{"id":140,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I don't trust him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":141}]},"141":{"id":141,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He wants to take the credit for the new Constitution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":146}]},"142":{"id":142,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Well. That was interesting.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Kesaro_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Kesaro_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":143}]},"143":{"id":143,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"So we are seriously joining forces with the NFP, huh?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":154},{"convId":97,"nodeId":149},{"convId":97,"nodeId":148}]},"144":{"id":144,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Damn right.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":2}]},"145":{"id":145,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Entirely? What is that supposed to mean? There's nothing wro-\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":161}]},"146":{"id":146,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"If it passes, that is.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":147},{"convId":97,"nodeId":155},{"convId":97,"nodeId":156},{"convId":97,"nodeId":159}]},"147":{"id":147,"speaker":"Player","isPlayerChoice":true,"text":"\"We don't need him anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":144}]},"148":{"id":148,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm not sure how deep we'll dive in. For now, we'll cooperate.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":151}]},"149":{"id":149,"speaker":"Player","isPlayerChoice":true,"text":"\"I believe it will only be beneficial for us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":153}]},"150":{"id":150,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"He's just playing the hero, sir. The honorable Sord against all odds.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":2}]},"151":{"id":151,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Gotcha.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":161}]},"152":{"id":152,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"But a coalition government could also make things much more difficult for us down the road.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":158}]},"153":{"id":153,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Actually, I kind of agree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":152}]},"154":{"id":154,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. Sordland needs to see different parties working together for once.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":157}]},"155":{"id":155,"speaker":"Player","isPlayerChoice":true,"text":"\"He'll get the credit in his dreams.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":144}]},"156":{"id":156,"speaker":"Player","isPlayerChoice":true,"text":"\"I respect the man. But he's overestimating himself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":150}]},"157":{"id":157,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"A coalition government could make things much more difficult for us though.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":97,"nodeId":158}]},"158":{"id":158,"speaker":"Lucian Galade","isPlayerChoice":false,"tex