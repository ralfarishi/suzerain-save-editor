oice":false,"text":"\"Great. My mouth's already watering.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":23}]},"21":{"id":21,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Y-yeah, of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":22}]},"22":{"id":22,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"All right, gentlemen. See you later.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":24}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"He laughed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":22}]},"24":{"id":24,"speaker":"Narrator","isPlayerChoice":false,"text":"They both left.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":49}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"\"Perfect timing. Tell him I'll be right there.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":28}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"\"Tell him I'm busy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":28}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"You know the details. Handle him yourself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":28}]},"28":{"id":28,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"I will, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":29}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"She turned to leave the balcony, then back to us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":94,"nodeId":3