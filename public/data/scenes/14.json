{"conversationId":14,"title":"Sordland/Turn02/A_ReformBriefing","storyPack":"StoryPack_Main","turn":2,"turnLabel":"Turn 2","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":1}]},"1":{"id":1,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":10}]},"2":{"id":2,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn02_A_ReformBriefing","op":"=","value":"true"}],"outgoingIds":[{"convId":14,"nodeId":134}]},"4":{"id":4,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":5},{"convId":14,"nodeId":6}]},"5":{"id":5,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Dictator_Intention\"] == true  or  Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true","variablesRead":[{"var":"BaseGame.Reform_Dictator_Intention","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":7}]},"6":{"id":6,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Dictator_Intention\"] == true  or  Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Dictator_Intention","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":37}]},"7":{"id":7,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Mr. President, I've heard from Mr. Galade that you're not intending to support the democratic reforms.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Dictator_Intention\"] == true  or  Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true","variablesRead":[{"var":"BaseGame.Reform_Dictator_Intention","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":35}]},"8":{"id":8,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"There is a lot to talk about the future of this process. Let us begin to tackle the points of contention.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":4}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"The reforms were slowly becoming the most significant expectation of my government. We would be changing Soll's Constitution of '29.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":11}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"I came a little early to the meeting room before anybody showed up. We had scheduled a meeting to discuss the progress of the reform committee regarding the new Constitution.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":110}]},"11":{"id":11,"speaker":"Narrator","isPlayerChoice":false,"text":"Most people nowadays blamed the constitution for the outstanding problems of the country.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":12}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"On the other hand, the reformists in the Assembly had been getting louder about their demands. What I knew for sure was that I needed to do something about this encroaching chaos before it swallowed me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":13}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"Meanwhile, Lucian, Petr and Nia had been leading the committee to prepare an initial draft for the constitutional amendments. I was intrigued to hear their results.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":14}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"There was a knock on the door. It was Lucian.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":15}]},"15":{"id":15,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Good afternoon, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":16}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian arrived exactly on the hour mark again. His punctuality could almost be described as obsessive.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":18},{"convId":14,"nodeId":17}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":false,"text":"\"Are you waiting behind the door to come at the exact right second?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":19}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"\"Good afternoon, Lucian.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":25}]},"19":{"id":19,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm sorry, sir?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":20},{"convId":14,"nodeId":21}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"\"Forget it. How are you, today?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":23}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"\"You seem to be arriving at the exact second all our meetings start.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":22}]},"22":{"id":22,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Punctuality is important for me, sir. I'm just doing my job.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":25}]},"23":{"id":23,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm good, Mr. President. Thanks for asking.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":25}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We should begin the meeting as soon as Mrs. Morgna and Vice President Vectern arrive. We finally have some results from the reform committee.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":26},{"convId":14,"nodeId":27},{"convId":14,"nodeId":28}]},"25":{"id":25,"speaker":"Narrator","isPlayerChoice":false,"text":"He took a seat on the table and took out a bunch of documents, spreading them on the long table.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":24}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"\"How does it look?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":29}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"What results?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":30}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"\"Good.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":33}]},"29":{"id":29,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Well, the situation is quite complicated. But I'm sure we will make it work, just like we accomplished many things before.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":32}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The reform committee already drafted the amendments for the new Constitution thanks to the help of the members.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":31}]},"31":{"id":31,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But the situation is still quite complicated politically. We'll go over the details in the meeting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":33}]},"32":{"id":32,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We'll go over the details regarding the new constitution in the meeting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":33}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"A few minutes later, Petr and Nia also arrived.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":34}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"After a short chat, everybody sat down and took out their notes. I knew it was going to be a long meeting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":8}]},"35":{"id":35,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Our committee meetings have been really fruitful, and we already started on the constitutional draft together with the feedback from all the political parties.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":36}]},"36":{"id":36,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We are making clear progress here. You wouldn't really block our hard work, would you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":40},{"convId":14,"nodeId":39},{"convId":14,"nodeId":44},{"convId":14,"nodeId":41}]},"37":{"id":37,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Mr. President, our committee meetings were really fruitful, and we already started working on the constitutional draft together with the reformists.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Dictator_Intention\"] == true  or  Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Dictator_Intention","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":38}]},"38":{"id":38,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"They demanded a little too much, but we've had success with Frens Ricter to create a realistic draft that could potentially go through the Supreme Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":42}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"\"What's that supposed to mean?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":60}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"I've already explained my intentions.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":60}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"\"A final decision hasn't been made yet.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":60}]},"42":{"id":42,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"A *little*? They demanded to rewrite the whole Constitution!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":146}]},"43":{"id":43,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I also didn't like their theatrics but the requests were definitely not outrageous. They were just not realistic in today's political circumstances.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":147}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"\"I would.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":60}]},"45":{"id":45,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"This is our once in a lifetime chance to change the Constitution of Tarquin Soll, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":46}]},"46":{"id":46,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":47},{"convId":14,"nodeId":48}]},"47":{"id":47,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Speech_Democracy_Liberal\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Speech_Democracy_Liberal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":49}]},"48":{"id":48,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Speech_Democracy_Liberal\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Speech_Democracy_Liberal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":50}]},"49":{"id":49,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You campaigned to bring real democracy to Sordland.\"","conditionsRaw":"Variable[\"BaseGame.Prologue_Speech_Democracy_Liberal\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Speech_Democracy_Liberal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":51}]},"50":{"id":50,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We worked hard to create a draft together with the leaders of our party and the opposition. Nothing else is more important for Sordland.\"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Speech_Democracy_Liberal\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Speech_Democracy_Liberal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":53},{"convId":14,"nodeId":52},{"convId":14,"nodeId":54}]},"51":{"id":51,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"With all due respect, you should hold that promise you made to the Sordish people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":53},{"convId":14,"nodeId":52},{"convId":14,"nodeId":54}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"\"With all due respect, I'll be the judge of that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":59}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks for the advice, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":59}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"\"I'll see what we can do.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":59}]},"55":{"id":55,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"If I may continue, Mr. President. We've discussed the possibilities of your intentions with Mr. Galade.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":56}]},"56":{"id":56,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":57},{"convId":14,"nodeId":58}]},"57":{"id":57,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":1}]},"58":{"id":58,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_Intention\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":15,"nodeId":1}]},"59":{"id":59,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr cut in before Nia could speak.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":55}]},"60":{"id":60,"speaker":"Narrator","isPlayerChoice":false,"text":"She leaned slightly towards me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":45}]},"61":{"id":61,"speaker":"Narrator","isPlayerChoice":false,"text":"I took a seat on the centre chair in the vacant meeting room as I waited for them to show up.","conditionsRaw":"(Variable[\"BaseGame.Turn01_InT_Investment_Highway\"] == true) and ((Variable[\"BaseGame.Turn01_InT_Investment_Highway\"] == true) == false) and (Variable[\"BaseGame.Turn01_InT_Investment_Railway\"] == true) and ((Variable[\"BaseGame.Turn01_InT_Investment_Railway\"] == true) == false) and (Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) == false) and (Variable[\"BaseGame.Turn02_InT_Corporation_UnderhallConstruction\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_UnderhallConstruction\"] == true) == false)","variablesRead":[{"var":"BaseGame.Turn01_InT_Investment_Highway","op":"==","value":"true"},{"var":"BaseGame.Turn01_InT_Investment_Railway","op":"==","value":"true"},{"var":"BaseGame.Turn02_InT_Corporation_SordishState","op":"==","value":"true"},{"var":"BaseGame.Turn02_InT_Corporation_UnderhallConstruction","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameSupport.Report_Turn02_Lachaven_H3_SSC","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn02_Lachaven_H3_Underhall","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn02_Lachaven_H3_Taurus","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn02_Holsord_L1_SSC","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn02_Holsord_L1_Underhall","op":"=","value":"true"},{"var":"BaseGameSupport.Report_Turn02_Holsord_L1_Taurus","op":"=","value":"true"}],"outgoingIds":[{"convId":14,"nodeId":9}]},"62":{"id":62,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think this was yet another fruitful meeting, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":76},{"convId":14,"nodeId":77},{"convId":14,"nodeId":78},{"convId":14,"nodeId":79}]},"63":{"id":63,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But now we have a better picture of your intentions, sir. I will start reaching out to my contacts to make a draft that works for you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":64}]},"64":{"id":64,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'll present your input to the USP leaders and the National Front. In a few months, you would have the draft on your desk to make the final changes yourself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":65}]},"65":{"id":65,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think this was yet another fruitful meeting, sir. I trust your judgement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":66},{"convId":14,"nodeId":67},{"convId":14,"nodeId":68},{"convId":14,"nodeId":69}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"\"Your service is appreciated.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":72}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"\"If we do this, I promise, you will be kings.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":72}]},"68":{"id":68,"speaker":"Player","isPlayerChoice":true,"text":"\"Together we will make Sordland great.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":71}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks for the meeting, gentlemen.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":70}]},"70":{"id":70,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for your time, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":75}]},"71":{"id":71,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Yes we will!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":74}]},"72":{"id":72,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for the kind words, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":73}]},"73":{"id":73,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"You can count on us, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":93}]},"74":{"id":74,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm sure you will lead us to greatness, sir. Thanks for your time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":93}]},"75":{"id":75,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Thank you, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":93}]},"76":{"id":76,"speaker":"Player","isPlayerChoice":true,"text":"\"Your service is appreciated.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":80}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"\"If we do this, we will be remembered as heroes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":85}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"\"Together we will democratize Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":84}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"\"Thanks for the meeting, everybody.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":82}]},"80":{"id":80,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for the kind words, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":83}]},"81":{"id":81,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Thank you, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":87}]},"82":{"id":82,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for your time, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":81}]},"83":{"id":83,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"You can count on us, Anton.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":90}]},"84":{"id":84,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"And you have my full support, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":89}]},"85":{"id":85,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Yes! The Heroes of Sordland!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":86}]},"86":{"id":86,"speaker":"Narrator","isPlayerChoice":false,"text":"He laughed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":91}]},"87":{"id":87,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You have my support, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":91}]},"88":{"id":88,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Yes, sir. Thank you for your time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":91}]},"89":{"id":89,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Ours too, of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":88}]},"90":{"id":90,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Yes, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":91}]},"91":{"id":91,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think this is where we'll call it, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":92}]},"92":{"id":92,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Have a good day.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":96}]},"93":{"id":93,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think this is where we'll call it, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":94}]},"94":{"id":94,"speaker":"Lucian Galade","is