{"conversationId":169,"title":"Sordland/Turn08/InT_LateHighwayOpening","storyPack":"StoryPack_Main","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":1}]},"1":{"id":1,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":128}]},"2":{"id":2,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian and I, together with project leads Symon and Lileas, met to discuss how to proceed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":94}]},"4":{"id":4,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Image is everything, Symon. I agree this would bolster the President's reputation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":108}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"The day before the grand opening ceremony of the H-3 Highway, we arrived in Lachaven to begin preparations.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"},{"var":"BaseGame.Turn04_InT_HighwayIssue_Solved","op":"=","value":"true"}],"outgoingIds":[{"convId":169,"nodeId":125}]},"6":{"id":6,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I don't support anything beyond the opening ceremony. The highway speaks for itself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":4}]},"7":{"id":7,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn08_InT_LateOpening","op":"=","value":"true"}],"outgoingIds":[{"convId":169,"nodeId":181}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"It was a great victory for my administration.","conditionsRaw":"(Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) == false) and (Variable[\"BaseGame.Turn02_InT_Corporation_TaurusHolding\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_TaurusHolding\"] == true) == false) and (Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) and ((Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false) and (Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  or  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) and ((Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  or  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) == false) and (Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  and  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) and ((Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true  and  Variable[\"BaseGame.Agnolia_TradeDeal\"] == true) == false) and (Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) and ((Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) == false)","variablesRead":[{"var":"BaseGame.Turn02_InT_Corporation_SordishState","op":"==","value":"true"},{"var":"BaseGame.Turn02_InT_Corporation_TaurusHolding","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"},{"var":"BaseGame.Agnolia_TradeDeal","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"},{"var":"BaseGame.Economy","op":"=","value":"Variable[\"BaseGame.Economy\"] + 1"},{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"},{"var":"BaseGameSupport.News_Turn08_E_H3_SSC_Show","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_H3_SSC_Show","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_H3_Taurus_NoShow","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_E_H3_Taurus_NoShow","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_E_H3_Taurus_Show","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_H3_Taurus_Show","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_H3_SSC_NoShow","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_E_H3_SSC_NoShow","op":"=","value":"true"}],"outgoingIds":[{"convId":169,"nodeId":127}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"“I'd prefer we just do the opening ceremony. No need for senseless spectacle.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":14}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“I agree. I'll hit the road.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":22}]},"11":{"id":11,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“The people will be satisfied. More importantly, so will businesses.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":15}]},"12":{"id":12,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Sounds good. It would display unity and strength if we were all together in the convoy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":15}]},"13":{"id":13,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":169,"nodeId":12}]},"14":{"id":14,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Of course. We'll hold the ceremony and open the highway to the public immediately after.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":11}]},"15":{"id":15,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Additionally, a large crowd has been invited to the ceremony and will be watching the opening speech.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":18},{"convId":169,"nodeId":16},{"convId":169,"nodeId":17},{"convId":169,"nodeId":109}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"“It will be a good opportunity for exposure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":75}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“Like the good old campaign days.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":76}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing like a cheerful crowd. Looking forward to it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":74}]},"19":{"id":19,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Alright then. We have a lot of work to do. See you in the morning.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":112},{"convId":169,"nodeId":113},{"convId":169,"nodeId":114}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"We dispersed to begin our individual preparations for the big day.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":23}]},"21":{"id":21,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Signal for Lucian to begin the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":24}]},"22":{"id":22,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":169,"nodeId":13}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"The next morning, a stage had been erected next to the entrance of the highway in downtown Lachaven.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":84}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Brothers and sisters of Sordland!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":86}]},"25":{"id":25,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Thank you, Mr. President. Lachaven! It is great to be here today among you industrious people.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":87}]},"26":{"id":26,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Thanks, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":88}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"We took our places onstage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":21}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“People of Sordland! Welcome to the opening ceremony of the H-3 Highway!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":35}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian's voice echoed in the square next to the highway. Hundreds of Sordland and USP flags began to wave as the cheers intensified.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":30}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Without further ado, I invite the President of Sordland to the stage.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":33}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“Citizens! Welcome to the opening ceremony of the H-3 Highway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":35}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“Lachaveners! Welcome to the opening ceremony of the H-3 Highway!”","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Lachaven_Rich","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":34}]},"33":{"id":33,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Walk up to the podium.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":121},{"convId":169,"nodeId":31},{"convId":169,"nodeId":28}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting from the crowd intensified. Some were yelling the motto of Lachaven: Liberty until eternity.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":36},{"convId":169,"nodeId":37}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting from the crowd continued.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":36},{"convId":169,"nodeId":37}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"“At the beginning of this journey, we promised jobs and opportunity. We kept our promise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":38},{"convId":169,"nodeId":39}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“Trust me, our work is far from over. This project is only the beginning.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":38},{"convId":169,"nodeId":39}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“The aim with the H-3 was to create economic growth in East Nargis and Agnland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":57},{"convId":169,"nodeId":56}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"“Our intention with the H-3 was to ensure citizens an easier commute between Lachaven and Arvory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":57},{"convId":169,"nodeId":56}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"As soon as we left, the highway opened to the public and thousands began using it.","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":174}]},"41":{"id":41,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":42},{"convId":169,"nodeId":43}]},"42":{"id":42,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":54}]},"43":{"id":43,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":40}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“None of this would be possible without the sound advice of my Interior Minister Lileas Graf. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":49}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"“I must thank the brilliant mind behind the highway project, the esteemed Minister of Economy and Tax, Symon Holl. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":50}]},"46":{"id":46,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“After we cut that ribbon and you drive on the highway, you can judge our success for yourself.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":82}]},"47":{"id":47,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“United we stand and divided we fall.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":81}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"“Ensuring the success of this project wasn't just one of my presidential goals. I made it my personal priority.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":83}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"Lileas walked up to me and leaned into the microphone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":25}]},"50":{"id":50,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon walked up to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":26}]},"51":{"id":51,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Cut the ribbon.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":52}]},"52":{"id":52,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Congratulations to all. Hopefully this is one of many successes to come.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":53}]},"53":{"id":53,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“It's a good moment indeed. It gives us pride as a nation. One big step forward.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":41}]},"54":{"id":54,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Your car is ready.”","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":90}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"A 40-meter-long red ribbon stretched across it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":89}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"“This highway has brought and will continue to bring thousands of new jobs.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":44},{"convId":169,"nodeId":48},{"convId":169,"nodeId":45}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"“Thanks to this highway, travel between Lachaven and Arvory is twice as fast and infinitely more comfortable.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":44},{"convId":169,"nodeId":48},{"convId":169,"nodeId":45}]},"58":{"id":58,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Enter the car.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":63}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“I'd like Lileas with me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":61}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“I will drive the car on my own.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":66}]},"61":{"id":61,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I'm honored. It will be lovely to arrive in Arvory with the President of Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":69}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“I want to have Symon in the lead car.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":65}]},"63":{"id":63,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Who do you want to travel with, Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":64},{"convId":169,"nodeId":62},{"convId":169,"nodeId":59},{"convId":169,"nodeId":60}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian, come ride with me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":145}]},"65":{"id":65,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This isn't necessary, but I won't refuse. We can talk about future economic projects.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":68}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“As you wish. I'll see you in Arvory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":70}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"I revved the engine. Lucian waved at the press photographers as I drove us onto the new highway.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":71}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"I revved the engine. Symon smiled awkwardly at the press photographers as I drove us onto the new highway.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":71}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"I revved the engine. Lileas waved to the press photographers as I drove us onto the new highway.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":71}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"I revved the engine and waved to the press photographers as I drove onto the new highway.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":71}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"The new highway was in pristine condition. The ride to Arvory was the smoothest I'd ever had.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":72}]},"72":{"id":72,"speaker":"Narrator","isPlayerChoice":false,"text":"After an uneventful four hours, we were welcomed by a throng of Arvory citizens and Mayor Eric Niel.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":40}]},"73":{"id":73,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“On another note. It goes without mentioning that this was a team effort.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":77}]},"74":{"id":74,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think all of us are.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":73}]},"75":{"id":75,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Agreed. Every single press outlet has of course been notified and they will be there.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":73}]},"76":{"id":76,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Things were certainly easier back then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":73}]},"77":{"id":77,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Beginning with the President who put his trust in me, I want to thank everyone involved in the H-3.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":78},{"convId":169,"nodeId":79},{"convId":169,"nodeId":110}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"“Symon, you deserve the credit. After all, it was you who came up with the project.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":80}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for your kind words. It truly means a good deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":80}]},"80":{"id":80,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“The people have been waiting a long time for this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":111}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"Lileas continued to speak about the strength that comes from unity and the positive change the highway would bring to Agnland.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":117}]},"82":{"id":82,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon continued to speak about how this project was a stepping stone towards a Sordish economic recovery.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":115}]},"83":{"id":83,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd began cheering my name.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":116}]},"84":{"id":84,"speaker":"Narrator","isPlayerChoice":false,"text":"The weather was warm and unusually calm for the windy port city. Spirits were high.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":85}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"Despite Lachaven's strong PFJP presence, a huge crowd of supporters had turned out. Lucian must have brought in some ringers.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":27}]},"86":{"id":86,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I welcome you Lachaveners today as a proud servant of this country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":29}]},"87":{"id":87,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“This project is a perfect example of the capacity and capabilities of Sordland as a nation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":47}]},"88":{"id":88,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Our aim with this project was obvious: to improve the speed and efficiency of transportation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":46}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon handed me a pair of oversized scissors.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":180}]},"90":{"id":90,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The drive to Arvory should take about four hours. We'll be right behind you in the motorcade.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":58}]},"91":{"id":91,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"}],"outgoingIds":[{"convId":169,"nodeId":161}]},"92":{"id":92,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Economy","op":"=","value":"Variable[\"BaseGame.Economy\"] + 1"}],"outgoingIds":[{"convId":169,"nodeId":8}]},"93":{"id":93,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"}],"outgoingIds":[{"convId":169,"nodeId":91}]},"94":{"id":94,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian stood up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":95}]},"95":{"id":95,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“First of all...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":96}]},"96":{"id":96,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“This day may have arrived later than expected, but it doesn't change the fact that we are here now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":126}]},"97":{"id":97,"speaker":"Player","isPlayerChoice":true,"text":"“We couldn't have done this without our excellent team.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":102}]},"98":{"id":98,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Nod.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":104}]},"99":{"id":99,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“To many more projects like this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":105}]},"100":{"id":100,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I have a plan for how to do that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":106}]},"101":{"id":101,"speaker":"Player","isPlayerChoice":true,"text":"“Good work.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":102}]},"102":{"id":102,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Indeed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":104}]},"103":{"id":103,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“It's been a long time since the last successful infrastructure project. From a public relations viewpoint, we can certainly capitalize on the occasion.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":100}]},"104":{"id":104,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Let's move on to our plans for the opening tomorrow.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":103}]},"105":{"id":105,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Well done.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":101},{"convId":169,"nodeId":97},{"convId":169,"nodeId":98}]},"106":{"id":106,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The president himself shall make the maiden voyage from Lachaven to Arvory along with his motorcade. If he agrees, of course.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":107}]},"107":{"id":107,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“What are your thoughts?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":6}]},"108":{"id":108,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think so too. Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":10},{"convId":169,"nodeId":9}]},"109":{"id":109,"speaker":"Player","isPlayerChoice":true,"text":"“I guess we can't avoid that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":73}]},"110":{"id":110,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":80}]},"111":{"id":111,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“We will need to show our best face tomorrow. I'll make sure that our focus on improving business and logistics is relayed by whatever means necessary.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":19}]},"112":{"id":112,"speaker":"Player","isPlayerChoice":true,"text":"“See you at the ceremony.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":20}]},"113":{"id":113,"speaker":"Player","isPlayerChoice":true,"text":"“Goodbye for now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":20}]},"114":{"id":114,"speaker":"Player","isPlayerChoice":true,"text":"“Once again, good work everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":20}]},"115":{"id":115,"speaker":"Narrator","isPlayerChoice":false,"text":"After he was done with his speech, Lucian took Symon's place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":118}]},"116":{"id":116,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took my place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":118}]},"117":{"id":117,"speaker":"Narrator","isPlayerChoice":false,"text":"After she was done with her speech, Lucian took Lileas's place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":118}]},"118":{"id":118,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Citizens of Lachaven! There you have it!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":119}]},"119":{"id":119,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“As promised, Anton Rayne -- the 4th President of Sordland -- has delivered!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":120}]},"120":{"id":120,"speaker":"Narrator","isPlayerChoice":false,"text":"We walked towards the entrance of the highway next to the stage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":55}]},"121":{"id":121,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":122},{"convId":169,"nodeId":123}]},"122":{"id":122,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Lachaven_Rich","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":124}]},"123":{"id":123,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Lachaven_Rich","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":32}]},"124":{"id":124,"speaker":"Player","isPlayerChoice":true,"text":"“Fellow Free Lachaveners! Welcome to the opening ceremony of the H-3 Highway!”","conditionsRaw":"Variable[\"BaseGame.Prologue_Birthplace_Lachaven_Rich\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Lachaven_Rich","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":34}]},"125":{"id":125,"speaker":"Narrator","isPlayerChoice":false,"text":"Although the delay had taken its toll on our morale, it was still a proud moment for all of us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":171}]},"126":{"id":126,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“This is still a big success. Congratulations, everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":99}]},"127":{"id":127,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn08_LateHighwayOpening","op":"=","value":"true"},{"var":"BaseGame.Policy_Economy_HighwayProject","op":"=","value":"true"}],"outgoingIds":[{"convId":169,"nodeId":7}]},"128":{"id":128,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"}],"outgoingIds":[{"convId":169,"nodeId":146}]},"129":{"id":129,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":169,"nodeId":130},{"convId":169,"nodeId":131}]},"130":{"id":130,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true","variablesRead":[{"var":"BaseGame.Turn02_InT_Corporation_SordishState","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":169,"