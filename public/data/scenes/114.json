{"conversationId":114,"title":"Sordland/Turn07/NiaDialogue01_Opposition","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":10}]},"3":{"id":3,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm sure he also pressured the Justices of the Court against your proposal right after that win. I hate to be on his side but I don't agree with your proposal either.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":4}]},"4":{"id":4,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You call this proposal *democratic*, but we know it's a power grab, Mr. President. I'm only doing this out of respect.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":5}]},"5":{"id":5,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I've organized this meeting because I am still a part of the cabinet. Consider this a favour from my side.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":85},{"convId":114,"nodeId":86},{"convId":114,"nodeId":87}]},"6":{"id":6,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Lucian and Petr believe that he can be persuaded too. Whatever you do, I am not with you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":17}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"\"What about Heron?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":14}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"\"We won the vote. I can still persuade Orso.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":12}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"\"Mrs. Morgna. Don't do this. I need your vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":10}]},"10":{"id":10,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I thought we've been through this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":17}]},"11":{"id":11,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Well, I'm not helping with that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":63}]},"12":{"id":12,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"He's not willing to talk. I doubt you can do anything about that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":17}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"\"There's nothing else.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":18}]},"14":{"id":14,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Oh, now you want to cooperate with the Old Guards, after all?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":6}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you for your efforts with the Anti-corruption police.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":21}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":36}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":16}]},"18":{"id":18,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Fine.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":2}]},"19":{"id":19,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"He's doing his best to organize the Court against your proposal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":40}]},"20":{"id":20,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I guess we have... maybe 5 minutes?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":2}]},"21":{"id":21,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Thank you for signing the order, Mr. President. But do not think that the force is a political tool.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":72}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":43}]},"23":{"id":23,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She's certainly open to dialogue but also sceptical. She seemed to be scared of a potential purge against the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":24},{"convId":114,"nodeId":28},{"convId":114,"nodeId":30}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"\"Interesting. Maybe I should play into that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":37}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":26},{"convId":114,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":31}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"\"We can find common ground against the Old Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":95}]},"29":{"id":29,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Their weakest link is Heron, but the rest are unbreakable.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":67},{"convId":114,"nodeId":38}]},"30":{"id":30,"speaker":"Player","isPlayerChoice":true,"text":"\"So, you think she's scared of us?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":32}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"\"When will Isabel be here?\"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true  and  Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":33}]},"32":{"id":32,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She's not entirely scared about the situation, but then again, none of the court even believed that you would succeed in the Assembly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":60}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked at her watch.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":20}]},"34":{"id":34,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Maybe she's feeling the pressure now. But in any case, you'll discover that soon enough.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":22}]},"35":{"id":35,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Having common enemies doesn't always result in an alliance. As you know...\"","conditionsRaw":"(Variable[\"BaseGame.Faction_OldGuard_Content\"] == true) == false","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":22}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":50},{"convId":114,"nodeId":53},{"convId":114,"nodeId":47},{"convId":114,"nodeId":13},{"convId":114,"nodeId":25}]},"37":{"id":37,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Do whatever you want, Mr. President. Isabel might be feeling the pressure after the vote, but she's not a weak woman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":22}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"\"We need to talk to Heron, then.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":11}]},"39":{"id":39,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But there's huge pressure on them. The Anti-corruption force has found incriminating evidence against some of the Justices.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":68}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":41},{"convId":114,"nodeId":42}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":39}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":29}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":36}]},"44":{"id":44,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You still need six votes from somewhere. Isabel can potentially bring two to three votes, that's why she's your ticket. But I doubt it will work out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":99}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"\"What is the atmosphere in the Court?\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":83}]},"46":{"id":46,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"The Old Guards are fanatically opposing your proposal too.\"","conditionsRaw":"(Variable[\"BaseGame.Faction_OldGuard_Content\"] == true) == false","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":7},{"convId":114,"nodeId":8},{"convId":114,"nodeId":9}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":48},{"convId":114,"nodeId":49}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":70}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":51},{"convId":114,"nodeId":52}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":58}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":54},{"convId":114,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":45}]},"56":{"id":56,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You are right, but where's the breaking point?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":75}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":16}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"\"What about Justice Edmonds? Does she share your views?\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":64}]},"59":{"id":59,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She's not openly protesting against the Old Guards but she has told me about her concerns about them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":23}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":61},{"convId":114,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":65}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":34}]},"63":{"id":63,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Your openness to talk to Heron is already showing me your true intentions...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"64":{"id":64,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Somewhat, yes. We are not ideologically entirely aligned but she's still someone who has a sense of justice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":59}]},"65":{"id":65,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She must also be under pressure after the anti-corruption police's raids against her fellow colleagues.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":22}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"\"We have to keep up the pressure.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":81}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"\"Nobody is unbreakable.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":56}]},"68":{"id":68,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Although they have immunity, they are scared that these would go public. You might have already gained a few more votes in the Court but I'm not sure more Old Guards would jump on the same wagon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":76},{"convId":114,"nodeId":15},{"convId":114,"nodeId":71},{"convId":114,"nodeId":66}]},"69":{"id":69,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"It is the Old Guard that are disrespecting their positions. You cannot bring down the Court. With all due respect, it is the *President* who needs to *finally learn to back down*.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":93},{"convId":114,"nodeId":92},{"convId":114,"nodeId":94}]},"70":{"id":70,"speaker":"Player","isPlayerChoice":true,"text":"\"What has Orso been doing?\"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_B","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_A","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn07_A_Reformist_ConvinceCourt_NiaHub_C","op":"=","value":"true"}],"outgoingIds":[{"convId":114,"nodeId":19}]},"71":{"id":71,"speaker":"Player","isPlayerChoice":true,"text":"\"Good. The whole Court must finally learn to back down.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":74}]},"72":{"id":72,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I won't let their efforts be exploited.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"73":{"id":73,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I only know about the two Justices I've mentioned earlier who are with me. So we have three votes there. Against you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":44}]},"74":{"id":74,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Is this a battle against the Court, Mr. President?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":69}]},"75":{"id":75,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"These old men have a pride as vast as Merkopa, they're not easy to break. And... This is not a game, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":77},{"convId":114,"nodeId":78}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":80}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"79":{"id":79,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Anyway...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"80":{"id":80,"speaker":"Player","isPlayerChoice":true,"text":"\"They can keep relying on their immunity. Soon, we will be able to impeach them.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":82}]},"81":{"id":81,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"The investigations are still going, Mr. President. The pressure will build up.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"82":{"id":82,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"With the ongoing investigations of the anti-corruption force, I'm sure we will have a strong position against most of the Old Guards regarding their impeachment.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":84}]},"83":{"id":83,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Most Justices don't really talk when I'm around. They don't trust me as I'm an outside member of the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":73}]},"84":{"id":84,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But I still think it was not the right decision to add that to the proposal. This might pressure the future Courts to always be in line with the fear of being displaced.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":79}]},"85":{"id":85,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you Mrs. Morgna. This means a lot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":89}]},"86":{"id":86,"speaker":"Player","isPlayerChoice":true,"text":"\"Are you saying that you will vote against the proposal?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":88}]},"87":{"id":87,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm disappointed, Mrs. Morgna. I thought I'd be able to change your mind.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":88}]},"88":{"id":88,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I believe my position was clear from the beginning.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":91}]},"89":{"id":89,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"It should, Mr. President. I'm aiding you against what I believe in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":90}]},"90":{"id":90,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Of course, that won't stop me from doing what I can to make it fail.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":91}]},"91":{"id":91,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But anyway... Let me know if there's something else... I'd be taking my leave as soon as Mrs. Edmonds gets here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":50},{"convId":114,"nodeId":53},{"convId":114,"nodeId":47},{"convId":114,"nodeId":13}]},"92":{"id":92,"speaker":"Player","isPlayerChoice":true,"text":"\"It is a battle that I will win. Yes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"93":{"id":93,"speaker":"Player","isPlayerChoice":true,"text":"\"Watch your words, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"94":{"id":94,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm sorry to hear that you feel this way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":57}]},"95":{"id":95,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":96},{"convId":114,"nodeId":97}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Faction_OldGuard_Content\"] == true","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":98}]},"97":{"id":97,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Faction_OldGuard_Content\"] == true) == false","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":35}]},"98":{"id":98,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Having common enemies doesn't always result in an alliance. But I doubt that they are really your *enemies.*","conditionsRaw":"Variable[\"BaseGame.Faction_OldGuard_Content\"] == true","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":22}]},"99":{"id":99,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":100},{"convId":114,"nodeId":101}]},"100":{"id":100,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Faction_OldGuard_Content\"] == true","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":102}]},"101":{"id":101,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Faction_OldGuard_Content\"] == true) == false","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":46}]},"102":{"id":102,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"The Old Guards were fanatically opposing any constitutional changes. But I think they are not that discontent anymore... Since you are protecting the status quo...\"","conditionsRaw":"Variable[\"BaseGame.Faction_OldGuard_Content\"] == true","variablesRead":[{"var":"BaseGame.Faction_OldGuard_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":7},{"convId":114,"nodeId":103},{"convId":114,"nodeId":105}]},"103":{"id":103,"speaker":"Player","isPlayerChoice":true,"text":"\"We won the vote. That might have changed their minds.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":104}]},"104":{"id":104,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Maybe...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":17}]},"105":{"id":105,"speaker":"Player","isPlayerChoice":true,"text":"\"So the problem is not the Old Guards but you...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":106}]},"106":{"id":106,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I thought we've been through this. I organized a meeting for you, didn't I? Don't even try to attack me with that...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":114,"nodeId":17}]}}}