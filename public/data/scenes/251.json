aseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":63}]},"58":{"id":58,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“I will not allow threats. This is a warning, Mr. President.”","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":63}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":60},{"convId":251,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":58}]},"62":{"id":62,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"“I will not allow threats. This is a warning, Mr. President.”","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":63}]},"63":{"id":63,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“That is all I have to present to the court, your honor.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":64}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRa