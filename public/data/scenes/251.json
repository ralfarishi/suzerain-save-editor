er\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":39}]},"37":{"id":37,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“Present your evidence then, Mr. Garaci.”","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":39}]},"38":{"id":38,"speaker":"Narrator","isPlayerChoice":false,"text":"He pulled out a check and held it up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":40}]},"39":{"id":39,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“I was wearing this exact outfit, a Justice's outfit, when Mr. Rayne approached me to give me this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":38}]},"40":{"id":40,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“This man attempted to bribe a member of the Supreme Court.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":41}]},"41":{"id":41,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“The check has his own signature on it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":42}]},"42":{"id":42,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“I think there is not much else to say here, is there?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":43}]},"43":{"id":43,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“I leave the accused at the mercy of the court.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":45}]},"44":{"id":44,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"“The court will take this evidence into consideration.”","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":49},{"convId":251,"nodeId":50},{"convId":251,"nodeId":51},{"convId":251,"nodeId":52}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":46},{"convId":251,"nodeId":47}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":44}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":48}]},"48":{"id":48,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“The court will take this evidence into consideration.”","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":49},{"convId":251,"nodeId":50},{"convId":251,"nodeId":51},{"convId":251,"nodeId":52}]},"49":{"id":49,"speaker":"Player","isPlayerChoice":true,"text":"“That fabricated piece of paper surely can't be evidence!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":53}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“I demand that the court investigate the authenticity of this check!”","condition