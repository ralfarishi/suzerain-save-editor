alse,"text":"“I see that you are wearing your old garb, Mr. Garaci.”","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":18}]},"16":{"id":16,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“I see that you are wearing your old garb, Mr. Garaci.”","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":19}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"I was surprised to see he was wearing his justice uniform.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":21},{"convId":251,"nodeId":22},{"convId":251,"nodeId":24},{"convId":251,"nodeId":26}]},"18":{"id":18,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"“Do I have to remind you that it is illegal to wear the robes of a Justice when you no longer hold that position?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":20}]},"19":{"id":19,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"“Do I have to remind you that it is illegal to wear the robes of a Justice when you no longer hold that position?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":20}]},"20":{"id":20,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“Let's just call it a habit, your honor.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":28}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“Still trying to latch onto what you don't have?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":23}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"“Great. You made a clown out of yourself, Heron.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":23}]},"23":{"id":23,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“Laugh all you want, Mr. President. I will have the last laugh.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":12}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"“You motherfucker...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":25}]},"25":{"id":25,"speaker":"Heron Garaci","isPlayerChoice":false,"text":"“Easy, Mr. President. You are in a court of law.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":12}]},"26":{"id":26,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Refrain from making a comment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":12}]},"27":{"id":27,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"“Very well. I will permit it for the duration of this session. If you repeat this offense, you will be punished for it. Do you understand?”","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":32}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":251,"nodeId":29},{"convId":251,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OvidGrecer\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OvidGrecer","op":"==","value":"true"}],"variablesModified":[],"ou