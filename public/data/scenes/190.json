{"conversationId":190,"title":"Sordland/Turn09/PFJP Investigation","storyPack":"StoryPack_Main","turn":9,"turnLabel":"Turn 9","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":5}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":188,"nodeId":56}]},"3":{"id":3,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Unfortunately, sir, the Reformists appear to be as clean as a whistle. Earlier rumors about connections to oligarchs turned out to be just that: rumors.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn09_A_CampaignInvestigations_DiscussedReformists","op":"=","value":"true"}],"outgoingIds":[{"convId":190,"nodeId":8}]},"4":{"id":4,"speaker":"Player","isPlayerChoice":true,"text":"\"Then you'll just have to make sure Nia never finds out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":52}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":7}]},"6":{"id":6,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Not only on your chances of re-election -- but on the remainder of your current term.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":4},{"convId":190,"nodeId":12},{"convId":190,"nodeId":38}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{