e[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) and ((Variable[\"BaseGame.Turn07_SecretState_Kill_FrensRicter\"] == true  or  Variable[\"BaseGame.Turn07_SecretState_Detained_FrensRicter\"] == true  or  Variable[\"BaseGame.Reform_Turn07_Emergency_Detained_Frens\"] == true) == false)","variablesRead":[{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"},{"var":"BaseGame.Turn07_SecretState_Kill_FrensRicter","op":"==","value":"true"},{"var":"BaseGame.Turn07_SecretState_Detained_FrensRicter","op":"==","value":"true"},{"var":"BaseGame.Reform_Turn07_Emergency_Detained_Frens","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":48}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"\"It's not fair! I didn't do anything wrong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":52}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":40},{"convId":190,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Alliance_NFP\"] == true","variablesRead":[{"var":"BaseGame.Reform_Alliance_NFP","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":60}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Alliance_NFP\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Alliance_NFP","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":50}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"You're lying.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":14}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As you wish. I'll give the order to the new police chief.\"","conditionsRaw":"Variable[\"BaseGame.Fired_KarlGreiser\"] == true","variablesRead":[{"var":"BaseGame.Fired_KarlGreiser","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":63}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"\"Damn. I knew I shouldn't have done that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":90}]},"45":{"id":45,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That would put a rather abrupt end to the momentum she's been gathering and help clear the path for your re-election.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":58},{"convId":190,"nodeId":59}]},"46":{"id":46,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Your previous actions with Ricter have already put you on shaky moral ground, wouldn't you say?\"","conditionsRaw":"((Variable[\"BaseGame.Relations_Lucian_Opinion\"] > 0) == false) and (Variable[\"BaseGame.Turn07_SecretState_Kill_FrensRicter\"] == true  or  Variable[\"BaseGame.Turn07_SecretState_Detained_FrensRicter\"] == true  or  Variable[\"BaseGame.Reform_Turn07_Emergency_Detained_Frens\"] == true)","variablesRead":[{"var":"BaseGame.Relations_Lucian_Opinion","op":">","value":"0"},{"var":"BaseGame.Turn07_SecretState_Kill_FrensRicter","op":"==","value":"true"},{"var":"BaseGame.Turn07_SecretState_Detained_FrensRicter","op":"==","value":"true"},{"var":"BaseGame.Reform_Turn07_Emergency_Detained_Frens","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":61}]},"47":{"id":47,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Forming the Secret State Police already put you on rather shaky moral ground, Mr. President.\"","conditionsRaw":"((Variable[\"BaseGame.Relations_Lucian_Opinion\"] > 0) == false) and ((Variable[\"BaseGame.Turn07_SecretState_Kill_FrensRicter\"] == true  or  Variable[\"BaseGame.Turn07_SecretState_Detained_FrensRicter\"] == true  or  Variable[\"BaseGame.Reform_Turn07_Emergency_Detained_Frens\"] == true) == false)","variablesRead":[{"var":"BaseGame.Relations_Lucian_Opinion","op":">","value":"0"},{"var":"BaseGame.Turn07_SecretState_Kill_FrensRicter","op":"==","value":"true"},{"var":"BaseGame.Turn07_SecretState_Detained_FrensRicter","op":"==","value":"true"},{"var":"BaseGame.Reform_Turn07_Emergency_Detained_Frens","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":61}]},"48":{"id":48,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That would help drain support from the Reformists and clear the path for your re-election.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":58},{"convId":190,"nodeId":59}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Mr. President, you're already about to neutralize one of your biggest opposition parties. Taking out both would just be wishful thinking.\"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn09_A_CampaignInvestigations_DiscussedNFP\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn09_A_CampaignInvestigations_DiscussedNFP","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":88}]},"50":{"id":50,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You'll be happy to hear that the investigation into the NFP was rather more successful.\"","conditionsRaw":"((Variable[\"BaseGameIsolated.Turn09_A_CampaignInvestigations_DiscussedNFP\"] == true) == false) and ((Variable[\"BaseGame.Reform_Alliance_NFP\"] == true) == false)","variablesRead":[{"var":"BaseGameIsolated.Turn09_A_CampaignInvestigations_DiscussedNFP","op":"==","value":"true"},{"var":"BaseGame.Reform_Alliance_NFP","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":190,"nodeId":97}]},"51":{"id":51,"speaker":"L