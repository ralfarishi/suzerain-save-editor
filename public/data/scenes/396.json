{"conversationId":396,"title":"Rizia/Turn 7/New Security Councilor Talk","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":395,"nodeId":494}]},"3":{"id":3,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"With Duchess Azaro now... indisposed, it is imperative that you choose a new security councilor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":4},{"convId":396,"nodeId":6},{"convId":396,"nodeId":7},{"convId":396,"nodeId":8}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"How is she faring in prison, by the way?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":5}]},"5":{"id":5,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"She's in a high-end women's facility within the Porte Drazon Citadel. I would not worry about her treatment.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":12}]},"6":{"id":6,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I was going to ask you about that. Have you found any suitable candidates?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":11}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I want a councilor who isn't a traitor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":10}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You mean a new war councilor.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":9}]},"9":{"id":9,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We have avoided a second Pales conflict. Lord willing, we will not be entering another war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":13}]},"10":{"id":10,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"A perfectly reasonable expectation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":13}]},"11":{"id":11,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Two, in fact.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":13}]},"12":{"id":12,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"As to candidates for her successor...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":13}]},"13":{"id":13,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Incredibly, it seems that General Taddeus Azaro is on track to make a full recovery.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":14}]},"14":{"id":14,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Give him another few months, and he will be ready to resume his former position.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":15},{"convId":396,"nodeId":16},{"convId":396,"nodeId":18},{"convId":396,"nodeId":17}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He still wants to serve me after I jailed his daughter?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":32}]},"16":{"id":16,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Why, that's excellent news. It'll be as if this whole unpleasantness with Lucita never occurred.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":27}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Oh. I must say that I dread that prospect, especially given the circumstances.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":69}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":19},{"convId":396,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_JoinedMilitary\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_JoinedMilitary","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_JoinedMilitary\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_JoinedMilitary","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"21":{"id":21,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Is that so? I'm looking forward to working with him again.\"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_JoinedMilitary\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_JoinedMilitary","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":22}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":23},{"convId":396,"nodeId":24}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":25}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":26}]},"25":{"id":25,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The feeling may not be mutual. House Azaro had qualms about your reign even before you jailed their heiress.\"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":39}]},"26":{"id":26,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The feeling is mutual, it seems. Even after the arrest of House Azaro's heiress.\"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":43}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":28},{"convId":396,"nodeId":29}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":31}]},"30":{"id":30,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I doubt that. House Azaro holds grudges for a long time, and General Taddeus is not one to forgive and forget.\"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":39}]},"31":{"id":31,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"General Taddeus is not one to forgive and forget, Your Majesty. But you have been a friend to his house throughout your reign.\"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":43}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":33},{"convId":396,"nodeId":34}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":36}]},"35":{"id":35,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Apparently. Which surprises me, given that General Taddeus is not one to forgive and forget.\"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":39}]},"36":{"id":36,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You have been a friend to House Azaro. Perhaps enough so that he is willing to overlook this incident.\"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":43}]},"37":{"id":37,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He has shown exceptional loyalty to the Crown in the past. But now? I confess I am not certain.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":81},{"convId":396,"nodeId":63},{"convId":396,"nodeId":64},{"convId":396,"nodeId":66}]},"38":{"id":38,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I have no doubt of his loyalty to the Crown. As long as you keep his daughter alive, of course.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":47},{"convId":396,"nodeId":52},{"convId":396,"nodeId":51},{"convId":396,"nodeId":57}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":40},{"convId":396,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":42}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":37}]},"42":{"id":42,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"However, with the threat of the Duchess' execution hanging over his head, I have no doubt he will be loyal to the Crown.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":47},{"convId":396,"nodeId":52},{"convId":396,"nodeId":51},{"convId":396,"nodeId":57}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":44},{"convId":396,"nodeId":45}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":38}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":46}]},"46":{"id":46,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He has shown exceptional loyalty to the Crown in the past. I have faith he will now.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_RemoveDeathPenalty","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":74},{"convId":396,"nodeId":76},{"convId":396,"nodeId":81}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":48},{"convId":396,"nodeId":49}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"]","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":50}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_TyrantKing\"]) == false","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"50":{"id":50,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I can't kill her? I was looking forward to a good old-fashioned beheading.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"]","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":59}]},"51":{"id":51,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The death penalty is standard for traitors to our kingdom. I'm afraid I can't make an exception.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":59}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":53},{"convId":396,"nodeId":54}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Lucita_RomanceHappened\"] == true","variablesRead":[{"var":"RiziaDLC.Lucita_RomanceHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Lucita_RomanceHappened\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Lucita_RomanceHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":56}]},"55":{"id":55,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I would never execute Duchess Azaro. I still harbor fond feelings for her, you know.\"","conditionsRaw":"Variable[\"RiziaDLC.Lucita_RomanceHappened\"] == true","variablesRead":[{"var":"RiziaDLC.Lucita_RomanceHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":61}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I would never execute Duchess Azaro. All of Cardesse-Montaklar would turn on me in an instant.\"","conditionsRaw":"(Variable[\"RiziaDLC.Lucita_RomanceHappened\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Lucita_RomanceHappened","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":60}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Palesians will be expecting an execution, won't they?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":58}]},"58":{"id":58,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"As long as treason to Rizia is punishable by death, then yes, they will take umbrage if you make an exception.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"59":{"id":59,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If that is what you insist, then I suggest you keep General Taddeus far from these halls.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"60":{"id":60,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Yes, ordering the death of such a prominent noble is bound to have repercussions. Even if her father is not restored to his former position.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"61":{"id":61,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I suspected the two of you were close. It's for the best that nothing came of it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"62":{"id":62,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I do have one other qualified candidate in mind.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":94}]},"63":{"id":63,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So what you're saying is that I should throw him in jail as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":86}]},"64":{"id":64,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The man's a patriot. He knows that Rizia's security comes before his petty familial concerns.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":88}]},"65":{"id":65,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He got us into an unnecessary war. I'm not chomping at the bit to have him back.\"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":83}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":67},{"convId":396,"nodeId":68}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":65}]},"68":{"id":68,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":80}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":70},{"convId":396,"nodeId":71}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":73}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":72}]},"72":{"id":72,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Is that so, Your Majesty? The General may not be one to forgive and forget, but you have secured House Azaro's favor up to this point.\"","conditionsRaw":"(Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0) == false","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":43}]},"73":{"id":73,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I don't blame you. House Azaro had qualms about your reign even before you jailed their heiress.\"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseAzaro\"] < 0","variablesRead":[{"var":"RiziaDLC.Country_HouseAzaro","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":39}]},"74":{"id":74,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The man's a patriot. He knows that Rizia's security comes before his petty familial concerns.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":82}]},"75":{"id":75,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"On the other hand... he got us into an unnecessary war. I'm not chomping at the bit to have him back.\"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":83}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":77},{"convId":396,"nodeId":78}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":75}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":79}]},"79":{"id":79,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"On the other hand... the uprising was his fault. I'm not chomping at the bit to have him back.\"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":84}]},"80":{"id":80,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Aside from that, the uprising was his fault. I'm not chomping at the bit to have him back.\"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Pales_AntiWar\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Pales_AntiWar","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":84}]},"81":{"id":81,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And what repercussions can I expect from the Azaros if I don't give him his council seat back?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":85}]},"82":{"id":82,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"One would hope so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"83":{"id":83,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He was instrumental in restoring stability after the conflict. Two decades without a major incident is nothing to sniff at.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"84":{"id":84,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The uprising had many causes. And the General was instrumental in restoring stability afterwards.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"85":{"id":85,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Obviously, they would prefer it if the council seat went to their house. But they will understand if you have lingering concerns about the General's health.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"86":{"id":86,"speaker":"Narrator","isPlayerChoice":false,"text":"He smiled darkly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":87}]},"87":{"id":87,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Not unless you want all of Cardesse-Montaklar rioting in the streets.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"88":{"id":88,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It is more complicated than that. House Azaro and national security have been synonymous for many years.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":62}]},"89":{"id":89,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Titus already commands his own security detail. Naming him councilor would only be natural.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Order_GoldenGuard_Expanded\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Order_GoldenGuard_Expanded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":105}]},"90":{"id":90,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":91},{"convId":396,"nodeId":92}]},"91":{"id":91,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Order_GoldenGuard_Expanded\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Order_GoldenGuard_Expanded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":89},{"convId":396,"nodeId":93}]},"92":{"id":92,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Order_GoldenGuard_Expanded\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_Order_GoldenGuard_Expanded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":95},{"convId":396,"nodeId":96}]},"93":{"id":93,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Titus already has an important assignment. I don't want to dilute his focus by putting him on the council.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Order_GoldenGuard_Expanded\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Order_GoldenGuard_Expanded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":106}]},"94":{"id":94,"speaker":"Narrator","isPlayerChoice":false,"text":"He nodded towards the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":90},{"convId":396,"nodeId":97},{"convId":396,"nodeId":98}]},"95":{"id":95,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That meathead, in charge of security? I want him taking bullets for me, not commanding our armies.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Order_GoldenGuard_Expanded\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_Order_GoldenGuard_Expanded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":101}]},"96":{"id":96,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I know Titus is still sore I never expanded the Golden Guard. Naming him security councilor would more than make up for that.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Order_GoldenGuard_Expanded\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_Order_GoldenGuard_Expanded","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":102}]},"97":{"id":97,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"A security councilor with no house and no agenda to push... It could be a refreshing change.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":103}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Titus? Really? What makes you think he can be trusted?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":99}]},"99":{"id":99,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He has been by your side since your coronation. And his conduct has been beyond reproach.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":100}]},"100":{"id":100,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Such loyalty should not go unrewarded.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":111}]},"101":{"id":101,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Perhaps his unconventional background will give him an edge in devising national security strategies.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":108}]},"102":{"id":102,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Captain Gordion is a professional. He would not resent you for a decision you made so early on in your reign.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":107}]},"103":{"id":103,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"His services have been indispensable in keeping the Royal Family safe. And what is Rizia, if not one extended royal family?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":109}]},"104":{"id":104,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"On the other hand, concentrating that much power in the hands of one man could prove dangerous.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":111}]},"105":{"id":105,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"His conduct as head of the Golden Guard has been beyond reproach.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":104}]},"106":{"id":106,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"With Rizia's national security apparatus at his disposal, he could easily handle both.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":104}]},"107":{"id":107,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I am confident he would make as trustworthy a councilor as he has a bodyguard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":111}]},"108":{"id":108,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It's true that he has no experience with military operations. But then again, we are not at war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":111}]},"109":{"id":109,"speaker":"Narrator","isPlayerChoice":false,"text":"He smiled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":111}]},"110":{"id":110,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"At any rate, I will leave the decision up to you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":2}]},"111":{"id":111,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You may not know this, but Captain Gordion petitioned King Valero about the interim security councilor position after General Azaro fell ill.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":112},{"convId":396,"nodeId":114},{"convId":396,"nodeId":116},{"convId":396,"nodeId":119}]},"112":{"id":112,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That's interesting. What'd my father say?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":113}]},"113":{"id":113,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He appeared interested. However, he signed the order for Duchess Azaro to fill the position without so much as interviewing the Captain.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":110}]},"114":{"id":114,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"My father should have said yes. Look what happened with Lucita.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":115}]},"115":{"id":115,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He couldn't have known. None of us did.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":110}]},"116":{"id":116,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That power-grubber. My father never even expanded the Golden Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":117}]},"117":{"id":117,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Perhaps he would have, had he lived.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":110}]},"118":{"id":118,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"But my father didn't think he was ready yet.\"","conditionsRaw":"Variable[\"RiziaDLC.Turn05_MurderInvest_SuspectHugo\"] == true","variablesRead":[{"var":"RiziaDLC.Turn05_MurderInvest_SuspectHugo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":122}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":120},{"convId":396,"nodeId":121}]},"120":{"id":120,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Turn05_MurderInvest_SuspectHugo\"] == true","variablesRead":[{"var":"RiziaDLC.Turn05_MurderInvest_SuspectHugo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":118}]},"121":{"id":121,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Turn05_MurderInvest_SuspectHugo\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Turn05_MurderInvest_SuspectHugo","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"122":{"id":122,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo frowned.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":123}]},"123":{"id":123,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"He said no such thing. He told me he was considering the possibility, in fact. But House Azaro took precedence.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":396,"nodeId":110}]}}}