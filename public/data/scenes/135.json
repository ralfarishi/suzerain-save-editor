{"conversationId":135,"title":"Sordland/Turn07/HOS AND BERGIA STEEL FULLY NATIONALISED","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":7}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":132,"nodeId":309}]},"3":{"id":3,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You are making a terrible mistake.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":4}]},"4":{"id":4,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“To put it mildly. You can't just take away our entire life's work and expect no repercussions.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":5}]},"5":{"id":5,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“This might be one of those rare moments where we are aligned, Marcel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":6}]},"6":{"id":6,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Well, it's rare a president does something this colossally stupid.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":10}]},"7":{"id":7,"speaker":"Narrator","isPlayerChoice":false,"text":"The two oligarchs looked at each other and then at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":3}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"“Keep the pen. A gift from me and a reminder.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":25}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel buried his head in his hands.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":52}]},"10":{"id":10,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Completely nationalizing Sordland's two biggest private corporations? Are you insane?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":12},{"convId":135,"nodeId":14},{"convId":135,"nodeId":13}]},"11":{"id":11,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I've been chewing up and spitting out Sordish politicians since you were in diapers.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":78}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"“Insanely clever.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":21}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"“Stop whining. You are both done for.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":22}]},"14":{"id":14,"speaker":"Player","isPlayerChoice":true,"text":"“I have already made my decision.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":21}]},"15":{"id":15,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“If we are going down, you are going down with us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":24}]},"16":{"id":16,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“With their connections and influence, they could cause us untold difficulties down the road.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":29},{"convId":135,"nodeId":98}]},"17":{"id":17,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I swear on my name as a Koronti.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":15}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian fanned the agreement papers out in front of them.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":19}]},"19":{"id":19,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Mr. Koronti. Mr. Tusk. Here are the agreements that pertain to the nationalization and the transfer of your shares to the state.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":27}]},"20":{"id":20,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I know everything.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":15}]},"21":{"id":21,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“This is nonsense.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":22}]},"22":{"id":22,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Mr. President. I beg you to rethink this decision.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":18}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel and Walter packed their belongings and furiously exited the room, closing the door loudly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":139}]},"24":{"id":24,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Most of the Assembly eats out of my hand.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":41}]},"25":{"id":25,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Rest assured. I will never forget what you have done to me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":74}]},"26":{"id":26,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Don't you realize how much dirt I have on you? You will pay for backstabbing me.”","conditionsRaw":"Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":17}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"He pointed to various sections and pages in the stack of papers.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":28}]},"28":{"id":28,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“You will need to sign here, here and here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":31}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"“No. There is no need.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":68}]},"30":{"id":30,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Don't you realize how much dirt I have on you?\"","conditionsRaw":"(Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true) == false","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":20}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":32},{"convId":135,"nodeId":33}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true","variablesRead":[{"var":"BaseGame.Medi