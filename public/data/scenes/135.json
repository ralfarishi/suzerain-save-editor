ulness.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":44}]},"41":{"id":41,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You will learn what it means to hurt Walter Tusk, President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":50}]},"42":{"id":42,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I will destroy you!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":36}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel and Walter packed their belongings and exited the room, closing the door loudly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn07_Fled_MarcelKoronti","op":"=","value":"true"},{"var":"BaseGame.Turn07_Fled_WalterTusk","op":"=","value":"true"},{"var":"BaseGame.Relations_Walter_Enemy","op":"=","value":"true"},{"var":"BaseGame.Relations_Marcel_Enemy","op":"=","value":"true"}],"outgoingIds":[{"convId":135,"nodeId":2}]},"44":{"id":44,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“No. This can't be.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":49}]},"45":{"id":45,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":42}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":47},{"convId":135,"nodeId":48}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":135,"nodeId":26}]},"48":{"id":48,