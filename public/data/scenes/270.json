n11_SnO_PointGunToSoldier\"] == true) == false) and ((Variable[\"BaseGame.RumburgWarLost_Alone\"] == false) == false)","variablesRead":[{"var":"BaseGameIsolated.Turn11_SnO_PointGunToHead","op":"==","value":"true"},{"var":"BaseGameIsolated.Turn11_SnO_PointGunToSoldier","op":"==","value":"true"},{"var":"BaseGame.RumburgWarLost_Alone","op":"==","value":"false"}],"variablesModified":[{"var":"BaseGame.Epilogue_RumburgWar_Lost","op":"=","value":"true"}],"outgoingIds":[{"convId":270,"nodeId":16},{"convId":270,"nodeId":17},{"convId":270,"nodeId":18}]},"14":{"id":14,"speaker":"Player","isPlayerChoice":false,"text":"...pulled the trigger.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":22}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":false,"text":"...thought there might still be a way out of this.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":21}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":false,"text":"...vowed to yourself that they would pay.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":44}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":false,"text":"...closed your eyes and accepted whatever might happen.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":44}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":false,"text":"...punched him in the face.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":49}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"The soldier reeled back, then re-trained his gun on you, sneering.\n\nYou prepared for the end.\n\nAnother one of the men approached you and hit you with the headstock of his rifle.","conditionsRaw":"(Variable[\"BaseGame.RumburgWarLost_Alone\"] == false) == false","variablesRead":[{"var":"BaseGame.RumburgWarLost_Alone","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":43}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"They laughed after detaining you. They started taking photos with you.\n\nThey cheerfully carried you to a personnel truck while singing Rumburgian victory songs.","conditionsRaw":"(Variable[\"BaseGame.RumburgWarLost_Alone\"] == false) == false","variablesRead":[{"var":"BaseGame.RumburgWarLost_Alone","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":24}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"As you hesitated, the soldier snatched the gun out of your hand. He and his men moved in on you and began to beat you mercilessly, until your face was bleeding and your eyes had swollen shut.\n\nThey cheerfully carried you to a personnel truck while singing Rumburgian victory songs.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":24}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"Your life flashed before your eyes.\n\nYou thought of happy times, sad times, all the decisions you had made that led you to this very moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":23}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":false,"text":"And so Anton Rayne was no more.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":2}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":false,"text":"Your journey to the enemy territory began.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":68}]},"25":{"id":25,"speaker":"Narrator","isPlayerChoice":false,"text":"The young soldier collapsed motionless. \n\nSwearing, his reinforcements aimed their rifles at you. You managed to kill another one in the melee.\n\nWhen the gunfire ended, you looked down to your body.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":26}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":false,"text":"Blood was everywhere.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":74}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":false,"text":"...prayed the soldiers would spare them.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":31}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":false,"text":"...told them it was all going to be okay.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":30}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":false,"text":"...said you were sorry for everything.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":30}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"Your voice only came out as a quiet whisper. Yet you knew that they had heard what you said.\n\nYou started to feel so tired that you couldn't keep your eyes open. You decided to rest for just a moment.\n\nAfter taking a deep breath, you closed your eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":23}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"You started to feel so tired that you couldn't keep your eyes open. You decided to rest for just a moment.\n\nAfter taking a deep breath, you closed your eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":23}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":false,"text":"...wished that things had gone differently.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":35}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":false,"text":