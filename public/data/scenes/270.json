day you were woken up with a splash of icy water.\n\nThe warden told you that the Queen would pay you a visit. You prepared a makeshift knife and hid it well.\n\nShe entered the cell. You...","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":55},{"convId":270,"nodeId":54}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":false,"text":"...begged for mercy.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":59}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":false,"text":"...tried to stab her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":56}]},"56":{"id":56,"speaker":"Narrator","isPlayerChoice":false,"text":"The prison guards quickly wrenched the knife out of your hands.\n\nQueen Beatrice Livingston demanded your immediate execution. \n\nYou were forcibly brought before an electric chair.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":57}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":false,"text":"They strapped you to the seat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":58}]},"58":{"id":58,"speaker":"Narrator","isPlayerChoice":false,"text":"The metal cap was put on your head without wetting the sponge.\n\nThe Queen pulled the lever.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":23}]},"59":{"id":59,"speaker":"Narrator","isPlayerChoice":false,"text":"Queen Beatrice smiled and gestured down towards her shoes.\n\nYou...","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":60},{"convId":270,"nodeId":61}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":false,"text":"...told her you'd rather die.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":62}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":false,"text":"...knelt down and kissed her feet.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":63}]},"62":{"id":62,"speaker":"Narrator","isPlayerChoice":false,"text":"With a haughty laugh, she left your cell.\n\nYou never saw her again.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":65}]},"63":{"id":63,"speaker":"Narrator","isPlayerChoice":false,"text":"She laughed at your humiliation and left the cell.\n\nYou never saw her again.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":65}]},"64":{"id":64,"speaker":"Narrator","isPlayerChoice":true,"text":"1960|Rumburg","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":66}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":false,"text":"Time flies in jail.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":64}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":false,"text":"You had grown old.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":67}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":true,"text":"1974|Rumburg","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":23}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"In Rumburg, they locked you in a prison cell.\n\nHours turned into days and days turned into weeks. Guards and soldiers tormented you from dusk until dawn, scarring your mind and body long after you'd told them everything you knew about Sordland and your presidency.\n\nYou asked about your family, but none of your questions were answered.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":270,"nodeId":69}]},"69":{"id":6