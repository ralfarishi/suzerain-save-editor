{"conversationId":397,"title":"Rizia/Turn 7/WIP_HODShutdownIntention","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":395,"nodeId":153},{"convId":395,"nodeId":183},{"convId":395,"nodeId":1502},{"convId":395,"nodeId":1506}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo scrutinized me very closely.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":5}]},"4":{"id":4,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Romus. What do you mean?\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn07_Hugo_Informal\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_Hugo_Informal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":9},{"convId":397,"nodeId":15},{"convId":397,"nodeId":14},{"convId":397,"nodeId":16},{"convId":397,"nodeId":11}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":6},{"convId":397,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn07_Hugo_Informal\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_Hugo_Informal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":4}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn07_Hugo_Informal\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_Hugo_Informal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":8}]},"8":{"id":8,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Your Majesty. What do you mean?\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn07_Hugo_Informal\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_Hugo_Informal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":9},{"convId":397,"nodeId":15},{"convId":397,"nodeId":14},{"convId":397,"nodeId":16},{"convId":397,"nodeId":11}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It was a fine experiment. But I believe the time has come to put a stop to it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":24}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I have a vision, Hugo. Of a Rizia led only by the most devout and pure of heart.\"","conditionsRaw":"Variable[\"RiziaDLC.Religion_Leaning_Theocratic\"] == true","variablesRead":[{"var":"RiziaDLC.Religion_Leaning_Theocratic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":26}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":12},{"convId":397,"nodeId":13}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Religion_Leaning_Theocratic\"] == true","variablesRead":[{"var":"RiziaDLC.Religion_Leaning_Theocratic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":10}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Religion_Leaning_Theocratic\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Religion_Leaning_Theocratic","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"14":{"id":14,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It's a waste of resources. My council advises me on lawmaking. I don't need a building full of useless bureaucrats doing the same thing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":23}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Even assuming we can control Manus, some other young hothead might try to warp the HOD to his or her own ends. It's too dangerous.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":21}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":17},{"convId":397,"nodeId":18}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_ElectoralReform\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_ElectoralReform","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":19}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_ElectoralReform\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_ElectoralReform","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":20}]},"19":{"id":19,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It was a mistake to make it easier to elect commoners. I don't want their heads getting too big.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_ElectoralReform\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_ElectoralReform","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":25}]},"20":{"id":20,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Sazon and the other noble houses should stick to their provinces. They don't need a say in the federal government.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_ElectoralReform\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_ElectoralReform","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":24}]},"21":{"id":21,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You do have a point...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":22}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo mulled it over for a few seconds.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":27}]},"23":{"id":23,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"A waste indeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":22}]},"24":{"id":24,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Hmm.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":22}]},"25":{"id":25,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Nor do I.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":22}]},"26":{"id":26,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I take it you've been consulting with the Grand Wiseman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":22}]},"27":{"id":27,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If you eliminate the House of Delegates as an institution, there will certainly be a backlash. Both at home and abroad.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":28}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":29},{"convId":397,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.HouseElections_RPPWinsSeats\"] == true","variablesRead":[{"var":"RiziaDLC.HouseElections_RPPWinsSeats","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":31}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.HouseElections_RPPWinsSeats\"] == true) == false","variablesRead":[{"var":"RiziaDLC.HouseElections_RPPWinsSeats","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":32}]},"31":{"id":31,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And the reformists who've recently been elected may turn to more dangerous outlets if this one is taken away.\"","conditionsRaw":"Variable[\"RiziaDLC.HouseElections_RPPWinsSeats\"] == true","variablesRead":[{"var":"RiziaDLC.HouseElections_RPPWinsSeats","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":34}]},"32":{"id":32,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The nobles who hold seats in the House of Delegates have also gotten quite used to their positions, and the salaries and perks that come with them.\"","conditionsRaw":"(Variable[\"RiziaDLC.HouseElections_RPPWinsSeats\"] == true) == false","variablesRead":[{"var":"RiziaDLC.HouseElections_RPPWinsSeats","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":34}]},"33":{"id":33,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"\"If you command enough respect in the capital, you may be able to get away with it. But not overnight.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Authority\"] > 7","variablesRead":[{"var":"RiziaDLC.Resources_Authority","op":">","value":"7"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":39},{"convId":397,"nodeId":43},{"convId":397,"nodeId":48},{"convId":397,"nodeId":53}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":35},{"convId":397,"nodeId":36}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Authority\"] > 7","variablesRead":[{"var":"RiziaDLC.Resources_Authority","op":">","value":"7"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":33}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Authority\"] > 7) == false","variablesRead":[{"var":"RiziaDLC.Resources_Authority","op":">","value":"7"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":37}]},"37":{"id":37,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If you command enough respect in the capital, you may be able to get away with it. But frankly put, you're currently at a disadvantage in that regard.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Authority\"] > 7) == false","variablesRead":[{"var":"RiziaDLC.Resources_Authority","op":">","value":"7"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":39},{"convId":397,"nodeId":43},{"convId":397,"nodeId":48},{"convId":397,"nodeId":45},{"convId":397,"nodeId":53}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And if I knew someone with connections among commoners and nobles alike? Someone with experience greasing the wheels in the capital?\"","conditionsRaw":"Variable[\"RiziaDLC.Rusty_Allied\"] == true","variablesRead":[{"var":"RiziaDLC.Rusty_Allied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":42}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":40},{"convId":397,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Rusty_Allied\"] == true","variablesRead":[{"var":"RiziaDLC.Rusty_Allied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":38}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Rusty_Allied\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Rusty_Allied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"42":{"id":42,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'd imagine such a person could be very helpful. But you have to be careful about what you promise them in return.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":52}]},"43":{"id":43,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"All right. I'll give it some more thought.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":52}]},"44":{"id":44,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This has been my goal since I took the throne. And I will stop at nothing to make it happen.\"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_Absolutism\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_Absolutism","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":51}]},"45":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You don't say. Even my own uncle disrespects me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":47}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'll let go of this for now. Winning the war is more important than consolidating my power.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":56}]},"47":{"id":47,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I hold you in the highest esteem. It's why I tell you the truth.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":52}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":49},{"convId":397,"nodeId":50}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Focus_Government_Absolutism\"] == true","variablesRead":[{"var":"RiziaDLC.Focus_Government_Absolutism","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":44}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Focus_Government_Absolutism\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Focus_Government_Absolutism","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"51":{"id":51,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"When the time comes, you shall have my full backing. As always.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":52}]},"52":{"id":52,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"At any rate, if you do shut down the House of Delegates, Manus Sazon will be one of your greatest opponents. So I strongly suggest we figure out what to do with him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":58}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":54},{"convId":397,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":46}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":57}]},"56":{"id":56,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Perhaps you'll win it more easily without a chorus of dissent in your ear.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":52}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'll let go of this for now. There are more important things than consolidating my power.\"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":397,"nodeId":52}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn07_Intention_HODShutdown","op":"=","value":"true"}],"outgoingIds":[{"convId":397,"nodeId":2}]}}}