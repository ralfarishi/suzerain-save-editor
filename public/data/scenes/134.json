{"conversationId":134,"title":"Sordland/Turn07/HOS AND BERGIA STEEL MINORITY OR MAJORITY NATIONALISED","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":109}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":132,"nodeId":309}]},"3":{"id":3,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You're not the boss of me. Or of anyone, come to think of it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":52}]},"4":{"id":4,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“No. I am not happy at all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":6}]},"5":{"id":5,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“If we're quite finished, I will take my leave.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":28}]},"6":{"id":6,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“But as you could've done far more damage, let's say that I am ready to put this unfortunate decision behind us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":9},{"convId":134,"nodeId":8},{"convId":134,"nodeId":7}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"“Yes, I spared you as much as I could. Don't forget that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":12}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"“No hard feelings, Marcel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":10}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"“Thanks for being cooperative.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":5}]},"10":{"id":10,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“In our line of business, there is no place for feelings.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":5}]},"11":{"id":11,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Just like your presidency.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":117}]},"12":{"id":12,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“That doesn't necessarily mean I'll spare you when the time comes.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":5}]},"13":{"id":13,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"\"Our deal is over, Mr. President.\"","conditionsRaw":"(Variable[\"BaseGame.HeartOfSordland_Nationalization\"] < Variable[\"BaseGame.BergiaSteel_Nationalization\"]) and (Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true)","variablesRead":[{"var":"BaseGame.HeartOfSordland_Nationalization","op":"<","value":"Variable[\"BaseGame.BergiaSteel_Nationalization\""},{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"},{"var":"BaseGame.BergiaSteel_Nationalization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":11}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel's shoulders slumped in defeat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":71}]},"15":{"id":15,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Gentlemen, don't make this more difficult.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":36}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"“Give me back my pen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":69}]},"17":{"id":17,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Shame on me for actually believing we could work together.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":22}]},"18":{"id":18,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“However, I understand.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":19}]},"19":{"id":19,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“This could've turned out much worse for me *and* you if not for our...friendship.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":20}]},"20":{"id":20,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I've signed the damn paperwork. We're done here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":24}]},"21":{"id":21,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Your time will come too, Rayne. Believe me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":24}]},"22":{"id":22,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I couldn't be more wrong.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":74},{"convId":134,"nodeId":55},{"convId":134,"nodeId":82}]},"23":{"id":23,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I should've destroyed you when I had the chance.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":74},{"convId":134,"nodeId":82},{"convId":134,"nodeId":50}]},"24":{"id":24,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Come on, Marcel. Let's go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":25}]},"25":{"id":25,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“We have work to do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":40}]},"26":{"id":26,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I knew you would end up destroying everything Sordland stood for.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":23}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"“I hope you can understand where this is coming from.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":96}]},"28":{"id":28,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Come on, Walter. Let's go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"=","value":"false"}],"outgoingIds":[{"convId":134,"nodeId":30}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"“I am sorry it had to come to this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":42}]},"30":{"id":30,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“We have work to do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":33}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“Enough. You will obey me regardless.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":44}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“Unfortunately, these sacrifices are necessary.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":43}]},"33":{"id":33,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You might have the upper hand for now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":34}]},"34":{"id":34,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“But don't go ordering me around, boy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":35}]},"35":{"id":35,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Otherwise, I will make you regret it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":49}]},"36":{"id":36,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Sign the papers.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":14}]},"37":{"id":37,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Not enough, President. Not enough.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":15}]},"38":{"id":38,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I knew this would happen. I should've trusted my gut feeling.”","conditionsRaw":"Variable[\"BaseGame.Faction_Oligarchs_Content\"] == true","variablesRead":[{"var":"BaseGame.Faction_Oligarchs_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":17}]},"39":{"id":39,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Otherwise, I will make you regret it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":45}]},"40":{"id":40,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You might have the upper hand for now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":41}]},"41":{"id":41,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“But don't go ordering me around, old man.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":39}]},"42":{"id":42,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“No. I am sorry about what will happen next.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":51}]},"43":{"id":43,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“For what? Ending the recession? We both know that's not the case.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":51}]},"44":{"id":44,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Now you are starting to show your true face.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":51}]},"45":{"id":45,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Hah.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":47}]},"46":{"id":46,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I had a gut feeling, President. I knew you were not to be trusted.”","conditionsRaw":"(Variable[\"BaseGame.Faction_Oligarchs_Content\"] == true) == false","variablesRead":[{"var":"BaseGame.Faction_Oligarchs_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":26}]},"47":{"id":47,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You're not half the man your father was. Remember that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":52}]},"48":{"id":48,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Rest assured. I will never forget what you have done to me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":58}]},"49":{"id":49,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Hah.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":3}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“And look at where we are now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":53}]},"51":{"id":51,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“This is nonsense.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":54}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel and Walter angrily packed their belongings and left the meeting room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":2}]},"53":{"id":53,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Screw you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":15}]},"54":{"id":54,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I beg you to rethink this decision.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":81}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":true,"text":"“Good riddance.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":53}]},"56":{"id":56,"speaker":"Narrator","isPlayerChoice":false,"text":"He grabbed the pen from Marcel's hands and gave it to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":58}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"“We *had* a deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":106}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":134,"nodeId":59},{"convId":134,"nodeId":60}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":fals