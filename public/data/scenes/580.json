{"conversationId":580,"title":"Rizia/ABOLISHLOCALPOLICE/ABOLISHLOCALPOLICE Conversation","storyPack":"StoryPack_Rizia","turn":-1,"turnLabel":"General","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":356,"nodeId":53}]},"3":{"id":3,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The provincial police may not be perfect, but they are the first line of defense against disorder.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":4}]},"4":{"id":4,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Crime doesn't wait for bureaucracy. Drugs, migrants and illegal cargo slipping through weak borders... These are not issues that solve themselves with a signature.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":5},{"convId":580,"nodeId":9},{"convId":580,"nodeId":11},{"convId":580,"nodeId":12},{"convId":580,"nodeId":10}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":6},{"convId":580,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Hugo_DecreeCounsel_Happened\"] > 0","variablesRead":[{"var":"RiziaDLC.Hugo_DecreeCounsel_Happened","op":">","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Hugo_DecreeCounsel_Happened\"] > 0) == false","variablesRead":[{"var":"RiziaDLC.Hugo_DecreeCounsel_Happened","op":">","value":"0"}],"variablesModified":[],"outgoingIds":[]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Not this again, Hugo...\"","conditionsRaw":"Variable[\"RiziaDLC.Hugo_DecreeCounsel_Happened\"] > 0","variablesRead":[{"var":"RiziaDLC.Hugo_DecreeCounsel_Happened","op":">","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":13}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I completely disagree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":13}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And what's your advice?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":13}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And yet I cannot allow the provinces to control security independently, as if they rule themselves.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":15}]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Then you must already know why centralization is necessary.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":14}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"He leveled his gaze at me and spoke with a calm but pressing tone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":15}]},"14":{"id":14,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"That depends on what you consider more dangerous. Fragmented policing, or a sudden vacuum in law enforcement that will make the Houses furious.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":15}]},"15":{"id":15,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Stripping the provinces of their forces overnight is not a good idea, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":16}]},"16":{"id":16,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It may strengthen the national government, but it will weaken security in ways we cannot afford.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":17}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":18},{"convId":580,"nodeId":19}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":21}]},"20":{"id":20,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"After your abolition of provincial levies, I'm afraid this may act as the tipping point for the other Houses.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":25},{"convId":580,"nodeId":28},{"convId":580,"nodeId":26},{"convId":580,"nodeId":23}]},"21":{"id":21,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"This will be seen as an attack against the autonomy of the provinces.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":22}]},"22":{"id":22,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"To remove their control of internal security would be seen as an attack to consolidate power under your rule.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":25},{"convId":580,"nodeId":26},{"convId":580,"nodeId":23},{"convId":580,"nodeId":24}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"I'm completely aware, Hugo. I don't expect them to be happy about this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":31}]},"24":{"id":24,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This isn't an attack on provinces. It's about strengthening the central police forces.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":32}]},"25":{"id":25,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So you're against it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":34}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't care what the Houses think.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":29}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Nobles never act vindictively. They're paragons of reason and rationality.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":52}]},"28":{"id":28,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Tipping point for what exactly?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":33}]},"29":{"id":29,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Then you should start.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":30}]},"30":{"id":30,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Because the moment they believe you're casting them aside, they will also stop caring about the Crown.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":25},{"convId":580,"nodeId":46},{"convId":580,"nodeId":42},{"convId":580,"nodeId":47},{"convId":580,"nodeId":27},{"convId":580,"nodeId":48}]},"31":{"id":31,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"A cornered noble isn't going to be merely *unhappy*. We shouldn't let them become desperate enough to act.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":35}]},"32":{"id":32,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You have to tell that to the Royal Houses who would be losing control over their own security.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":35}]},"33":{"id":33,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You know what I'm talking about, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":35}]},"34":{"id":34,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I am only against making changes without accounting for the consequences.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":37}]},"35":{"id":35,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The moment they believe you're casting them aside, they may stop voicing their discontent in letters and start acting on it with force.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":25},{"convId":580,"nodeId":46},{"convId":580,"nodeId":42},{"convId":580,"nodeId":47},{"convId":580,"nodeId":27},{"convId":580,"nodeId":48}]},"36":{"id":36,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Having said that, I will support your decision, no matter the course you choose.\"","conditionsRaw":"((Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true  or  (Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  and  Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false)) == false) and (Variable[\"RiziaDLC.Country_HouseToras\"] >= 8  and  (Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false  or  Variable[\"RiziaDLC.Reform_DeclareIntention_WeakStatement\"] == true))","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"false"},{"var":"RiziaDLC.Country_HouseToras","op":">=","value":"8"},{"var":"RiziaDLC.Reform_DeclareIntention_WeakStatement","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":99}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":38},{"convId":580,"nodeId":39}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true  or  (Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  and  Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false)","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":40}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true  or  (Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  and  Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false)) == false","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":70}]},"40":{"id":40,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If this decree weakens rather than strengthens our hold on the kingdom, then yes, I am against it.\"","conditionsRaw":"(Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true  or  (Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  and  Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false)) and ((Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true  or  (Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  and  Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false)) == false) and ((Variable[\"RiziaDLC.Country_HouseToras\"] >= 8  and  (Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false  or  Variable[\"RiziaDLC.Reform_DeclareIntention_WeakStatement\"] == true)) == false)","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"false"},{"var":"RiziaDLC.Country_HouseToras","op":">=","value":"8"},{"var":"RiziaDLC.Reform_DeclareIntention_WeakStatement","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":73}]},"41":{"id":41,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Why are you so concerned? With both their military and police forces gone, they will have no power to contest the Crown.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":49}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":43},{"convId":580,"nodeId":44}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":41}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":45}]},"45":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Then I need to abolish their military forces as well.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":51}]},"46":{"id":46,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You have a point. It might be risky to push this so quickly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":78}]},"47":{"id":47,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Do you have a solution, Hugo, or just more warnings?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":64}]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That is why I will act first and strip them of the means to challenge the Crown.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":54}]},"49":{"id":49,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"That's what worries me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":50}]},"50":{"id":50,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"They won't have power in the way they used to, but power doesn't disappear overnight. If they feel threatened, they'll fight with whatever they have left.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":61}]},"51":{"id":51,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Well, if your goal is to make every Royal House panic at once, that would certainly do it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":61}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"He chuckled but his expression remained neutral.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":53}]},"53":{"id":53,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If only they were all like House Toras. Alas, they are not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":61}]},"54":{"id":54,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Then just be sure they don’t feel it all at once.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":55}]},"55":{"id":55,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"If they feel threatened, they'll fight with everything they have left.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":61}]},"56":{"id":56,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'm afraid I must counsel against this.\"","conditionsRaw":"((Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true  or  (Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  and  Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false)) == false) and ((Variable[\"RiziaDLC.Country_HouseToras\"] >= 8  and  (Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false  or  Variable[\"RiziaDLC.Reform_DeclareIntention_WeakStatement\"] == true)) == false)","variablesRead":[{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"false"},{"var":"RiziaDLC.Country_HouseToras","op":">=","value":"8"},{"var":"RiziaDLC.Reform_DeclareIntention_WeakStatement","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":73}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":580,"nodeId":58},{"convId":580,"nodeId":59}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Country_HouseToras\"] >= 8  and  (Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == false  or  Variable[\"RiziaDLC.Reform_DeclareIntention_WeakStatement\"] == true)","variablesRead":[{"var":"RiziaDLC.Country_HouseToras","op":">=","value":"8"},{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"false"},{"var