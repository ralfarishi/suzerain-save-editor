goingIds":[{"convId":585,"nodeId":15}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It's unsettling that you'd doubt my familiarity.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_TyrantKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":28}]},"16":{"id":16,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That I am. The celestial alignment holds great importance in our religious heritage.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":27}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Indeed, I've been rehearsing my 'impressed by the universe' face for weeks now.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_FunnyKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":26}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes. I've been preparing for weeks to truly appreciate the awe-inspiring celestial alignment.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_FunnyKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":23}]},"19":{"id":19,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Indeed it does.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":25}]},"20":{"id":20,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Forgive me. That was never my intention.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":25}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"Sal respectfully bowed his head.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":20}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Vaguely... I mean, I know about it as much as the next person.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":24}]},"23":{"id":23,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"That pleases me to hear it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":25}]},"24":{"id":24,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I'm surprised to hear it. In that case...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":25}]},"25":{"id":25,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"As we celebrate tonight's event, I'd be honored to retell the story.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"26":{"id":26,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"It truly completes your countenance, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":25}]},"27":{"id":27,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"I'm glad you think so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":25}]},"28":{"id":28,"speaker":"Narrator","isPlayerChoice":false,"text":"Sal offered a respectful bow of his head.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":29}]},"29":{"id":29,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"That was never my intention. Forgive me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":25}]}}}