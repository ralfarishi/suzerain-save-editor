{"conversationId":585,"title":"Rizia/Turn 6/Star_Align_Notes/Star_Align_Notes Conversation","storyPack":"StoryPack_Rizia","turn":6,"turnLabel":"Turn 6","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"It's remarkable that we're about to witness the same celestial alignment St. Wruhec beheld so many years ago. You're acquainted with the story, aren't you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":12},{"convId":585,"nodeId":6},{"convId":585,"nodeId":9},{"convId":585,"nodeId":22}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That I am. It symbolizes the timeless connection between our faith and the heavens.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":19}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm a Wruhecist. How the hell could you possibly think I'm not?\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":21}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":585,"nodeId":7},{"convId":585,"nodeId":8}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] 