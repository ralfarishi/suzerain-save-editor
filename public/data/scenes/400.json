{"conversationId":400,"title":"Rizia/Turn 7/Angelica Greeting","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":4}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":399,"nodeId":1236}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"She approached me, her demeanor friendly yet cautious.","conditionsRaw":"Variable[\"RiziaDLC.Manus_Gone\"] == true  and  Variable[\"RiziaDLC.Iza_AntiMonarchism\"] > 2","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"},{"var":"RiziaDLC.Iza_AntiMonarchism","op":">","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":12}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":5},{"convId":400,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Manus_Gone\"] == true  and  Variable[\"RiziaDLC.Iza_AntiMonarchism\"] > 2","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"},{"var":"RiziaDLC.Iza_AntiMonarchism","op":">","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":3}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Manus_Gone\"] == true  and  Variable[\"RiziaDLC.Iza_AntiMonarchism\"] > 2) == false","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"},{"var":"RiziaDLC.Iza_AntiMonarchism","op":">","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":7}]},"7":{"id":7,"speaker":"Narrator","isPlayerChoice":false,"text":"She approached me with a smile.","conditionsRaw":"(Variable[\"RiziaDLC.Manus_Gone\"] == true  and  Variable[\"RiziaDLC.Iza_AntiMonarchism\"] > 2) == false","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"},{"var":"RiziaDLC.Iza_AntiMonarchism","op":">","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":12}]},"8":{"id":8,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"King Romus. We meet at last.\"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Studied\"]) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Studied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":9},{"convId":400,"nodeId":18},{"convId":400,"nodeId":24},{"convId":400,"nodeId":34},{"convId":400,"nodeId":19}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":10},{"convId":400,"nodeId":11}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Studied\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Studied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":17}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Studied\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Studied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":13},{"convId":400,"nodeId":14}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Studied\"]","variablesRead":[{"var":"RiziaDLC.Prologue_Studied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Prologue_Studied\"]) == false","variablesRead":[{"var":"RiziaDLC.Prologue_Studied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":8}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"I suddenly remembered watching her give a speech in this very auditorium, nearly 30 years ago.","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Studied\"]","variablesRead":[{"var":"RiziaDLC.Prologue_Studied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":16}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"The person in front of me was much older, but had the exact same fire in her eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":8}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We meet *again*. I saw you speak when I was studying here.\"","conditionsRaw":"Variable[\"RiziaDLC.Prologue_Studied\"] == true","variablesRead":[{"var":"RiziaDLC.Prologue_Studied","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":25}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Romus the Merciful, you mean. You're welcome.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":29}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":20},{"convId":400,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.VinaManus_Together\"] == true","variablesRead":[{"var":"RiziaDLC.VinaManus_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":22}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.VinaManus_Together\"] == true) == false","variablesRead":[{"var":"RiziaDLC.VinaManus_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're the mother of my future son-in-law. I couldn't let you rot away on that island.\"","conditionsRaw":"Variable[\"RiziaDLC.VinaManus_Together\"] == true","variablesRead":[{"var":"RiziaDLC.VinaManus_Together","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":40}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am so sorry about your son.\"","conditionsRaw":"Variable[\"RiziaDLC.Manus_Arrested\"] == true  or  Variable[\"RiziaDLC.SuOmina_OrderedToKillManus\"] == true","variablesRead":[{"var":"RiziaDLC.Manus_Arrested","op":"==","value":"true"},{"var":"RiziaDLC.SuOmina_OrderedToKillManus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":37}]},"24":{"id":24,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Duchess Sazon. It is a pleasure to see you here in Iza.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":31}]},"25":{"id":25,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"Oh, that's terribly embarrassing. I'm sure I was parroting whatever revolutionary nonsense my husband was filling my head with at the time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":26},{"convId":400,"nodeId":27},{"convId":400,"nodeId":28},{"convId":400,"nodeId":33}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Your husband. Right.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":43}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Lucas had the right idea. But his methods left something to be desired.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":44}]},"28":{"id":28,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't blame him for what he did. Rizia was hungry for change. It still is.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":46}]},"29":{"id":29,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"Yes, thank you, Your Majesty. I'm happy to be home again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":30}]},"30":{"id":30,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"At the same time, it fills me with shame to think about my last days here. The things my husband did...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":26},{"convId":400,"nodeId":27},{"convId":400,"nodeId":28},{"convId":400,"nodeId":33}]},"31":{"id":31,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"Likewise, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":32}]},"32":{"id":32,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"I watched your coronation from Caleqabiz. It disgusted me to think how close my husband came to keeping you from the throne.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":26},{"convId":400,"nodeId":27},{"convId":400,"nodeId":28},{"convId":400,"nodeId":33}]},"33":{"id":33,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You were as guilty as your husband was. But you redeemed yourself by turning him in.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":47}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":35},{"convId":400,"nodeId":36}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Manus_Arrested\"] == true  or  Variable[\"RiziaDLC.SuOmina_OrderedToKillManus\"] == true","variablesRead":[{"var":"RiziaDLC.Manus_Arrested","op":"==","value":"true"},{"var":"RiziaDLC.SuOmina_OrderedToKillManus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":23}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Manus_Arrested\"] == true  or  Variable[\"RiziaDLC.SuOmina_OrderedToKillManus\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Manus_Arrested","op":"==","value":"true"},{"var":"RiziaDLC.SuOmina_OrderedToKillManus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"37":{"id":37,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"Yes, Manus' unfortunate absence has tainted the joy of my return.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":38}]},"38":{"id":38,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"I am ashamed to think that he inherited his father's treasonous tendencies. I thought I raised him better than that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":27},{"convId":400,"nodeId":33},{"convId":400,"nodeId":39}]},"39":{"id":39,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You can't seriously expect me to believe you don't share those tendencies.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":48}]},"40":{"id":40,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"I wouldn't call it rotting, Your Majesty. Manus and I were treated the same as any other villager on Caleqabiz.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":41}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked fondly at Manus and Vina.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":42}]},"42":{"id":42,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"But yes, it warms my heart to see my son and the Crown Princess so happy together. A sign that our houses are finally reconciling after my husband's shameful act.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":26},{"convId":400,"nodeId":28}]},"43":{"id":43,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"I won't pretend his words never swayed me. But when I became pregnant I realized some things are more important than revolution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":52}]},"44":{"id":44,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"A revolution bought with blood will never succeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":49}]},"45":{"id":45,"speaker":"Narrator","isPlayerChoice":false,"text":"Her eyes traveled past me to the heavily armed officers patrolling the auditorium aisles.","conditionsRaw":"Variable[\"RiziaDLC.Iza_Outcome_MaxOppression\"] == true","variablesRead":[{"var":"RiziaDLC.Iza_Outcome_MaxOppression","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":57}]},"46":{"id":46,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"A revolution bought with blood will never succeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":49}]},"47":{"id":47,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"I was about to become a mother. That mattered more to me than any revolution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":52}]},"48":{"id":48,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"Maybe I did once. But when I became pregnant I realized some things are more important than revolution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":52}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":50},{"convId":400,"nodeId":51}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Iza_Outcome_MaxOppression\"] == true","variablesRead":[{"var":"RiziaDLC.Iza_Outcome_MaxOppression","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":45}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Iza_Outcome_MaxOppression\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Iza_Outcome_MaxOppression","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":58}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":53},{"convId":400,"nodeId":54}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Manus_Gone\"] == true","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Manus_Gone\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":56}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"A flash of sorrow crossed her face.","conditionsRaw":"Variable[\"RiziaDLC.Manus_Gone\"] == true","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":57}]},"56":{"id":56,"speaker":"Narrator","isPlayerChoice":false,"text":"Her eyes traveled past me to her son.","conditionsRaw":"(Variable[\"RiziaDLC.Manus_Gone\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Manus_Gone","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":57}]},"57":{"id":57,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"I should be getting to my seat. We will speak again soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":65},{"convId":400,"nodeId":64},{"convId":400,"nodeId":63},{"convId":400,"nodeId":59}]},"58":{"id":58,"speaker":"Narrator","isPlayerChoice":false,"text":"Her eyes traveled past me to Rico, who was already sitting onstage.","conditionsRaw":"(Variable[\"RiziaDLC.Iza_Outcome_MaxOppression\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Iza_Outcome_MaxOppression","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":57}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":60},{"convId":400,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reforms_DiscussedOnYacht\"] == true","variablesRead":[{"var":"RiziaDLC.Reforms_DiscussedOnYacht","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reforms_DiscussedOnYacht\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reforms_DiscussedOnYacht","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"62":{"id":62,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We can change Rizia together. It's not too late.\"","conditionsRaw":"Variable[\"RiziaDLC.Reforms_DiscussedOnYacht\"] == true","variablesRead":[{"var":"RiziaDLC.Reforms_DiscussedOnYacht","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":67}]},"63":{"id":63,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You'll get your seat, all right. Sooner than you think.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":68}]},"64":{"id":64,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Enjoy the festivities, Duchess.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":66}]},"65":{"id":65,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Try not to blame yourself for what happened. Focus on the future.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":70}]},"66":{"id":66,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"Please, Your Majesty. Call me Angelica.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":69}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"She nodded, stepped away and continued down the aisle.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":2}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"With a confused look, she continued down the aisle.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":2}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"She stepped away from me and continued down the aisle.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":2}]},"70":{"id":70,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"I will. Thank you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":400,"nodeId":69}]}}}