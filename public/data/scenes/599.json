e":"true"}],"variablesModified":[],"outgoingIds":[{"convId":599,"nodeId":8}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I began these reforms with the help of the Rizian People's Party. I urge you to vote for them, so that we may complete the trajectory that we started together.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_PrimeMinister_Daria\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_PrimeMinister_Daria","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":599,"nodeId":8}]}}}