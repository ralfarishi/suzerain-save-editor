{"conversationId":558,"title":"Rizia/Turn 10/STRIKE SCENE/INTRO_ABDICATION/ABOLISHMENT/INTRO_ABDICATION/ABOLISHMENT Conversation","storyPack":"StoryPack_Rizia","turn":10,"turnLabel":"Turn 10","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":104}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":555,"nodeId":49}]},"3":{"id":3,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":2}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I had a whole speech prepared. But now that we're all here, let's just raise a toast.\"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_ViolentAction_DirectStrike\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_ViolentAction_DirectStrike","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":5}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"They looked at one another, seemingly relieved.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":6}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":555,"nodeId":25}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":8},{"convId":558,"nodeId":9}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_ViolentAction_DirectStrike\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_ViolentAction_DirectStrike","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":4}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_ViolentAction_DirectStrike\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_ViolentAction_DirectStrike","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"A wise man once said, 'Resistance to change is futile when the wheels of time turn unceasingly.'\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":72}]},"11":{"id":11,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I've called everyone here as a courtesy to inform you that there are going to be some changes around here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":14}]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I didn't want it to come to this. But alas, here we are.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":73}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"Once inside, I closed the door, leaving the celebrations behind us.","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false) and (Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) == false) and (Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) == false) and (Variable[\"RiziaDLC.BirthdayGathering_Invited_Manus\"] == true) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Manus\"] == true) == false) and (Variable[\"RiziaDLC.BirthdayGathering_Invited_Rico\"]) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Rico\"]) == false)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Manus","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Rico","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":11},{"convId":558,"nodeId":10},{"convId":558,"nodeId":12},{"convId":558,"nodeId":7}]},"14":{"id":14,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You've already outdone yourself with the renovations, Your Majesty. No need to gild the lily.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":15}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"There was a ripple of light laughter.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":92}]},"16":{"id":16,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"For centuries, the monarchy has been the stabilizing force of Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":78},{"convId":558,"nodeId":89},{"convId":558,"nodeId":17}]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Through hardship and prosperity, the Crown has stood firm, guiding this nation through its darkest and brightest days.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":18},{"convId":558,"nodeId":79},{"convId":558,"nodeId":90}]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"While Rizia’s past should be celebrated and revered, we cannot afford to become stuck in it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":91},{"convId":558,"nodeId":19},{"convId":558,"nodeId":82}]},"19":{"id":19,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Clinging too tightly to tradition risks dragging us into ruin.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":125}]},"20":{"id":20,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"Are you saying tradition is a burden now?\"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Manus\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":25}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":22},{"convId":558,"nodeId":23}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":20}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":24}]},"24":{"id":24,"speaker":"Leona Sazon","isPlayerChoice":false,"text":"\"Are you suggesting that tradition is a burden now?","conditionsRaw":"((Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) == false) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Manus\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":25}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":26},{"convId":558,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":29}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":34}]},"28":{"id":28,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"You’re speaking in riddles, dear.\"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) and (Variable[\"RiziaDLC.Lucita_Married\"] == true)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"},{"var":"RiziaDLC.Lucita_Married","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":39}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"