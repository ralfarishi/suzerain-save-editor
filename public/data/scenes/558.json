_Carlos\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":33}]},"36":{"id":36,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":38}]},"37":{"id":37,"speaker":"Carlos Robles Azaro","isPlayerChoice":false,"text":"\"Yes, just what exactly are you trying to tell us?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":44}]},"38":{"id":38,"speaker":"Carlos Robles Azaro","isPlayerChoice":false,"text":"\"You’re speaking in riddles, Your Majesty. Just what exactly is it you're trying to tell us?\"","conditionsRaw":"((Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":44}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":40},{"convId":558,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":42}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":43}]},"42":{"id":42,"speaker":"Carlos Robles Azaro","isPlayerChoice":false,"text":"\"Yes, just what exactly are you trying to tell us?\"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":44}]},"43":{"id":43,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"Just what exactly are you trying to tell us?\"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":44}]},"44":{"id":44,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Quiet, everyone. Let His Majesty speak.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":83},{"convId":558,"nodeId":85},{"convId":558,"nodeId":45},{"convId":558,"nodeId":84}]},"45":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I intend to transform Rizia into a democratic republic -- one governed by the people, for the people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":46}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"The guests froze, their eyes reflecting shock and outrage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":49}]},"47":{"id":47,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Romus, please. You can't be serious about this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":65}]},"48":{"id":48,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"A republic? You mean to dismantle the monarchy?\"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":47}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":50},{"convId":558,"nodeId":51}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":48}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":53}]},"52":{"id":52,"speaker":"Taddeus Azaro","isPlayerChoice":false,"text":"\"A republic? You mean to abolish the monarchy?\"","conditionsRaw":"((Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false) and (Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":47}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":54},{"convId":558,"nodeId":55}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":52}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":56}]},"56":{"id":56,"speaker":"Carlos Robles Azaro","isPlayerChoice":false,"text":"\"A republic? You intend to dismantle the monarchy?\"","conditionsRaw":"((Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false) and ((Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":47}]},"57":{"id":57,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"If you're committed to this course, where does that leave the nobility?\"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":86},{"convId":558,"nodeId":58},{"convId":558,"nodeId":87},{"convId":558,"nodeId":102}]},"58":{"id":58,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That’s why I've brought you here -- to ensure we embrace this change together on the best possible terms.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":68}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":60},{"convId":558,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":63}]},"62":{"id":62,"speaker":"Angelica Sazon","isPlayerChoice":false,"text":"\"The same holds true for House Sazon. I did not tolerate this talk coming from Lucas, and I won't hear it coming from you.\"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":3}]},"63":{"id":63,"speaker":"Leona Sazon","isPlayerChoice":false,"text":"\"The same holds true for House Sazon. We will not stand for such treachery.\"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":3}]},"64":{"id":64,"speaker":"Leona Sazon","isPlayerChoice":false,"text":"\"If you intend to follow through with this, where does that leave the nobility?\"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":86},{"convId":558,"nodeId":58},{"convId":558,"nodeId":87},{"convId":558,"nodeId":102}]},"65":{"id":65,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":66},{"convId":558,"nodeId":67}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":57}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Angelica\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Angelica","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":64}]},"68":{"id":68,"speaker":"Taddeus Azaro","isPlayerChoice":false,"text":"\"You’re declaring open war on us -- a war which you cannot win!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":69}]},"69":{"id":69,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"As head of House Toras -- your own family -- understand this...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":70}]},"70":{"id":70,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You may have the crown, but you do not have us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":59}]},"71":{"id":71,"speaker":"Taddeus Azaro","isPlayerChoice":false,"text":"\"Resistance to what, exactly?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":92}]},"72":{"id":72,"speaker":"Narrator","isPlayerChoice":false,"text":"There was a tense silence followed by uneasy glances.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":71}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"The nobles exchange confused looks.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":74}]},"74":{"id":74,"speaker":"Taddeus Azaro","isPlayerChoice":false,"text":"\"Come to what, exactly?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":75}]},"75":{"id":75,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"What is this about, Your Majesty?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":92}]},"76":{"id":76,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You people have taken Rizia for granted.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":78},{"convId":558,"nodeId":89},{"convId":558,"nodeId":17}]},"77":{"id":77,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Rizia is burdened by the weight of its history. She deserves a future unshackled from the past.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":78},{"convId":558,"nodeId":89},{"convId":558,"nodeId":17}]},"78":{"id":78,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"While the Crown has shouldered the cost of your greed and apathy, you grew fat on the very people you were meant to serve.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":103},{"convId":558,"nodeId":88},{"convId":558,"nodeId":80}]},"79":{"id":79,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"But you have failed to protect what was entrusted to you, and now the kingdom teeters on the edge of destruction.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":91},{"convId":558,"nodeId":81},{"convId":558,"nodeId":19},{"convId":558,"nodeId":82}]},"80":{"id":80,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I see no heirs to this legacy, only scavengers circling a dying institution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":91},{"convId":558,"nodeId":81},{"convId":558,"nodeId":19},{"convId":558,"nodeId":82}]},"81":{"id":81,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"For it is you who are the engineers of Rizia's demise.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":125}]},"82":{"id":82,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The world has outgrown kings, and I refuse to be a relic hopelessly tied to a fading throne.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":125}]},"83":{"id":83,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It’s time for the Crown to fall, so Rizia may rise.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":94}]},"84":{"id":84,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You know, I'm going to remember this moment... the moment when the winds of democracy swept through the land and Rizia's nobles became footnotes in history.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":46}]},"85":{"id":85,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Oh, who am I kidding. Speeches are useless. You'll never support Rizia's transformation into a republic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":46}]},"86":{"id":86,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It leaves you free of your obligations to the Crown.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":68}]},"87":{"id":87,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Exactly where you deserve to be --without the power you never earned.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":68}]},"88":{"id":88,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You have failed to protect what was entrusted, and now the kingdom teeters on the edge of destruction.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":91},{"convId":558,"nodeId":81},{"convId":558,"nodeId":19},{"convId":558,"nodeId":82}]},"89":{"id":89,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Crown may have guided us through war and famine, but those victories now rest on forgotten laurels.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":88},{"convId":558,"nodeId":80},{"convId":558,"nodeId":19},{"convId":558,"nodeId":82}]},"90":{"id":90,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"But I see no heirs to this legacy, only scavengers circling a dying institution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":91},{"convId":558,"nodeId":19},{"convId":558,"nodeId":82}]},"91":{"id":91,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The throne has become a symbol of frailty, not strength.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":125}]},"92":{"id":92,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":76},{"convId":558,"nodeId":16},{"convId":558,"nodeId":77}]},"93":{"id":93,"speaker":"Lucita Azaro","isPlayerChoice":false,"text":"\"You mean to dismantle the monarchy?\"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":47}]},"94":{"id":94,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":95},{"convId":558,"nodeId":96}]},"95":{"id":95,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":93}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":98}]},"97":{"id":97,"speaker":"Taddeus Azaro","isPlayerChoice":false,"text":"\"You mean to abolish the monarchy?\"","conditionsRaw":"((Variable[\"RiziaDLC.BirthdayGathering_Invited_Lucita\"] == true) == false) and (Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true)","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_Invited_Lucita","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_Invited_Carlos","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":47}]},"98":{"id":98,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":558,"nodeId":99},{"convId":558,"nodeId":100}]},"99":{"id":99,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_Invited_Carlos\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGather