{"conversationId":33,"title":"Sordland/Turn03/A_AutocratDecree","storyPack":"StoryPack_Main","turn":3,"turnLabel":"Turn 3","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":1}]},"1":{"id":1,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":10}]},"2":{"id":2,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Good morning, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":34}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"They placed the draft for the Emergency act in front of me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":39}]},"5":{"id":5,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It's because Mr. Ricter made it known that our administration is blocking the reforms. Many are protesting against that now too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":35}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"Not long after, Orso and Lucian arrived.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":7},{"convId":33,"nodeId":8},{"convId":33,"nodeId":18}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"“Greetings.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":3}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"“Finally, you're here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":3}]},"9":{"id":9,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"Understood, sir. I'll take your coat now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":14}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"I was walking to my office. Today was the day to finally write the Emergency Act and order the execution of the decree.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":36}]},"11":{"id":11,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"Fine, thank you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":31}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"Talks with the leading figures of the Old Guards were fruitful and the preparation for the emergency was already underway.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn03_LT_BenfiFestival","op":"=","value":"true"}],"outgoingIds":[{"convId":33,"nodeId":15}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"“I feel better now that I've seen you, Livia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":30}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"Livia left to hang up my coat. I walked into my office and sat down.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":6}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"I walked in the marble corridors of the Palace, thinking about the huge decisions I was going to make.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":17}]},"16":{"id":16,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"I'm sorry to hear that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":37}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"My secretary greeted me at the entrance to my presidential office.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":19}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“Good morning everybody.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":3}]},"19":{"id":19,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"Good morning, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":24},{"convId":33,"nodeId":23}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"“I'm just fine.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":29}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“I'm about to make stressful decisions. So, not feeling that great.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":16}]},"22":{"id":22,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"Thank you, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":37}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"\"How are you today?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":11}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"“Good morning, Livia.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":32}]},"25":{"id":25,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"Whatever you say, sir. I'll take your coat now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":14}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"\"You're right, sweetheart. It isn't your place.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":9}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"\"You may be right. But I just don't see any other way out of this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":25}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“I'm your boss, Livia. Don't question my decisions.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":25}]},"29":{"id":29,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"That's good to hear.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":37}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"She averted her eyes away from me and smiled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":22}]},"31":{"id":31,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"More importantly, how are you, sir?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":20},{"convId":33,"nodeId":21},{"convId":33,"nodeId":13}]},"32":{"id":32,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"How are you today, sir?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":20},{"convId":33,"nodeId":21},{"convId":33,"nodeId":13}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"After carefully examining the draft and my own notes, I buried myself in the papers.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn03_A_Pre_Constitution","op":"=","value":"true"}],"outgoingIds":[{"convId":33,"nodeId":40}]},"34":{"id":34,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"It's time to start the emergency period. The situation on the streets got worse after we last met.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":5}]},"35":{"id":35,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"\"Regardless of who they are or what they support, the situation is clear. Let's see how we'll proceed with the President's decree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":4}]},"36":{"id":36,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn03_LT_BenfiFestival","op":"=","value":"true"}],"outgoingIds":[{"convId":33,"nodeId":12}]},"37":{"id":37,"speaker":"Narrator","isPlayerChoice":false,"text":"She paused before taking my coat. It looked like she had something on her mind.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":38}]},"38":{"id":38,"speaker":"Livia Suno","isPlayerChoice":false,"text":"\"Mr. Rayne, it may not be my place to say this, but I'm wondering about your reasoning behind this emergency act. The people want reforms, and delaying them will only lead to more violence.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":26},{"convId":33,"nodeId":27},{"convId":33,"nodeId":28}]},"39":{"id":39,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn03_A_Pre_Constitution","op":"=","value":"true"}],"outgoingIds":[{"convId":33,"nodeId":33}]},"40":{"id":40,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":34,"nodeId":1}]},"41":{"id":41,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":33,"nodeId":2}]},"42":{"id":42,"speaker":"Orso Hawker","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.News_Turn03_E_EPA_PotentialsAnalysis","op":"=","value":"true"}],"outgoingIds":[{"convId":33,"nodeId":41}]}}}