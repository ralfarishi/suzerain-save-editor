{"conversationId":383,"title":"Rizia/Turn 7/Energy Partnership Friendly","storyPack":"StoryPack_Rizia","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":91}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":377,"nodeId":575}]},"3":{"id":3,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"In fact, I was hoping to speak with you about an energy partnership.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false) and ((Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true) == false) and ((Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false)","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":4}]},"4":{"id":4,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I hear you are constructing a pipeline between Rizia and Morella. Can it be extended to my country?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":5},{"convId":383,"nodeId":14},{"convId":383,"nodeId":15},{"convId":383,"nodeId":61}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I doubt that Morella would allow such an extension given your history.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":7}]},"6":{"id":6,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're right. We shouldn't be getting too far ahead of ourselves.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":79}]},"7":{"id":7,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"It is not Derdia's fault that we are cruelly barred from our ancestral places of worship.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":24}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Perfect. Derdia, Rizia and Morella will stand strong against the CSP's overreach.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_CommieKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":78}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":10},{"convId":383,"nodeId":11}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":12}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Pales_War\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We're at war. Our ships could get targeted.\"","conditionsRaw":"Variable[\"RiziaDLC.Pales_War\"] == true","variablesRead":[{"var":"RiziaDLC.Pales_War","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":60}]},"13":{"id":13,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You do not want to extend your pipeline from Morella. But perhaps you would still be willing to ship us oil or gas across the Gulf of Moridia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":55},{"convId":383,"nodeId":9},{"convId":383,"nodeId":58},{"convId":383,"nodeId":59}]},"14":{"id":14,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"It depends on whether you are able to make peace with the Morellan prime minister.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":41}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"An interesting possibility. I will consider it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":16}]},"16":{"id":16,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I recognize that this would require closer cooperation with Morella.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":24}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":18},{"convId":383,"nodeId":19}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":22}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":33}]},"20":{"id":20,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I have not given up hope that we may form an energy partnership.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false) and (Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true) and ((Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false)","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":13}]},"21":{"id":21,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"In fact, I was hoping to speak with you about an energy partnership.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true) == false) and (Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false)","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":28}]},"22":{"id":22,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"The pipeline you have promised is a good start.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Economy_DerdiaPipeline_Project\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":29}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Perfect. Derdia, Rizia and Morella will stand strong together against Arcasian imperialism.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_CommieKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":78}]},"24":{"id":24,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But for a chance at energy security, I am willing to face the devil herself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":42}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":26},{"convId":383,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_CommieKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":23}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_CommieKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_CommieKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":8}]},"28":{"id":28,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I hear you have sold oil and gas to other Merkopan countries. Perhaps you would be willing to ship it to us across the Gulf of Moridia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":55},{"convId":383,"nodeId":9},{"convId":383,"nodeId":58},{"convId":383,"nodeId":59}]},"29":{"id":29,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Once energy is flowing from Rizia to Derdia, we can begin to talk about further cooperation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":6},{"convId":383,"nodeId":84},{"convId":383,"nodeId":25}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":31},{"convId":383,"nodeId":32}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":20}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn07_DerdiaRequests_Morella","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":3}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":34},{"convId":383,"nodeId":35}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":21}]},"35":{"id":35,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Morella","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":30}]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We would be, if we had any energy to sell you.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 2","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":83}]},"37":{"id":37,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am afraid not. We barely have enough energy to meet Morella's needs, let alone Derdia's.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 1","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":64}]},"38":{"id":38,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"I agree to extend the pipeline. But you must be ready to stop your disgraceful border violations.\" [-2 Energy For +4 Budget Per Turn, -2 Budget Per Turn For Pipeline]","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] > 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":65}]},"39":{"id":39,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"Excellent. We will begin the pipeline, and our three nations will begin a new era of peace and cooperation.\" [-2 Energy For +4 Budget Per Turn, -2 Budget Per Turn For Pipeline]","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] > 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":71}]},"40":{"id":40,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"My answer is no. You will have to come up with another energy solution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":72}]},"41":{"id":41,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Peace? Her country discarded that chance when it closed its borders to us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":24}]},"42":{"id":42,"speaker":"Narrator","isPlayerChoice":false,"text":"Sal smiled faintly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":43}]},"43":{"id":43,"speaker":"Sal Ignacius","isPlayerChoice":false,"text":"\"Ignoring your religious ideals for the sake of earthly riches. Your true colors are showing, Supreme Wiseman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":73},{"convId":383,"nodeId":74},{"convId":383,"nodeId":44},{"convId":383,"nodeId":67}]},"44":{"id":44,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I wouldn't call energy 'riches'. It is a basic need.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":48}]},"45":{"id":45,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Remember Wruhec's words, Sal. Do not reach for the stars above your head before tending to the soil beneath your feet.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":47}]},"46":{"id":46,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Precisely.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":383,"nodeId":54}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] + 1"}],"outgoingIds":[{"convId":383,"nodeId":46}]},"48":{"id":48,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Precisely. We cannot honor God if we cannot keep the lights on at our sanctuaries.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":54}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Energy_Modifier_DerdiaEnergyExport","op":"=","value":"-2"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"3"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_EnergyDealShipping","op":"=","value":"true"},{"var":"RiziaDLC.Derdia_EnergyShippingAgreement","op":"=","value":"true"}],"outgoingIds":[{"convId":383,"nodeId":51}]},"50":{"id":50,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"That's too bad, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":96}]},"51":{"id":51,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Thank you, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"},{"var":"RiziaDLC.Energy_Modifier_DerdiaEnergyExport","op":"=","value":"-2"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"3"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_EnergyDealShipping","op":"=","value":"true"},{"var":"RiziaDLC.Derdia_EnergyShippingAgreement","op":"=","value":"true"}],"outgoingIds":[{"convId":383,"nodeId":70}]},"52":{"id":52,"speaker":"Player_Romus","isPlayerChoice":true,"text":"\"All right. An energy agreement it is.\" [-2 Energy Per Turn, +3 Budget Per Turn]","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":49}]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Nevertheless, I would rather not make an energy deal at this time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":50}]},"54":{"id":54,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"It is your energy, Your Majesty. And your decision.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":111},{"convId":383,"nodeId":40}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":56},{"convId":383,"nodeId":57}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 2","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":36}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":82}]},"58":{"id":58,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Wouldn't it be easier for you to buy oil from Wehlen?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":81}]},"59":{"id":59,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"To be frank, we need your diplomatic support more than we need you to buy our energy.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 1) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":76}]},"60":{"id":60,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"The Gulf is far north of your front, is it not? Shipping has not been disrupted so far.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":89}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":62},{"convId":383,"nodeId":63}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Energy\"] < 1","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":37}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 1) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":59}]},"64":{"id":64,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Ah. A shame.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":96}]},"65":{"id":65,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Only if she is ready to admit that she has wronged us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":110}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Turn07_Diplomacy_Derdia_EnableSaltanaMeeting","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn07_Derdia_FavorsDone","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn07_Derdia_FavorsDone\"] + 1"}],"outgoingIds":[{"convId":383,"nodeId":2}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":68},{"convId":383,"nodeId":69}]},"68":{"id":68,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":45}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"70":{"id":70,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Our great Nurist republic will endeavor to support you diplomatically as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":98},{"convId":383,"nodeId":99},{"convId":383,"nodeId":100},{"convId":383,"nodeId":101}]},"71":{"id":71,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You're very optimistic. But I would not count on Morella to offer either of those to us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":110}]},"72":{"id":72,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"That's unfortunate, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":96}]},"73":{"id":73,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He is only trying to provide for his people, Grand Wiseman. Just as I am doing in Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":86}]},"74":{"id":74,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Indeed, Azmal. You cannot have it both ways.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":75}]},"75":{"id":75,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"You asked me about closer ties, Your Majesty. This is my answer.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":54}]},"76":{"id":76,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Diplomatic support from a country with rolling blackouts. I'm not sure how much that's worth, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":94}]},"77":{"id":77,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"When two like souls converge, the Divine smiles upon them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":89}]},"78":{"id":78,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Both superpowers are equally repugnant to me, Your Majesty. All I wish is for both of them to leave Derdia alone.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":93}]},"79":{"id":79,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Still, I see much potential.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":97}]},"80":{"id":80,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"'United' is not the word for it. But if Rizia wishes for us to keep the peace, we shall.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":97}]},"81":{"id":81,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Wehlen? Your Majesty, Wiktor Smolak's persecution of Golcondists makes Morella's border controls seem gentle.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":88}]},"82":{"id":82,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That's exactly the kind of strengthened ties I was thinking of, Supreme Wiseman.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Energy\"] < 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Energy","op":"<","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":77}]},"83":{"id":83,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Ah. So I heard wrong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":87}]},"84":{"id":84,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Empire of Moridia, united once more. It warms my heart.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":80}]},"85":{"id":85,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":383,"nodeId":90}]},"86":{"id":86,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Yes, we cannot be expected to carry out our religious duties without heat or electricity.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":54}]},"87":{"id":87,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We ourselves have implemented rolling blackouts recently.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":95}]},"88":{"id":88,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"He will not even grant our pilgrims passage through his country to the holy Archsanctuary of Deyr. And you think he will trade with us?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":85}]},"89":{"id":89,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Think about it. Once your Zille harbor is recovered, the distance between our ports will be practically nothing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":52},{"convId":383,"nodeId":53}]},"90":{"id":90,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"It will be easier to trade with Rizia once your Zille harbor is recovered from that madman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":383,"nodeId":52},{"convId":383,"nodeId":53}]},"91":{"id":91,"speaker":"Narrator","isPlayerChoice":false,"text":"Azmal's eyes lit up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":92}]},"92":{"id":92,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"I would welcome the chance for Derdia to grow closer to our Rizian brothers.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":17}]},"93":{"id":93,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But as long as you continue to support Golcondists, we will endeavor to support you in whatever matters we can.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":98},{"convId":383,"nodeId":99},{"convId":383,"nodeId":100},{"convId":383,"nodeId":101}]},"94":{"id":94,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"But we will endeavor to support you however we can.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":98},{"convId":383,"nodeId":99},{"convId":383,"nodeId":100}]},"95":{"id":95,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We may not be able to help each other with our energy needs. But you will have our support in other matters.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":98},{"convId":383,"nodeId":99},{"convId":383,"nodeId":100}]},"96":{"id":96,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Regardless, we will do our best to support you in other matters if that is what you desire.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":98},{"convId":383,"nodeId":100}]},"97":{"id":97,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"As long as you do not succumb to the Morellans' influence, we will endeavor to support you in whatever matters we can.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":98},{"convId":383,"nodeId":99},{"convId":383,"nodeId":100},{"convId":383,"nodeId":101}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"May St. Wruhec bless our bond.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":106}]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will hold you to those words, Supreme Wiseman.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":107}]},"100":{"id":100,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You need not be outspoken in your support. Behind the scenes is fine.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":102}]},"101":{"id":101,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"An energy partnership is enough for now, I think.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":104}]},"102":{"id":102,"speaker":"Narrator","isPlayerChoice":false,"text":"Azmal looked somewhat wounded.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":108}]},"103":{"id":103,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"If you do not wish to be associated with Derdia, we will stay in the shadows.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":383,"nodeId":2}]},"104":{"id":104,"speaker":"Narrator","isPlayerChoice":false,"text":"Azmal nodded slowly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":105}]},"105":{"id":105,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"We will see where it takes us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":2}]},"106":{"id":106,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"From now through eternity.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":109}]},"107":{"id":107,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"From my lips to God's ears.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":109}]},"108":{"id":108,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Diplomacy_Derdia_NegotiatingPower","op":"=","value":"Variable[\"RiziaDLC.Diplomacy_Derdia_NegotiatingPower\"] - 1"}],"outgoingIds":[{"convId":383,"nodeId":103}]},"109":{"id":109,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.CountryRelation_Derdia_Friendly","op":"=","value":"true"}],"outgoingIds":[{"convId":383,"nodeId":2}]},"110":{"id":110,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Policy_Economy_DerdiaPipeline_Project","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn07_Derdia_EnergyAgreement","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn07_Derdia_PipelineExtension","op":"=","value":"true"},{"var":"RiziaDLC.Policy_Diplomacy_TradeDeal_Derdia","op":"=","value":"true"},{"var":"RiziaDLC.Budget_Modifier_DerdiaTrade","op":"=","value":"4"}],"outgoingIds":[{"convId":383,"nodeId":66}]},"111":{"id":111,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":112},{"convId":383,"nodeId":113}]},"112":{"id":112,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] > 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":38},{"convId":383,"nodeId":39}]},"113":{"id":113,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] > 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":114}]},"114":{"id":114,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Sorry. But it's out of the realm of possibility for us at the moment.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] > 2  or  Variable[\"RiziaDLC.Resources_BudgetModifiersTotal\"] >= 2) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":">","value":"2"},{"var":"RiziaDLC.Resources_BudgetModifiersTotal","op":">=","value":"2"}],"variablesModified":[],"outgoingIds":[{"convId":383,"nodeId":72}]}}}