s_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":17}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"\"I disagree. We have much in common with Mr. Ricter. An alliance with them is beneficial for our party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":60}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"\"You need to respect my decision. It is a done deal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":46}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":24},{"convId":118,"nodeId":25}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":46}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":54}]},"26":{"id":26,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"\"I do, Mr. President. And it's not just a concern, I am completely against any idea about an alliance with the NFP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":30}]},"27":{"id":27,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"I was against the idea of cooperating with Mr. Ricter from the beginning. I think you are pushing our party too far.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":41}]},"28":{"id":28,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"He is a rising figure in politics. Using his influence would not be bad. Let's not forget that they are still a much smaller party than us. We would be the big partner in this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":79},{"convId":118,"nodeId":80},{"convId":118,"nodeId":81}]},"29":{"id":29,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"I disagree with Mrs. Walda. We have common values with the NFP.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":28}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":31},{"convId":118,"nodeId":32}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":36}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":55}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't want to hear your opinions. It is a done deal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":23}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"Ciara clenched her jaw and stood up.","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true) == false","vari