.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":59}]},"55":{"id":55,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"\"Did they even help you achieve your goals with your constitutional amendments?\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":63}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":57},{"convId":118,"nodeId":58}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":16}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":39}]},"59":{"id":59,"speaker":"Narrator","isPlayerChoice":false,"text":"She took hear seat. Iosef cut in.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":29}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":61},{"convId":118,"nodeId":62}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Democratic\"] >= 7","variablesRead":[{"var":"BaseGame.Democratic","op":">=","value":"7"}],"variablesModifi