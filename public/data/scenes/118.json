sef nodded in agreement.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":22},{"convId":118,"nodeId":21},{"convId":118,"nodeId":15}]},"42":{"id":42,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"\"I cannot let this party be corrupted further.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":7},{"convId":118,"nodeId":44},{"convId":118,"nodeId":43}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"\"I came here to change this party. I need the opposition's help.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":67}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"\"I disagree. We have much in common with Mr. Kibener. An alliance with them is beneficial for our party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":75}]},"45":{"id":45,"speaker":"Narrator","isPlayerChoice":false,"text":"Lileas clenched her jaw and stood up.","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":64}]},"46":{"id":46,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"Good to know.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":40}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":48},{"convId":118,"nodeId":49}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Fre