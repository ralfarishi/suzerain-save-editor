null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":73},{"convId":118,"nodeId":74},{"convId":118,"nodeId":72}]},"70":{"id":70,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"Let's not forget that this party was founded on the ideals of Sollism. We have nothing in common with Anti-Sollist liberals.\"","conditionsRaw":"Variable[\"BaseGame.Democratic\"] >= 7","variablesRead":[{"var":"BaseGame.Democratic","op":">=","value":"7"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":69}]},"71":{"id":71,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"Do we really? I think this is more of a political manoeuvre, Mr. President. We have nothing in common with Anti-Sollist liberals.\"","conditionsRaw":"(Variable[\"BaseGame.Democratic\"] >= 7) == false","variablesRead":[{"var":"BaseGame.Democratic","op":">=","value":"7"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":69}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"\"You have valid concerns, Mrs. Graf. I am open to reconsider my decision.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":93}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"\"I appreciate your opinion. But the alliance is going to happen.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":40}]},"74":{"id":74,"speaker":"Player","isPlayerChoice":true,"text":"\"I have heard enough. The deal is a done deal. Let's move on.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":40}]},"75":{"id":75,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":76},{"convId":118,"nodeId":77}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Malenyevi