{"conversationId":118,"title":"Sordland/Turn07/AnnounceAlliance","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":4}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":117,"nodeId":21}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Ciara stood up.","conditionsRaw":"(Variable[\"BaseGame.Relations_Frens_Promise_Alliance\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Frens_Promise_Alliance","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":26}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"Some people looked at me questioningly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":38},{"convId":118,"nodeId":6}]},"5":{"id":5,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"\"We have cooperated with them enough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":42}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"\"Does anybody have any concerns about this decision?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":8}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"\"You need to respect my decision. It is a done deal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":118,"nodeId":50}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":fals