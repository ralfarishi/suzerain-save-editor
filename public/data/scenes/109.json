{"conversationId":109,"title":"Sordland/Turn07/NiaDialogue02_Personal","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":9}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":33}]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"\"So... let's just move on to our plan with Isabel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":195}]},"4":{"id":4,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Thank you. That means a lot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":52},{"convId":109,"nodeId":140}]},"5":{"id":5,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Hmm... \"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":184}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"\"But seriously, I want to know more about you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":160}]},"7":{"id":7,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked at me with surprise.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":188}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's talk about you a little.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":54}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"Nia took a sip from her glass of water and looked at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":3},{"convId":109,"nodeId":8},{"convId":109,"nodeId":10},{"convId":109,"nodeId":11}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"\"Do you think we'll succeed?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":14}]},"11":{"id":11,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Stay silent.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":35}]},"12":{"id":12,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Do you really think we're a strong team though?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":153},{"convId":109,"nodeId":155},{"convId":109,"nodeId":159},{"convId":109,"nodeId":140}]},"13":{"id":13,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Yes. I believe we are in a good position now. The anti-corruption force helped a lot.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":19}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":15},{"convId":109,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":13}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":17}]},"17":{"id":17,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'd like to hope so, yes.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":23}]},"18":{"id":18,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Do you really think so?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":153},{"convId":109,"nodeId":155},{"convId":109,"nodeId":159},{"convId":109,"nodeId":140}]},"19":{"id":19,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We only need either Isabel's or Heron's vote.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":22}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"\"Where is Isabel? I don't like waiting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":41}]},"21":{"id":21,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Come on, Mr. President. Don't overthink this. We just need to focus on Isabel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":27}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"She smiled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":21}]},"23":{"id":23,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"We might need to get both Isabel and Heron to work with us. I don't want to rely on Isabel to bring exactly three votes. It's risky.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":29}]},"24":{"id":24,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Anyway... I think Isabel is going to be here very soon. Maybe we should return back to the topic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":2}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":3},{"convId":109,"nodeId":8},{"convId":109,"nodeId":57},{"convId":109,"nodeId":11}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"\"Anyway, let's talk about what we'll do with Isabel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":37}]},"27":{"id":27,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But anyway...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":32}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't think they are what they used to be. It changed a lot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":122}]},"29":{"id":29,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Let's not overthink this though, Mr. President. We have to focus on the meeting with Isabel now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":27}]},"30":{"id":30,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Very funny, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":184}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"\"Hmm. I used to be part of the Red Youth during my university years.\"","conditionsRaw":"Variable[\"BaseGame.Prologue_University_Political_Socialist\"] == true","variablesRead":[{"var":"BaseGame.Prologue_University_Political_Socialist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":111}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"She took another sip from her glass.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":33}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":25}]},"34":{"id":34,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Well...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":59}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"She didn't say anything and leaned over to look out the window.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":3},{"convId":109,"nodeId":8},{"convId":109,"nodeId":38}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"\"Hmm. I used to be part of the Young Sords during my university years.\"","conditionsRaw":"Variable[\"BaseGame.Prologue_University_Political_Nationalist\"] == true","variablesRead":[{"var":"BaseGame.Prologue_University_Political_Nationalist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":113}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":46}]},"38":{"id":38,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Keep staying silent.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":40}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"\"You and I. We are a strong team Nia. We will succeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":12}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"She watched the beautiful sunset from the window. Then she brought her eyes back to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":3},{"convId":109,"nodeId":8},{"convId":109,"nodeId":43},{"convId":109,"nodeId":45}]},"41":{"id":41,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm sure she'll be here shortly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":37}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"Alphonso was just a rich businessman. I couldn't trust him.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":24}]},"43":{"id":43,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Look at her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":47}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"\"I didn't support Alphonso's free market policies.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Economy_PromoteMarket\"] == true","variablesRead":[{"var":"BaseGame.Policy_Economy_PromoteMarket","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":24}]},"45":{"id":45,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Watch the sunset.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":50}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"\"Soll wasn't that bad.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":24}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"She smiled at me, then averted her gaze.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":48}]},"48":{"id":48,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"So...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":8},{"convId":109,"nodeId":57},{"convId":109,"nodeId":168}]},"49":{"id":49,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"This was always what I've worked towards. Nothing has changed one bit.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":127},{"convId":109,"nodeId":129},{"convId":109,"nodeId":131}]},"50":{"id":50,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"So...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":8},{"convId":109,"nodeId":57},{"convId":109,"nodeId":168}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"\"They became a militant extremist group that threatens Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":148}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":26},{"convId":109,"nodeId":20}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"\"You and I. We are a strong team Nia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":18}]},"54":{"id":54,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Me?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":62},{"convId":109,"nodeId":56},{"convId":109,"nodeId":58},{"convId":109,"nodeId":60}]},"55":{"id":55,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Well yes, that's the same for me too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":184}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. How have you been holding up these rough days?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":76}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"\"So... How about you? How have you been holding up?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":76}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"\"Is everything fine with you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":76}]},"59":{"id":59,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"How about you tell me something first?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":105},{"convId":109,"nodeId":109},{"convId":109,"nodeId":99},{"convId":109,"nodeId":87},{"convId":109,"nodeId":71}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm disappointed that you couldn't get the Court for me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":66}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"\"Honestly, I still support their cause.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":191}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. I want to know more about you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":78}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":64},{"convId":109,"nodeId":65}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Economy_PromoteMarket\"] == true","variablesRead":[{"var":"BaseGame.Policy_Economy_PromoteMarket","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":44}]},"65":{"id":65,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Economy_PromoteMarket\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Economy_PromoteMarket","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"66":{"id":66,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I thought you were aware about the situation in the Court.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":68}]},"67":{"id":67,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"It's fine, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":59}]},"68":{"id":68,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I already have two Justices working with me. The court is dominated by Orso's crew so there's not much room to work with.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":70}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"She frowned at me first and then smiled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":30}]},"70":{"id":70,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Also, let's not forget that I persuaded Isabel into meeting with you, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":74}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":72},{"convId":109,"nodeId":73}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_University_Political_Nationalist\"] == true","variablesRead":[{"var":"BaseGame.Prologue_University_Political_Nationalist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":36}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_University_Political_Nationalist\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_University_Political_Nationalist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"74":{"id":74,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But anyway, she'll be here soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":126}]},"75":{"id":75,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"So you really did support Tarquin Soll...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":46},{"convId":109,"nodeId":63},{"convId":109,"nodeId":42}]},"76":{"id":76,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm fine, Mr. President. Thanks for asking.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":80}]},"77":{"id":77,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"So you really did support Tarquin Soll...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":46},{"convId":109,"nodeId":63},{"convId":109,"nodeId":42}]},"78":{"id":78,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"What do you want to know?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":117},{"convId":109,"nodeId":119},{"convId":109,"nodeId":121}]},"79":{"id":79,"speaker":"Narrator","isPlayerChoice":false,"text":"She was not at all impressed with my reply.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":24}]},"80":{"id":80,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm just focused on our proposal. If it passes the Supreme Court, this will be a historical moment for Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":82}]},"81":{"id":81,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I see...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":79}]},"82":{"id":82,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I just... don't want to see another failure trying to change this Constitution anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":86},{"convId":109,"nodeId":90},{"convId":109,"nodeId":84},{"convId":109,"nodeId":92}]},"83":{"id":83,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I had the exact same belief. He proved us wrong very quickly though.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":24}]},"84":{"id":84,"speaker":"Player","isPlayerChoice":true,"text":"\"It's not the end of the world if it doesn't go through.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":94}]},"85":{"id":85,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"That's true. He was the only option for sure.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":24}]},"86":{"id":86,"speaker":"Player","isPlayerChoice":true,"text":"\"That's why we can't become another Alphonso administration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":108}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":88},{"convId":109,"nodeId":89}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_University_Political_Socialist\"] == true","variablesRead":[{"var":"BaseGame.Prologue_University_Political_Socialist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":31}]},"89":{"id":89,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_University_Political_Socialist\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_University_Political_Socialist","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"90":{"id":90,"speaker":"Player","isPlayerChoice":true,"text":"\"Me neither, Mrs. Morgna. We have to make sure we succeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":98}]},"91":{"id":91,"speaker":"Narrator","isPlayerChoice":false,"text":"She was not at all impressed with my reply.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":24}]},"92":{"id":92,"speaker":"Player","isPlayerChoice":true,"text":"\"Don't let your emotions get in the way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":97}]},"93":{"id":93,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I see...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":91}]},"94":{"id":94,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Great motivational speech, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":96}]},"95":{"id":95,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Thank you, Mr. President. I respect your ideals too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":53},{"convId":109,"nodeId":52},{"convId":109,"nodeId":140}]},"96":{"id":96,"speaker":"Narrator","isPlayerChoice":false,"text":"She let out a short laugh followed by a sigh.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":52}]},"97":{"id":97,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Of course, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":52}]},"98":{"id":98,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I've done my best so far, Mr. President. It's up to you now to persuade Isabel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":100}]},"99":{"id":99,"speaker":"Player","isPlayerChoice":true,"text":"\"There is not much to tell. I am a pretty regular man outside politics.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":55}]},"100":{"id":100,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":101},{"convId":109,"nodeId":102}]},"101":{"id":101,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":104}]},"102":{"id":102,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":106}]},"103":{"id":103,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":46}]},"104":{"id":104,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"She's the last remaining piece of the puzzle. We are close to finalizing it but that idea alone is enough to make me a little stressed.\"","conditionsRaw":"Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":52},{"convId":109,"nodeId":189}]},"105":{"id":105,"speaker":"Player","isPlayerChoice":true,"text":"\"What do you want to know?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":5}]},"106":{"id":106,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm slightly scared that Isabel's help might not be enough. That we might need Heron's help one way or another...\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Order_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Order_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":52},{"convId":109,"nodeId":189}]},"107":{"id":107,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"What do you think about them now?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":192},{"convId":109,"nodeId":194},{"convId":109,"nodeId":158}]},"108":{"id":108,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You're exactly right. I've had my experience with his administration when I worked as a vice minister.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":110}]},"109":{"id":109,"speaker":"Player","isPlayerChoice":true,"text":"\"Did you know that I am one of the top four best presidents of Sordland?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":69}]},"110":{"id":110,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But it was not Alphonso who was to blame. The Old Guard put enormous pressure on him and the Justice Ministry back then.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":112}]},"111":{"id":111,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Oh really?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":186}]},"112":{"id":112,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I guess it's not so different today.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":52},{"convId":109,"nodeId":193},{"convId":109,"nodeId":189}]},"113":{"id":113,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Are you kidding me?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":7}]},"114":{"id":114,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I hope we succeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":52},{"convId":109,"nodeId":39}]},"115":{"id":115,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I don't really know what to say. You already know about my background experience.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":180},{"convId":109,"nodeId":164},{"convId":109,"nodeId":167},{"convId":109,"nodeId":170}]},"116":{"id":116,"speaker":"Player","isPlayerChoice":true,"text":"\"It was obvious that he would win. I saw that as an investment.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":93}]},"117":{"id":117,"speaker":"Player","isPlayerChoice":true,"text":"\"Tell me about your past.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":142}]},"118":{"id":118,"speaker":"Player","isPlayerChoice":true,"text":"\"It was time for Soll to leave. He was the only alternative.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":85}]},"119":{"id":119,"speaker":"Player","isPlayerChoice":true,"text":"\"We usually don't have time to talk alone. I was just interested to know more about you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":154}]},"120":{"id":120,"speaker":"Player","isPlayerChoice":true,"text":"\"At the time, I really believed that Alphonso would do great things.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":83}]},"121":{"id":121,"speaker":"Player","isPlayerChoice":true,"text":"\"What do you aim to achieve?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":123}]},"122":{"id":122,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I agree.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":190}]},"123":{"id":123,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"A fair and transparent justice system for Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":49}]},"124":{"id":124,"speaker":"Narrator","isPlayerChoice":false,"text":"She took another sip from her water.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":115}]},"125":{"id":125,"speaker":"Player","isPlayerChoice":true,"text":"\"We'll do it together.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":182}]},"126":{"id":126,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":46}]},"127":{"id":127,"speaker":"Player","isPlayerChoice":true,"text":"\"I respect that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":135}]},"128":{"id":128,"speaker":"Player","isPlayerChoice":true,"text":"\"At the time, I really wanted him to continue leading the party.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":77}]},"129":{"id":129,"speaker":"Player","isPlayerChoice":true,"text":"\"I meant other than that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":137}]},"130":{"id":130,"speaker":"Player","isPlayerChoice":true,"text":"\"He promised me a seat in his cabinet. I couldn't say no.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":81}]},"131":{"id":131,"speaker":"Player","isPlayerChoice":true,"text":"\"For some reason I'm sceptical about that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":133}]},"132":{"id":132,"speaker":"Player","isPlayerChoice":true,"text":"\"I didn't want Alphonso's leadership.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":75}]},"133":{"id":133,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"What do you mean? Have you seen any hypocrisy from me? I doubt that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":178},{"convId":109,"nodeId":181},{"convId":109,"nodeId":52}]},"134":{"id":134,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Tell me, Mr. President... Why did you vote for Alphonso in the '46 Congress?\"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Party_Congress_Soll\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Party_Congress_Soll","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":116},{"convId":109,"nodeId":118},{"convId":109,"nodeId":120}]},"135":{"id":135,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Thank you, Mr. President. I respect your ideals too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":151},{"convId":109,"nodeId":125},{"convId":109,"nodeId":52}]},"136":{"id":136,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Tell me, Mr. President... Why did you vote for Soll in the '46 Congress?\"","conditionsRaw":"Variable[\"BaseGame.Prologue_Party_Congress_Soll\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Party_Congress_Soll","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":130},{"convId":109,"nodeId":132},{"convId":109,"nodeId":128}]},"137":{"id":137,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Hmm. You mean more personal aims? I might want to settle down at some point in a coastal town like Lachaven. I'd like that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":139}]},"138":{"id":138,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Toppling Soll's Constitution would be the grandest thing that I can achieve. Other dreams will come later.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":176},{"convId":109,"nodeId":125},{"convId":109,"nodeId":52}]},"139":{"id":139,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But I really can't think of anything personal these days. My dream is to see real democracy in Sordland. The republic's history has been pitch black.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":138}]},"140":{"id":140,"speaker":"Player","isPlayerChoice":true,"text":"\"I can achieve anything with a woman like you by my side.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":147}]},"141":{"id":141,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Oh, you're being too nice, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":179}]},"142":{"id":142,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"My past? I thought you've read my biography before you chose me for the cabinet, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":146}]},"143":{"id":143,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":144},{"convId":109,"nodeId":145}]},"144":{"id":144,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Prologue_Party_Congress_Soll\"] == true","variablesRead":[{"var":"BaseGame.Prologue_Party_Congress_Soll","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":136}]},"145":{"id":145,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Prologue_Party_Congress_Soll\"] == true) == false","variablesRead":[{"var":"BaseGame.Prologue_Party_Congress_Soll","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":134}]},"146":{"id":146,"speaker":"Narrator","isPlayerChoice":false,"text":"She let out a short laughter.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":6},{"convId":109,"nodeId":150},{"convId":109,"nodeId":152}]},"147":{"id":147,"speaker":"Narrator","isPlayerChoice":false,"text":"She took a while to respond.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":141}]},"148":{"id":148,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"It is true that they have a militant wing but I wouldn't call them a real threat.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":190}]},"149":{"id":149,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":46}]},"150":{"id":150,"speaker":"Player","isPlayerChoice":true,"text":"\"If you don't want to share, it's okay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":160}]},"151":{"id":151,"speaker":"Player","isPlayerChoice":true,"text":"\"You are a strong woman, Nia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":4}]},"152":{"id":152,"speaker":"Player","isPlayerChoice":true,"text":"\"I guess that's correct.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":160}]},"153":{"id":153,"speaker":"Player","isPlayerChoice":true,"text":"\"Of course. We have done a great deal so far.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":175}]},"154":{"id":154,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Oh, okay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":124}]},"155":{"id":155,"speaker":"Player","isPlayerChoice":true,"text":"\"I couldn't do any of this without you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":175}]},"156":{"id":156,"speaker":"Narrator","isPlayerChoice":false,"text":"She frowned.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":161}]},"157":{"id":157,"speaker":"Narrator","isPlayerChoice":false,"text":"She gave me an inscrutable look.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":143}]},"158":{"id":158,"speaker":"Player","isPlayerChoice":true,"text":"\"They became a militant extremist group that threatens Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":169}]},"159":{"id":159,"speaker":"Player","isPlayerChoice":true,"text":"\"Time will tell.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":162}]},"160":{"id":160,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I mean... I don't really know what to say. You already know about my background experience.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":180},{"convId":109,"nodeId":164},{"convId":109,"nodeId":167},{"convId":109,"nodeId":170}]},"161":{"id":161,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Anyway... Isabel's going to be here any minute.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":149}]},"162":{"id":162,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I guess so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":179}]},"163":{"id":163,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm sure she'll be here shortly.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":165}]},"164":{"id":164,"speaker":"Player","isPlayerChoice":true,"text":"\"That's not what I meant.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":34}]},"165":{"id":165,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":46}]},"166":{"id":166,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But I think it was always a ultranationalist group, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":179}]},"167":{"id":167,"speaker":"Player","isPlayerChoice":true,"text":"\"Anyway, let's talk about what we'll do with Isabel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":103}]},"168":{"id":168,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":171},{"convId":109,"nodeId":173}]},"169":{"id":169,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I think it was always just *that*, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":179}]},"170":{"id":170,"speaker":"Player","isPlayerChoice":true,"text":"\"It's okay, I didn't want to put you on the spot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":67}]},"171":{"id":171,"speaker":"Player","isPlayerChoice":true,"text":"\"Anyway, let's talk about what we'll do with Isabel.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":165}]},"172":{"id":172,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Well, I guess that's true.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":166}]},"173":{"id":173,"speaker":"Player","isPlayerChoice":true,"text":"\"Where is Isabel? I don't like waiting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":163}]},"174":{"id":174,"speaker":"Narrator","isPlayerChoice":false,"text":"She smiled.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":53},{"convId":109,"nodeId":52},{"convId":109,"nodeId":140}]},"175":{"id":175,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Thank you. It really means a lot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":179}]},"176":{"id":176,"speaker":"Player","isPlayerChoice":true,"text":"\"I respect that a lot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":95}]},"177":{"id":177,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You do?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":156}]},"178":{"id":178,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm sorry, you've got me wrong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":183}]},"179":{"id":179,"speaker":"Narrator","isPlayerChoice":false,"text":"Nia took another sip from her glass of water and looked at me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":143}]},"180":{"id":180,"speaker":"Player","isPlayerChoice":true,"text":"\"Come on, Nia. I'm just trying to have a conversation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":34}]},"181":{"id":181,"speaker":"Player","isPlayerChoice":true,"text":"\"The way you said it felt like it was a rehearsed statement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":183}]},"182":{"id":182,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Yes. We will, Mr. President!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":174}]},"183":{"id":183,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Really?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":185}]},"184":{"id":184,"speaker":"Narrator","isPlayerChoice":false,"text":"She took another sip from her glass.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":143}]},"185":{"id":185,"speaker":"Narrator","isPlayerChoice":false,"text":"She was visibly annoyed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":187}]},"186":{"id":186,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"What do you think about them now?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":61},{"convId":109,"nodeId":28},{"convId":109,"nodeId":51}]},"187":{"id":187,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"But anyway, Isabel will be here soon.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":37}]},"188":{"id":188,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I didn't know that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":107}]},"189":{"id":189,"speaker":"Player","isPlayerChoice":true,"text":"\"Don't worry, we've got this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":114}]},"190":{"id":190,"speaker":"Narrator","isPlayerChoice":false,"text":"She took another sip from her glass.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":143}]},"191":{"id":191,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Interesting...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":157}]},"192":{"id":192,"speaker":"Player","isPlayerChoice":true,"text":"\"Honestly, I still support their cause.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":177}]},"193":{"id":193,"speaker":"Player","isPlayerChoice":true,"text":"\"Not really.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":114}]},"194":{"id":194,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't think they are what they used to be. It changed a lot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":109,"nodeId":172}]},"195":{"id":195,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":107,"nodeId":46}]}}}