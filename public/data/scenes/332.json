{"conversationId":332,"title":"Rizia/Turn 10/VinaFuneral","storyPack":"StoryPack_Rizia","turn":10,"turnLabel":"Turn 10","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":140}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"I had done this countless times now. Far too often. My wife, my father, and so many others.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":4}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"But I had never expected that I would have to bury my own daughter.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":81}]},"5":{"id":5,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Make way. Make way for the Princess of Rizia.\"","conditionsRaw":"Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":136}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"As per tradition, Hugo was leading the cortège. Around us were thousands of people, crying for their Princess.","conditionsRaw":"((Variable[\"RiziaDLC.Council_GrandVizier_Hugo\"] == false) == false) and ((Variable[\"RiziaDLC.HouseToras_Conquered\"] == true  or  (Variable[\"RiziaDLC.Reform_Success\"] == true  and  Variable[\"RiziaDLC.BirthdayGathering_ViolentAction\"] == true)) == false)","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Hugo","op":"==","value":"false"},{"var":"RiziaDLC.HouseToras_Conquered","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Success","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_ViolentAction","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":7}]},"7":{"id":7,"speaker":"Narrator","isPlayerChoice":false,"text":"We arrived at the entrance to the National Mausoleum. Hugo stopped and I moved over to the front.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":8}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"He knelt before me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":10}]},"9":{"id":9,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A sword.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":13}]},"10":{"id":10,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"An offering for the Heiress's passage into Golconda, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":9},{"convId":332,"nodeId":11},{"convId":332,"nodeId":12},{"convId":332,"nodeId":14}]},"11":{"id":11,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A rose.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":15}]},"12":{"id":12,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A feather.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":16}]},"13":{"id":13,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The sword is heavy. Sharp and strong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":19}]},"14":{"id":14,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A gold coin.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":17}]},"15":{"id":15,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The rose has thorns. Beautiful and defiant.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":19}]},"16":{"id":16,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The feather is light. Free and flowing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":19}]},"17":{"id":17,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The gold is heart. Generous and gracious.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":19}]},"18":{"id":18,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And so, Vina passes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":20}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to the crowd and held it high. Silence was deafening. His voice roared.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":18}]},"20":{"id":20,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The first of her name. Daughter of Romus I. Daughter of the late Princess Consort Lena. Princess of Rizia. Heir to Valenqiris and the lands of Rizia Imperii.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":68}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"To my left was my mother. Her eyes were still red from crying, but she held her head up high.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":22},{"convId":332,"nodeId":23}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"How are you holding up, Mother?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":24}]},"23":{"id":23,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Stay silent.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":34}]},"24":{"id":24,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Losing Lena, then Vina...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":25}]},"25":{"id":25,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"The women of this family must be cursed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":26}]},"26":{"id":26,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Perhaps it really is my fault. A commoner tainting the Toras bloodline and dooming its heirs.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":132}]},"27":{"id":27,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"You won't die too, will you, darling? I want you to promise me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":29},{"convId":332,"nodeId":30}]},"28":{"id":28,"speaker":"Narrator","isPlayerChoice":false,"text":"She turned to me with a serious look.","conditionsRaw":"(Variable[\"RiziaDLC.Hugo_Arrested\"] == true  or  Variable[\"RiziaDLC.Hugo_Executed\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"true"},{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":27}]},"29":{"id":29,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I promise, mother.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":60}]},"30":{"id":30,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Do not answer.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":31}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"A single tear fell down her cheek.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.VinaFuneral_PromisedEstela_NotToDie","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn10_VinaFuneral_PromisedEstelaNotToDie","op":"=","value":"true"}],"outgoingIds":[{"convId":332,"nodeId":32}]},"32":{"id":32,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"We must... pay our respects.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":33}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"Her voice broke off.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":34}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"She gripped my arm as the flag of Rizia was removed by ceremonial guardsmen, revealing Vina's serene face. There was an undeniable calmness about her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":35}]},"35":{"id":35,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Oh, my dearest Vina.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":36}]},"36":{"id":36,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"What did they do to you? How did we let this happen?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":37}]},"37":{"id":37,"speaker":"Narrator","isPlayerChoice":false,"text":"She stood and went toward Vina as her grief took over.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":39},{"convId":332,"nodeId":111},{"convId":332,"nodeId":38},{"convId":332,"nodeId":40}]},"38":{"id":38,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Let her go.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":62}]},"39":{"id":39,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Quietly gesture for her to return to her seat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":41}]},"40":{"id":40,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Join her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":61}]},"41":{"id":41,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Can't a grandmother say her farewells?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":45}]},"42":{"id":42,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Come back. That's an order.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":43}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"She reluctantly returned to her seat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":46}]},"44":{"id":44,"speaker":"Narrator","isPlayerChoice":false,"text":"Her voice wavered. She didn't sound like her usual self.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":42},{"convId":332,"nodeId":38},{"convId":332,"nodeId":40}]},"45":{"id":45,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"I never said goodbye before she left for Pales. The last thing I told her was to watch her waistline...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":44}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"Several ceremonial guardsmen picked up the sarcophagus lid.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":70}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"She went up alongside Vina's stone encasement and stood for a moment. After whispering a few words, she gripped its sides, as if reluctant to let go.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.VinaFuneral_CoffinFarewell_MotherHerself","op":"=","value":"true"}],"outgoingIds":[{"convId":332,"nodeId":112}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"Hugo allowed her some time before gently guiding her back to her seat.","conditionsRaw":"Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":73}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"She went up alongside Vina's stone encasement.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.VinaFuneral_CoffinFarewell_JoinedMother","op":"=","value":"true"}],"outgoingIds":[{"convId":332,"nodeId":50}]},"50":{"id":50,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Oh, my darling girl. If I was harsh on you, it was because you were my favorite person in the world.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":51}]},"51":{"id":51,"speaker":"Estela Toras","isPlayerChoice":false,"text":"\"Farewell, Your Highness. Your grandmother will love you forever.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":121}]},"52":{"id":52,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Say your final words to Vina.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":54},{"convId":332,"nodeId":55},{"convId":332,"nodeId":56},{"convId":332,"nodeId":57},{"convId":332,"nodeId":58}]},"53":{"id":53,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Return to seat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":46}]},"54":{"id":54,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am sorry.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":59}]},"55":{"id":55,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I love you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":59}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Say hello to your mother for me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":59}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will never forgive myself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":59}]},"58":{"id":58,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will avenge you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":59}]},"59":{"id":59,"speaker":"Narrator","isPlayerChoice":false,"text":"I kissed her on the forehead and went back to my throne.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":46}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.VinaFuneral_PromisedEstela_NotToDie","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn10_VinaFuneral_PromisedEstelaNotToDie","op":"=","value":"true"}],"outgoingIds":[{"convId":332,"nodeId":31}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.VinaFuneral_CoffinFarewell_JoinedMother","op":"=","value":"true"}],"outgoingIds":[{"convId":332,"nodeId":49}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.VinaFuneral_CoffinFarewell_MotherHerself","op":"=","value":"true"}],"outgoingIds":[{"convId":332,"nodeId":72}]},"63":{"id":63,"speaker":"Narrator","isPlayerChoice":false,"text":"A vessel filled with molten gold was presented to me by a guardsman. I was handed protective gloves, allowing me to grip it without harm.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":122}]},"64":{"id":64,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Pour gold over Vina's coffin.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":65}]},"65":{"id":65,"speaker":"Narrator","isPlayerChoice":false,"text":"As I watched the gold solidify, I felt weak. Frail.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":66}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"Just like my father.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":130}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":5}]},"68":{"id":68,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":109}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":21}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":71}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"They walked it toward Vina and carefully lowered it onto its final resting place.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":63}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":47}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":46}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Successor_Hugo","op":"=","value":"true"},{"var":"RiziaDLC.Vina_FuneralHappened","op":"=","value":"true"}],"outgoingIds":[{"convId":332,"nodeId":75}]},"75":{"id":75,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":2}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":3}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":78},{"convId":332,"nodeId":79}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Council_GrandVizier_Hugo\"] == false","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Hugo","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":80}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Council_GrandVizier_Hugo\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Hugo","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":6}]},"80":{"id":80,"speaker":"Narrator","isPlayerChoice":false,"text":"Despite his resignation as Grand Vizier, Hugo had agreed to lead the cortège. Around us were thousands of people, crying for their Princess.","conditionsRaw":"(Variable[\"RiziaDLC.Council_GrandVizier_Hugo\"] == false) and ((Variable[\"RiziaDLC.HouseToras_Conquered\"] == true  or  (Variable[\"RiziaDLC.Reform_Success\"] == true  and  Variable[\"RiziaDLC.BirthdayGathering_ViolentAction\"] == true)) == false)","variablesRead":[{"var":"RiziaDLC.Council_GrandVizier_Hugo","op":"==","value":"false"},{"var":"RiziaDLC.HouseToras_Conquered","op":"==","value":"true"},{"var":"RiziaDLC.Reform_Success","op":"==","value":"true"},{"var":"RiziaDLC.BirthdayGathering_ViolentAction","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":7}]},"81":{"id":81,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":82},{"convId":332,"nodeId":83}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":67}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":101}]},"84":{"id":84,"speaker":"Narrator","isPlayerChoice":false,"text":"It was customary for me, as both her father and the King of Rizia, to present an offering for the Heiress's passage into Golconda.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":85},{"convId":332,"nodeId":86},{"convId":332,"nodeId":87},{"convId":332,"nodeId":88}]},"85":{"id":85,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A sword.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":91}]},"86":{"id":86,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A rose.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":92}]},"87":{"id":87,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A feather.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":93}]},"88":{"id":88,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"A gold coin.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":94}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"Around me were thousands of people, crying for their Princess.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":84}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"It wasn't long before we entered the tomb, where Vina's sarcophagus, draped in the Rizian flag, had been placed next to her mother's. The lid was laid off to the side.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":95}]},"91":{"id":91,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The sword is heavy. Sharp and strong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":96}]},"92":{"id":92,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The rose has thorns. Beautiful and defiant.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":96}]},"93":{"id":93,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The feather is light. Free and flowing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":96}]},"94":{"id":94,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The gold is heart. Generous and gracious.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":96}]},"95":{"id":95,"speaker":"Narrator","isPlayerChoice":false,"text":"Her resting place, like that of all royals, had been prepared early on in life, a precaution for when the inevitable came.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":108}]},"96":{"id":96,"speaker":"Narrator","isPlayerChoice":false,"text":"I held it up for all to see.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":104},{"convId":332,"nodeId":102},{"convId":332,"nodeId":99},{"convId":332,"nodeId":103}]},"97":{"id":97,"speaker":"Narrator","isPlayerChoice":false,"text":"Only a select few were permitted to enter -- immediate family, close relatives, and high-ranking nobility. The rest of the crowd remained outside.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":98}]},"98":{"id":98,"speaker":"Narrator","isPlayerChoice":false,"text":"As we moved through the corridor, a hushed reverence fell over the smaller group, a stark contrast to the swelling voices from beyond the stone walls.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":90}]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"And so, Vina passes. The first of her name. Daughter of Romus I. Daughter of late Queen Lena. Princess of Rizia. Heir to the lands of Rizia Imperii.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":100}]},"100":{"id":100,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd began to collectively pray and chant her name as I went inside the mausoleum.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":97}]},"101":{"id":101,"speaker":"Narrator","isPlayerChoice":false,"text":"With overcast skies above and a light drizzle falling, I arrived at the entrance to the National Mausoleum.","conditionsRaw":"(Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":89}]},"102":{"id":102,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"May this offering guide her to the realms beyond, where her ancestors await. \"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":100}]},"103":{"id":103,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Vina, your journey has ended too soon. May this gift be a token of my love, to accompany you as you cross into the afterlife.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":100}]},"104":{"id":104,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":105},{"convId":332,"nodeId":106}]},"105":{"id":105,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":107}]},"106":{"id":106,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":102}]},"107":{"id":107,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"By the grace of God, may this offering guide you into the next world, where your spirit will rest beside those who came before you.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_ReligiousKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_ReligiousKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":100}]},"108":{"id":108,"speaker":"Narrator","isPlayerChoice":false,"text":"I was glad Lena had not lived to see this day. I knew it would have destroyed her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":110}]},"109":{"id":109,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd began to collectively pray and chant her name as we turned and went inside the mausoleum.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":97}]},"110":{"id":110,"speaker":"Narrator","isPlayerChoice":false,"text":"I sat in one of the empty seats set out for the royal family.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":69}]},"111":{"id":111,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Wait! You must follow protocol.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":41}]},"112":{"id":112,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":113},{"convId":332,"nodeId":114}]},"113":{"id":113,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":48}]},"114":{"id":114,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":115}]},"115":{"id":115,"speaker":"Narrator","isPlayerChoice":false,"text":"The ceremonial guardsmen gave her some time before gently guiding her back to her seat.","conditionsRaw":"(Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false) == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaDLC.Hugo_Arrested","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":73}]},"116":{"id":116,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":332,"nodeId":117},{"convId":332,"nodeId":118}]},"117":{"id":117,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Hugo_Executed\"] == false  and  Variable[\"RiziaDLC.Hugo_Arrested\"] == false","variablesRead":[{"var":"RiziaDLC.Hugo_Executed","op":"==","value":"false"},{"var":"RiziaD