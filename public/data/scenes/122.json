Id":122,"nodeId":112}]},"118":{"id":118,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian stepped up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":119}]},"119":{"id":119,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm already working on it, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":120},{"convId":122,"nodeId":113}]},"120":{"id":120,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you Lucian. Please make sure the whole team is on the same page with us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":124}]},"121":{"id":121,"speaker":"Player","isPlayerChoice":true,"text":"\"I will be using my powers to their limits.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":115}]},"122":{"id":122,"speaker":"Ciara Walda","isPlayerChoice":false,"text":"\"With all due respect, I'm not going to respond to that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":116},{"convId":122,"nodeId":123}]},"123":{"id":123,"speaker":"Player","isPlayerChoice":true,"text":"\"Frankly, I don't care what you think. We have bigger problems here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":116}]},"124":{"id":124,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian nodded. Nobody else responded.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":116}]},"125":{"id":125,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"Yes sir. It is of utmost importance.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":122,"nodeId":127},{"convId":122,"nodeId":128}]},"126":{"id":126,"speaker":"Narrator","isPlayerChoice":false,"text":