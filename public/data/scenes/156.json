Variable[\"BaseGameIsolated.Turn08_FPnT_BrokenTeapot\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn08_FPnT_BrokenTeapot","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":7}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“Have you been drinking?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":20}]},"18":{"id":18,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Don't say anything.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":28}]},"19":{"id":19,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Thank you for your visit.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":130},{"convId":156,"nodeId":129},{"convId":156,"nodeId":128}]},"20":{"id":20,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“A couple of glasses of the finest Lespian wine is the best way to start any meeting.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":22}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“I would recommend you not to badmouth Colonel Soll.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":45}]},"22":{"id":22,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Would you like some?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":23},{"convId":156,"nodeId":25},{"convId":156,"nodeId":27}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"“No, thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":30}]},"24":{"id":24,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I'm afraid I have to leave now to attend to other matters.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":19}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"“Since you asked, why not?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":31}]},"26":{"id":26,"speaker":"Narrator","isPlayerChoice":false,"text":"He looked at the clock.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":24}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"“You are speaking to a President. Where is your professionalism?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":29}]},"28":{"id":28,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Let's begin then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":38}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"He cleared his throat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":41}]},"30":{"id":30,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":28}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"He gestured to the assistants.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":32}]},"32":{"id":32,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Two glasses.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":34}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"“And?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":101}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"They came back very fast. They must've been