,"outgoingIds":[{"convId":156,"nodeId":40}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"“Mr. Alvarez. Are you making fun of me right now?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":60}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“We want to provide Sordish fishing output in return for Lespian capital.”","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":65}]},"45":{"id":45,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“My apologies. I never took you for a Sollist.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":42}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":47},{"convId":156,"nodeId":48}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Lorren\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Lorren","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":57}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Lorren\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Lorren","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":58}]},"49":{"id":49,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":50},{"convId":156,"nodeId":51}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Bergia\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Bergia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":56}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Bergia\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Bergia","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":46}]},"52":{"id":52,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":53},{"convId":156,"nodeId":54}]},"53":{"id":53,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":44}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInvestment_Agnland\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn04_RegionalInvestment_Agnland","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":49}]},"55":{"id":55,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I am doing exactly that right now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":42}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"“We want to provide Sordish wheat in return for Lespian capital.”","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn04_RegionalInv