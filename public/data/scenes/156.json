variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":86}]},"83":{"id":83,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Your decision to defend the border while Smolak committed war crimes diverted all those refugees here.”","conditionsRaw":"Variable[\"BaseGame.Wehlen_DefendBorder\"] == true","variablesRead":[{"var":"BaseGame.Wehlen_DefendBorder","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":84}]},"84":{"id":84,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Now we have a full-blown refugee crisis in Lespia.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":85}]},"85":{"id":85,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Which unfortunately means that the price has gone up, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":89},{"convId":156,"nodeId":88},{"convId":156,"nodeId":91}]},"86":{"id":86,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Your decision to join Smolak in his attack against the unfortunate Bludish population compromised a lot of the Lespian assets in the area.”","conditionsRaw":"(Variable[\"BaseGame.Wehlen_DefendBorder\"] == true) == false","variablesRead":[{"var":"BaseGame.Wehlen_DefendBorder","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":68}]},"87":{"id":87,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“This has negatively affected Lespia. Our economy was indirectly hit due to the destruction of manufacturing sites. In particular the oil refineries.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":85}]},"88":{"id":88,"speaker":"Player","isPlayerChoice":true,"text":"“No. The price will stay the same or there won't be any deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":92}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"“Tell me what you want, Mr. Alvarez.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":97}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"We shook hands.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":111}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"“Makes sense. I knew this was coming. So what is on the new price tag?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":95}]},"92":{"id":92,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“It is your choice.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":93}]},"93":{"id":93,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Just like it was your choice to leave Bludish people alone to fend for themselves.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":94}]},"94":{"id":94,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Reminds me of Soll in many ways. What was it? Ah yes. The Soll Dam Incident.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":21},{"convId":156,"nodeId":66},{"convId":156,"nodeId":63}]},"95":{"id":95,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Good intuition.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":40}]},"96":{"id":96,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Lespia_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":156,"nodeId":122},{"convId":156,"nodeId":123},{"convId":156,"nodeId":124}]},"97":{"id":97,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“The only thing that anyone could possibly ever want out of Wehlen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":98}]},"98":{"id":98,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I want their oil.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":100},{"convId":156,"nodeId":99},{"convId":156,"nodeId":33}]},"99":{"id":99,"speaker":"Player","isPlayerChoice":true,"text":"“And how are you planning to get that?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":101}]},"100":{"id":100,"speaker":"Player","isPlayerChoice":true,"text":"“I'm listening.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":101}]},"101":{"id":101,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“A lot of oil from Wehlen is passing through Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":103}]},"102":{"id":102,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I think this deal will contribute nicely to the relationship between Lespia and Sordland.”","conditionsRaw":"(Variable[\"BaseGame.Wehlen_DefendBorder\"] == true  or  Variable[\"BaseGame.Wehlen_JointOperation\"] == true) == false","variablesRead":[{"var":"BaseGame.Wehlen_DefendBorder","op":"==","value":"true"},{"var":"BaseGame.Wehlen_JointOperation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":121}]},"103":{"id":103,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“And Sordish Petroleum owns most of the oil trade in Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":105}]},"104":{"id":104,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Excellent.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Lespia_SoldSordishPetroleum","op":"=","value":"true"},{"var":"BaseGame.Lespia_TradeDeal","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn08_LespiaVisit_TradeDealAndSold","op":"=","value":"true"}],"outgoingIds":[{"convId":156,"nodeId":26}]},"105":{"id":105,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Do you see where I am going with that?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":106},{"convId":156,"nodeId":107}]},"106":{"id":106,"speaker":"Player","isPlayerChoice":true,"text":"“Yes, I do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":109}]},"107":{"id":107,"speaker":"Player","isPlayerChoice":true,"text":"“Enlighten me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":109}]},"108":{"id":108,"speaker":"Player","isPlayerChoice":true,"text":"“You really are a shrewd man, Mr. Alvarez.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":154}]},"109":{"id":109,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I want you to sell me Sordish Petroleum or the deal is off.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":108},{"convId":156,"nodeId":149},{"convId":156,"nodeId":156}]},"110":{"id":110,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Lespia_SoldSordishPetroleum","op":"=","value":"true"}],"outgoingIds":[{"convId":156,"nodeId":148}]},"111":{"id":111,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Lespia_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":156,"nodeId":110}]},"112":{"id":112,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I wish I could say the same about you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":137},{"convId":156,"nodeId":114},{"convId":156,"nodeId":113},{"convId":156,"nodeId":115}]},"113":{"id":113,"speaker":"Player","isPlayerChoice":true,"text":"“Don't take my kindness for granted.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":118}]},"114":{"id":114,"speaker":"Player","isPlayerChoice":true,"text":"“What the hell does that mean?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":116}]},"115":{"id":115,"speaker":"Player","isPlayerChoice":true,"text":"“No need to argue, right? We have just met.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":119}]},"116":{"id":116,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Ah, Mr. Rayne. You know what you have done.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":117}]},"117":{"id":117,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Your actions speak for themselves. It almost seems like you are on a mission to ideologically oppose us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":120}]},"118":{"id":118,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“And don't take my straightforwardness for granted, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":11}]},"119":{"id":119,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Exactly. We don't need to waste any time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":11}]},"120":{"id":120,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“By us, I mean Lespia and ATO.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":11}]},"121":{"id":121,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Despite a lack of ideological alignments.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":74}]},"122":{"id":122,"speaker":"Player","isPlayerChoice":true,"text":"“When did ideology ever stop deals from happening?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Lespia_TradeDeal","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn08_LespiaVisit_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":156,"nodeId":126}]},"123":{"id":123,"speaker":"Player","isPlayerChoice":true,"text":"“That is excellent news.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Lespia_TradeDeal","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn08_LespiaVisit_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":156,"nodeId":127}]},"124":{"id":124,"speaker":"Player","isPlayerChoice":true,"text":"“Very good. We are done then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Lespia_TradeDeal","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn08_LespiaVisit_TradeDeal","op":"=","value":"true"}],"outgoingIds":[{"convId":156,"nodeId":125}]},"125":{"id":125,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Yes. We are done.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":26}]},"126":{"id":126,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I could count at least a few dozen instances, but let's not go into that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":26}]},"127":{"id":127,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I'm glad we are on the same page.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":26}]},"128":{"id":128,"speaker":"Player","isPlayerChoice":true,"text":"“I'm glad this was quick. The less time I spend here, the better.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":136}]},"129":{"id":129,"speaker":"Player","isPlayerChoice":true,"text":"“Perhaps we could advance this deal. What are your thoughts about an alliance?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":131}]},"130":{"id":130,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for having me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":135}]},"131":{"id":131,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Mr. Rayne, Mr. Rayne, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":132}]},"132":{"id":132,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I don't think so.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":133}]},"133":{"id":133,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“You should be glad that I am a lenient man. That's the only reason we were able to achieve a deal today.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":134}]},"134":{"id":134,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I wouldn't push it if I were you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":135}]},"135":{"id":135,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Have a good day, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":14}]},"136":{"id":136,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“If I were you I would reconsider my decision on who my friends and foes are.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":135}]},"137":{"id":137,"speaker":"Player","isPlayerChoice":true,"text":"“I thought the Prime Minister of Lespia would have at least some amount of social aptitude.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":138}]},"138":{"id":138,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I can assure you, I do, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":139}]},"139":{"id":139,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“And it is reserved only for my friends.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":11}]},"140":{"id":140,"speaker":"Narrator","isPlayerChoice":false,"text":"On his way to the door, he suddenly turned around.","conditionsRaw":"Variable[\"BaseGameIsolated.Turn08_FPnT_BrokenTeapot\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn08_FPnT_BrokenTeapot","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":141}]},"141":{"id":141,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Before I forget.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":145}]},"142":{"id":142,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":143},{"convId":156,"nodeId":144}]},"143":{"id":143,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn08_FPnT_BrokenTeapot\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn08_FPnT_BrokenTeapot","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeI