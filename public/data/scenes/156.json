ayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":42}]},"60":{"id":60,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“No. Absolutely not.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":61}]},"61":{"id":61,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I have just been very busy lately.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":76}]},"62":{"id":62,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“My favorite phrase in this world. 'I accept.'.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":37}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“I had to make a hard decision, and this is the result of it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":59}]},"64":{"id":64,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“You know...being the Prime Minister makes you pretty busy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":70}]},"65":{"id":65,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Ah. Yes. Right.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":67}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“Take care of your own country's issues first, Mr. Alvarez.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":55}]},"67":{"id":67,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Sorry. I have just been very busy lately.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":64}]},"68":{"id":68,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“Not to mention the humanitarian implications. We had to do our duty and send aid to those who were displaced as a result.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":87}]},"69":{"id":69,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“We Eastern Merkopans should stand together.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":90}]},"70":{"id":70,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“So, I don't have any issues with this deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":71}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":72},{"convId":156,"nodeId":73}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Wehlen_DefendBorder\"] == true  or  Variable[\"BaseGame.Wehlen_JointOperation\"] == true","variablesRead":[{"var":"BaseGame.Wehlen_DefendBorder","op":"==","value":"true"},{"var":"BaseGame.Wehlen_JointOperation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":75}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Wehlen_DefendBorder\"] == true  or  Variable[\"BaseGame.Wehlen_JointOperation\"] == true) == false","variablesRead":[{"var":"BaseGame.Wehlen_DefendBorder","op":"==","value":"true"},{"var":"BaseGame.Wehlen_JointOperation","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":102}]},"74":{"id":74,"speaker":"Patricio Alvarez","isPlayerChoice":false,"text":"“I will sign the executive order.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":156,"nodeId":147}]},"75":{"id":75,"speaker":"Patricio Alvarez","isPlayerChoice":f