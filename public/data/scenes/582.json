{"conversationId":582,"title":"Rizia/INHERITANCETAX/INHERITANCETAX Conversation","storyPack":"StoryPack_Rizia","turn":-1,"turnLabel":"General","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":356,"nodeId":55}]},"3":{"id":3,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You would tax the dead now?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":16}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"He bowed and left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":2}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Hugo_CounselIgnored","op":"=","value":"Variable[\"RiziaDLC.Hugo_CounselIgnored\"] + 1"}],"outgoingIds":[{"convId":582,"nodeId":8}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"I took a look at the decree.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":7},{"convId":582,"nodeId":10}]},"7":{"id":7,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Sign the decree.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":5}]},"8":{"id":8,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Very well... I hope we won't have any trouble in its implementation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Hugo_CounselIgnored","op":"=","value":"Variable[\"RiziaDLC.Hugo_CounselIgnored\"] + 1"}],"outgoingIds":[{"convId":582,"nodeId":9}]},"9":{"id":9,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'll see you later.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":4}]},"10":{"id":10,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You've given me a lot to consider. I'll hold off on the decree for now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":11}]},"11":{"id":11,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Thank you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":12}]},"12":{"id":12,"speaker":"Narrator","isPlayerChoice":false,"text":"I gave him the unsigned decree and left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":2}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":14},{"convId":582,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":27}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":19}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":17},{"convId":582,"nodeId":18}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":13}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":39}]},"19":{"id":19,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We've been through this, Romus. These tax proposals were deliberate attempts by the RPP to attack the nobility.\"","conditionsRaw":"((Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true) == false) and (Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true)","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":20}]},"20":{"id":20,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The Land Owners' Tax, Inheritance Tax... What will they try to take from us next?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":23}]},"21":{"id":21,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You already weakened the Royal Houses with your decrees, Romus.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":31}]},"22":{"id":22,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Please don't let the RPP influence you.\"","conditionsRaw":"(Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true) == false","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":37},{"convId":582,"nodeId":60}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":24},{"convId":582,"nodeId":25}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":50}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true) == false","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":22}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So taxation is only legitimate when it burdens the commoners? But when it reaches the nobility, it's suddenly a conspiracy?\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"27":{"id":27,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Your approval of the RPP's other tax proposal has already left you on thin ice with the nobility.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true) and (Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true)","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":28}]},"28":{"id":28,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You shouldn't push it too far.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":32}]},"29":{"id":29,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Allowing the RPP to use the media against us has already led to problems with the nobility.\"","conditionsRaw":"((Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false) and (Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress\"] == true) and (Variable[\"RiziaDLC.Policy_RD_Welfare_FreePress\"] == true)","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Welfare_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":30}]},"30":{"id":30,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Signing this would be a step too far for them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":32}]},"31":{"id":31,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But this proposal is a deliberate attempt by the RPP to attack the nobility.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":37},{"convId":582,"nodeId":35}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":33},{"convId":582,"nodeId":34}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":21}]},"34":{"id":34,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":52}]},"35":{"id":35,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Don't be so dramatic, Hugo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This is not about the RPP, nor is it about punishing the nobility. This is for Rizia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"37":{"id":37,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":62},{"convId":582,"nodeId":36},{"convId":582,"nodeId":63},{"convId":582,"nodeId":57}]},"38":{"id":38,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We've already talked about this, Romus. This is just another attempt by the RPP to undermine the nobility, like that free press proposal.\"","conditionsRaw":"((Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false) and (Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress\"] == true) and ((Variable[\"RiziaDLC.Policy_RD_Welfare_FreePress\"] == true) == false)","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Welfare_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":23}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":40},{"convId":582,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":42}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":144}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":43},{"convId":582,"nodeId":44}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Welfare_FreePress\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":29}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Welfare_FreePress\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Welfare_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":38}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":46},{"convId":582,"nodeId":47}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":48}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":49}]},"48":{"id":48,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Especially not after what you've already taken from them.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":49}]},"49":{"id":49,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Tell me, Romus, was there even a conversation to be had about this? Or did the RPP simply write it for you?\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":91},{"convId":582,"nodeId":72},{"convId":582,"nodeId":76},{"convId":582,"nodeId":73},{"convId":582,"nodeId":68},{"convId":582,"nodeId":95}]},"50":{"id":50,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"These proposals already lost all of their legitimacy when you closed down the House of Delegates.\"","conditionsRaw":"Variable[\"RiziaDLC.HouseOfDelegates_Abolished\"] == true","variablesRead":[{"var":"RiziaDLC.HouseOfDelegates_Abolished","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":51}]},"51":{"id":51,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"There is no point in even considering them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":66},{"convId":582,"nodeId":37}]},"52":{"id":52,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Please reconsider.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":37},{"convId":582,"nodeId":56}]},"53":{"id":53,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You know by now that I support the Rizian People's Party, Hugo.\"","conditionsRaw":"Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":77}]},"55":{"id":55,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Just because this is proposed by the RPP doesn't make it wrong. The nobility must also pay its fair share of taxes.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"There is nothing to reconsider. I have already decided.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":58},{"convId":582,"nodeId":59}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":53}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_DeclareIntention_Public\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_DeclareIntention_Public","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":55}]},"60":{"id":60,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What does that even mean, Hugo? Are you implying I'm somehow a puppet of the RPP now -- that I can't decide on my own?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"61":{"id":61,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"My apologies if I caused offense.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":54}]},"62":{"id":62,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You already told me that, Uncle. Maybe it's time to let this go.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":64},{"convId":582,"nodeId":65}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"65":{"id":65,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":26}]},"66":{"id":66,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"How convenient.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":69}]},"67":{"id":67,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Romus, I have watched you challenge traditions before. I have even defended you when others whispered that you were reaching too far.\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":82}]},"68":{"id":68,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So taxation is only legitimate when it burdens the commoners? But when it reaches the nobility, it's suddenly a conspiracy?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":54}]},"69":{"id":69,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":70},{"convId":582,"nodeId":71}]},"70":{"id":70,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":67}]},"71":{"id":71,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":77}]},"72":{"id":72,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You give them too much credit, Hugo. My decisions are my own.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":54}]},"73":{"id":73,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So, are you just opposed to the decree because of who proposed it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":54}]},"74":{"id":74,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You listened to my advice and held off on the Land Owners' Tax.\"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":96}]},"75":{"id":75,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But it's not only the Royal Houses, Romus. If the nobility unites against you, they can still wield considerable influence over key people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":120},{"convId":582,"nodeId":113},{"convId":582,"nodeId":114},{"convId":582,"nodeId":115}]},"76":{"id":76,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, Hugo... I am just a mouthpiece for the reformists, after all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":81}]},"77":{"id":77,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I'm just saying, Your Majesty, that this is not just a tax.\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":78}]},"78":{"id":78,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"This tax is clearly directed at the nobility. They will see it as a *message* directed at them.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":117},{"convId":582,"nodeId":97},{"convId":582,"nodeId":102},{"convId":582,"nodeId":98},{"convId":582,"nodeId":99},{"convId":582,"nodeId":104}]},"79":{"id":79,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The nobility are the pillars of this monarchy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":80}]},"80":{"id":80,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Cracked, perhaps. But pillars still.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":87}]},"81":{"id":81,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I didn't mean to suggest that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":54}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":83},{"convId":582,"nodeId":84}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":94}]},"84":{"id":84,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":74}]},"85":{"id":85,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Perhaps so.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":75}]},"86":{"id":86,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The Land Owners' Tax was a big blow to the nobility already. Please don't add insult to injury.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":132},{"convId":582,"nodeId":137}]},"87":{"id":87,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Don't forget they are holding the roof of this palace above our heads.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":131},{"convId":582,"nodeId":130},{"convId":582,"nodeId":129}]},"88":{"id":88,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":54}]},"89":{"id":89,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The Houses can take their grievances and shove them exactly where they belong.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":90}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"He sighed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":88}]},"91":{"id":91,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":92},{"convId":582,"nodeId":93}]},"92":{"id":92,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":89}]},"93":{"id":93,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"94":{"id":94,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But with this... I have to be the one telling you that you would indeed be doing just that.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Economy_LandOwnersTax\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Economy_LandOwnersTax","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":86}]},"95":{"id":95,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What does that even mean, Hugo? I advise you to be more respectful towards me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":61}]},"96":{"id":96,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I want you to do the same with this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":132},{"convId":582,"nodeId":133}]},"97":{"id":97,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Do you think this will push them too far?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":105}]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Let them rage. Their approval was never a requirement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":103}]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I cannot let the nobility dictate policy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":112}]},"100":{"id":100,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The numbers on the balance sheet won't matter if the nobility starts treating you as a threat rather than a king.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":110}]},"101":{"id":101,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We cannot trade political stability for revenue, Romus.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":100}]},"102":{"id":102,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We are going to be making money for the treasury, Hugo. This is a necessary policy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":101}]},"103":{"id":103,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"No it wasn't...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":107}]},"104":{"id":104,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, Hugo, because taxing the wealthiest estates is truly the gravest injustice in this kingdom.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":108}]},"105":{"id":105,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I do. And I believe you know it too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":110}]},"106":{"id":106,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We've been through this, Hugo. I've already weakened them. They can't fight back against this change.\"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":85}]},"107":{"id":107,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But their cooperation has kept this kingdom standing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":110}]},"108":{"id":108,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I understand the sentiment...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":109}]},"109":{"id":109,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"But these are the men and women who fund armies, who own land, who control commerce.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":111}]},"110":{"id":110,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"These are the men and women who fund armies, who own land, who control commerce.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":111}]},"111":{"id":111,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And people like that do not sit idly when they believe their future is at risk.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":113},{"convId":582,"nodeId":114},{"convId":582,"nodeId":115},{"convId":582,"nodeId":116}]},"112":{"id":112,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"And yet they do dictate much of this kingdom, whether you acknowledge it or not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":109}]},"113":{"id":113,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The nobility is not Rizia, Hugo. The people are. If the nobles have forgotten that, then it is time they remembered.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":79}]},"114":{"id":114,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The disparity between nobles and commoners grows wider by the year. If we continue down this path of preservation over reform, we will not be the ones who decide when change comes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":121}]},"115":{"id":115,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're looking at this as a political move, Hugo. But I see it as an economic one.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":125}]},"116":{"id":116,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So, basically, men like you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":128}]},"117":{"id":117,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":118},{"convId":582,"nodeId":119}]},"118":{"id":118,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":106}]},"119":{"id":119,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies\"] == true  or  Variable[\"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialLevies","op":"==","value":"true"},{"var":"RiziaDLC.Policy_RD_Order_RemoveProvincialPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"120":{"id":120,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I don't care what they think. I will keep weakening them until they have no power over me nor the people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":79}]},"121":{"id":121,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":122},{"convId":582,"nodeId":123}]},"122":{"id":122,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":140}]},"123":{"id":123,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":124}]},"124":{"id":124,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We can help the poor without disrupting the whole system.\"","conditionsRaw":"(Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":79}]},"125":{"id":125,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":126},{"convId":582,"nodeId":127}]},"126":{"id":126,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":141}]},"127":{"id":127,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":142}]},"128":{"id":128,"speaker":"Narrator","isPlayerChoice":false,"text":"He grunted in disapproval.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":79}]},"129":{"id":129,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You may have a point about the risk. I'll hold off on the decree for now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":11}]},"130":{"id":130,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No, Hugo. It's the other way around. And the nobility must pay their share of taxes just like everyone else.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":7}]},"131":{"id":131,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I think I've heard enough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":6}]},"132":{"id":132,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":136},{"convId":582,"nodeId":138},{"convId":582,"nodeId":134}]},"133":{"id":133,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm sorry, Hugo, but this time I will be signing this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":135}]},"134":{"id":134,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No. Nobody is going to get away with not paying their share of taxes anymore.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":135}]},"135":{"id":135,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":6}]},"136":{"id":136,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're repeating the same words, Hugo. I understand your concerns, but you have to trust my judgement.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":135}]},"137":{"id":137,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will add another one as I see fit. This is happening, Hugo. So please don't stand against me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":135}]},"138":{"id":138,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Fine. Maybe you're right about this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":135}]},"139":{"id":139,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I advise you to ignore her opinion on this topic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":79}]},"140":{"id":140,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We can't let the masses on the streets dictate policy-making.\"","conditionsRaw":"Variable[\"RiziaDLC.Reform_Movement_Grows\"] == true  or  Variable[\"RiziaDLC.Situation_Order_Unrest_NationalDestabilization\"] == true","variablesRead":[{"var":"RiziaDLC.Reform_Movement_Grows","op":"==","value":"true"},{"var":"RiziaDLC.Situation_Order_Unrest_NationalDestabilization","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":79}]},"141":{"id":141,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It seems it is only you and Ms. Werner who see it that way.\"","conditionsRaw":"Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":139}]},"142":{"id":142,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I believe Ms. Werner also doesn't support this decree, Your Majesty. Despite its potential impact on the treasury.\"","conditionsRaw":"(Variable[\"RiziaDLC.Resources_Budget\"] <= 3  and  Variable[\"RiziaDLC.Country_HouseAzaro\"] > 5  and  Variable[\"RiziaDLC.Country_HouseSazon\"] > 5  and  Variable[\"RiziaDLC.Country_HouseToras\"] > 5) == false","variablesRead":[{"var":"RiziaDLC.Resources_Budget","op":"<=","value":"3"},{"var":"RiziaDLC.Country_HouseAzaro","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseSazon","op":">","value":"5"},{"var":"RiziaDLC.Country_HouseToras","op":">","value":"5"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":143}]},"143":{"id":143,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I advise you not to ignore her opinion on this topic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":79}]},"144":{"id":144,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"The Houses' noble standing -- including our own, I'll remind you -- depends on the flow of wealth from generation to generation. You cannot simply take that away.\"","conditionsRaw":"((Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax\"] == true) == false) and ((Variable[\"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress\"] == true) == false)","variablesRead":[{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_LandOwnersTax","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Hugo_DecreeCounsel_FreePress","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":582,"nodeId":45}]}}}