{"conversationId":69,"title":"Sordland/Turn05/NOTES","storyPack":"StoryPack_Main","turn":5,"turnLabel":"Turn 5","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"“By taking away his mayorship. Let's reach out to Lileas to have him removed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":5}]},"4":{"id":4,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Taking the fight to him is the right approach. Proactive behavior will benefit us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn05_Admin_Mayor_Fire","op":"=","value":"true"}],"outgoingIds":[{"convId":69,"nodeId":7}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn05_Admin_Mayor_Fire","op":"=","value":"true"}],"outgoingIds":[{"convId":69,"nodeId":4}]},"6":{"id":6,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Hello, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":69}]},"7":{"id":7,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Lileas is his superior -- she ought to side with us and remove him from his post. I'll ask Livia to call her.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":55}]},"8":{"id":8,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Yet I cannot possibly fathom how I'm related to this.”","conditionsRaw":"(Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":13},{"convId":69,"nodeId":12}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":10},{"convId":69,"nodeId":11}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease\"] == true","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":19}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":18}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"“I want him fired for his actions, Lileas.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":9}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"“What do you think about removing him from his mayorship?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":9}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":15},{"convId":69,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase\"] == true","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":17}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":8}]},"17":{"id":17,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“How can I help?”","conditionsRaw":"Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase\"] == true","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Increase","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":13},{"convId":69,"nodeId":12}]},"18":{"id":18,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“It could be accomplished, but it would hurt the trust the mayors have placed in me and the Ministry.”","conditionsRaw":"(Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":23},{"convId":69,"nodeId":21}]},"19":{"id":19,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I'm against administrative intervention in local governments, especially in a city like Anrica. We'll lose trust.”","conditionsRaw":"Variable[\"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease\"] == true","variablesRead":[{"var":"BaseGame.Turn03_EnT_LawEnforcement_Budget_Decrease","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":23},{"convId":69,"nodeId":21}]},"20":{"id":20,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I appreciate that you hold me in such high esteem, but I'm reluctant about this move.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":71}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“We can repair that trust in the near future. But right now we need this man weakened.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":22}]},"22":{"id":22,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"At the expense of yet more pressure on myself and my staff.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":71}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"“Your personal support and weight is needed. This needs to look as if it came from you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":20}]},"24":{"id":24,"speaker":"Narrator","isPlayerChoice":false,"text":"Lileas hung up the phone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":46}]},"25":{"id":25,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“She won't upset the mayors at all costs, even one who insulted the First Lady. So much for female solidarity!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“We'll keep in touch.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":44}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"“Very much appreciated, Lileas.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":44}]},"28":{"id":28,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I support you as much as I am able to. I must excuse myself now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":44}]},"29":{"id":29,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“That was a waste of valuable time. But at least Lileas revealed her ambitions.”","conditionsRaw":"(Variable[\"BaseGame.Relations_Lileas_GendermariePromise\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Lileas_GendermariePromise","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":25}]},"30":{"id":30,"speaker":"Player","isPlayerChoice":true,"text":"“Maybe it will blow over. You might be right.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":31}]},"31":{"id":31,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“With time it should. I must excuse myself now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":44}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“I don't see Iosef accepting this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":36}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"Lileas sighed heavily.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":37}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“I haven't heard of this before.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":35}]},"35":{"id":35,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“I'm still working on the proposal and legal backing for it. I was going to mention it later.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":38},{"convId":69,"nodeId":39}]},"36":{"id":36,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Well, he just might have to agree if the President of Sordland tells him to.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":38},{"convId":69,"nodeId":39}]},"37":{"id":37,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Yet I would gladly support you... if you back my plan to put the Gendarmerie under the Ministry of Interior.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":34},{"convId":69,"nodeId":32},{"convId":69,"nodeId":70}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“I will support you in the Gendarmerie authority transfer. Now it's your turn.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":40}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"“I can't make that promise. Iosef would be furious.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":41}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Lileas_GendermariePromise","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn05_Scandal_CurtanAskedResign","op":"=","value":"true"}],"outgoingIds":[{"convId":69,"nodeId":42}]},"41":{"id":41,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“That is unfortunate. In that case there is not much I can do, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"42":{"id":42,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Excellent. I'll make arrangements to remove the mayor from his post.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Lileas_GendermariePromise","op":"=","value":"true"},{"var":"BaseGameSupport.Journal_Turn05_Scandal_CurtanAskedResign","op":"=","value":"true"}],"outgoingIds":[]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"“I'm disappointed in the lack of support from you. I expected more.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":28}]},"44":{"id":44,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Goodbye.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":24}]},"45":{"id":45,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Let's hope this arrangement won't backfire on us. It's true that Iosef will object.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Lileas_GendermariePromise\"] == true","variablesRead":[{"var":"BaseGame.Relations_Lileas_GendermariePromise","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":49}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":47},{"convId":69,"nodeId":48}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Lileas_GendermariePromise\"] == true","variablesRead":[{"var":"BaseGame.Relations_Lileas_GendermariePromise","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":45}]},"48":{"id":48,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Lileas_GendermariePromise\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Lileas_GendermariePromise","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":29}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“In the short term, though, we need to make Leste's removal seem as necessary as possible.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":68}]},"50":{"id":50,"speaker":"Narrator","isPlayerChoice":false,"text":"The Minister of the Interior was on the line.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":6}]},"51":{"id":51,"speaker":"Narrator","isPlayerChoice":false,"text":"Livia left the room to arrange the call. A few minutes later, the phone lit up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":50}]},"52":{"id":52,"speaker":"Livia Suno","isPlayerChoice":false,"text":"“I'll let you know once I have her on the line.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":61}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"“Yes please.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":56}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"“That would be appreciated.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":52}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr left the room and came back with Livia. She had on a short dress and dark eyeliner -- clearly she'd been counting on me being away at the festival for longer. Still, her demeanor was nothing but professional.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":57}]},"56":{"id":56,"speaker":"Livia Suno","isPlayerChoice":false,"text":"“As you wish.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":61}]},"57":{"id":57,"speaker":"Livia Suno","isPlayerChoice":false,"text":"“Mr. Vectern told me what happened. Should I connect you with the Interior Minster directly?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":53},{"convId":69,"nodeId":54}]},"58":{"id":58,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Taking the fight to him is the right approach. Proactive behavior will benefit us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn05_Admin_Mayor_Fire","op":"=","value":"true"}],"outgoingIds":[{"convId":69,"nodeId":59}]},"59":{"id":59,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Lileas is his superior -- she ought to side with us and remove him from his post. I'll ask Livia to call her.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":60}]},"60":{"id":60,"speaker":"Narrator","isPlayerChoice":false,"text":"A few minutes later, the phone lit up. The Minister of the Interior was on the line.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":6}]},"61":{"id":61,"speaker":"Livia Suno","isPlayerChoice":false,"text":"“I'd be careful, though. I doubt Mrs. Graf will remove Mayor Leste without asking for something in return.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":73}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":63},{"convId":69,"nodeId":64}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn05_Admin_Mayor_Fire\"] == false","variablesRead":[{"var":"BaseGameIsolated.Turn05_Admin_Mayor_Fire","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":65}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn05_Admin_Mayor_Fire\"] == false) == false","variablesRead":[{"var":"BaseGameIsolated.Turn05_Admin_Mayor_Fire","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"“All right, we'll take away his mayorship. Let's reach out to Lileas to have him removed.”","conditionsRaw":"Variable[\"BaseGameIsolated.Turn05_Admin_Mayor_Fire\"] == false","variablesRead":[{"var":"BaseGameIsolated.Turn05_Admin_Mayor_Fire","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":66}]},"66":{"id":66,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn05_Admin_Mayor_Fire","op":"=","value":"true"}],"outgoingIds":[{"convId":69,"nodeId":58}]},"67":{"id":67,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"\"It's just one noisy mayor. Perhaps you have nothing to worry about.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":43},{"convId":69,"nodeId":30}]},"68":{"id":68,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I'll prepare our press release.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"69":{"id":69,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“Let me take a guess. You're calling me about the Curtan Leste situation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":14}]},"70":{"id":70,"speaker":"Player","isPlayerChoice":true,"text":"“After what you said about my wife? No.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":41}]},"71":{"id":71,"speaker":"Lileas Graf","isPlayerChoice":false,"text":"“This isn't even counting my personal feelings about the matter. Mr. Rayne, I chose a political career at the expense of becoming a mother. Your wife did not. Leste was right -- her place is at home, not on that stage.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"72":{"id":72,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Speak to Lileas, Mr. President. Unless you'd rather take advice from someone in a conical brassiere.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":51}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr grinned. Lucian looked outraged.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":69,"nodeId":72}]}}}