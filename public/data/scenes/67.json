eGame.Reform_Reformist_Intention\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reformist_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":14}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":10},{"convId":67,"nodeId":11}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Promise_Diplomacy_West\"] == true","variablesRead":[{"var":"BaseGame.Promise_Diplomacy_West","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":17}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Promise_Diplomacy_West\"] == true) == false","variablesRead":[{"var":"BaseGame.Promise_Diplomacy_West","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":16}]},"12":{"id":12,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"Your refusal to bail out struggling businesses in this climate is a hardline stance, President Rayne. Some might say too hardline.\"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn02_EconomicRelief_BailedBusinesses\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn02_EconomicRelief_BailedBusinesses","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"13":{"id":13,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"It seems you've been quite generous in bailing out businesses, Anton. Not everyone would agree with that strategy in a recession.\"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn02_EconomicRelief_BailedBusinesses\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn02_EconomicRelief_BailedBusinesses","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"14":{"id":14,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"You've chosen to forego constitutional reform, President Rayne. A decision that speaks volumes about your respect for tradition.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reformist_Intention\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reformist_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"15":{"id":15,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"I've heard about your attempts at constitutional reform, Anton. Not an easy path, if I recall correctly.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Reformist_Intention\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reformist_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"16":{"id":16,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"Your decision not to align Sordland with the West is a perplexing one, President Rayne. It leaves one questioning your vision for our nation's place in the world.\"","conditionsRaw":"(Variable[\"BaseGame.Promise_Diplomacy_West\"] == true) == false","variablesRead":[{"var":"BaseGame.Promise_Diplomacy_West","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"17":{"id":17,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"And your foreign policy, Anton. Quite the tightrope walk, isn't it? West, East, or the middle ground?\"","conditionsRaw":"Variable[\"BaseGame.Promise_Diplomacy_West\"] == true","variablesRead":[{"var":"BaseGame.Promise_Diplomacy_West","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"18":{"id":18,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"Your decision not to construct a large-scale railway project between our major cities is a stance that confounds me. Such an initiative could have had transformative implications for corporate logistics.\"","conditionsRaw":"(Variable[\"BaseGame.Turn01_InT_Investment_Railway\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn01_InT_Investment_Railway","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"19":{"id":19,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"Your decision to maintain a stricter immigration policy is a departure from the open and inclusive vision I had for Sordland.\"","conditionsRaw":"(Variable[\"BaseGame.Promise_Immigration_Relaxed\"] == true) == false","variablesRead":[{"var":"BaseGame.Promise_Immigration_Relaxed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"20":{"id":20,"speaker":"Ewald Alphonso","isPlayerChoice":false,"text":"\"Your choice not to pursue constitutional reform is a conservative stance, differing from my belief that change is necessary for Sordland's advancement.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reformist_Intention\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reformist_Intention","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":31}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":22},{"convId":67,"nodeId":23}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn01_InT_Investment_Railway\"] == true","variablesRead":[{"var":"BaseGame.Turn01_InT_Investment_Railway","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":35}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn01_InT_Investment_Railway\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn01_InT_Investment_Railway","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":18}]},"24":{"id":24,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":67,"nodeId":25},{