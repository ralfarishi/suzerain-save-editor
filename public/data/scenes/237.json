Debate_Enable_MansounLeke\"] == true) == false) and ((Variable[\"BaseGame.Decision_Turn03_Extraction_AddressProtestors\"] == true) == false)","variablesRead":[{"var":"BaseGameIsolated.Debate_Enable_MansounLeke","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn03_Extraction_AddressProtestors","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":237,"nodeId":18}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Debate_Enable_DenisStahler","op":"=","value":"false"}],"outgoingIds":[{"convId":237,"nodeId":4}]},"15":{"id":15,"speaker":"Denis Stahler","isPlayerChoice":false,"text":"\"No. The charade has gone on long enough. How can the blatant censorship of the media go unremarked upon on this stage?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":237,"nodeId":18}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"\"The Red Youth was out of control. You should have done something.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":237,"nodeId":12}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Debate_Enable_MansounLeke","op":"=","value":"false"},{"var":"BaseGameIsolated.Debate_Enable_DenisStahler","op":"=","value":"false"}],"outgoingIds":[{"convId":237,"nodeId":4}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":237,"nodeId":19},{"convId":237,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Faction_PFJP_Destroyed\"] == true  or  Variable[\"BaseGame.Faction_NFP_Destroyed\"] == true","variablesRead":[{"var":"BaseGame.Faction_PFJP_Destro