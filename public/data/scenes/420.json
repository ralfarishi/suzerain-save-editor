{"conversationId":420,"title":"Rizia/Turn 8/Garden/Vina Non Marriage","storyPack":"StoryPack_Rizia","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":4}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":592,"nodeId":367}]},"3":{"id":3,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"We haven't gotten a chance to speak since Her Highness' engagement.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":7}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":5},{"convId":420,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Engaged\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":3}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":18}]},"7":{"id":7,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":8},{"convId":420,"nodeId":9}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_ForcedIntoMarriage\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_ForcedIntoMarriage","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":10}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_ForcedIntoMarriage\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_ForcedIntoMarriage","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":12}]},"10":{"id":10,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Vina didn't tell me the full extent of your conversation. But from what I gather, she had no say in the matter whatsoever.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_ForcedIntoMarriage\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_ForcedIntoMarriage","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":11}]},"11":{"id":11,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"I have to say, I was shocked that you would do such a thing to your own daughter.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":25},{"convId":420,"nodeId":26},{"convId":420,"nodeId":27}]},"12":{"id":12,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Vina didn't tell me the full extent of your conversation. But from what I gather, this was necessary for the sake of the kingdom.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_ForcedIntoMarriage\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_ForcedIntoMarriage","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":13}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":14},{"convId":420,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":22}]},"16":{"id":16,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"I also have a sneaking suspicion that more went on between them in Pales than Her Highness was willing to admit at the time.\"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":17}]},"17":{"id":17,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"At any rate... it goes without saying that my family is disappointed. But I don't want this to affect our professional relationship.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":2}]},"18":{"id":18,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"We haven't gotten a chance to speak since you refused to allow Her Highness and myself to marry.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Engaged\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Engaged","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":19}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":20},{"convId":420,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_FullCouncilor\"] == true  or  Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_FullCouncilor","op":"==","value":"true"},{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":23}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_FullCouncilor\"] == true  or  Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_FullCouncilor","op":"==","value":"true"},{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":24}]},"22":{"id":22,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Her Highness assured me that you gave her a choice in the matter. All I could do was wish her and her new fiance the best of luck.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Pales_Vina_LeadsDeal","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":17}]},"23":{"id":23,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Her Highness assured me that there were legitimate reasons behind your decision. All I could do was wish her the best of luck in her new position.\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_FullCouncilor\"] == true  or  Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_FullCouncilor","op":"==","value":"true"},{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":17}]},"24":{"id":24,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Vina didn't tell me the full extent of your conversation. But she seemed quite shaken.\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_FullCouncilor\"] == true  or  Variable[\"RiziaDLC.Vina_DuchessOfValenqiris\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_FullCouncilor","op":"==","value":"true"},{"var":"RiziaDLC.Vina_DuchessOfValenqiris","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":25},{"convId":420,"nodeId":26},{"convId":420,"nodeId":27}]},"25":{"id":25,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Vina will be fine, Mr. Sazon. I made this decision for her own good.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":28}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I wish things had gone differently as well. But what's done is done.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":28}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Rest assured, it's nothing personal. I won't let it affect our working relationship.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":28}]},"28":{"id":28,"speaker":"Narrator","isPlayerChoice":false,"text":"His expression darkened. He nodded.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":29}]},"29":{"id":29,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"I understand, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":420,"nodeId":2}]}}}