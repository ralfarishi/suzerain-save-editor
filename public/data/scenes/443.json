{"conversationId":443,"title":"Rizia/Turn 9/Manus Vina Concerns","storyPack":"StoryPack_Rizia","turn":9,"turnLabel":"Turn 9","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":442,"nodeId":363}]},"3":{"id":3,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Have you thought about how Vina will react?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":4}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":5},{"convId":443,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Hostage\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Hostage","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":7}]},"6":{"id":6,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_Hostage\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_Hostage","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":8}]},"7":{"id":7,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"What will Her Highness say when she comes back from Pales to a Rizia reformed by violent means?\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_Hostage\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_Hostage","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":18},{"convId":443,"nodeId":13},{"convId":443,"nodeId":15},{"convId":443,"nodeId":24}]},"8":{"id":8,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":9},{"convId":443,"nodeId":10}]},"9":{"id":9,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":12}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":11}]},"11":{"id":11,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"We aren't close anymore, as you know. But I don't believe she'd want to see Rizia reformed by violent means.\"","conditionsRaw":"((Variable[\"RiziaDLC.Vina_Hostage\"] == true) == false) and ((Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Vina_Hostage","op":"==","value":"true"},{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":13},{"convId":443,"nodeId":14},{"convId":443,"nodeId":15},{"convId":443,"nodeId":24}]},"12":{"id":12,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Both you and I know she'd never want to see Rizia reformed by violent means.\"","conditionsRaw":"((Variable[\"RiziaDLC.Vina_Hostage\"] == true) == false) and (Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true)","variablesRead":[{"var":"RiziaDLC.Vina_Hostage","op":"==","value":"true"},{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":13},{"convId":443,"nodeId":14},{"convId":443,"nodeId":15},{"convId":443,"nodeId":24}]},"13":{"id":13,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"She's got more of a spine than you do. She'll understand that this is necessary for the greater good.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":21}]},"14":{"id":14,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'll make sure she's safely out of the way while all this is happening, if that's what you're worried about.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":20}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":16},{"convId":443,"nodeId":17}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_ReformTalks_ViolentPlanB\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_ReformTalks_ViolentPlanB","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":19}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.BirthdayGathering_ReformTalks_ViolentPlanB\"] == true) == false","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_ReformTalks_ViolentPlanB","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"18":{"id":18,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We won't be able to get her out of Pales without resorting to violence. Sometimes it's the only solution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":22}]},"19":{"id":19,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You're getting ahead of yourself. It will never come to violence.\"","conditionsRaw":"Variable[\"RiziaDLC.BirthdayGathering_ReformTalks_ViolentPlanB\"] == true","variablesRead":[{"var":"RiziaDLC.BirthdayGathering_ReformTalks_ViolentPlanB","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":23}]},"20":{"id":20,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"That's the minimum I expect.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":2}]},"21":{"id":21,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"With all due respect, Your Majesty, it takes more of a spine to resist violence than to give in to it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":30}]},"22":{"id":22,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"That may be so in matters of war, but it's a dangerous line of thinking in internal politics...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":30}]},"23":{"id":23,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"For all of our sakes, I hope not.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":2}]},"24":{"id":24,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Vina has nothing to do with this. It's none of your business what she'll think.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":25}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":26},{"convId":443,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":29}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":28}]},"28":{"id":28,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"But...\"","conditionsRaw":"(Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":31}]},"29":{"id":29,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"None of my business? I'm her husband!\"","conditionsRaw":"Variable[\"RiziaDLC.Vina_MarriageDecision_Manus\"] == true","variablesRead":[{"var":"RiziaDLC.Vina_MarriageDecision_Manus","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":30}]},"30":{"id":30,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"But as I said, if this is really what you want, I won't get in your way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":2}]},"31":{"id":31,"speaker":"Manus Sazon","isPlayerChoice":false,"text":"\"Fine. As I said, if this is truly what you want, I won't get in your way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":443,"nodeId":2}]}}}