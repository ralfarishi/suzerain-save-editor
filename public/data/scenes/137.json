ir word.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":16}]},"14":{"id":14,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Your time will come. Be sure of that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":20},{"convId":137,"nodeId":18},{"convId":137,"nodeId":21}]},"15":{"id":15,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Whatever you say won't change the fact that you are done for.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":14}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"Cuffed by the two guards, Walter Tusk left the room. Marcel left shortly after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":115}]},"17":{"id":17,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“No matter what, I have my honor as a Koronti.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":13}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“That's enough, both of you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":24}]},"19":{"id":19,"speaker":"Player","isPlayerChoice":true,"text":"“You are right. Guards! Mr. Tusk will join Mr. Aven in Antel Rock Prison.”","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) and (Variable[\"BaseGame.Turn07_Detained_MikailAven\"] == true)","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"},{"var":"BaseGame.Turn07_Detained_MikailAven","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":37}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"“Marcel. Shut up.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":26}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“Marcel is right. You are done, Walter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":29}]},"22":{"id":22,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I am not you, Walter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":17}]},"23":{"id":23,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Or else what?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":64}]},"24":{"id":24,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I'm not the one who put us in this position, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":28}]},"25":{"id":25,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Mark my words. One day he will turn on you as well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":22}]},"26":{"id":26,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“My apologies. Of course, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":33}]},"27":{"id":27,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“See, Walter?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":81}]},"28":{"id":28,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Mr. Tusk. You heard the President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":33}]},"29":{"id":29,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“You heard the President, Walter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":33}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":31},{"convId":137,"nodeId":32}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":55},{"convId":137,"nodeId":116}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":42},{"convId":137,"nodeId":116}]},"33":{"id":33,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Now then. Before the conversation is derailed any further...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":36}]},"34":{"id":34,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Mr. Rayne! You are being played by this man.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":25}]},"35":{"id":35,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter stuffed the agreement in his briefcase and exited the room, closing the door with a loud bang. Marcel left shortly after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":2}]},"36":{"id":36,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian moved over to Walter and fanned the agreement papers out in front of him.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":38}]},"37":{"id":37,"speaker":"Narrator","isPlayerChoice":false,"text":"Two guards waiting outside entered the room immediately and grabbed Walter Tusk's arms.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":99}]},"38":{"id":38,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Mr. Tusk. Here is the agreement that pertains to the nationalization of Bergia Steel and the transfer of the entirety of your shares to the state.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":41}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter angrily stuffed the agreement in his briefcase and left the meeting room. Marcel followed shortly after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":2}]},"40":{"id":40,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Good luck doing that behind bars.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":34}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"He pointed to various sections on various pages of the document.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":43}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"“Mr. Tusk. I've already showed you what I'm capable of. You will stand down... or else.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial\"] == true  or  Variable[\"BaseGame.Turn05_SnO_LE_Policy_SecretStateService\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_DetentionWithoutTrial","op":"==","value":"true"},{"var":"BaseGame.Turn05_SnO_LE_Policy_SecretStateService","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":23}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“You will need to sign here, here and here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":44}]},"44":{"id":44,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I won't sign anything without reading it first.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":47}]},"45":{"id":45,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Rayne. I hope I never see your face again in my life.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":35}]},"46":{"id":46,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I will destroy you!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":40}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"He started going through the papers.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":48}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"When he finished, he turned back to the first page and went over the whole stack again.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":51}]},"49":{"id":49,"speaker":"Player","isPlayerChoice":true,"text":"“No need for escalation. He doesn't have any power anymore.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":79}]},"50":{"id":50,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":27}]},"51":{"id":51,"speaker":"Narrator","isPlayerChoice":false,"text":"And again...","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":53}]},"52":{"id":52,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Don't underestimate me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":45}]},"53":{"id":53,"speaker":"Narrator","isPlayerChoice":false,"text":"And again...","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":59},{"convId":137,"nodeId":60},{"convId":137,"nodeId":61}]},"54":{"id":54,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Marcel!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":46}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":56},{"convId":137,"nodeId":57}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn07_Detained_MikailAven\"] == true","variablesRead":[{"var":"BaseGame.Turn07_Detained_MikailAven","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":19}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn07_Detained_MikailAven\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn07_Detained_MikailAven","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":8}]},"58":{"id":58,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I will never forget what you have done to me.”","conditionsRaw":"(Variable[\"BaseGame.Faction_Oligarchs_Content\"] == true  and  Variable[\"BaseGame.BergiaSteel_Nationalization\"] == 1) == false","variablesRead":[{"var":"BaseGame.Faction_Oligarchs_Content","op":"==","value":"true"},{"var":"BaseGame.BergiaSteel_Nationalization","op":"==","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":90}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“Just sign it already.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":65}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“Stalling won't change the outcome.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":65}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"“Is there a problem?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":65}]},"62":{"id":62,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“And Korontis always keep their word.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":52}]},"63":{"id":63,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I will make sure to pay a visit sometime.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":54}]},"64":{"id":64,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Do you know who I am?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":107}]},"65":{"id":65,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I have to make sure I understand an agreement that takes my whole life's effort away from me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":66}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"He started checking his pockets.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":68}]},"67":{"id":67,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You can't do this to me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":140}]},"68":{"id":68,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I don't have a pen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":70}]},"69":{"id":69,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Thanks for the reminder, Mr. Rayne.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":87}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"Marcel immediately produced a pen from his pocket and put it in front of Walter with a toothy grin.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":72}]},"71":{"id":71,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“No matter what, I have my honor as a Koronti.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":62}]},"72":{"id":72,"speaker":"Narrator","isPlayerChoice":false,"text":"The pen had a large Heart of Sordland symbol with the name of the company engraved on it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":74}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter packed his belongings and furiously exited the room, slamming the door loudly. Marcel followed shortly after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn07_Sued_WalterTusk","op":"=","value":"true"}],"outgoingIds":[{"convId":137,"nodeId":2}]},"74":{"id":74,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“There you go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":143}]},"75":{"id":75,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Serves you right. Good riddance, Walter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":63}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"Walter reluctantly signed the papers after letting out a deep sigh.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":78}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"“No. There is no need.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":50}]},"78":{"id":78,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“My pen, please.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":80}]},"79":{"id":79,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I wouldn't underestimate what he can do, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":106}]},"80":{"id":80,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Take your damn pen.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":82}]},"81":{"id":81,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“This is called graciousness and mercy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":111}]},"82":{"id":82,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":9}]},"83":{"id":83,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“I am not you, Walter.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":71}]},"84":{"id":84,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Hah.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":12}]},"85":{"id":85,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Get your hands off of me!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":75}]},"86":{"id":86,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You are putting me in a difficult position.”","conditionsRaw":"Variable[\"BaseGame.Faction_Oligarchs_Content\"] == true  and  Variable[\"BaseGame.BergiaSteel_Nationalization\"] == 1","variablesRead":[{"var":"BaseGame.Faction_Oligarchs_Content","op":"==","value":"true"},{"var":"BaseGame.BergiaSteel_Nationalization","op":"==","value":"1"}],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":89}]},"87":{"id":87,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I will see you later.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":95}]},"88":{"id":88,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Not at all.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":87}]},"89":{"id":89,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“However, I understand.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":92}]},"90":{"id":90,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Your time will come too, Mr. President. Believe me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":94}]},"91":{"id":91,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Mr. Rayne. Are you just going to stay silent in the face of these blatant threats?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":105}]},"92":{"id":92,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“This could've turned out much worse for me *and* you if not for our...friendship.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":96}]},"93":{"id":93,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Mark my words. One day he will turn on you as well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":83}]},"94":{"id":94,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Did you just threaten the President of Sordland?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":98}]},"95":{"id":95,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“And this isn't over, Marcel. Next time I see you, I will make you beg me for forgiveness.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":84}]},"96":{"id":96,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“The paperwork is done so I will take my leave, President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":100}]},"97":{"id":97,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"\"Fuck off, Koronti.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":135}]},"98":{"id":98,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“This is ridiculous! Know your place!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":91}]},"99":{"id":99,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“No. No, no no.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":67}]},"100":{"id":100,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Be careful about this weasel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":104}]},"101":{"id":101,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Dictator!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":85}]},"102":{"id":102,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You little...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":49},{"convId":137,"nodeId":30}]},"103":{"id":103,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“President Rayne. You are being played by Marcel.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":93}]},"104":{"id":104,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“Your words hold no weight, old man.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":108}]},"105":{"id":105,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“He needs to be punished swiftly. Surely you can't let him speak to you like that!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":102}]},"106":{"id":106,"speaker":"Marcel Koronti","isPlayerChoice":false,"text":"“An animal is most dangerous when it is cornered. A man with Tusk's connections would prove...difficult in the future for sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":77},{"convId":137,"nodeId":30}]},"107":{"id":107,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I've been chewing up and spitting out Sordish politicians since you were in diapers.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":110}]},"108":{"id":108,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“We will see about that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":137,"nodeId":114},{"convId":137,"nodeId":113},{"convId":137,"nodeId":109}]},"109":{"id":109,"speaker":"Player","isPlayerChoice":true,"text":"“Don't forget. This could've gone much worse for you.”","c