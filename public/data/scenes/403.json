{"conversationId":403,"title":"Rizia/Turn 8/Heljiland Dispute","storyPack":"StoryPack_Rizia","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":401,"nodeId":29}]},"3":{"id":3,"speaker":"Ephraim Nines (R)","isPlayerChoice":false,"text":"\"The Alliance of Nations summons Maartin van Hoorten, Prime Minister of Agnolia, to the stage.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":81}]},"4":{"id":4,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Good morning.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":8}]},"6":{"id":6,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"It is an honor to see you all in this chamber.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":7}]},"7":{"id":7,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"The Alliance of Nations and its position is paramount to maintaining peace in the world. It is the sole organization that can bring all of us together...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":9}]},"8":{"id":8,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Thank you, President Nines.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":4}]},"9":{"id":9,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Not only for constructive discussions, but for collective problem-solving.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":10}]},"10":{"id":10,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"With our combined will and desire for justice, there is no issue we cannot resolve.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":11}]},"11":{"id":11,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"I therefore ask for your assistance in the fair and just resolution of a dilemma faced by my proud nation of Agnolia.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":12}]},"12":{"id":12,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"It concerns Helji Island.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":14}]},"13":{"id":13,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"This again. We're in for an interesting time.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":15},{"convId":403,"nodeId":16}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"Upon hearing the name of the island, everyone in the room woke up and sprang to attention. I heard Laurento mutter under his breath.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":13}]},"15":{"id":15,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"What do you mean?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":17}]},"16":{"id":16,"speaker":"Player_Romus_Italic","isPlayerChoice":true,"text":"Keep watching.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":18}]},"17":{"id":17,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"He's reigniting Agnolia's feud with Valgsland. If you ask me, now is neither the time nor place.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":18}]},"18":{"id":18,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"The innocent Agnolians living on this island are currently living under the long shadow cast by Valgsland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":19}]},"19":{"id":19,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Their territorial ambitions know no bounds. They will not rest until they have subdued every Agnolian soul on the land they have unlawfully claimed as theirs.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":25}]},"20":{"id":20,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"I pose you this question. What would you have done if it was your own land under threat?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":21}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"Our eyes randomly met before he turned his gaze away.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":22}]},"22":{"id":22,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"The place where your great-grandfather was born, where your father was born...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":26}]},"23":{"id":23,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"For peace in Eastern Merkopa, Heljiland has to be recognized as Agnolian.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":28}]},"24":{"id":24,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"I urge you to do the right thing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":27}]},"25":{"id":25,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Helji Island is a vital piece of our heritage that Chancellor Hegel is trying to take away from us by force.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":20}]},"26":{"id":26,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Would you not defend it? Would you not protect it with your life?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":31}]},"27":{"id":27,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Thank you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":29}]},"28":{"id":28,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Don't forget. If you tolerate this happening to us, your own nations will be next.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":24}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"I could see that Emmerich Hegel had a smirk on his face. He seemed confident.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":30}]},"30":{"id":30,"speaker":"Ephraim Nines (R)","isPlayerChoice":false,"text":"\"Thank you, Mr. Prime Minister. The voting will now commence.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":50}]},"31":{"id":31,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"He has a point.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":33},{"convId":403,"nodeId":32},{"convId":403,"nodeId":34},{"convId":403,"nodeId":83}]},"32":{"id":32,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Agnolia has no chance. Valgsland won't stand for this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":36}]},"33":{"id":33,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He speaks the truth, that's for sure.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":35}]},"34":{"id":34,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Having a point is not enough. There is more at play here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":37}]},"35":{"id":35,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"I admire his pride and his bravery. Even if they will not help him here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":23}]},"36":{"id":36,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"No, they won't. Especially not with United Contana backing them up.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":23}]},"37":{"id":37,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"As unfortunate as it is, we've seen firsthand how often might makes right.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":23}]},"38":{"id":38,"speaker":"Jorga Azmal","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":39}]},"39":{"id":39,"speaker":"Patricio Alvarez (R)","isPlayerChoice":false,"text":"\"Aye.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":52}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":41},{"convId":403,"nodeId":42}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Agnolia_HeljilandRecognised\"] == true","variablesRead":[{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":43}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Agnolia_HeljilandRecognised\"] == true) == false","variablesRead":[{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":44}]},"43":{"id":43,"speaker":"Anton Rayne (R)","isPlayerChoice":false,"text":"\"Aye.\"","conditionsRaw":"Variable[\"BaseGame.Agnolia_HeljilandRecognised\"] == true","variablesRead":[{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":78}]},"44":{"id":44,"speaker":"Anton Rayne (R)","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":"(Variable[\"BaseGame.Agnolia_HeljilandRecognised\"] == true) == false","variablesRead":[{"var":"BaseGame.Agnolia_HeljilandRecognised","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":78}]},"45":{"id":45,"speaker":"Axel Reinhart","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":"((Variable[\"RiziaDLC.War_Pales_Won\"] == true) == false) and (Variable[\"RiziaDLC.Vina_MarriageDecision_Axel\"] == true)","variablesRead":[{"var":"RiziaDLC.War_Pales_Won","op":"==","value":"true"},{"var":"RiziaDLC.Vina_MarriageDecision_Axel","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":46}]},"46":{"id":46,"speaker":"Alma Saltana","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":"Variable[\"RiziaDLC.War_Pales_Won\"] == true","variablesRead":[{"var":"RiziaDLC.War_Pales_Won","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":47}]},"47":{"id":47,"speaker":"Beatrice Livingston (R)","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":48}]},"48":{"id":48,"speaker":"Emmerich Hegel (R)","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":53}]},"49":{"id":49,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":51}]},"50":{"id":50,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":38}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":55}]},"52":{"id":52,"speaker":"Dwight Walker (R)","isPlayerChoice":false,"text":"\"Abstain.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":54}]},"53":{"id":53,"speaker":"Leon Malenyev (R)","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":49}]},"54":{"id":54,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Aye.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":40}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"It was finally my turn to cast a vote.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":56},{"convId":403,"nodeId":57}]},"56":{"id":56,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Aye.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":75}]},"57":{"id":57,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Nay.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":76}]},"58":{"id":58,"speaker":"Narrator","isPlayerChoice":false,"text":"Gasps and hushed whispers circulated around the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.Journal_Turn08_ANSession_HeljilandAye","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn08_Agnolia_HelijlandRecognition_Yes","op":"=","value":"true"}],"outgoingIds":[{"convId":403,"nodeId":72}]},"59":{"id":59,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Thank you for your support, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":96},{"convId":403,"nodeId":60},{"convId":403,"nodeId":62},{"convId":403,"nodeId":63}]},"60":{"id":60,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No need to thank me. I only did it because I thought it was right.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":64}]},"61":{"id":61,"speaker":"Narrator","isPlayerChoice":false,"text":"Maartin Van Hoorten came over to my side to personally shake my hand.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":59}]},"62":{"id":62,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"That was a touching speech.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":65}]},"63":{"id":63,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Best of luck.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":65}]},"64":{"id":64,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Thank you regardless. I won't forget that you stood by our side.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":74}]},"65":{"id":65,"speaker":"Maartin Van Hoorten (R)","isPlayerChoice":false,"text":"\"Thank you. I won't forget that you stood by our side.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":74}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"The voting concluded and President Nines took his seat.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.Journal_Turn08_ANSession_HeljilandNay","op":"=","value":"true"}],"outgoingIds":[{"convId":403,"nodeId":67}]},"67":{"id":67,"speaker":"Ephraim Nines (R)","isPlayerChoice":false,"text":"\"By a large margin, the Nays have won. Helji Island will not be recognized as Agnolian territory.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":68}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"Defeated, Maartin Van Hoorten shook his head in disbelief.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":69}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"His shoulders dropped. Who knew how he felt in that moment?","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":70}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"Nines signaled for a break. Laurento stood up to catch a minister he wanted to talk to.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":71}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"I enjoyed the Kyrutian circular pastry with sesame seeds -- apparently named 'Rekgev' -- that was handed out as a snack as we waited for the session to continue.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":77}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":61}]},"73":{"id":73,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":66}]},"74":{"id":74,"speaker":"Narrator","isPlayerChoice":false,"text":"He left to talk to his aides.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":73}]},"75":{"id":75,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.Journal_Turn08_ANSession_HeljilandAye","op":"=","value":"true"},{"var":"RiziaDLCSupport.Reports_Turn08_Agnolia_HelijlandRecognition_Yes","op":"=","value":"true"}],"outgoingIds":[{"convId":403,"nodeId":58}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.Journal_Turn08_ANSession_HeljilandNay","op":"=","value":"true"}],"outgoingIds":[{"convId":403,"nodeId":66}]},"77":{"id":77,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCSupport.News_Turn08_G_HeljilandRecognition","op":"=","value":"true"}],"outgoingIds":[{"convId":403,"nodeId":2}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":79},{"convId":403,"nodeId":80}]},"79":{"id":79,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.War_Pales_Won\"] == true","variablesRead":[{"var":"RiziaDLC.War_Pales_Won","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":46}]},"80":{"id":80,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.War_Pales_Won\"] == true) == false","variablesRead":[{"var":"RiziaDLC.War_Pales_Won","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":92}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"I looked around the room. The attendees' attention had begun to flag. A few didn't even bother to disguise their yawns.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":5}]},"82":{"id":82,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The AN recognized Zille as Rizian territory. I suppose he thinks he has a shot.\"","conditionsRaw":"Variable[\"RiziaDLC.ZilleReferendum_StoppedByAN\"] == true","variablesRead":[{"var":"RiziaDLC.ZilleReferendum_StoppedByAN","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":86}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":84},{"convId":403,"nodeId":85}]},"84":{"id":84,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.ZilleReferendum_StoppedByAN\"] == true","variablesRead":[{"var":"RiziaDLC.ZilleReferendum_StoppedByAN","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":82}]},"85":{"id":85,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.ZilleReferendum_StoppedByAN\"] == true) == false","variablesRead":[{"var":"RiziaDLC.ZilleReferendum_StoppedByAN","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":87}]},"86":{"id":86,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"Yes, although the circumstances surrounding Helji Island are quite different.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":23}]},"87":{"id":87,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":88},{"convId":403,"nodeId":89}]},"88":{"id":88,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.ZilleReferendum_NotStoppedByAN\"] == true","variablesRead":[{"var":"RiziaDLC.ZilleReferendum_NotStoppedByAN","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":90}]},"89":{"id":89,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.ZilleReferendum_NotStoppedByAN\"] == true) == false","variablesRead":[{"var":"RiziaDLC.ZilleReferendum_NotStoppedByAN","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"90":{"id":90,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The AN wouldn't even recognize Zille as Rizian territory. What makes him think he has a shot?\"","conditionsRaw":"((Variable[\"RiziaDLC.ZilleReferendum_StoppedByAN\"] == true) == false) and (Variable[\"RiziaDLC.ZilleReferendum_NotStoppedByAN\"] == true)","variablesRead":[{"var":"RiziaDLC.ZilleReferendum_StoppedByAN","op":"==","value":"true"},{"var":"RiziaDLC.ZilleReferendum_NotStoppedByAN","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":91}]},"91":{"id":91,"speaker":"Laurento Esquibel","isPlayerChoice":false,"text":"\"That's a good question.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":403,"nodeId":23}]},"92":{"id":92,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModi