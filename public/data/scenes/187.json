{"conversationId":187,"title":"Sordland/Turn09/Personal_PetrFuneral","storyPack":"StoryPack_Main","turn":9,"turnLabel":"Turn 9","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":1}]},"1":{"id":1,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":91},{"convId":187,"nodeId":94}]},"2":{"id":2,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Our convoy pulled up to the gates of the Public Cemetery in Erlory -- Petr's hometown. Monica and Deana were beside me in the car.","conditionsRaw":"Variable[\"BaseGame.Decision_Turn09_PetrFuneral_RegularFuneral\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn09_PetrFuneral_RegularFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":99}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"Monica looked numb and empty. Deana appeared to be deep in thought.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":144}]},"5":{"id":5,"speaker":"Deana","isPlayerChoice":false,"text":"“But how did Uncle Petr die? Why won't anyone tell me?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":8}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"“He killed himself, Deana.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":14}]},"7":{"id":7,"speaker":"Monica","isPlayerChoice":false,"text":"“He...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":9}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"Monica looked like she was about to cry.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":7}]},"9":{"id":9,"speaker":"Monica","isPlayerChoice":false,"text":"“It doesn't matter, sweetheart.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":10}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"She turned her head to look out the window, hiding her tears.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":115},{"convId":187,"nodeId":116},{"convId":187,"nodeId":117}]},"11":{"id":11,"speaker":"Deana","isPlayerChoice":false,"text":"“Papa? Tell me the truth!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":13},{"convId":187,"nodeId":12},{"convId":187,"nodeId":6}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"\"He... fell. It was an accident.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":15}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"“You will understand when you are older.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":16}]},"14":{"id":14,"speaker":"Deana","isPlayerChoice":false,"text":"“But... but why?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":17}]},"15":{"id":15,"speaker":"Deana","isPlayerChoice":false,"text":"“Like when I fall off my bike?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":22}]},"16":{"id":16,"speaker":"Deana","isPlayerChoice":false,"text":"“That's not fair. I'm almost 12.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":24}]},"17":{"id":17,"speaker":"Monica","isPlayerChoice":false,"text":"“Anton! She is still too young.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":20}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"\"I can't sugar-coat reality for her forever, Monica.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":24}]},"19":{"id":19,"speaker":"Player","isPlayerChoice":true,"text":"“Your mother is right, Deana. Sorry.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":24}]},"20":{"id":20,"speaker":"Monica","isPlayerChoice":false,"text":"“It's better to remember Uncle Petr by the way he lived, not by the way he died.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":19},{"convId":187,"nodeId":18},{"convId":187,"nodeId":21}]},"21":{"id":21,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Do not reply.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":24}]},"22":{"id":22,"speaker":"Monica","isPlayerChoice":false,"text":"\"No, honey. Nothing like that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":24}]},"23":{"id":23,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“We have arrived, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":103}]},"24":{"id":24,"speaker":"Narrator","isPlayerChoice":false,"text":"The driver's window rolled down.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":23}]},"25":{"id":25,"speaker":"Narrator","isPlayerChoice":false,"text":"Serge went outside and opened our door. As soon as we stepped out, camera flashes went off.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":26}]},"26":{"id":26,"speaker":"Narrator","isPlayerChoice":false,"text":"Evelyn Vectern was waiting for us. Upon seeing her, Monica ran up to her and they hugged.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":27}]},"27":{"id":27,"speaker":"Monica","isPlayerChoice":false,"text":"“Evelyn. I'm so sorry. How are you holding up?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":28}]},"28":{"id":28,"speaker":"Evelyn Vectern","isPlayerChoice":false,"text":"“So-so. It's hard to play the bereaved widow, knowing the kind of man he really was.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":29}]},"29":{"id":29,"speaker":"Evelyn Vectern","isPlayerChoice":false,"text":"“But still. We were married almost 20 years, Monica.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":31}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"They hugged once again. Evelyn wiped her tears and patted Deana on the head before turning to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":32},{"convId":187,"nodeId":36},{"convId":187,"nodeId":33}]},"31":{"id":31,"speaker":"Evelyn Vectern","isPlayerChoice":false,"text":"“And the way he died...It's just too...sudden.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":30}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“My condolences.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":34}]},"33":{"id":33,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Hug her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":35}]},"34":{"id":34,"speaker":"Evelyn Vectern","isPlayerChoice":false,"text":"“Thank you, Anton.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":35}]},"35":{"id":35,"speaker":"Evelyn Vectern","isPlayerChoice":false,"text":"“I know there's nothing either of us could have done. But I still can't help feeling responsible for this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":109},{"convId":187,"nodeId":108},{"convId":187,"nodeId":107}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"“I can't believe he's gone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":35}]},"37":{"id":37,"speaker":"Evelyn Vectern","isPlayerChoice":false,"text":"“All right. Let's go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":123}]},"38":{"id":38,"speaker":"Narrator","isPlayerChoice":false,"text":"The four of us -- Evelyn, Monica, Deana and I -- took our places towards the front of the crowd.","conditionsRaw":"Variable[\"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":39}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"From afar, we heard the sound of military boots approaching. A soldier was leading a group with a large framed photo of Petr in his hands.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":40}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"Behind him followed other soldiers, marching alongside a cart with a carved goat on the front.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":41}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"On top of the cart, wrapped in a Sordish flag, was the coffin of Petr Vectern. The Fourth Vice President of Sordland.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":42}]},"42":{"id":42,"speaker":"Narrator","isPlayerChoice":false,"text":"The group stopped in front of us. They lifted the coffin up off the cart and laid it down on a platform.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":43}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"One of the soldiers took the flag, folded it and presented it to me. I walked behind the podium to deliver my speech.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":46}]},"44":{"id":44,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd was sparse -- Petr hadn't had many friends left by the end. His father and brothers lifted the coffin on their shoulders and brought it to the grave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":45}]},"45":{"id":45,"speaker":"Narrator","isPlayerChoice":false,"text":"The priest completed his ceremony. It was time for me to make a speech.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":46}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"“Today, we mourn Petr Vectern. The Fourth Vice President of Sordland and...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":47},{"convId":187,"nodeId":48},{"convId":187,"nodeId":49}]},"47":{"id":47,"speaker":"Player","isPlayerChoice":true,"text":"“...a true Sord who strived to achieve the best for his country against all odds.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":51},{"convId":187,"nodeId":52},{"convId":187,"nodeId":50}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"“...a very successful statesman with whom I worked very closely over many years.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":51},{"convId":187,"nodeId":52},{"convId":187,"nodeId":50}]},"49":{"id":49,"speaker":"Player","isPlayerChoice":true,"text":"“...my brother. Our bond was not a bond of blood. It was something stronger. It was a bond of friendship and camaraderie.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":51},{"convId":187,"nodeId":52},{"convId":187,"nodeId":50}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“He was there with me from the very beginning. He swore he would support our cause until the end.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":54},{"convId":187,"nodeId":53},{"convId":187,"nodeId":55}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“God's word says no man can be perfect. And Petr was certainly no exception.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":54},{"convId":187,"nodeId":53},{"convId":187,"nodeId":55}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"“We drank together. Cried together. Laughed together. Fought together.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":54},{"convId":187,"nodeId":53},{"convId":187,"nodeId":55}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"“Though we did not always see eye to eye, I owe Petr everything. I wouldn't be President if not for him.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":58},{"convId":187,"nodeId":56},{"convId":187,"nodeId":57}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"“Despite his unconscionable actions towards the very end of his life, I choose to remember him as he was.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":58},{"convId":187,"nodeId":56},{"convId":187,"nodeId":57}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":true,"text":"“We must all remember him not at his worst, but for the good deeds he has done.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":58},{"convId":187,"nodeId":56},{"convId":187,"nodeId":57}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"“The path he paved will go down in history.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":61},{"convId":187,"nodeId":59},{"convId":187,"nodeId":60}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"“Never before Sordland had a Vice President like Petr. Never again will it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":61},{"convId":187,"nodeId":59},{"convId":187,"nodeId":60}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"“The past is past. We must always look to the future. That's what he would've wanted.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":61},{"convId":187,"nodeId":59},{"convId":187,"nodeId":60}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":63}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“Farewell brother. You will be missed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":63}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"“Morning shall come!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":62}]},"62":{"id":62,"speaker":"Narrator","isPlayerChoice":false,"text":"Everyone in the crowd yelled: \"Victory is close!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":63}]},"63":{"id":63,"speaker":"Narrator","isPlayerChoice":false,"text":"Amid the applause, I went back to join Monica and Deana.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":64}]},"64":{"id":64,"speaker":"Narrator","isPlayerChoice":false,"text":"As I walked past Evelyn, she mouthed the words: \"Thank you\".","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":65}]},"65":{"id":65,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":66},{"convId":187,"nodeId":67}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":68}]},"67":{"id":67,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":71}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"Trumpets cut through the silence. Stern-looking soldiers formed a line and held their rifles in front.","conditionsRaw":"Variable[\"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":69}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"One after another, ten shots rang out. With each shot, I shuddered.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":75}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"I felt a tug on my left arm.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":74}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"The priest's voice cut through the silence. Everyone joined in the prayer he was chanting.","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":72}]},"72":{"id":72,"speaker":"Narrator","isPlayerChoice":false,"text":"Looking at the coffin, I shuddered.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":73}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"The coffin started to be lowered into the grave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":75}]},"74":{"id":74,"speaker":"Deana","isPlayerChoice":false,"text":"“Are you crying?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":77}]},"75":{"id":75,"speaker":"Narrator","isPlayerChoice":false,"text":"I had known Petr for almost 30 years. The time we spent together flashed back before my eyes. The good memories and bad ones. All of it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":111}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"It didn't matter anymore. He was gone.","conditionsRaw":"(Variable[\"BaseGame.Turn08_SecondScandal_SecretState_Kill_Petr\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn08_SecondScandal_SecretState_Kill_Petr","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":70}]},"77":{"id":77,"speaker":"Narrator","isPlayerChoice":false,"text":"Surprised, I checked my face. My eyes were wet.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":78},{"convId":187,"nodeId":79},{"convId":187,"nodeId":80}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"“It's raining.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":81}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"“Yes.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":84}]},"80":{"id":80,"speaker":"Player","isPlayerChoice":true,"text":"“No, I'm not.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":83}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked up to the sky.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":82}]},"82":{"id":82,"speaker":"Deana","isPlayerChoice":false,"text":"“Papa, it's not raini-.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":83}]},"83":{"id":83,"speaker":"Monica","isPlayerChoice":false,"text":"“Come on Deana. Let's go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":85}]},"84":{"id":84,"speaker":"Narrator","isPlayerChoice":false,"text":"She hugged my leg.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":83}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"The coffin was fully lowered and the tombstone placed. The crowd began dispersing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":86},{"convId":187,"nodeId":87}]},"86":{"id":86,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Leave a bottle of whiskey on the grave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":143}]},"87":{"id":87,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Leave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":135}]},"88":{"id":88,"speaker":"Narrator","isPlayerChoice":false,"text":"I stayed there by myself for another half hour.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":135}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"The sun finally set after painting the sky blood red.","conditionsRaw":"(Variable[\"BaseGame.Turn08_SecondScandal_SecretState_Kill_Petr\"] == true  and  Variable[\"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn08_SecondScandal_SecretState_Kill_Petr","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":90}]},"90":{"id":90,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn09_Personal_PetrFuneral","op":"=","value":"true"}],"outgoingIds":[{"convId":187,"nodeId":128}]},"91":{"id":91,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":187,"nodeId":92},{"convId":187,"nodeId":93}]},"92":{"id":92,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn09_PetrFuneral_StateFuneral","op":"==","value":"true"}],"variablesModified":[],"outgoin