{"conversationId":79,"title":"Sordland/Turn06/InT_RailwayOpening","storyPack":"StoryPack_Main","turn":6,"turnLabel":"Turn 6","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":1}]},"1":{"id":1,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":17}]},"2":{"id":2,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving the train out of the central station, the media took photos of me and Lucian who kept his usual cool.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":49}]},"4":{"id":4,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn06_InT_Opening","op":"=","value":"true"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 2"}],"outgoingIds":[{"convId":79,"nodeId":129}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"Today was a great victory for the administration.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"},{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"}],"outgoingIds":[{"convId":79,"nodeId":101}]},"6":{"id":6,"speaker":"Narrator","isPlayerChoice":false,"text":"The railway officially opened to the public as soon as we arrived and thousands began utilising it.","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":165}]},"7":{"id":7,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":8},{"convId":79,"nodeId":9}]},"8":{"id":8,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":14}]},"9":{"id":9,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":6}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"We moved towards the line where the first electric train was waiting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":15}]},"11":{"id":11,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Cut the ribbon.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":12}]},"12":{"id":12,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Congratulations to all. It was a solid and fruitful effort. Hopefully with much more to come.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":13}]},"13":{"id":13,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“It's a good moment indeed. We have helped so many in the countryside.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":7}]},"14":{"id":14,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The train is prepared and ready.”","conditionsRaw":"Variable[\"BaseGameIsolated.Turn06_InT_Show\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":98}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"A red ribbon was hanging by the door of the train.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":97}]},"16":{"id":16,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Sounds fantastic. The President arriving to Lachaven on the driver seat would make the headlines for sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":53}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"We arrived in Holsord for the grand opening ceremony of the L-1 High-speed rail. It was a proud moment for all of us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":18}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon and Gus, who heavily assisted the project, were with me along with Lucian to decide on how to proceed tomorrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":154}]},"19":{"id":19,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I don't support anything beyond the opening ceremony. Actions speak for themselves anyway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":21}]},"20":{"id":20,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Thank you, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":96}]},"21":{"id":21,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I see your point. But involving the President further could be beneficial for the administration.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":115}]},"22":{"id":22,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Enter train.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":30}]},"23":{"id":23,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Alright then. We have a lot of work to do tomorrow. See you in the morning.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":51},{"convId":79,"nodeId":60},{"convId":79,"nodeId":118}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“It's been a long time since the last successful infrastructure project. There is good reason to capitalise on the occasion.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":102}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"“I'd like Gus with me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":28}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“I will drive the train on my own.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":36}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon walked up beside me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":61}]},"28":{"id":28,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“I'm honored. It will be great to arrive in Lachaven with the President of Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":41}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"“I want to have Symon in the cab.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":32}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Who do you want to travel with in the cab, Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":31},{"convId":79,"nodeId":29},{"convId":79,"nodeId":25},{"convId":79,"nodeId":26}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian, you would be my preference.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":33}]},"32":{"id":32,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“This isn't necessary but I won't refuse. We can talk about future economic projects.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":39}]},"33":{"id":33,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Thank you, Mr. President. It will be a good journey. We can talk about the reforms on the way as well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":3}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“I agree. There is much to gain.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":40}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"“I'd prefer we just do the opening ceremony. No need for senseless show.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":44}]},"36":{"id":36,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Sure. We will be in the other carriages. See you in Lachaven.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":43}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“This Railway brings thousands of new jobs! Many unemployed citizens have benefited and will benefit on the path of the railway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":73},{"convId":79,"nodeId":46},{"convId":79,"nodeId":68}]},"38":{"id":38,"speaker":"Narrator","isPlayerChoice":false,"text":"Gus came to the podium with his relaxed casual posture. He then leaned to the microphone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":20}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving the train out of the central station, the media took photos of me and Symon who smiled to the cameras.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":49}]},"40":{"id":40,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":79,"nodeId":45}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving the train out of the central station, the media took photos of me and Gus who gave a thumbs up to the cameras.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":49}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"“This railway brings down travel time by half! Travelling between Holsord and Lachaven is now faster and more comfortable.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":73},{"convId":79,"nodeId":46},{"convId":79,"nodeId":68}]},"43":{"id":43,"speaker":"Narrator","isPlayerChoice":false,"text":"As we began driving the train out of the central station, the media took photos of me driving by myself with the locomotive assistant next to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":49}]},"44":{"id":44,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Of course. We'll do the ceremony and open the upgraded railway to the public immediately after.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":52}]},"45":{"id":45,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Very well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn06_InT_Show","op":"=","value":"true"}],"outgoingIds":[{"convId":79,"nodeId":16}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"“I took time off from my duties to personally manage the project to success.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":91}]},"47":{"id":47,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Move up to the stage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":123},{"convId":79,"nodeId":71},{"convId":79,"nodeId":64}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian's voice echoed in the central station. Thousands of Sordland and USP flags began to wave as the loud cheers intensified.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":67}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"The new train was in pristine condition and the electric engine made much faster acceleration possible while providing minimal noise and maximum comfort.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":54}]},"50":{"id":50,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“This railway project is a perfect example of how we can bring prosperity to the under-developed areas in between our major cities.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":90}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“See you at the ceremony.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":65}]},"52":{"id":52,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“The people will be satisfied with the improved transportation service anyway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":53}]},"53":{"id":53,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Additionally, a large crowd is invited for the ceremony and will be watching the opening speech.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":69},{"convId":79,"nodeId":63},{"convId":79,"nodeId":74},{"convId":79,"nodeId":116}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"After the relaxing four hour drive to Lachaven, we were welcomed by celebratory citizens at Lachaven station.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":6}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took my place on the stage to close the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":121}]},"56":{"id":56,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“I'm sure each one of you will be proud of the achievements made during the project once we cut that ribbon. And you can get on that train yourselves.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":89}]},"57":{"id":57,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Signal Lucian to begin the ceremony.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":59}]},"58":{"id":58,"speaker":"Narrator","isPlayerChoice":false,"text":"The next day, a stage had been erected inside the central station along the new electrified railway line.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":92}]},"59":{"id":59,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Brothers and sisters of Sordland!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":94}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“Goodbye for now.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":65}]},"61":{"id":61,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Thanks, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":95}]},"62":{"id":62,"speaker":"Narrator","isPlayerChoice":false,"text":"We began moving towards the stage as the excitement was growing.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":57}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“It will be a good opportunity for exposure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":83}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“People of Sordland! Welcome to the opening ceremony of the L-1 High-speed railway.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":70}]},"65":{"id":65,"speaker":"Narrator","isPlayerChoice":false,"text":"The team left, leaving the rest of the evening to prepare for the big day tomorrow.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":58}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“The aim with the L-1 Railway was to improve development in rural areas and cities in between Holsord and Lachaven to create economic growth in the Greater Holsord and Gelsland regions.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":42},{"convId":79,"nodeId":37}]},"67":{"id":67,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Without further ado, I invite the President of Sordland to the stage.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":47}]},"68":{"id":68,"speaker":"Player","isPlayerChoice":true,"text":"“We have to thank the mind behind the railway project for it all, the esteemed Minister of Economy and Tax, Symon Holl. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":27}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"“Nothing like a cheerful crowd. Looking forward to it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":84}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting and excitement from the crowd intensified. A large group began singing the national anthem.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":77},{"convId":79,"nodeId":79}]},"71":{"id":71,"speaker":"Player","isPlayerChoice":true,"text":"“Citizens! Welcome to the opening ceremony of the L-1 High-speed railway!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":70}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"“Holsordians! I welcome you today to our opening ceremony of the L-1 High-speed railway.”","conditionsRaw":"(Variable[\"BaseGame.Prologue_Birthplace_Holsord_Middle\"]) == false","variablesRead":[{"var":"BaseGame.Prologue_Birthplace_Holsord_Middle","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":70}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"“None of this would be possible without my colleague with sound advice, the Minister Gus Manger. Please come over here.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":38}]},"74":{"id":74,"speaker":"Player","isPlayerChoice":true,"text":"“Like the good old campaign days.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":80}]},"75":{"id":75,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“We will show our best face tomorrow. Meanwhile, I'll make sure that our message of improving the countryside will get across.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":23}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"The chanting from the crowd continued. Some were yelling the motto of Holsord; High above all.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":77},{"convId":79,"nodeId":79}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"“At the beginning of this journey we promised jobs and opportunity. We kept our promise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":66},{"convId":79,"nodeId":78}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"“Our intention with the L-1 Railway was to serve our citizens who were having a hard time travelling between the major cities of Holsord and Lachaven.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":42},{"convId":79,"nodeId":37}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"“Trust me, our work is far from over. This project is only the beginning of good tidings.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":66},{"convId":79,"nodeId":78}]},"80":{"id":80,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Things were certainly easier back then.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":82}]},"81":{"id":81,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“We had our disagreements, but the important thing was the outcome. Sordish people got what they needed for a long time.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":75}]},"82":{"id":82,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon stepped in for a comment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":88}]},"83":{"id":83,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Agreed. Every single press outlet has of course been notified and they will be there.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":82}]},"84":{"id":84,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think all of us do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":82}]},"85":{"id":85,"speaker":"Player","isPlayerChoice":true,"text":"“Symon, you deserve a lot of credit. After all, it was you who came up with the project.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":81}]},"86":{"id":86,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for your kind words. It truly means a good deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":81}]},"87":{"id":87,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Beginning with the President who put his trust in me, I want to thank all who were involved in L-1.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":85},{"convId":79,"nodeId":86},{"convId":79,"nodeId":117}]},"88":{"id":88,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“On another note. It goes without mentioning that this was a team effort.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":87}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon mentioned the beginning of a Sordish economic recovery and the plans to stop the recession altogether.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":120}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"Gus continued to explain how this not only helps Holsord but also many areas along the path of the upgraded railway.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":119}]},"91":{"id":91,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd began cheering my name.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":55}]},"92":{"id":92,"speaker":"Narrator","isPlayerChoice":false,"text":"The sunny weather created a positive mood in the usually grey Holsord.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":93}]},"93":{"id":93,"speaker":"Narrator","isPlayerChoice":false,"text":"The crowd looked quite large. I spotted many party members among them.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":62}]},"94":{"id":94,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I welcome you Holsordians today as a proud servant of this country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":48}]},"95":{"id":95,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“Our aim with this project is obvious: to improve the speed and efficiency of transportation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":56}]},"96":{"id":96,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Holsord! It is great to be here in this beautiful capital that does so much good for this country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":50}]},"97":{"id":97,"speaker":"Narrator","isPlayerChoice":false,"text":"Symon gave me a large pair of scissors to commence the opening while the crowd was watching.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":153}]},"98":{"id":98,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The journey to Lachaven should take about four hours and the rest of us will be in the carriage with you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":22}]},"99":{"id":99,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_AverageTransportation","op":"=","value":"true"}],"outgoingIds":[{"convId":79,"nodeId":5}]},"100":{"id":100,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Situation_Economy_WeakTransportation","op":"=","value":"false"}],"outgoingIds":[{"convId":79,"nodeId":99}]},"101":{"id":101,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn06_InT_OnTime","op":"=","value":"true"}],"outgoingIds":[{"convId":79,"nodeId":127}]},"102":{"id":102,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I have a plan on how to do that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":103}]},"103":{"id":103,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“If Mr. President accepts, driving the first high-speed train to Lachaven would be great for our image nationwide.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":114}]},"104":{"id":104,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian stood up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":105}]},"105":{"id":105,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“First of all...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":108}]},"106":{"id":106,"speaker":"Gus Manger","isPlayerChoice":false,"text":"“Well done, everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":109},{"convId":79,"nodeId":110},{"convId":79,"nodeId":111}]},"107":{"id":107,"speaker":"Symon Holl","isPlayerChoice":false,"text":"“To many more projects like this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":106}]},"108":{"id":108,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Congratulations everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":107}]},"109":{"id":109,"speaker":"Player","isPlayerChoice":true,"text":"“Good work.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":112}]},"110":{"id":110,"speaker":"Player","isPlayerChoice":true,"text":"“We couldn't have done this without our excellent team.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":112}]},"111":{"id":111,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Nod.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":113}]},"112":{"id":112,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Indeed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":113}]},"113":{"id":113,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Let's move on to our plans for the opening tomorrow.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":24}]},"114":{"id":114,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“What are your thoughts?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":19}]},"115":{"id":115,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I think so too. Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":34},{"convId":79,"nodeId":35}]},"116":{"id":116,"speaker":"Player","isPlayerChoice":true,"text":"“I guess we can't help it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":82}]},"117":{"id":117,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":81}]},"118":{"id":118,"speaker":"Player","isPlayerChoice":true,"text":"“Once again, good work everyone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":65}]},"119":{"id":119,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took Gus' place after he was done with his speech.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":121}]},"120":{"id":120,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian took Symon's place after he was done with his speech.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":121}]},"121":{"id":121,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Citizens of Holsord! There you have it!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":122}]},"122":{"id":122,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“As promised, Anton Rayne—the 4th President of Sordland—has delivered!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":10}]},"123":{"id":123,"speaker":"Symon Holl","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":79,"nodeId":124},{"convId":79,"nodeId":125}]},"124":{"id":12