blesModified":[],"outgoingIds":[{"convId":239,"nodeId":39}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"\"Leave this building. Now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":69}]},"38":{"id":38,"speaker":"Mansoun Leke","isPlayerChoice":false,"text":"\"Sorry, Denis, I can't risk it. You're on your own.\"","conditionsRaw":"(Variable[\"BaseGame.Policy_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Policy_Law_Threshold_15\"] == true) == false","variablesRead":[{"var":"BaseGame.Policy_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Policy_Law_Threshold_15","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":28}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"The studio went deathly silent.","conditionsRaw":"((Variable[\"BaseGame.Faction_PFJP_Destroyed\"] == true  or  Variable[\"BaseGame.Faction_NFP_Destroyed\"] == true) == false) and ((Variable[\"BaseGameIsolated.Debate_Enable_ManolySuheil\"] == true  or  Variable[\"BaseGameIsolated.Debate_Enable_RemusHolstron\"] == true) == false) and ((Variable[\"BaseGame.Turn07_SecretState_Kill_OrsoHawker\"] == true  or  Variable[\"BaseGame.Turn08_SecondScandal_SecretState_Kill_Petr\"] == true  or  Variable[\"BaseGame.Turn09_A_Investigation_Oligarchs_Kill_Tusk\"] == true  or  Variable[\"BaseGame.Killed_MarcelKoronti\"] == true) == false)","variablesRead":[{"var":"BaseGame.Faction_PFJP_Destroyed","op":"==","value":"true"},{"var":"BaseGame.Faction_NFP_Destroyed","op":"==","value":"true"},{"var":"BaseGameIsolated.Debate_Enable_ManolySuheil","op":"==","value":"true"},{"var":"BaseGameIsolated.Debate_Enable_RemusHolstron","op":"==","value":"true"},{"var":"BaseGame.Turn07_SecretState_Kill_OrsoHawker","op":"==","value":"true"},{"var":"BaseGame.Turn08_SecondScandal_SecretState_Kill_Petr","op":"==","value":"true"},{"var":"BaseGame.Turn09_A_Investigation_Oligarchs_Kill_Tusk","op":"==","value":"true"},{"var":"BaseGame.Killed_MarcelKoronti","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":41},{"convId":239,"nodeId":43},{"convId":239,"nodeId":52},{"convId":239,"nodeId":47}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"Mansoun got up and looked into the camera.","conditionsRaw":"Variable[\"BaseGame.Policy_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Policy_Law_Threshold_15\"] == true","variablesRead":[{"var":"BaseGame.Policy_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Policy_Law_Threshold_15","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":32}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"\"Mr. Stahler. If I really am as powerful as you claim, wouldn't it be extremely foolish of you to speak against me?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":63}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"Sit back down. Now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":62}]},"43":{"id":43,"speaker":"Player","isPlayerChoice":true,"text":"\"Mr. Stahler. Leave this stage and do not ever show your face in front of me again.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":69}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":45},{"convId":239,"nodeId":46}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Policy_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Policy_Law_Threshold_15\"] == true","variablesRead":[{"var":"BaseGame.Policy_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Policy_Law_Threshold