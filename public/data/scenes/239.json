15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Debate_Enable_DenisStahler","op":"=","value":"false"}],"outgoingIds":[{"convId":239,"nodeId":5}]},"16":{"id":16,"speaker":"Denis Stahler","isPlayerChoice":false,"text":"\"No. The charade has gone on long enough. How can the blatant censorship of the media go unremarked upon on this stage?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":19}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"\"The Red Youth was out of control. You should have done something.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":13}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Debate_Enable_MansounLeke","op":"=","value":"false"},{"var":"BaseGameIsolated.Debate_Enable_DenisStahler","op":"=","value":"false"}],"outgoingIds":[{"convId":239,"nodeId":5}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":20},{"convId":239,"nodeId":21}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Faction_PFJP_Destroyed\"] == true  or  Variable[\"BaseGame.Faction_NFP_Destroyed\"] == true","variablesRead":[{"var":"BaseGame.Faction_PFJP_Destroyed","op":"==","value":"true"},{"var":"BaseGame.Faction_NFP_Destroyed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":30}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Faction_PFJP_Destroyed\"] == true  or  Variable[\"BaseGame.Faction_NFP_Destroyed\"] == true) == false","variablesRead