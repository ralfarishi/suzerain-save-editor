,"isPlayerChoice":false,"text":"\"I--\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":42},{"convId":239,"nodeId":37}]},"54":{"id":54,"speaker":"Denis Stahler","isPlayerChoice":false,"text":"\"Abdicating responsibility. A good look for a President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":65}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":true,"text":"\"If I was censoring the media, would I permit you to make this kind of scene?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":57}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"\"Whatever you think you know about me, it's a lie.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":64}]},"57":{"id":57,"speaker":"Narrator","isPlayerChoice":false,"text":"Denis gaped at me indignantly, then sat, his face red.","conditionsRaw":"(Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":12}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"\"Guards, this man is a danger to me. Please escort him out of the building at once.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":50}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":239,"nodeId":60},{"convId":239,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_EmergencyDecree_Banned_RY\"] == true","variablesRead":[{"var":"BaseGame.Reform_EmergencyDecree_Banned_RY","op":"==","value":"true"}],"variablesMod