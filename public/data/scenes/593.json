{"conversationId":593,"title":"Rizia/Turn 8/HugoConfronts/HugoConfronts Conversation","storyPack":"StoryPack_Rizia","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":419,"nodeId":16}]},"3":{"id":3,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"May I have a quick word with you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":4},{"convId":593,"nodeId":5},{"convId":593,"nodeId":6},{"convId":593,"nodeId":7}]},"4":{"id":4,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Of course, Uncle.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":10}]},"5":{"id":5,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Please.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":10}]},"6":{"id":6,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Is there something wrong?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":9}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Not now, Hugo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":8}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"Despite my words he leaned in and kept speaking.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":10}]},"9":{"id":9,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You tell me, Romus...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":10}]},"10":{"id":10,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You've published the evidence everywhere. Lespian intelligence planted the bomb in Zille. As I suspected from the beginning, my son had nothing to do with it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":11}]},"11":{"id":11,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"So I must ask you. When will Ricardus be freed?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":12},{"convId":593,"nodeId":13},{"convId":593,"nodeId":36},{"convId":593,"nodeId":14}]},"12":{"id":12,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Don't worry. I will order his release immediately.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":19}]},"13":{"id":13,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"We are still not completely sure that he's innocent.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":16}]},"14":{"id":14,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He will be freed when I say he will be freed. You are in no position to make demands, Your Grace.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":18}]},"15":{"id":15,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I don't understand, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":12},{"convId":593,"nodeId":39},{"convId":593,"nodeId":22},{"convId":593,"nodeId":23}]},"16":{"id":16,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"You're not sure? Even after finding indisputable proof that Lespia was the true culprit?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":15}]},"17":{"id":17,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Even if Rico were not my son, it does us no good to have a member of House Toras in prison. An innocent one at that...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":29}]},"18":{"id":18,"speaker":"Narrator","isPlayerChoice":false,"text":"His face turned bitter.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":17}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Rico_Arrested","op":"=","value":"false"},{"var":"RiziaDLC.Rico_Pardoned","op":"=","value":"true"},{"var":"RiziaDLCSupport.News_Turn08_RH_RicoPardoned","op":"=","value":"true"},{"var":"RiziaDLCSupport.News_Turn08_V_RicoPardoned","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_RicoPardon","op":"=","value":"true"}],"outgoingIds":[{"convId":593,"nodeId":34}]},"20":{"id":20,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Thank you, Your Majesty. From the bottom of my heart.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":21}]},"21":{"id":21,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"It does us no good to have a member of House Toras in prison. An innocent one, at that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":31}]},"22":{"id":22,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He and Su Omina may have still played some role. We need to investigate this further.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":24}]},"23":{"id":23,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He was not involved in the Zille bombing. But he may be guilty of other crimes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":35}]},"24":{"id":24,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Rico would never collaborate with Lespia, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":27},{"convId":593,"nodeId":26},{"convId":593,"nodeId":25}]},"25":{"id":25,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I am sorry. But I can't release your son.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":18}]},"26":{"id":26,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"He shall only walk free once he has been completely cleared of all wrongdoing.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":18}]},"27":{"id":27,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"You are right. He will be freed immediately.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":19}]},"28":{"id":28,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Be careful with what you're about to say, Hugo.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":18}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"He was losing control of the volume of his voice. He quickly stopped himself.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":30}]},"30":{"id":30,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We will talk later. The council is waiting for us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":33}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"He swiftly stepped in front of me and motioned towards the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":32}]},"32":{"id":32,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"Come now. The council is waiting for us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":2}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Hugo_RicoNotPardoned","op":"=","value":"true"}],"outgoingIds":[{"convId":593,"nodeId":2}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"My uncle heaved a sigh of relief.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLC.Rico_Arrested","op":"=","value":"false"},{"var":"RiziaDLC.Rico_Pardoned","op":"=","value":"true"},{"var":"RiziaDLCSupport.News_Turn08_RH_RicoPardoned","op":"=","value":"true"},{"var":"RiziaDLCSupport.News_Turn08_V_RicoPardoned","op":"=","value":"true"},{"var":"RiziaDLCSupport.Journal_Turn08_RicoPardon","op":"=","value":"true"}],"outgoingIds":[{"convId":593,"nodeId":20}]},"35":{"id":35,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"I assure you that he is not. And besides, suspicions alone do not justify his detention.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":26},{"convId":593,"nodeId":25},{"convId":593,"nodeId":28}]},"36":{"id":36,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I will be honest with you. Rico is a necessary sacrifice that must be made in order for Zille to be returned.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":37}]},"37":{"id":37,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"What?!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":38}]},"38":{"id":38,"speaker":"Hugo Toras","isPlayerChoice":false,"text":"\"We have proven to the world that Lespia was the true culprit. If Wiktor Smolak doesn't return Zille in the face of that proof, the Alliance of Nations will surely force him to.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":39},{"convId":593,"nodeId":25},{"convId":593,"nodeId":40}]},"39":{"id":39,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Fine. If it makes you happy, I will order his release.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":19}]},"40":{"id":40,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"This is a private matter between myself and President Smolak. Do not attempt to intervene in it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":593,"nodeId":18}]}}}