"nodeId":57},{"convId":138,"nodeId":58},{"convId":138,"nodeId":59}]},"52":{"id":52,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Listen to me carefully now, Rayne.”","conditionsRaw":"(Variable[\"BaseGame.Faction_Oligarchs_Content\"] == true) == false","variablesRead":[{"var":"BaseGame.Faction_Oligarchs_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":72}]},"53":{"id":53,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“You will bring a known criminal to justice.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":78},{"convId":138,"nodeId":36},{"convId":138,"nodeId":34},{"convId":138,"nodeId":89}]},"54":{"id":54,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Good man.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":41}]},"55":{"id":55,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“He is a dangerous man.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":67}]},"56":{"id":56,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I want him out of the equation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":85}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"“I do. But why are you helping me?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":60}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you, Walter. I'm glad I can depend on you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":6}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“If you ever use this against me...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":65}]},"60":{"id":60,"speaker":"Walter Tusk","i