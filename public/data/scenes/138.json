{"conversationId":138,"title":"Sordland/Turn07/STATUS QUO","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":132,"nodeId":309}]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Livia intercepted me in front of my office and informed me that I had a call from Walter Tusk.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":5}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"The line dropped dead.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":2}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"I entered and picked up the phone.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":10},{"convId":138,"nodeId":9},{"convId":138,"nodeId":8}]},"6":{"id":6,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Anytime.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":69}]},"7":{"id":7,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Good afternoon, President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":14}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"“President Rayne speaking.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":19}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"“Mr. Tusk. To what do I owe the pleasure?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":17}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“Walter. What do you want?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":7}]},"11":{"id":11,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“If you don't do it, you will suffer the consequences.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":41}]},"12":{"id":12,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“If you want to keep being one.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":4}]},"13":{"id":13,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Here is what this will cost you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":61}]},"14":{"id":14,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Not the nicest way to pick up the phone.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":20}]},"15":{"id":15,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Have a good afternoon and think about what I said.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":4}]},"16":{"id":16,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Heed my words, President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":55}]},"17":{"id":17,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Good afternoon, President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":20}]},"18":{"id":18,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“All I ask is for you to think about it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":16}]},"19":{"id":19,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Good afternoon.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":20}]},"20":{"id":20,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“I heard some disturbing news.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":25}]},"21":{"id":21,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“That's not too much to ask, is it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":53}]},"22":{"id":22,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Frankly, I was not surprised either.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":39}]},"23":{"id":23,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“News about a deal between you and Marcel Koronti.”","conditionsRaw":"Variable[\"BaseGame.Media_SordlandToday_Bias\"] == true","variablesRead":[{"var":"BaseGame.Media_SordlandToday_Bias","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":33},{"convId":138,"nodeId":32},{"convId":138,"nodeId":31}]},"24":{"id":24,"speaker":"Walter Tusk","isPlayerChoice":false,"text":"“Listen, President.”","conditionsRaw":"Variable[\"BaseGame.Faction_Oligarchs_Content\"] == true","variablesRead":[{"var":"BaseGame.Faction_Oligarchs_Content","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":48}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":138,"nodeId":26},{"convId":138,"nodeId":27}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsR