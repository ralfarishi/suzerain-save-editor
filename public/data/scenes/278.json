:{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"\"Let's us get straight to business.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":17}]},"16":{"id":16,"speaker":"Player","isPlayerChoice":true,"text":"\"Both of your expressions are sending me mixed signals... I hope that the war effort is going well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":19}]},"17":{"id":17,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"Of course, Mr. President!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":18}]},"18":{"id":18,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"I'm happy to report to you, Mr. President. That our first phase of the war was a complete success,\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":22}]},"19":{"id":19,"speaker":"Valken Kruger","isPlayerChoice":false,"text":"\"It seems that the Minister of Defence forgot that we're still at war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":20}]},"20":{"id":20,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"My apologies, but we need to take every wins we can get.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":21}]},"21":{"id":21,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"Speaking of which...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":18}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"Briefly describe what happened on the battle field based on the plan chosen.\n\nFran ?\n\nMade","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":23},{"convId":278,"nodeId":24},{"convId":278,"nodeId":25}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"\"This is great news. Somebody brings the champaign. We need to celebrate this victory.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":30}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"\"Excellent work, generals. I had no doubt in your capabilities to fight for your country.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":37}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"\"Good, we are one step closer to ending this war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":42}]},"26":{"id":26,"speaker":"Valken Kruger","isPlayerChoice":false,"text":"\"Mr. President, the war is not over yet.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":27}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"Valken spoke with his regular, impassive tone, yet I could feel the tension in the room rising.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":28}]},"28":{"id":28,"speaker":"Narrator","isPlayerChoice":false,"text":"Then he glared over to one of the staff that was about to go and grab a bottle of champaign. Freezing him in place.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":29}]},"29":{"id":29,"speaker":"Valken Kruger","isPlayerChoice":false,"text":"\"This is not yet the time to celebrate. This is the time to focus and achieve absolute victory.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":33}]},"30":{"id":30,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":31},{"convId":278,"nodeId":32}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff\"] == true","variablesRead":[{"var":"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":34}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":26}]},"33":{"id":33,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"I'm afraid the General is correct, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":35}]},"34":{"id":34,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"Not yet, Mr. President. The war is not over.\"","conditionsRaw":"Variable[\"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff\"] == true","variablesRead":[{"var":"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":35}]},"35":{"id":35,"speaker":"Iosef Lancea","isPlayerChoice":false,"text":"\"We must not drown ourselves in small victories and forget the final goal of the war.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":278,"nodeId":42}]},"36":{"id":36,"speaker":"Valken Kruger","isPlayerChoice":false,"text":"\"Thank you, Mr. President.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_PresiPower_Strong_PurgeGeneralStaff\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_PresiPow