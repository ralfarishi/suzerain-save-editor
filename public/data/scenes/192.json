{"conversationId":192,"title":"Sordland/Turn09/Old Guard Investivation","storyPack":"StoryPack_Main","turn":9,"turnLabel":"Turn 9","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":3}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":188,"nodeId":65}]},"3":{"id":3,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":4},{"convId":192,"nodeId":5}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":7}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":25}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"\"I want their heads, Lucian.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":57}]},"7":{"id":7,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Mrs. Morgna's task force suspected Old Guard members of multiple cases of corruption and lobbying. But when they looked deeper into it, they found something truly shocking.\"","conditionsRaw":"Variable[\"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice\"] == true","variablesRead":[{"var":"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":8}]},"8":{"id":8,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The Old Guard led by Hawker and Graf -- with the suspected approval of Tarquin Soll -- organized the assassination of Bernard Circas.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":10},{"convId":192,"nodeId":14},{"convId":192,"nodeId":15}]},"9":{"id":9,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The main co-conspirators were Orso Hawker and Lileas Graf.\"","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OrsoHawker\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":61}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"\"You're joking.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":16}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":12},{"convId":192,"nodeId":13}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Path\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":24}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":23}]},"14":{"id":14,"speaker":"Player","isPlayerChoice":true,"text":"\"What? But why?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":16}]},"15":{"id":15,"speaker":"Player","isPlayerChoice":true,"text":"\"I always thought they were involved.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":16}]},"16":{"id":16,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Since you took office, their goal was to protect Soll and his constitution. They needed an event extreme enough to distract you from making reforms.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":18}]},"17":{"id":17,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, they didn't succeed.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":21},{"convId":192,"nodeId":97}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":19},{"convId":192,"nodeId":20}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":17}]},"20":{"id":20,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":11}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"\"Who was involved in this?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":22}]},"22":{"id":22,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That may be complicated. Because we found out about another piece of information.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":95}]},"23":{"id":23,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, when that didn't work, they had other ways of impeding you.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) == false) and ((Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"},{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":21},{"convId":192,"nodeId":97}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And they succeeded.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) and ((Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"},{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":21},{"convId":192,"nodeId":97}]},"25":{"id":25,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As you may recall, Karl Greiser hinted at a 'complex web of connections' surrounding the Old Guard as well as multiple cases of corruption and lobbying.\"","conditionsRaw":"(Variable[\"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn05_SnO_LE_Policy_AntiCorruptionPolice","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":26}]},"26":{"id":26,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"However, he kept stalling whenever I pressed him for details.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":27}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":28},{"convId":192,"nodeId":29}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Fired_KarlGreiser\"] == true","variablesRead":[{"var":"BaseGame.Fired_KarlGreiser","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":30}]},"29":{"id":29,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Fired_KarlGreiser\"] == true) == false","variablesRead":[{"var":"BaseGame.Fired_KarlGreiser","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":31}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"As did his successor after he was fired.\"","conditionsRaw":"Variable[\"BaseGame.Fired_KarlGreiser\"] == true","variablesRead":[{"var":"BaseGame.Fired_KarlGreiser","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":31}]},"31":{"id":31,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Eventually, I received this bulletin from the desk of the Secret State Police. Supposedly a list of leads they'd uncovered.\"","conditionsRaw":"(Variable[\"BaseGame.Fired_KarlGreiser\"] == true) == false","variablesRead":[{"var":"BaseGame.Fired_KarlGreiser","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":32}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"He handed me a sheet of paper. On it was a short list of names.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":33}]},"33":{"id":33,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Look at the first letter of each name.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":34}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"I went down the list. It spelled \"NICE TRY GALADE.'\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":35},{"convId":192,"nodeId":36},{"convId":192,"nodeId":37}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"\"Cute.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":39}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"\"So they're playing with us?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":39}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"\"What is the meaning of this?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":39}]},"38":{"id":38,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Lileas and the Old Guard undoubtedly have something to hide. But the Secret State Police is their instrument.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":40}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian smiled wryly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":38}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":41},{"convId":192,"nodeId":42}]},"41":{"id":41,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Lucian_Opinion\"] < 0","variablesRead":[{"var":"BaseGame.Relations_Lucian_Opinion","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":43}]},"42":{"id":42,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Lucian_Opinion\"] < 0) == false","variablesRead":[{"var":"BaseGame.Relations_Lucian_Opinion","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":44}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Frankly, sir, you asking them to investigate their own bosses was a waste of both your time and mine.\"","conditionsRaw":"Variable[\"BaseGame.Relations_Lucian_Opinion\"] < 0","variablesRead":[{"var":"BaseGame.Relations_Lucian_Opinion","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":46},{"convId":192,"nodeId":47}]},"44":{"id":44,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I should have advised you not to pursue this. Sorry to have failed you.\"","conditionsRaw":"(Variable[\"BaseGame.Relations_Lucian_Opinion\"] < 0) == false","variablesRead":[{"var":"BaseGame.Relations_Lucian_Opinion","op":"<","value":"0"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":48},{"convId":192,"nodeId":45}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"\"It was my fault, not yours.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":49}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"\"I realize that now. I'm sorry.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":49}]},"47":{"id":47,"speaker":"Player","isPlayerChoice":true,"text":"\"Can't we still fire Lileas?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":49}]},"48":{"id":48,"speaker":"Player","isPlayerChoice":true,"text":"\"Apology accepted.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":49}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"If you wish, you could still remove Lileas from her cabinet position for encouraging the police's insubordination. But it wouldn't make you very popular.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":50},{"convId":192,"nodeId":51}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"\"Ms. Graf has caused me nothing but grief. Let's get rid of her.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":52}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"\"You're right. Can't be rocking the boat this close to the election.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":2}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian swallowed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":53}]},"53":{"id":53,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It may take some time to fire her without harming your election chances. But I'll get the process started.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":56}]},"54":{"id":54,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn09_A_Investigation_OldGuard_AttemptToFireLileas","op":"=","value":"true"}],"outgoingIds":[{"convId":192,"nodeId":94}]},"55":{"id":55,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And then there are the dozens of Assembly members and thousands of government officials who may have been aware of the assassination plot and helped cover it up.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":66},{"convId":192,"nodeId":67}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameSupport.Journal_Turn09_Investigations_FireLileas","op":"=","value":"true"}],"outgoingIds":[{"convId":192,"nodeId":54}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":58},{"convId":192,"nodeId":59}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OrsoHawker\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":60}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.ChiefJustice_OrsoHawker\"] == true) == false","variablesRead":[{"var":"BaseGame.ChiefJustice_OrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":9}]},"60":{"id":60,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The main conspirator was Lileas Graf.\"","conditionsRaw":"Variable[\"BaseGame.ChiefJustice_OrsoHawker\"] == true","variablesRead":[{"var":"BaseGame.ChiefJustice_OrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":55}]},"61":{"id":61,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"And then there are the dozens of Assembly members and thousands of government officials who may have been aware of the assassination plot and helped cover it up.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":62},{"convId":192,"nodeId":108},{"convId":192,"nodeId":64},{"convId":192,"nodeId":105}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"\"We will get rid of every single one that was involved in this plot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":68}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"\"It would cause ripples if we got rid of everyone at once. We will start with Orso and Lileas.\"","conditionsRaw":"(Variable[\"BaseGame.Turn07_SecretState_Kill_OrsoHawker\"] == true  or  Variable[\"BaseGame.YoungSords_Kill_OrsoHawker\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn07_SecretState_Kill_OrsoHawker","op":"==","value":"true"},{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":78}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"\"Lileas Graf will be our primary target. It's time she left politics. Once and for all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":76}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"\"Orso Hawker should be our primary target. He is too dangerous keep around.\"","conditionsRaw":"(Variable[\"BaseGame.Turn07_SecretState_Kill_OrsoHawker\"] == true  or  Variable[\"BaseGame.YoungSords_Kill_OrsoHawker\"] == true) == false","variablesRead":[{"var":"BaseGame.Turn07_SecretState_Kill_OrsoHawker","op":"==","value":"true"},{"var":"BaseGame.YoungSords_Kill_OrsoHawker","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":80}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"\"We will get rid of every single one that was involved in this plot.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":71}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"\"Lileas Graf will be our primary target. It's time she left politics. Once and for all.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":74}]},"68":{"id":68,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That could end up being the largest government purge in Sordland's history. Are you sure?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":69},{"convId":192,"nodeId":70}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. The Old Guard has been a taint on my government for far too long.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":87}]},"70":{"id":70,"speaker":"Player","isPlayerChoice":true,"text":"\"I meant, let's get rid of all the main conspirators we can touch. No need to shake up the entire government so close to the election.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":78}]},"71":{"id":71,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"That could end up being the largest government purge in Sordland's history. Are you sure?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":72},{"convId":192,"nodeId":73}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. The Old Guard has been a taint on my government for far too long.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":88}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"\"I meant, let's get rid of the main conspirator we can touch. No need to shake up the entire government so close to the election.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":192,"nodeId":74}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Turn09_A_Investigation_OldGuard_Trial_Lileas","op":"=","value":"true"}],"outgoingIds":[{"convId":192,"nodeId":101}]},"75":{"id":75,"speaker":"Pa