{"conversationId":125,"title":"Sordland/Turn07/IntroWithLucian","storyPack":"StoryPack_Main","turn":7,"turnLabel":"Turn 7","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":71}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":115,"nodeId":4}]},"3":{"id":3,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Especially all that lobbying work. But it's nothing to break me down, sir. Trust me, I'm fine.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":52}]},"4":{"id":4,"speaker":"Player","isPlayerChoice":true,"text":"\"Anything you want to say before we go in?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":21}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":115,"nodeId":3}]},"6":{"id":6,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you, Lucian. You look tired. How are you holding up?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":8}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"\"I couldn't have done it without you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":94}]},"8":{"id":8,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"It's nothing, sir. I am ready and able as always.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":10},{"convId":125,"nodeId":12},{"convId":125,"nodeId":14}]},"9":{"id":9,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":5}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"\"Good to know. I need you at your full potential.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":18}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":115,"nodeId":3}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"\"I hope so, Lucian. I can't have my team get worn out at a time like this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":18}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":115,"nodeId":3}]},"14":{"id":14,"speaker":"Player","isPlayerChoice":true,"text":"\"Are you sure? You can be honest with me.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":16}]},"15":{"id":15,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":63}]},"16":{"id":16,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'm always honest with you, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":43}]},"17":{"id":17,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":62}]},"18":{"id":18,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. I'll be doing my best.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":67},{"convId":125,"nodeId":4}]},"19":{"id":19,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think we should go, sir. Mr. Vice President must have started the session already.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":5}]},"20":{"id":20,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Please sir, don't be like that. You'll get through this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":44}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":22},{"convId":125,"nodeId":23}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":76}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":26}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think we should go, sir. Vice President Vectern must have started the session already.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":11}]},"25":{"id":25,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think we should go, sir. Mr. Vice President must have started the session already.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":13}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":27},{"convId":125,"nodeId":28}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Path\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":31}]},"28":{"id":28,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":29}]},"29":{"id":29,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"No, sir. Just keep your cool with the cabinet. I believe concerns will be raised in the meeting.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false) and ((Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":91},{"convId":125,"nodeId":90},{"convId":125,"nodeId":77}]},"30":{"id":30,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I can't let them bring you down however they like. We must resist.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":56},{"convId":125,"nodeId":55},{"convId":125,"nodeId":54}]},"31":{"id":31,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":32},{"convId":125,"nodeId":33}]},"32":{"id":32,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":35}]},"33":{"id":33,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":37}]},"34":{"id":34,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":13}]},"35":{"id":35,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"No, sir. Everything is under control. But I'm sure the ministers will raise their concerns at the meeting.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false) and (Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) and (Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true)","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":59},{"convId":125,"nodeId":58},{"convId":125,"nodeId":57}]},"36":{"id":36,"speaker":"Narrator","isPlayerChoice":false,"text":"He gestured at the door with the files he held.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":19}]},"37":{"id":37,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"There's not much to say, sir. We should find a way to restrain the Supreme Court from impeaching you.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true) == false) and (Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) and ((Variable[\"BaseGame.Reform_Autocrat_CourtVote_Success\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"},{"var":"BaseGame.Reform_Autocrat_CourtVote_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":39}]},"38":{"id":38,"speaker":"Narrator","isPlayerChoice":false,"text":"He gestured to the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":24}]},"39":{"id":39,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I have already been doing my best to find ways around it. Please stay composed and do not worry.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":85},{"convId":125,"nodeId":84},{"convId":125,"nodeId":83}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"Thank you, Lucian.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":92}]},"41":{"id":41,"speaker":"Player","isPlayerChoice":true,"text":"\"It is an emergency... What do they expect?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":88}]},"42":{"id":42,"speaker":"Player","isPlayerChoice":true,"text":"\"They don't even have the guts to face me. If the party doesn't fall in line, we must consider radical changes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":61}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I'll admit, this last year was tough.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":45}]},"44":{"id":44,"speaker":"Narrator","isPlayerChoice":false,"text":"He gestured to the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":25}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":46},{"convId":125,"nodeId":47}]},"46":{"id":46,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Path\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":49}]},"47":{"id":47,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Autocrat_Path\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":3}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"He stared down at the floor for a few seconds and then gestured at the door with the files he held.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":24}]},"49":{"id":49,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Especially all that work with the Old Guard. But it's nothing to break me down, sir. Trust me.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Autocrat_Path\"] == true","variablesRead":[{"var":"BaseGame.Reform_Autocrat_Path","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":52}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"\"We need their trust. We have to do something to prove our capabilities.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":65}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"\"Alright. Let's go to the meeting and hear these concerns out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":9}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"He fixed his tie.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":67},{"convId":125,"nodeId":4}]},"53":{"id":53,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Some Sollists have also been nagging our ministers about the short-lived state of emergency, which they believe has only worsened the situation.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":73},{"convId":125,"nodeId":79},{"convId":125,"nodeId":69}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm afraid we're trapped. Our future is up to the Old Guard now.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":20}]},"55":{"id":55,"speaker":"Player","isPlayerChoice":true,"text":"\"Alright. Let's get on with this meeting then.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":34}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"\"We will resist, Lucian. Don't you worry. Nothing will happen to us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":34}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"\"Alright, let's go in and hear them out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":15}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"\"What concerns?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":97}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"\"Concerns? It doesn't sound like everything is under control.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":97}]},"60":{"id":60,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Thank you for your trust in me. However, this is a very important matter, sir. I cannot take it easy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":30}]},"61":{"id":61,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Such radical changes towards the end of our term is not advised, sir. But we could talk about these in the meeting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":36}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":115,"nodeId":3}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":115,"nodeId":3}]},"64":{"id":64,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Our failure of the reforms had a huge impact on public opinion. And also on some of the ministers, from the looks of it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":70}]},"65":{"id":65,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. Let's discuss that in the meeting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":36}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The cabinet has gathered in the White Room, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":68}]},"67":{"id":67,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm ready. Let's go.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":75}]},"68":{"id":68,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The Vice President will be opening the session soon. We can go in whenever you're ready.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":67},{"convId":125,"nodeId":4},{"convId":125,"nodeId":6}]},"69":{"id":69,"speaker":"Player","isPlayerChoice":true,"text":"\"They don't even have the guts to face me. If the party doesn't fall in line, we must consider radical changes.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":80}]},"70":{"id":70,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The party is quite discontent about the whole situation. They believe your presidency has destroyed the USP's prestige.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":50},{"convId":125,"nodeId":51},{"convId":125,"nodeId":42}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian stood upright, holding a large folder of files under his arm. He bowed in acknowledgement.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":103}]},"72":{"id":72,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You already knew and expected this, I presume. I just wanted to give you a heads up.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":41},{"convId":125,"nodeId":79},{"convId":125,"nodeId":69}]},"73":{"id":73,"speaker":"Player","isPlayerChoice":true,"text":"\"We need their trust. We have to do something to prove our capabilities.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":86}]},"74":{"id":74,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"No, sir. I don't believe there's anything we didn't expect. However, our failure of the reforms had a huge impact on public opinion.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":70}]},"75":{"id":75,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":2}]},"76":{"id":76,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I only want to congratulate you again, sir. You wrote history.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Reform_Court_Success\"] == true","variablesRead":[{"var":"BaseGame.Reform_Reform_Court_Success","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":40},{"convId":125,"nodeId":7},{"convId":125,"nodeId":81}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"\"Alright, let's go in and hear them out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":17}]},"78":{"id":78,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":11}]},"79":{"id":79,"speaker":"Player","isPlayerChoice":true,"text":"\"Alright. Let's go to the meeting and hear these concerns out.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":78}]},"80":{"id":80,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Such radical change towards the end of our term is not advised, sir. But we could talk about this in the meeting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":38}]},"81":{"id":81,"speaker":"Player","isPlayerChoice":true,"text":"\"We have done it together.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":94}]},"82":{"id":82,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"But we can't allow them to bring you down however they like. We must resist.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":56},{"convId":125,"nodeId":55},{"convId":125,"nodeId":54}]},"83":{"id":83,"speaker":"Player","isPlayerChoice":true,"text":"\"Do you really think they can impeach me?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":93}]},"84":{"id":84,"speaker":"Player","isPlayerChoice":true,"text":"\"It doesn't sound like it's going well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":87}]},"85":{"id":85,"speaker":"Player","isPlayerChoice":true,"text":"\"I trust you Lucian. Take it easy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":60}]},"86":{"id":86,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. Let's discuss that in the meeting.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":38}]},"87":{"id":87,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"The investigation has already been opened against you, sir. But I'm sure nothing will come out of it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":100}]},"88":{"id":88,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"You are right, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":48}]},"89":{"id":89,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I think we should go, sir. Vice President Vectern must have started the session already.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":125,"nodeId":95}]},"90":{"