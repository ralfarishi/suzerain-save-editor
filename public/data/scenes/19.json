{"conversationId":19,"title":"Sordland/Turn02/Personal_Funeral","storyPack":"StoryPack_Main","turn":2,"turnLabel":"Turn 2","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Player","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":1}]},"1":{"id":1,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":3}]},"2":{"id":2,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Narrator","isPlayerChoice":false,"text":"Dark clouds were looming over Deyr. They looked daunting as our convoy started approaching the century-old cemetery.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":126}]},"4":{"id":4,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Anton.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":6}]},"5":{"id":5,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“Sir, we have arrived.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":153}]},"6":{"id":6,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":17}]},"7":{"id":7,"speaker":"Narrator","isPlayerChoice":false,"text":"It looked like it was going to rain. Certainly fitting weather for a funeral.","conditionsRaw":"(Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_SordishState\"] == true) == false) and (Variable[\"BaseGame.Turn02_InT_Corporation_TaurusHolding\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_TaurusHolding\"] == true) == false) and (Variable[\"BaseGame.Turn02_InT_Corporation_UnderhallConstruction\"] == true) and ((Variable[\"BaseGame.Turn02_InT_Corporation_UnderhallConstruction\"] == true) == false)","variablesRead":[{"var":"BaseGame.Turn02_InT_Corporation_SordishState","op":"==","value":"true"},{"var":"BaseGame.Turn02_InT_Corporation_TaurusHolding","op":"==","value":"true"},{"var":"BaseGame.Turn02_InT_Corporation_UnderhallConstruction","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 1"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] + 1"},{"var":"BaseGame.Capitalist","op":"=","value":"Variable[\"BaseGame.Capitalist\"] + 1"}],"outgoingIds":[{"convId":19,"nodeId":8}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"As expected, Bernard Circas's passing maintained its media traction and all of Sordland was paying attention to the ceremony. Especially to what I would say in my speech today.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":5}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"Rain drops were running down the car window when Serge opened my door and held an umbrella over my head. As soon as I got out, flashes from the cameras blinded me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":10},{"convId":19,"nodeId":11}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“It's okay Serge. I will hold my own umbrella.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":12}]},"11":{"id":11,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":13}]},"12":{"id":12,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“As you wish sir.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":14}]},"13":{"id":13,"speaker":"Serge Wolkner","isPlayerChoice":false,"text":"“It's my duty, sir.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":15}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"He handed me the umbrella and started waiting next to the car with his own.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":16}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"He silently started following me while holding the umbrella.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":16}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr and Karl exited from their own cars in the convoy. They made their way over to me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":4}]},"17":{"id":17,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“I just wanted to inform you that the perimeter is clear and secured completely. There is no one getting in or out without our knowledge.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":18},{"convId":19,"nodeId":19},{"convId":19,"nodeId":20}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“We don't want something similar happening again, do we?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":22}]},"19":{"id":19,"speaker":"Player","isPlayerChoice":true,"text":"“You better be right for your sake.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":21}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"“Good work. Thank you Karl.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":23}]},"21":{"id":21,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“I have taken the necessary precautions. I personally made sure of that. We are all safe.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":24}]},"22":{"id":22,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“Absolutely not, Mr. President. The same mistakes will never happen again. I personally made sure of that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":24}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"Karl bowed his head with respect.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":24}]},"24":{"id":24,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Good. If anything happens to Anton, you will have to answer to the First Lady.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":25}]},"25":{"id":25,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“And trust me Karl. You don't want that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":26}]},"26":{"id":26,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr let out a laugh, which drew some attention from bereaved attendees.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":27},{"convId":19,"nodeId":28},{"convId":19,"nodeId":29},{"convId":19,"nodeId":95}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"“Petr, you are being inconsiderate.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":30}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“I don't think any of us want that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":32}]},"29":{"id":29,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Gesture Petr to lower his voice.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":31}]},"30":{"id":30,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“You are right. Sorry.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":33}]},"31":{"id":31,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“You are right. Sorry.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":33}]},"32":{"id":32,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Indeed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":33}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"It started to rain. Several unintelligible voices were heard from Karl's radio. He stepped out to reply and returned shortly.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":34}]},"34":{"id":34,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“We have a small problem, sir.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":35}]},"35":{"id":35,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“A few -- five to be exact -- Red Youth members are here to attend the funeral. They apparently said they wish to pay their respects to their fallen comrade.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":36}]},"36":{"id":36,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“Should we let them in?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":39},{"convId":19,"nodeId":37},{"convId":19,"nodeId":46},{"convId":19,"nodeId":38}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“Let them in.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":42}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“Absolutely not.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":43}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"“Do you think they pose a security threat?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":40}]},"40":{"id":40,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“No. They were thoroughly searched. It looks like they really are here to attend the funeral.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":37},{"convId":19,"nodeId":46},{"convId":19,"nodeId":38}]},"41":{"id":41,"speaker":"Karl Greiser","isPlayerChoice":false,"text":"“As you command.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"=","value":"false"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] - 1"},{"var":"BaseGame.Democratic","op":"=","value":"Variable[\"BaseGame.Democratic\"] - 1"},{"var":"BaseGame.Country_Unrest","op":"=","value":"Variable[\"BaseGame.Country_Unrest\"] + 1"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 1"},{"var":"BaseGame.Democratic","op":"=","value":"Variable[\"BaseGame.Democratic\"] + 1"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] - 1"}],"outgoingIds":[{"convId":19,"nodeId":144}]},"42":{"id":42,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"=","value":"true"}],"outgoingIds":[{"convId":19,"nodeId":125}]},"43":{"id":43,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"=","value":"false"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] - 1"},{"var":"BaseGame.Democratic","op":"=","value":"Variable[\"BaseGame.Democratic\"] - 1"}],"outgoingIds":[{"convId":19,"nodeId":41}]},"44":{"id":44,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Let's head over. They are about to start.”","conditionsRaw":"(Variable[\"BaseGame.Accepted_MediaDeal\"] == true) and ((Variable[\"BaseGame.Accepted_MediaDeal\"] == true) == false)","variablesRead":[{"var":"BaseGame.Accepted_MediaDeal","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] + 1"},{"var":"BaseGame.Public_Opinion","op":"=","value":"Variable[\"BaseGame.Public_Opinion\"] - 1"}],"outgoingIds":[{"convId":19,"nodeId":45}]},"45":{"id":45,"speaker":"Narrator","isPlayerChoice":false,"text":"We walked towards the crowd circled around the grave. Everyone in attendance was wearing black in mourning. The rain started pouring heavily.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":47}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"“Let them in but put a few guards on them.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":42}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"Bernard's widow and daughter were in the front row, staring at the coffin with a mixture of disbelief, confusion and above all, a cold, unforgiving sadness.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":49}]},"48":{"id":48,"speaker":"Narrator","isPlayerChoice":false,"text":"Before taking my place to observe the ceremony, I gave my condolences to Bernard's wife and his daughter who looked at me. She reminded me of Deana.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":50}]},"49":{"id":49,"speaker":"Narrator","isPlayerChoice":false,"text":"Both of their eyes were very red and swollen from weeping.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":48}]},"50":{"id":50,"speaker":"Narrator","isPlayerChoice":false,"text":"When the religious ceremony was done, I was invited by the priest to deliver my speech. I took the podium. I felt like I had a lump in my throat. I couldn't get the daughter's eyes out of my head.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":51}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“Today, we are mourning Bernard Circas, a father, a husband and a loyal servant of this country.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":53}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"Towards the back of the crowd, I spotted the members of the Red Youth, wearing red shirts and black bands of mourning on their arms. They seemed ruly and were respectfully bowing their heads.","conditionsRaw":"Variable[\"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":56}]},"53":{"id":53,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":54},{"convId":19,"nodeId":55}]},"54":{"id":54,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth\"] == true","variablesRead":[{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":52}]},"55":{"id":55,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":56}]},"56":{"id":56,"speaker":"Narrator","isPlayerChoice":false,"text":"There was complete silence except for the sound of raindrops.","conditionsRaw":"(Variable[\"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth\"] == true) == false","variablesRead":[{"var":"BaseGameIsolated.Turn02_P_Funeral_AllowedRedYouth","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":82},{"convId":19,"nodeId":96},{"convId":19,"nodeId":57},{"convId":19,"nodeId":60}]},"57":{"id":57,"speaker":"Player","isPlayerChoice":true,"text":"“Regardless of his ideology, this was a heinous act made towards a good man. We must end this cycle of violence.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":59},{"convId":19,"nodeId":97},{"convId":19,"nodeId":58},{"convId":19,"nodeId":65}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"“I interpret this attack as an attack against Sordland and by extension, against me personally.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 1"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] - 1"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] - 1"}],"outgoingIds":[{"convId":19,"nodeId":90},{"convId":19,"nodeId":91},{"convId":19,"nodeId":89}]},"59":{"id":59,"speaker":"Player","isPlayerChoice":true,"text":"“We will make sure that unfortunate events such as this will never happen again.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 1"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] - 1"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] - 1"}],"outgoingIds":[{"convId":19,"nodeId":90},{"convId":19,"nodeId":91},{"convId":19,"nodeId":89}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“He was a true comrade and he fought for what he believed in, his ideal vision of Sordland, in every step of his life.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":112}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"“A moment of silence please.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn02_P_RecitedPoem","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn02_P_RecitedPoem2","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn02_P_RecitedPoem3","op":"=","value":"true"}],"outgoingIds":[{"convId":19,"nodeId":66}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn02_P_RecitedPoem","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn02_P_RecitedPoem2","op":"=","value":"true"},{"var":"BaseGameIsolated.Turn02_P_RecitedPoem3","op":"=","value":"true"}],"outgoingIds":[{"convId":19,"nodeId":67}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“I would now like to recite one of the poems he left us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":154}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“Our only strength is the will to survive, knowing that we will perish, knowing nothing more absolute.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":104}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"“I promise you this. The blood of Bernard will not remain on the sacred ground of Sordland.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] + 1"},{"var":"BaseGame.Sollist","op":"=","value":"Variable[\"BaseGame.Sollist\"] - 1"},{"var":"BaseGame.Malenyevist","op":"=","value":"Variable[\"BaseGame.Malenyevist\"] - 1"}],"outgoingIds":[{"convId":19,"nodeId":90},{"convId":19,"nodeId":91},{"convId":19,"nodeId":89}]},"66":{"id":66,"speaker":"Narrator","isPlayerChoice":false,"text":"During the silence, all that was heard were the ravens.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":67}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"Some attendees started clapping, some crying.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":68}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"The coffin was lowered into the grave by the gravekeepers. After a couple of minutes, Bernard Circas was with the soil, no more.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":83},{"convId":19,"nodeId":84}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"The widow thanked me with a soft and defeated voice before we dispersed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":70}]},"70":{"id":70,"speaker":"Narrator","isPlayerChoice":false,"text":"On my way back to the car, I still couldn't get the eyes of Bernard's daughter, nor the faltering voice of his wife, out of my head. Would Deana, Monica and Franc look the same way if something happened to me?","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":71}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"Petr put his hand on my shoulder.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":72}]},"72":{"id":72,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“That was a good speech.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":75}]},"73":{"id":73,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Come on, it's time to go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":74}]},"74":{"id":74,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“We've got work to do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":76}]},"75":{"id":75,"speaker":"Narrator","isPlayerChoice":false,"text":"I sensed only respect in his voice.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":92},{"convId":19,"nodeId":78},{"convId":19,"nodeId":88}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"He was right. We had work to do. So much more to do.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":80}]},"77":{"id":77,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn02_Personal_Funeral","op":"=","value":"true"}],"outgoingIds":[{"convId":19,"nodeId":155}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you. I mean it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":79}]},"79":{"id":79,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“I know you do.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":73}]},"80":{"id":80,"speaker":"Narrator","isPlayerChoice":false,"text":"I realized that the rain had stopped, and I looked up.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":81}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"The black clouds slowly dispersed and sunbeams enlightened our surroundings.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":87}]},"82":{"id":82,"speaker":"Player","isPlayerChoice":true,"text":"“This is a great loss for all of us.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":59},{"convId":19,"nodeId":97},{"convId":19,"nodeId":58},{"convId":19,"nodeId":65}]},"83":{"id":83,"speaker":"Player","isPlayerChoice":true,"text":"“As we bid farewell to Bernard, I want to close with the words every Sord lives by: A Morgna wes core!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":152}]},"84":{"id":84,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Step down from the podium.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":69}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"Everyone replied: “Vectern sis da!”. Victory is close.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.AMorgnaWesCore","op":"=","value":"Variable[\"BaseGame.AMorgnaWesCore\"] + 1"}],"outgoingIds":[{"convId":19,"nodeId":86}]},"86":{"id":86,"speaker":"Narrator","isPlayerChoice":false,"text":"With applauses, I stepped down from the podium. It was time to leave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":69}]},"87":{"id":87,"speaker":"Narrator","isPlayerChoice":false,"text":"As someone once said: 'Even the darkest night will end and the sun will rise.'","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":110}]},"88":{"id":88,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Nod.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":73}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"“The tears of the family he left behind have a price that needs to be paid. I will not stop until it is paid in full.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":62},{"convId":19,"nodeId":63}]},"90":{"id":90,"speaker":"Player","isPlayerChoice":true,"text":"“Let us all mourn the passing of Bernard Circas and remember him well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":62},{"convId":19,"nodeId":63}]},"91":{"id":91,"speaker":"Player","isPlayerChoice":true,"text":"“But, hatred begets hatred. There is only one way to overcome this vicious cycle. We must unite against the evil of this world.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":62},{"convId":19,"nodeId":63}]},"92":{"id":92,"speaker":"Player","isPlayerChoice":true,"text":"“It's time to go.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":93}]},"93":{"id":93,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Agreed.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":74}]},"94":{"id":94,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"“Hah! Right? I mean, life is full of tragedy. We should try to take it easy if we can.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":19,"nodeId":33}]},"95":{"id":95,"speaker":"Player","isPlayerChoice":true,"text":