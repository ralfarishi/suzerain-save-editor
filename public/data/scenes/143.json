{"conversationId":143,"title":"Sordland/Turn08/A_NewVPIntroduction","storyPack":"StoryPack_Main","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":1}]},"1":{"id":1,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":9}]},"2":{"id":2,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":4},{"convId":143,"nodeId":5}]},"4":{"id":4,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn08_VPSelection_Albin\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn08_VPSelection_Albin","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":145}]},"5":{"id":5,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn08_VPSelection_Albin\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn08_VPSelection_Albin","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":6}]},"6":{"id":6,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":7},{"convId":143,"nodeId":8}]},"7":{"id":7,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Decision_Turn08_VPSelection_Gloria\"] == true","variablesRead":[{"var":"BaseGame.Decision_Turn08_VPSelection_Gloria","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":146}]},"8":{"id":8,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn08_VPSelection_Gloria\"] == true) == false","variablesRead":[{"var":"BaseGame.Decision_Turn08_VPSelection_Gloria","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":147}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian and I were on our way to my office. I was holding a mug of coffee in one hand and a folder of various documents in the other.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":144}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"“I don't want to cause further division among Sords because of this.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":19}]},"11":{"id":11,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“Be careful with that box!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":32}]},"12":{"id":12,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“You can leave it there. Thank you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":34}]},"13":{"id":13,"speaker":"Narrator","isPlayerChoice":false,"text":"As we turned a corner, Lucian spoke.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Petr_isVP","op":"=","value":"false"}],"outgoingIds":[{"convId":143,"nodeId":14}]},"14":{"id":14,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“The Aschraf anniversary is coming up soon. The most important day for the Bludish populace. Watani Aschraf is one of their symbols, as you know.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":16}]},"15":{"id":15,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Be careful with that!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":28}]},"16":{"id":16,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Your presence at this event would show your desire for a more unified Sordland. We will reap the benefits if you decide to go, I'm sure.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":10},{"convId":143,"nodeId":17},{"convId":143,"nodeId":18}]},"17":{"id":17,"speaker":"Player","isPlayerChoice":true,"text":"“Why should I attend a Bludish anniversary?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":20}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“You are right.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":21}]},"19":{"id":19,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“As I said, I believe this is an opportunity to portray yourself as a unifier, not a divider.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":22}]},"20":{"id":20,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“It would send a clear message to the Bludish. Your President is with you. This will alleviate tensions.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":22}]},"21":{"id":21,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian nodded.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":22}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"We rounded another corner to reach the last corridor leading to my office.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":23}]},"23":{"id":23,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian suddenly stopped in front of one of the doors. The plaque that once said 'Vice President Petr Vectern' had been removed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":24}]},"24":{"id":24,"speaker":"Narrator","isPlayerChoice":false,"text":"The door was halfway open, and I could see a few workers moving boxes around the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":3}]},"25":{"id":25,"speaker":"Narrator","isPlayerChoice":false,"text":"I heard Albin's voice from inside.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":157}]},"26":{"id":26,"speaker":"Narrator","isPlayerChoice":false,"text":"I heard Gloria's voice from behind him.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":11}]},"27":{"id":27,"speaker":"Narrator","isPlayerChoice":false,"text":"Another handyman dropped a heavy-looking box on the desk. A crunching sound was heard from within.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":15}]},"28":{"id":28,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Mr. President, this move requires my personal attention.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":86}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"One of them saw us, bowed his head and changed the name tag on the door to 'Vice President Lucian Galade'.","conditionsRaw":"((Variable[\"BaseGame.Decision_Turn08_VPSelection_Albin\"] == true) == false) and ((Variable[\"BaseGame.Decision_Turn08_VPSelection_Gloria\"] == true) == false) and (Variable[\"BaseGame.Media_Censored\"] == false) and ((Variable[\"BaseGame.Media_Censored\"] == false) == false)","variablesRead":[{"var":"BaseGame.Decision_Turn08_VPSelection_Albin","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn08_VPSelection_Gloria","op":"==","value":"true"},{"var":"BaseGame.Media_Censored","op":"==","value":"false"}],"variablesModified":[{"var":"BaseGameSupport.News_Turn08_R_VP_Lucian","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_VP_Lucian","op":"=","value":"true"}],"outgoingIds":[{"convId":143,"nodeId":155}]},"30":{"id":30,"speaker":"Narrator","isPlayerChoice":false,"text":"One of them saw us, bowed his head and changed the name tag on the door to 'Vice President Gloria Tory'.","conditionsRaw":"((Variable[\"BaseGame.Decision_Turn08_VPSelection_Albin\"] == true) == false) and (Variable[\"BaseGame.Decision_Turn08_VPSelection_Gloria\"] == true) and (Variable[\"BaseGame.Media_Censored\"] == false) and ((Variable[\"BaseGame.Media_Censored\"] == false) == false)","variablesRead":[{"var":"BaseGame.Decision_Turn08_VPSelection_Albin","op":"==","value":"true"},{"var":"BaseGame.Decision_Turn08_VPSelection_Gloria","op":"==","value":"true"},{"var":"BaseGame.Media_Censored","op":"==","value":"false"}],"variablesModified":[{"var":"BaseGameSupport.News_Turn08_R_VP_Gloria","op":"=","value":"true"},{"var":"BaseGameSupport.News_Turn08_HP_VP_Gloria","op":"=","value":"true"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly","op":"=","value":"false"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_NoSpeaker","op":"=","value":"false"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_SpeakerAlbin","op":"=","value":"true"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_SpeakerKatarina","op":"=","value":"false"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_SpeakerRemus","op":"=","value":"false"},{"var":"BaseGame.CurrentSpeaker_Albin","op":"=","value":"true"}],"outgoingIds":[{"convId":143,"nodeId":156}]},"31":{"id":31,"speaker":"Narrator","isPlayerChoice":false,"text":"One of them saw us, bowed his head and changed the name tag on the door to 'Vice President Albin Clavin'.","conditionsRaw":"(Variable[\"BaseGame.Decision_Turn08_VPSelection_Albin\"] == true) and (Variable[\"BaseGame.CurrentSpeaker_Albin\"] == true) and ((Variable[\"BaseGame.CurrentSpeaker_Albin\"] == true) == false) and (Variable[\"BaseGame.Media_Censored\"] == false) and ((Variable[\"BaseGame.Media_Censored\"] == false) == false)","variablesRead":[{"var":"BaseGame.Decision_Turn08_VPSelection_Albin","op":"==","value":"true"},{"var":"BaseGame.CurrentSpeaker_Albin","op":"==","value":"true"},{"var":"BaseGame.Media_Censored","op":"==","value":"false"}],"variablesModified":[{"var":"BaseGameSupport.News_Turn08_R_VP_Albin","op":"=","value":"true"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly","op":"=","value":"false"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_NoSpeaker","op":"=","value":"false"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_SpeakerAlbin","op":"=","value":"false"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_SpeakerKatarina","op":"=","value":"false"},{"var":"BaseGameSupport.Codex_Organisations_Governmental_GrandNationalAssembly_SpeakerRemus","op":"=","value":"true"},{"var":"BaseGame.CurrentSpeaker_Albin","op":"=","value":"false"},{"var":"BaseGame.CurrentSpeaker_Remus","op":"=","value":"true"}],"outgoingIds":[{"convId":143,"nodeId":25}]},"32":{"id":32,"speaker":"Narrator","isPlayerChoice":false,"text":"She noticed us and immediately made her way to us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":33}]},"33":{"id":33,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“Mr. President. Mr. Galade.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":52},{"convId":143,"nodeId":51},{"convId":143,"nodeId":50}]},"34":{"id":34,"speaker":"Narrator","isPlayerChoice":false,"text":"He noticed us and immediately made his way to us.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":36}]},"35":{"id":35,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“That is Mr. Galade to you Mr. *Vice President*.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":37}]},"36":{"id":36,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“Mr. President. Lucian.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":35}]},"37":{"id":37,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“Very well, Mr. Galade.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":44},{"convId":143,"nodeId":45},{"convId":143,"nodeId":46}]},"38":{"id":38,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian's upper lip curled. He and Albin stared at each other down for a moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":42}]},"39":{"id":39,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“Mr. Galade. Please deliver this to my secretary. This needs to be in the hands of the Justice Committee as soon as possible.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":38}]},"40":{"id":40,"speaker":"Narrator","isPlayerChoice":false,"text":"Lucian's upper lip curled. He and Gloria stared at each other down for a moment.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":43}]},"41":{"id":41,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“Mr. Galade. Could you talk to the Staff Secretary for me to get the furniture sorted here? I have a few more boxes coming in.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":40}]},"42":{"id":42,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I am not your servant, Mr. Clavin.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":57}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I am not your servant, Mrs. Tory.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":56}]},"44":{"id":44,"speaker":"Player","isPlayerChoice":true,"text":"“How is it going? Are you settled in yet?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":47}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"“I want you ready to work as soon as possible.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":48}]},"46":{"id":46,"speaker":"Player","isPlayerChoice":true,"text":"“Albin! Good to see you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":49}]},"47":{"id":47,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“Getting there, Mr. President. That reminds me...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":39}]},"48":{"id":48,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“As you wish, Mr. President. That reminds me...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":39}]},"49":{"id":49,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“Good to see you too, Mr. President. I'm almost ready to get to work. That reminds me...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":39}]},"50":{"id":50,"speaker":"Player","isPlayerChoice":true,"text":"“Gloria! Good to see you.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":53}]},"51":{"id":51,"speaker":"Player","isPlayerChoice":true,"text":"“I want you ready to work as soon as possible.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":54}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"“How is it going? Are you settled in yet?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":55}]},"53":{"id":53,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“Good to see you too, Mr. President. I'm almost ready to get to work. That reminds me...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":41}]},"54":{"id":54,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“As you wish, Mr. President. That reminds me...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":41}]},"55":{"id":55,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“Getting there, Mr. President. That reminds me...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":41}]},"56":{"id":56,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“It was just a simple request, Mr. Galade. I don't know what's with you but I don't like your attitude.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":72},{"convId":143,"nodeId":78},{"convId":143,"nodeId":75}]},"57":{"id":57,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“True, but I am your superior, *Lucian*.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":58},{"convId":143,"nodeId":63},{"convId":143,"nodeId":64}]},"58":{"id":58,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian, do as your Vice President says.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":60}]},"59":{"id":59,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“But, Mr. President...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":61}]},"60":{"id":60,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me with surprise.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":59}]},"61":{"id":61,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Very well. I will do it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":88}]},"62":{"id":62,"speaker":"Narrator","isPlayerChoice":false,"text":"He walked out in a huff, leaving me alone with Albin.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Lucian_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Lucian_Opinion\"] - 1"}],"outgoingIds":[{"convId":143,"nodeId":87}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“We work with requests here, Mr. Clavin. Not orders.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":65}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“Albin. Go deliver it yourself. We are busy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":67}]},"65":{"id":65,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“Then I request. Mr. Galade, could you *please* deliver this to my secretary? Please.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":66}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Fine. I'll take it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":70}]},"67":{"id":67,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“I see. I will do that then. Thank you for stopping by.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":68}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned his back on us. Lucian had an uncharacteristic smirk on his face.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":71}]},"69":{"id":69,"speaker":"Narrator","isPlayerChoice":false,"text":"He walked out, leaving me alone with Albin.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":87}]},"70":{"id":70,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I will see you later, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":89}]},"71":{"id":71,"speaker":"Narrator","isPlayerChoice":false,"text":"The two of us continued to my office to talk about our Aschraf strategy.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":119}]},"72":{"id":72,"speaker":"Player","isPlayerChoice":true,"text":"“Lucian, do as your Vice President says.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":73}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me with surprise.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":76}]},"74":{"id":74,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I will see you later. Mr. President and Mrs. Vice President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":92}]},"75":{"id":75,"speaker":"Player","isPlayerChoice":true,"text":"“Gloria. Go talk to the Staff Secretary yourself. We are busy.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":82}]},"76":{"id":76,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“But, Mr. President...”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":77}]},"77":{"id":77,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Very well. I will do it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":91}]},"78":{"id":78,"speaker":"Player","isPlayerChoice":true,"text":"“That's the job of an office secretary, Mrs. Tory. Not our chief strategist.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":79}]},"79":{"id":79,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“I know. As I said, it was just a simple request. I do not understand why it's becoming such a huge deal.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":80}]},"80":{"id":80,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“Very well... I will do it.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":74}]},"81":{"id":81,"speaker":"Narrator","isPlayerChoice":false,"text":"He walked out, leaving me alone with Gloria.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":94}]},"82":{"id":82,"speaker":"Gloria Tory","isPlayerChoice":false,"text":"“I see. I will do that then. Thank you for stopping by.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":83}]},"83":{"id":83,"speaker":"Narrator","isPlayerChoice":false,"text":"She turned her back on us. Lucian had an uncharacteristic smirk on his face.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":85}]},"84":{"id":84,"speaker":"Narrator","isPlayerChoice":false,"text":"He left in a huff. I turned to Gloria.","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Lucian_Opinion","op":"=","value":"Variable[\"BaseGame.Relations_Lucian_Opinion\"] - 1"}],"outgoingIds":[{"convId":143,"nodeId":94}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"The two of us continued to my office to talk about our Aschraf strategy.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":119}]},"86":{"id":86,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“We shall discuss the Aschraf matter later.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":97},{"convId":143,"nodeId":95},{"convId":143,"nodeId":99}]},"87":{"id":87,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“Well then. I must get back to tidying up this room. Thank you for visiting, Mr. President.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":90}]},"88":{"id":88,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“For the Aschraf matter, I will present you with our options later.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":123}]},"89":{"id":89,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“For the Aschraf matter, I will present you with our options later.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":69}]},"90":{"id":90,"speaker":"Albin Clavin","isPlayerChoice":false,"text":"“I will stop by as soon as this is done.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":104},{"convId":143,"nodeId":103},{"convId":143,"nodeId":105}]},"91":{"id":91,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I will present you with our options on the Aschraf matter later.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":143,"nodeId":122}]},"92":{"id":92,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"“I will present you with our options on the Aschraf matter later.”","conditions