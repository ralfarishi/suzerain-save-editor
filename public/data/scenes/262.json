aw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":262,"nodeId":95},{"convId":262,"nodeId":96},{"convId":262,"nodeId":97}]},"95":{"id":95,"speaker":"Player","isPlayerChoice":false,"text":"...the largest, bloodiest steak he could find.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":262,"nodeId":117}]},"96":{"id":96,"speaker":"Player","isPlayerChoice":false,"text":"...a hearty and healthy breakfast.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":262,"nodeId":117}]},"97":{"id":97,"speaker":"Player","isPlayerChoice":false,"text":"...a bottle of whiskey.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":262,"nodeId":117}]},"98":{"id":98,"speaker":"Narrator","isPlayerChoice":false,"text":"You were dragged outside after you finished your final meal. The guards brought you to a corner just outside the prison block and tied your hands behind your back.\n\nYou took a look at the wall behind you. It was covered in dried blood.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":262,"nodeId":99}]},"99":{"id":99,"speaker":"Player","isPlayerChoice":false,"text":"You heard the footsteps of soldiers approaching.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":262,"nodeId":118}]},"100":{"id":100,"speaker":"Narrator","isPlayerChoice":false,"text":"The squad of soldiers turned the corner and lined up across from you. At the head of the line was their commander, Iosef.\n\nHe checked his watch and declared that the time had come. \n\nHe pulled out a cloth to cover your eyes.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":262,"nodeId":102},{"convId":262,"nodeId":101}]},"101":{"id":101,"speaker":"Player","isPlayerChoice":false,"text":"Beg Iosef to free you.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outg