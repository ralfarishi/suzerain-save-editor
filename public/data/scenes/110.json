What are your real intentions?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":10},{"convId":110,"nodeId":8},{"convId":110,"nodeId":9},{"convId":110,"nodeId":7}]},"7":{"id":7,"speaker":"Player","isPlayerChoice":true,"text":"\"I'm trying not to lose the support of the people. This is their will.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":59}]},"8":{"id":8,"speaker":"Player","isPlayerChoice":true,"text":"\"I know that I can't do a lot. But I'm doing my best to start the change.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":38}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"\"I only want a strong Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":51}]},"10":{"id":10,"speaker":"Player","isPlayerChoice":true,"text":"\"We need a better democracy. That's all I'm striving for.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":20}]},"11":{"id":11,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I see your intentions but this is not the way forward.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Veto_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Veto_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":25}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"\"The threshold is what keeps the extremist parties outside.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":104}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"\"The Assembly is the most democratic institution that we have.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":15}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"She smiled a little.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":71}]},"15":{"id":15,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"But what happens when they have no checks on them?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":77},{"convId":110,"nodeId":27},{"convId":110,"nodeId":48}]},"16":{"id":16,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":25}]},"17":{"id":17,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":18},{"convId":110,"nodeId":19}]},"18":{"id":18,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or \nVariable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":28}]},"19":{"id":19,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or \nVariable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == tr