n\"] + 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"55":{"id":55,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Strong? You are weakening both the executive and the judiciary.\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Veto_Removed\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Veto_Removed","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":16}]},"56":{"id":56,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I don't see any in this proposal.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":67}]},"57":{"id":57,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I don't see how this proposal helps with that.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Decrees_Removed\"] == true  and  Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  and  Variable[\"BaseGame.Reform_Law_Veto_Removed\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Decrees_Stronger\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Law_Decrees_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Veto_Removed","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Decrees_Stronger","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":78}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":60},{"convId":110,"nodeId":61}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_15\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_15","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":63}]},"61":{"id":61,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_15\"] == true) == false","variablesRead":[{"var":"BaseGame.Reform_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_15","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":3}]},"62":{"id":62,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Maybe you are right about that. But I still don't think if this proposal would help with that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":97}]},"63":{"id":63,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Then why would you not include a decrease in our election threshold that everybody outside of your own party finds ridiculous?\"","conditionsRaw":"Variable[\"BaseGame.Reform_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_15\"] == true","variablesRead":[{"var":"BaseGame.Reform_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_15","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":66}]},"64":{"id":64,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I like your honesty, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":54}]},"65":{"id":65,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Oh yes. People wanted the Supreme Court Justices to be impeached by the Assembly whenever they want.\"","conditionsRaw":"(Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or \nVariable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true) and ((Variable[\"BaseGame.Reform_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_15\"] == true) == false)","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_15","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":70}]},"66":{"id":66,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Maybe you only care about a certain part of the population, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"},{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":110,"nodeId":12},{"convId":110,"nodeId":99},{"convId":110,"nodeId":101},{"convId":110,"nodeId":103}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"68":{"id":68,"speaker":"Player","isPlayerChoice":true,"text":"\"Not my intention. But if there is demand, we must consider it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":79}]},"69":{"id":69,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"But this will also result in the same, Mr. President. What happens if a party holds an absolute majority in the Assembly?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":41},{"convId":110,"nodeId":37},{"convId":110,"nodeId":35}]},"70":{"id":70,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I am sure this is what takes up everybody's mind.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":76}]},"71":{"id":71,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I guess it's a fitting description.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":69}]},"72":{"id":72,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I don't find it believable.\"","conditionsRaw":"((Variable[\"BaseGame.Reform_Law_Judges_Impeachment_Assembly\"] == true  or \nVariable[\"BaseGame.Reform_Law_Judges_Impeachment_President\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_15\"] == true) == false) and ((Variable[\"BaseGame.Reform_Law_Ministers_Default\"] == true  and  (Variable[\"BaseGame.Reform_Law_Threshold_Default\"] == true  or  Variable[\"BaseGame.Reform_Law_Threshold_15\"] == true)  and  (Variable[\"BaseGame.Reform_Law_Decrees_Default\"] == true  or  Variable[\"BaseGame.Reform_Law_Decrees_Stronger\"] == true)) == false)","variablesRead":[{"var":"BaseGame.Reform_Law_Judges_Impeachment_Assembly","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Judges_Impeachment_President","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_Default","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Threshold_15","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Ministers_Default","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Decrees_Default","op":"==","value":"true"},{"var":"BaseGame.Reform_Law_Decrees_Stronger","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":118}]},"73":{"id":73,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Interesting. But I am not sure if this proposal would help with that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":97}]},"74":{"id":74,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":66}]},"75":{"id":75,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Is that what you call it?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":14}]},"76":{"id":76,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":92}]},"77":{"id":77,"speaker":"Player","isPlayerChoice":true,"text":"\"Is the elective dictatorship we have is better?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":75}]},"78":{"id":78,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"79":{"id":79,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Of course it's not your intention.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":64}]},"80":{"id":80,"speaker":"Player","isPlayerChoice":true,"text":"\"I thought you would agree to that. I believed that respectable Justices like you are against the Old Guard.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":87}]},"81":{"id":81,"speaker":"Player","isPlayerChoice":true,"text":"\"It depends on the circumstances.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":94}]},"82":{"id":82,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"83":{"id":83,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":85}]},"84":{"id":84,"speaker":"Player","isPlayerChoice":true,"text":"\"This will pave the way for a parliamentary democracy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":24}]},"85":{"id":85,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"How? This is an attack against the Court...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"86":{"id":86,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":92}]},"87":{"id":87,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Look. I am in opposition to them and definitely stand against their dominance. But this is not the way.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":42}]},"88":{"id":88,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. We must eventually decrease the threshold.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":90}]},"89":{"id":89,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes. That is the future for Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":62}]},"90":{"id":90,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":42}]},"91":{"id":91,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Is that one of your intentions then?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":88},{"convId":110,"nodeId":81},{"convId":110,"nodeId":68}]},"92":{"id":92,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"Why did you include that in the proposal, knowing that you need our vote?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":108},{"convId":110,"nodeId":80},{"convId":110,"nodeId":93}]},"93":{"id":93,"speaker":"Player","isPlayerChoice":true,"text":"\"I thought the Court could see reason.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":83}]},"94":{"id":94,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"What a convincing answer, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":98}]},"95":{"id":95,"speaker":"Player","isPlayerChoice":true,"text":"\"I think the presidential system is what damaged our republic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":62}]},"96":{"id":96,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"The proposal doesn't contain any democratic reforms about the elections, decrees nor the minister procedures.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":102}]},"97":{"id":97,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] + 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"98":{"id":98,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGameIsolated.Turn07_A_Isabel_Opinion","op":"=","value":"Variable[\"BaseGameIsolated.Turn07_A_Isabel_Opinion\"] - 1"}],"outgoingIds":[{"convId":110,"nodeId":42}]},"99":{"id":99,"speaker":"Player","isPlayerChoice":true,"text":"\"I don't think this is the right time for such reform. It can create a political crisis.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":110,"nodeId":104}]},"100":{"id":100,"speaker":"Isabel Edmonds","isPlayerChoice":false,"text":"\"I actually agree with that. We can't let the Malenyevi