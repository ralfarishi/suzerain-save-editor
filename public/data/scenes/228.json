{"conversationId":228,"title":"Sordland/Turn10/Personal_SergeFuneral","storyPack":"StoryPack_Main","turn":10,"turnLabel":"Turn 10","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":80}]},"2":{"id":2,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Player","isPlayerChoice":true,"text":"“I will hold my own umbrella.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":73}]},"4":{"id":4,"speaker":"Narrator","isPlayerChoice":false,"text":"It was raining as my car came to a stop by the Holsord Grand Cemetery.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":69}]},"5":{"id":5,"speaker":"Narrator","isPlayerChoice":false,"text":"He offered to carry my umbrella.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":3},{"convId":228,"nodeId":6}]},"6":{"id":6,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Let him carry your umbrella.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":73}]},"7":{"id":7,"speaker":"Narrator","isPlayerChoice":false,"text":"Under the watchful eyes of security officers, I started walking amidst the gravestones.","conditionsRaw":"(Variable[\"BaseGame.Ending_Coup\"] == true) == false","variablesRead":[{"var":"BaseGame.Ending_Coup","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":8}]},"8":{"id":8,"speaker":"Narrator","isPlayerChoice":false,"text":"A small crowd of family and friends gathered around the final resting place of Serge Wolkner.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":9}]},"9":{"id":9,"speaker":"Narrator","isPlayerChoice":false,"text":"Some in the media were calling him a hero: the brave driver who saved the president by sacrificing his life. It was true.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":20}]},"10":{"id":10,"speaker":"Narrator","isPlayerChoice":false,"text":"I walked up to his widow, Suzan. I had never met her in person before.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":84}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":12},{"convId":228,"nodeId":13}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Serge_Friend\"] == true","variablesRead":[{"var":"BaseGame.Relations_Serge_Friend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":14}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Serge_Friend\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Serge_Friend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":15}]},"14":{"id":14,"speaker":"Narrator","isPlayerChoice":false,"text":"Little Anton was crying silently next to his sister, Erica.","conditionsRaw":"Variable[\"BaseGame.Relations_Serge_Friend\"] == true","variablesRead":[{"var":"BaseGame.Relations_Serge_Friend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":57},{"convId":228,"nodeId":58},{"convId":228,"nodeId":59}]},"15":{"id":15,"speaker":"Narrator","isPlayerChoice":false,"text":"Little Georg was crying silently next to his sister, Erica.","conditionsRaw":"(Variable[\"BaseGame.Relations_Serge_Friend\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Serge_Friend","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":57},{"convId":228,"nodeId":58},{"convId":228,"nodeId":59}]},"16":{"id":16,"speaker":"Narrator","isPlayerChoice":false,"text":"They were too young to experience the pain of losing a father.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":17}]},"17":{"id":17,"speaker":"Narrator","isPlayerChoice":false,"text":"I walked over to stand next to the priest, who stepped back upon my arrival.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":19}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"“Today, we are mourning a hero of our nation.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":23},{"convId":228,"nodeId":24},{"convId":228,"nodeId":25}]},"19":{"id":19,"speaker":"Narrator","isPlayerChoice":false,"text":"I looked around at everyone's faces.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":21},{"convId":228,"nodeId":18},{"convId":228,"nodeId":22}]},"20":{"id":20,"speaker":"Narrator","isPlayerChoice":false,"text":"Despite my protests, security wouldn't permit a larger funeral.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":10}]},"21":{"id":21,"speaker":"Player","isPlayerChoice":true,"text":"“Today, we have gathered here to mourn the man who saved my life.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":23},{"convId":228,"nodeId":24},{"convId":228,"nodeId":25}]},"22":{"id":22,"speaker":"Player","isPlayerChoice":true,"text":"“Today, we are sending off a friend, a husband and a father.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":23},{"convId":228,"nodeId":24},{"convId":228,"nodeId":25}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"“Serge Wolkner was a true Sord. He was honest, proud and brave.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":29},{"convId":228,"nodeId":28},{"convId":228,"nodeId":26}]},"24":{"id":24,"speaker":"Player","isPlayerChoice":true,"text":"“Serge Wolkner was more than a simple driver for me. He was a real friend.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":29},{"convId":228,"nodeId":28},{"convId":228,"nodeId":26}]},"25":{"id":25,"speaker":"Player","isPlayerChoice":true,"text":"“Serge Wolkner was loved by many and he will be missed dearly.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":29},{"convId":228,"nodeId":28},{"convId":228,"nodeId":26}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"“I will always cherish the moments I spent with him.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":31},{"convId":228,"nodeId":30},{"convId":228,"nodeId":27}]},"27":{"id":27,"speaker":"Player","isPlayerChoice":true,"text":"“He has left us too soon.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":34},{"convId":228,"nodeId":35},{"convId":228,"nodeId":33}]},"28":{"id":28,"speaker":"Player","isPlayerChoice":true,"text":"“His memory is engraved in all of our minds and hearts. We must remember him well.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":31},{"convId":228,"nodeId":30},{"convId":228,"nodeId":27}]},"29":{"id":29,"speaker":"Player","isPlayerChoice":true,"text":"“I wouldn't be able to find a single person who did not enjoy his company.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":31},{"convId":228,"nodeId":30},{"convId":228,"nodeId":27}]},"30":{"id":30,"speaker":"Player","isPlayerChoice":true,"text":"“I will never forget that I am standing here right now because of his sacrifice.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":34},{"convId":228,"nodeId":35},{"convId":228,"nodeId":33}]},"31":{"id":31,"speaker":"Player","isPlayerChoice":true,"text":"“I will be forever burdened with the fact that this happened because of me.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":34},{"convId":228,"nodeId":35},{"convId":228,"nodeId":33}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"“I am granting him the title, 'Hero of Sordland'.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":40},{"convId":228,"nodeId":38},{"convId":228,"nodeId":39}]},"33":{"id":33,"speaker":"Player","isPlayerChoice":true,"text":"“I swear to cherish the life he has once again granted me with.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":32},{"convId":228,"nodeId":36},{"convId":228,"nodeId":37}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"“His death will be avenged. This, I promise.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":32},{"convId":228,"nodeId":36},{"convId":228,"nodeId":37}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"“The family he has left behind will have the full support of the government.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":32},{"convId":228,"nodeId":36},{"convId":228,"nodeId":37}]},"36":{"id":36,"speaker":"Player","isPlayerChoice":true,"text":"“I am granting him the military rank of Major.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":40},{"convId":228,"nodeId":38},{"convId":228,"nodeId":39}]},"37":{"id":37,"speaker":"Player","isPlayerChoice":true,"text":"“In these dark times, we need to come together in unity.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":40},{"convId":228,"nodeId":38},{"convId":228,"nodeId":39}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"“Farewell, brother.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":41}]},"39":{"id":39,"speaker":"Player","isPlayerChoice":true,"text":"“Thank you for your service, Serge.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":41}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"“May his memory last forever.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":41}]},"41":{"id":41,"speaker":"Narrator","isPlayerChoice":false,"text":"The casket started to be lowered.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":43}]},"42":{"id":42,"speaker":"Narrator","isPlayerChoice":false,"text":"I put my hand in my pocket and pulled out the watch Serge once gave me.","conditionsRaw":"Variable[\"BaseGame.Relations_Serge_GoodLuckCharm\"] == true","variablesRead":[{"var":"BaseGame.Relations_Serge_GoodLuckCharm","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":46}]},"43":{"id":43,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":44},{"convId":228,"nodeId":45}]},"44":{"id":44,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"BaseGame.Relations_Serge_GoodLuckCharm\"] == true","variablesRead":[{"var":"BaseGame.Relations_Serge_GoodLuckCharm","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":42}]},"45":{"id":45,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"BaseGame.Relations_Serge_GoodLuckCharm\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Serge_GoodLuckCharm","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":52}]},"46":{"id":46,"speaker":"Narrator","isPlayerChoice":false,"text":"I recalled that he said it protected his father from the evil of this world.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":47}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"At first I didn't believe it, but now I did.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":48},{"convId":228,"nodeId":49},{"convId":228,"nodeId":50}]},"48":{"id":48,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Keep the watch.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":52}]},"49":{"id":49,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Give the watch to Serge's son.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":51}]},"50":{"id":50,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Place the watch on his grave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":51}]},"51":{"id":51,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Serge_GoodLuckCharm","op":"=","value":"false"}],"outgoingIds":[{"convId":228,"nodeId":79}]},"52":{"id":52,"speaker":"Narrator","isPlayerChoice":false,"text":"As the casket hit the ground, mourners sprinkled handfuls of dirt on Serge's grave.","conditionsRaw":"(Variable[\"BaseGame.Relations_Serge_GoodLuckCharm\"] == true) == false","variablesRead":[{"var":"BaseGame.Relations_Serge_GoodLuckCharm","op":"==","value":"true"}],"variablesModified":[{"var":"BaseGame.Relations_Serge_GoodLuckCharm","op":"=","value":"false"}],"outgoingIds":[{"convId":228,"nodeId":53}]},"53":{"id":53,"speaker":"Narrator","isPlayerChoice":false,"text":"His wife and children hugged each other.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":54}]},"54":{"id":54,"speaker":"Narrator","isPlayerChoice":false,"text":"I realized it was time for me to leave.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":67}]},"55":{"id":55,"speaker":"Narrator","isPlayerChoice":false,"text":"It started pouring.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":56}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"GameCondition.Turn10_Personal_SergeFuneral","op":"=","value":"true"}],"outgoingIds":[{"convId":228,"nodeId":78}]},"57":{"id":57,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Wipe their tears.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":60},{"convId":228,"nodeId":61},{"convId":228,"nodeId":66}]},"58":{"id":58,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Pat them on their heads.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":60},{"convId":228,"nodeId":61},{"convId":228,"nodeId":66}]},"59":{"id":59,"speaker":"Player_Italic","isPlayerChoice":true,"text":"Give them a hug.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":60},{"convId":228,"nodeId":61},{"convId":228,"nodeId":66}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"“Your father was a great man. Don't ever forget that.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":16}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"“It's okay to cry. Let it all out.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":16}]},"62":{"id":62,"speaker":"Player","isPlayerChoice":true,"text":"“Ms. Wolkner. I will never forget your husband's service and his heroic sacrifice.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":65}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"“I am so sorry, Suzan.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":65}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"“My condolences.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":65}]},"65":{"id":65,"speaker":"Narrator","isPlayerChoice":false,"text":"We hugged and she cried on my shoulder. I crouched next to Serge's children.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":11}]},"66":{"id":66,"speaker":"Player","isPlayerChoice":true,"text":"“You must be strong.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":16}]},"67":{"id":67,"speaker":"Narrator","isPlayerChoice":false,"text":"As I turned my back on Serge's final resting place, I looked up at the dark clouds above.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":228,"nodeId":55}]},"68":{"id":68,"speaker":"Narrator","isPlayerChoice":false,"text":"My new driver opened the door. I had forgotten his name already.","conditionsRaw":"(