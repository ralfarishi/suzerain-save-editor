{"conversationId":16,"title":"Sordland/Turn02/AutocratSection","storyPack":"StoryPack_Main","turn":2,"turnLabel":"Turn 2","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":1}]},"1":{"id":1,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":14}]},"2":{"id":2,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":14,"nodeId":97}]},"3":{"id":3,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Let's get back to the topic.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":2}]},"4":{"id":4,"speaker":"Player","isPlayerChoice":true,"text":"\"Be careful with what you decide to do, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":29}]},"5":{"id":5,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":17,"nodeId":36}]},"6":{"id":6,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I can't believe you are supporting this too.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":46}]},"7":{"id":7,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"While I respect her, I doubt that she's capable of creating major obstacles for us. But we have to keep close eyes on her.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":13},{"convId":16,"nodeId":12},{"convId":16,"nodeId":9}]},"8":{"id":8,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"That's true. We have bigger fish to catch.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":3}]},"9":{"id":9,"speaker":"Player","isPlayerChoice":true,"text":"\"She's not our main problem here.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":8}]},"10":{"id":10,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":3}]},"11":{"id":11,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Oh she will. I don't think she has that in her.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":3}]},"12":{"id":12,"speaker":"Player","isPlayerChoice":true,"text":"\"I will make sure she stays in line.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":11}]},"13":{"id":13,"speaker":"Player","isPlayerChoice":true,"text":"\"Yes, keep an eye on her. We can't let her sabotage us.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":10}]},"14":{"id":14,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"We already know that the Old Guards will block any reforms to the Constitution. So, they would definitely want to work with you to preserve it, if that's still what you want to do.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":6}]},"15":{"id":15,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I... Don't get me wrong. I am with you. I was only saying that you could go over the draft. I didn't notice if that came out wrong.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":60},{"convId":16,"nodeId":61}]},"16":{"id":16,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Maybe we can first go over the draft of the amendments that the committee prepared for reforms. You do not have to approve it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":26},{"convId":16,"nodeId":20},{"convId":16,"nodeId":18}]},"17":{"id":17,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"Let's not go that far, Mrs. Morgna. I'm sure we can figure something out. If Mr. President can get Orso Hawker to work with him...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":21}]},"18":{"id":18,"speaker":"Player","isPlayerChoice":true,"text":"\"Fine. Let's hear it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":5}]},"19":{"id":19,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"That's troublesome.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Nia_Opposition","op":"=","value":"true"}],"outgoingIds":[{"convId":16,"nodeId":7}]},"20":{"id":20,"speaker":"Player","isPlayerChoice":true,"text":"\"I've heard the security reports. Now is not the time for reform.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":62}]},"21":{"id":21,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I just do not trust the Chief Justice in delivering any promises. I'm afraid that ignoring the demands for reform might create some future problems for our administration.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":59}]},"22":{"id":22,"speaker":"Narrator","isPlayerChoice":false,"text":"She left the room and slammed the door behind her.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":24}]},"23":{"id":23,"speaker":"Player","isPlayerChoice":true,"text":"\"So what do you suggest we do?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":31}]},"24":{"id":24,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"BaseGame.Relations_Nia_Opposition","op":"=","value":"true"}],"outgoingIds":[{"convId":16,"nodeId":19}]},"25":{"id":25,"speaker":"Petr Vectern","isPlayerChoice":false,"text":"\"I think we can figure something out. You can call a meeting with Orso Hawker. We are not here to destroy the legacy of Tarquin Soll. Why not work with them?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":21}]},"26":{"id":26,"speaker":"Player","isPlayerChoice":true,"text":"\"You too?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":15}]},"27":{"id":27,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I understand, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":22}]},"28":{"id":28,"speaker":"Narrator","isPlayerChoice":false,"text":"She gave a fake smile and left the room.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":24}]},"29":{"id":29,"speaker":"Narrator","isPlayerChoice":false,"text":"She gave a fake smile.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":27}]},"30":{"id":30,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"With all due respect, Mr. President. You are being gullible in thinking you can survive by leaning against the remnants of Soll's autocracy.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":17}]},"31":{"id":31,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Work with the reformists on writing a more democratic Constitution for Sordland. Change cannot be stopped.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":16}]},"32":{"id":32,"speaker":"Player","isPlayerChoice":true,"text":"\"How about you, Petr?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":25}]},"33":{"id":33,"speaker":"Narrator","isPlayerChoice":false,"text":"She didn't respond.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":16}]},"34":{"id":34,"speaker":"Player","isPlayerChoice":true,"text":"\"Good day to you too, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":28}]},"35":{"id":35,"speaker":"Player","isPlayerChoice":true,"text":"\"I will be watching you.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":29}]},"36":{"id":36,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir. Let's proceed to the draft.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":67}]},"37":{"id":37,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Have a good day.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":4},{"convId":16,"nodeId":35},{"convId":16,"nodeId":34}]},"38":{"id":38,"speaker":"Player","isPlayerChoice":true,"text":"\"Come now, I can't have you all go against me on this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":30}]},"39":{"id":39,"speaker":"Narrator","isPlayerChoice":false,"text":"She looked at me in shock. She had no words to say.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":16}]},"40":{"id":40,"speaker":"Player","isPlayerChoice":true,"text":"\"I appreciate your thoughts. Now let's move on.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":30}]},"41":{"id":41,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"With all due respect, I will take my leave from this meeting. I don't think I have anything to add anymore, and I won't sit here and listen to plans of tyranny.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":42}]},"42":{"id":42,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"You cannot stop change from happening, Mr. President.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":44}]},"43":{"id":43,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Even though I do not trust the Chief Justice, I think we can set up a meeting with him to discuss working together to handle the opposition.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":49}]},"44":{"id":44,"speaker":"Narrator","isPlayerChoice":false,"text":"She grabbed her notes and went towards the door.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":37}]},"45":{"id":45,"speaker":"Player","isPlayerChoice":true,"text":"\"So you came here to tell me not to do this.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":30}]},"46":{"id":46,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I do not. I have already explained Mr. President my position on working with the Old Guards.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":45},{"convId":16,"nodeId":40},{"convId":16,"nodeId":38},{"convId":16,"nodeId":32}]},"47":{"id":47,"speaker":"Narrator","isPlayerChoice":false,"text":"Nia stood up with rage.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":41}]},"48":{"id":48,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":55}]},"49":{"id":49,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I can't believe this!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":47}]},"50":{"id":50,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"I'm sorry you feel that way, Mr. President. But I thought you picked me because you wanted to bring justice to Sordland.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":16}]},"51":{"id":51,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Blocking the way of the reforms will create many enemies for us. Our best bet would definitely be working with the Old Guards...\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":43}]},"52":{"id":52,"speaker":"Player","isPlayerChoice":true,"text":"\"YES. I thought I already explained myself.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":57}]},"53":{"id":53,"speaker":"Player","isPlayerChoice":true,"text":"\"I am disappointed in you, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":50}]},"54":{"id":54,"speaker":"Player","isPlayerChoice":true,"text":"\"No, let's try to work with the reformists on a new Constitution.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":36}]},"55":{"id":55,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"I see.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":51}]},"56":{"id":56,"speaker":"Player","isPlayerChoice":true,"text":"\"Watch your words, Mrs. Morgna.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":33}]},"57":{"id":57,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"Of course, sir.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":51}]},"58":{"id":58,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"With all due respect, I have to say that I feel disappointed. I thought this administration was going to bring real change. It seems Sollism still lives on.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":56},{"convId":16,"nodeId":64},{"convId":16,"nodeId":53},{"convId":16,"nodeId":23}]},"59":{"id":59,"speaker":"Nia Morgna","isPlayerChoice":false,"text":"\"Excuse me gentlemen. The reforms are not just *some* problem, they are absolutely necessary to democratize this country.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":58}]},"60":{"id":60,"speaker":"Player","isPlayerChoice":true,"text":"\"Okay. Let's see what these suggested reforms are.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":66}]},"61":{"id":61,"speaker":"Player","isPlayerChoice":true,"text":"\"Look, I will not reform the Constitution. We have other problems.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":62}]},"62":{"id":62,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"\"So we're officially against the constitutional reforms?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":63},{"convId":16,"nodeId":65},{"convId":16,"nodeId":52},{"convId":16,"nodeId":54}]},"63":{"id":63,"speaker":"Player","isPlayerChoice":true,"text":"\"Looks like it.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":55}]},"64":{"id":64,"speaker":"Player","isPlayerChoice":true,"text":"\"Sollism will never die.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":39}]},"65":{"id":65,"speaker":"Player","isPlayerChoice":true,"text":"\"Not *officially.*\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":16,"nodeId":55}]},"66":{"id":66,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":17,"nodeId":36}]},"67":{"id":67,"speaker":"Lucian Galade","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":17,"nodeId":36}]}}}