e  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true) == false)","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":41}]},"37":{"id":37,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"And your decision to renig on your commitment to wiping out the BFF.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true) and (Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true)","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":44}]},"38":{"id":38,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":39},{"convId":596,"nodeId":40}]},"39":{"id":39,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":37}]},"40":{"id":40,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":36}]},"41":{"id":41,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Agree to help us fight a common threat and you'll be one step closer to seeing Zille under the Rizian flag once more.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":48}]},"42":{"id":42,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Assist in our efforts to combat the well-know terrorist group, the Bludish Freedom Front.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":45}]},"43":{"id":43,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Ban Derdians from crossing into Rizia.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":33}]},"44":{"id":44,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Agree to one or all of those proposals and you'll be one step closer to seeing Zille under the Rizian flag once more.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":49}]},"45":{"id":45,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Agree to one or all proposals, and I can assure that you'll be one step closer to seeing Zille under the Rizian flag once more.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":47}]},"46":{"id":46,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Well, seeing as how you never broke you promise to fight them because you never said you would in the first place, you could...\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true  or \nVariable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":55}]},"47":{"id":47,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Alright.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"48":{"id":48,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm willing to agree to only one of those proposals.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"49":{"id":49,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"No. I can't do that. The issue is too sensitive. I'm not going to put myself in a politically dangerous position.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"50":{"id":50,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Say no more. I agree to all of them, as long as you follow through as well.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":51}]},"51":{"id":51,"speaker":"Narrator","isPlayerChoice":false,"text":"Smolak's eyes went wide.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":52}]},"52":{"id":52,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"This is excellent news! To be perfectly honestly, I wasn't sure I could convince you to agree to just one, let alone all three.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"53":{"id":53,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Allowing Derdians free reign to cross into Rizia whenever they so choose.\"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":33}]},"54":{"id":54,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"There's the issue of Bludish migrants  still being allowed to cross your border.\"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":58}]},"55":{"id":55,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":56},{"convId":596,"nodeId":57}]},"56":{"id":56,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":54}]},"57":{"id":57,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":61}]},"58":{"id":58,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":59},{"convId":596,"nodeId":60}]},"59":{"id":59,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":53}]},"60":{"id":60,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":43}]},"61":{"id":61,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Stop Bludish migrants from crossing your borders.\"","conditionsRaw":"(Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":58}]},"62":{"id":62,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":63},{"convId":596,"nodeId":64}]},"63":{"id":63,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == false  and  (Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true  or \nVariable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF\"] == true)","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"false"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":65}]},"64":{"id":64,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == false  and  (Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true  or \nVariable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF\"] == true)) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"false"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"65":{"id":65,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"So you haven't given up on your crusades against the Bluds.\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == false  and  (Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan\"] == true  or  Variable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan\"] == true  or \nVariable[\"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF\"] == true)","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"false"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_DerdianBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_BludBorderBan","op":"==","value":"true"},{"var":"RiziaDLC.Diplomacy_Wehlen_PromisesBroken_AntiBFF","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":67}]},"66":{"id":66,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"That's like asking to give up our national security. The Bluds pose a constant threat, and we must remain vigilant in protecting our borders and our people.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_RequestPoints","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_RequestPoints\"] + 1"}],"outgoingIds":[{"convId":596,"nodeId":68}]},"67":{"id":67,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"=","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_RequestPoints","op":"=","value":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_RequestPoints\"] + 1"}],"outgoingIds":[{"convId":596,"nodeId":66}]},"68":{"id":68,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"As should you. They're just as much a threat to Rizia as they are to Wehlen.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":70},{"convId":596,"nodeId":69},{"convId":596,"nodeId":71}]},"69":{"id":69,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes, they are indeed a threat. But the political ramifications from the your conditions regarding this issue is too great.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":72}]},"70":{"id":70,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"While Rizia has our own issues with the Bluds, their nothing compared to the yours, which is a result of your own making.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":72}]},"71":{"id":71,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"True. I can't argue with that.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":72}]},"72":{"id":72,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":424,"nodeId":484}]},"73":{"id":73,"speaker":"Narrator","isPlayerChoice":false,"text":"As the sun hung low in the sky, casting long shadows over the empty streets of Wraclawitz, our motorcade wound its way through the heart of Wehlen toward the presidential palace.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":74}]},"74":{"id":74,"speaker":"Narrator","isPlayerChoice":false,"text":"Historic buildings lined our path, their ornate facades a testament to the city's enduring legacy. Yet, despite their lavish appearance, it was clear that time had taken its toll.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":75}]},"75":{"id":75,"speaker":"Narrator","isPlayerChoice":false,"text":"At the behest of President Smolak, I had arrived here with the purpose of negotiating and sealing the agreement with him that would formally reunite Zille with Rizia.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":76}]},"76":{"id":76,"speaker":"Narrator","isPlayerChoice":false,"text":"However, Smolak was conspicuously absent. Upon my plane's landing, I was taken aback to find myself greeted not by President Smolak, but by an elaborate display of Wehlen soldiers standing in formation.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":77}]},"77":{"id":77,"speaker":"Narrator","isPlayerChoice":false,"text":"Before long, the presidential palace came into view. But instead of turning towards the grand entrance, our convoy continued past it.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":108},{"convId":596,"nodeId":107},{"convId":596,"nodeId":78},{"convId":596,"nodeId":106}]},"78":{"id":78,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“Titus, what's the meaning of this? Why aren't we heading to the palace as planned?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":79}]},"79":{"id":79,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"“I'll find out, Your Majesty.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":80}]},"80":{"id":80,"speaker":"Narrator","isPlayerChoice":false,"text":"Titus reached for his handheld radio and contacted the lead vehicle.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":81}]},"81":{"id":81,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"“This is Titus. Why are we not heading to the palace?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":82}]},"82":{"id":82,"speaker":"Narrator","isPlayerChoice":false,"text":"A crackling response from the captain of our Wehzek security escort came through the radio, but it was too inaudible for me to discern.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":83}]},"83":{"id":83,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"“I’m sorry, Your Majesty. There’s apparently been a change of plans. President Smolak isn't at the palace. We're to meet him elsewhere.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":104},{"convId":596,"nodeId":103},{"convId":596,"nodeId":84},{"convId":596,"nodeId":102}]},"84":{"id":84,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“’Elsewhere?’ Where?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":85}]},"85":{"id":85,"speaker":"Narrator","isPlayerChoice":false,"text":"The convoy pulled up to an airfield on the outskirts of the palace grounds, and to my astonishment, a colossal airship awaited me.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":86}]},"86":{"id":86,"speaker":"Narrator","isPlayerChoice":false,"text":"Its sleek form dominated the skyline, with President Smolak's giant image emblazoned on its side, accompanied by the flag of Wehlen along with a bold proclamations of Wehlen's ascent:","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":87}]},"87":{"id":87,"speaker":"Narrator","isPlayerChoice":false,"text":"“With Smolak at the Helm: Wehlen Rises, Soaring to New Heights!\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":99},{"convId":596,"nodeId":98},{"convId":596,"nodeId":88},{"convId":596,"nodeId":105}]},"88":{"id":88,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“Well, this is unexpected.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":89}]},"89":{"id":89,"speaker":"Narrator","isPlayerChoice":false,"text":"If the red carpet stretching from my vehicle to the stairs leading to the airship’s gondola wasn’t a blatant indicator of where I could find Smolak, nothing was.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":90}]},"90":{"id":90,"speaker":"Narrator","isPlayerChoice":false,"text":"Before long, I exited the vehicle and made my way down toward the airship, escorted by Titus.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":91}]},"91":{"id":91,"speaker":"Narrator","isPlayerChoice":false,"text":"It wasn’t until I neared the stairs that I noticed at least a dozen or more attractive young women in impeccably pressed uniforms flanked on either side.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":101},{"convId":596,"nodeId":100},{"convId":596,"nodeId":92},{"convId":596,"nodeId":97}]},"92":{"id":92,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“It appears Smolak has a keen eye for... *talent*.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":93}]},"93":{"id":93,"speaker":"Titus Gordion","isPlayerChoice":false,"text":"“If by ‘talent’ you mean pretty faces in crisp uniforms, then yes. A keen eye, indeed.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":94}]},"94":{"id":94,"speaker":"Narrator","isPlayerChoice":false,"text":"Stepping inside, the interior of the ship was adorned with lavish blue and white drapes cascading from floor-to-ceiling windows. Plush magenta seats line the cabin, each embellished with opulent tassels and cushions embroidered with the Wehlen crest.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":95}]},"95":{"id":95,"speaker":"Narrator","isPlayerChoice":false,"text":"And crystal chandeliers hung from the ceiling, casting a dazzling array of light across the space.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":96}]},"96":{"id":96,"speaker":"Narrator","isPlayerChoice":false,"text":"The gondola cabin practically screamed excess, to the point of absurdity.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"97":{"id":97,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"98":{"id":98,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"The man's got his very own private blimp... why am I not surprised?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"99":{"id":99,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"100":{"id":100,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“Looks like Smolak's crew selection process involves a very specific type.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"101":{"id":101,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"102":{"id":102,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"103":{"id":103,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"104":{"id":104,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"105":{"id":105,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"106":{"id":106,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"107":{"id":107,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"108":{"id":108,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"109":{"id":109,"speaker":"Narrator","isPlayerChoice":false,"text":"Smolak wiped his eyes, thought whether or not it was in jest was unclear.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":113},{"convId":596,"nodeId":112},{"convId":596,"nodeId":110},{"convId":596,"nodeId":114}]},"110":{"id":110,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"How fortuitous that today, of all days, you chose to watch that specific film.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":111}]},"111":{"id":111,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"“Oh, Your Majesty! Fancy seeing you here.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"112":{"id":112,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"113":{"id":113,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"114":{"id":114,"speaker":"Player_Romus","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"115":{"id":115,"speaker":"Narrator","isPlayerChoice":false,"text":"One of the crew members led us to a room where Smolak was waiting.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":116}]},"116":{"id":116,"speaker":"Narrator","isPlayerChoice":false,"text":"I stepped into total blackness, with the only light coming from black and white images being projected onto a screen. Smolak apparently his own private movie theater onboard.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":117}]},"117":{"id":117,"speaker":"Narrator","isPlayerChoice":false,"text":"And there, sitting amongst the twenty or so seats, was the President of Wehlen. He was eating popcorn.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":133},{"convId":596,"nodeId":132},{"convId":596,"nodeId":118}]},"118":{"id":118,"speaker":"Player_Romus","isPlayerChoice":false,"text":"“Mr. President?”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":119}]},"119":{"id":119,"speaker":"Narrator","isPlayerChoice":false,"text":"He turned to me and held a finger to his mouth.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":120}]},"120":{"id":120,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"“Shhh! This is the best part!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":121}]},"121":{"id":121,"speaker":"Narrator","isPlayerChoice":false,"text":"I immediately recognize it as the Wehlen propaganda film, \"From Here to Zille\" a dramatized version of the 1926 Uprising.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":122}]},"122":{"id":122,"speaker":"Narrator","isPlayerChoice":false,"text":"In it, Wehlen soldiers are portrayed as valiant heroes, while the Rizian forces appear bumbling and ineffectual -- highly controversial, to say the least.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":123}]},"123":{"id":123,"speaker":"Narrator","isPlayerChoice":false,"text":"In the scene I was currently watching, a frightened Rizian solider stood before a firing squad, his fate seemingly sealed.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":124}]},"124":{"id":124,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"“Here it comes!”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":125}]},"125":{"id":125,"speaker":"Narrator","isPlayerChoice":false,"text":"But just as the guns are about to fire, a machine gun erupts, mowing down the entire firing squad. The Rizian turns to see a Wehlen soldier standing over him, bathed in sunlight like a divine savior.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":126}]},"126":{"id":126,"speaker":"Narrator","isPlayerChoice":false,"text":"Smolak began speaking along with the actors on the screen.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":127}]},"127":{"id":127,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"“’Behold the might of Wehlen! Our noble soldiers, defenders of justice and champions of the weak! We come to the aid of our Rizian brethren, ensuring peace and prosperity for all under the glorious banner of Wehlen!’\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":128}]},"128":{"id":128,"speaker":"Narrator","isPlayerChoice":false,"text":"The young solider thanked the Wehles soldier, exclaiming that he was forever in his debt.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":129}]},"129":{"id":129,"speaker":"Narrator","isPlayerChoice":false,"text":"Soon after, the music swelled and the credits began to roll.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":130}]},"130":{"id":130,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"“Every time... gets me right in the feelings.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":131}]},"131":{"id":131,"speaker":"Narrator","isPlayerChoice":false,"text":"The lights came up, and it was then that I noticed a baby, who couldn’t have been more than a year old, happily sitting next to Smolak.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"132":{"id":132,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Is someone there?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":119}]},"133":{"id":133,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Smolak, is that you?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":119}]},"134":{"id":134,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"“But come, let us take our leave so we can talk somewhere more comfortably.”","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":135}]},"135":{"id":135,"speaker":"Narrator","isPlayerChoice":false,"text":"Smolak, still holding his bag of popcorn, picked up little Wiktor in his free hand and left the room. I followed after.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":136}]},"136":{"id":136,"speaker":"Narrator","isPlayerChoice":false,"text":"We reentered the observation deck, where I was, once again, greeted by extravagance.","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]}}}