{"conversationId":596,"title":"Rizia/Turn 8/Notes/Notes Conversation","storyPack":"StoryPack_Rizia","turn":8,"turnLabel":"Turn 8","isDevNote":false,"rootNodeId":0,"nodes":{"0":{"id":0,"speaker":"Ovid Grecer","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":1}]},"1":{"id":1,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[]},"3":{"id":3,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":4},{"convId":596,"nodeId":5}]},"4":{"id":4,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == true  and  Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub2\"] == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub2","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":6}]},"5":{"id":5,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == true  and  Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub2\"] == false) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub2","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[]},"6":{"id":6,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Can I count you to help Wehlen counter the Blushish threat?\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == true  and  Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub2\"] == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub2","op":"==","value":"false"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":13},{"convId":596,"nodeId":10},{"convId":596,"nodeId":17}]},"7":{"id":7,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Fine. If it's gas imports you want, I'll make it happen. Even if it means taking a hit in the short term.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_FunnyKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":19}]},"8":{"id":8,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I'm sorry, but I cannot condone any form of oppression against the Bludish people.\"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_TyrantKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":21}]},"9":{"id":9,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"I thought I made myself perfectly clear. I want nothing to do with your opression of the Bludish people.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":21}]},"10":{"id":10,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":11},{"convId":596,"nodeId":12}]},"11":{"id":11,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_TyrantKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":9}]},"12":{"id":12,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_TyrantKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_TyrantKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":8}]},"13":{"id":13,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":14},{"convId":596,"nodeId":15}]},"14":{"id":14,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLC.Trait_FunnyKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":16}]},"15":{"id":15,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLC.Trait_FunnyKing\"] == true) == false","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":7}]},"16":{"id":16,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Alright, fine. If you're dead set on gas imports, I'll play along. But just know, we might end up taking a financial dip faster than a lead balloon -- or should I say lead *air ship*, given our present situation.\"","conditionsRaw":"Variable[\"RiziaDLC.Trait_FunnyKing\"] == true","variablesRead":[{"var":"RiziaDLC.Trait_FunnyKing","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[]},"17":{"id":17,"speaker":"Player_Romus","isPlayerChoice":false,"text":"\"Yes. Whatever it takes to get Zille back. What did you have in mind?\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":30}]},"18":{"id":18,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Haha, well played, Your Majesty! It's good to see you haven't lost your sense of humor amidst all this serious talk.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":27}]},"19":{"id":19,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"Excellent! Your willingness to adapt to the situation is commendable, Your Majesty.\"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":27}]},"20":{"id":20,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"That's unfortunate to hear. Well, if there's no changing your mind, then perhaps you'll agree to another.\"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":27}]},"21":{"id":21,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":22},{"convId":596,"nodeId":23}]},"22":{"id":22,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1\"] == true","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":20}]},"23":{"id":23,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":24}]},"24":{"id":24,"speaker":"Wiktor Smolak (R)","isPlayerChoice":false,"text":"\"I'm quite disappointed by your unwillingness to compromise. In that case, I'm afraid that I have no choice but hold a referendum in Zille regarding the issue of reunification.\"","conditionsRaw":"(Variable[\"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1\"] == true  or \nVariable[\"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1\"] == true) == false","variablesRead":[{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_BludOptions_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_EnergyImport_Hub1","op":"==","value":"true"},{"var":"RiziaDLCIsolated.Turn08_ZilleNeg_ArmsExport_Hub1","op":"==","value":"true"}],"variablesModified":[],"outgoingIds":[{"convId":596,"nodeId":28}]},"25":{"id":25,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":424,"nodeId":1173}]},"26":{"id":26,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],"variablesModified":[],"outgoingIds":[{"convId":424,"nodeId":632}]},"27":{"id":27,"speaker":"Paskal Beniwoll","isPlayerChoice":false,"text":"","conditionsRaw":null,"variablesRead":[],